---
// Fold 3. Structure follows docs/superpowers/specs/assets/home-mock.html
// (the `03 products` block): one featured product with its screenshot and
// scoring weights, then the other three as rows.
//
// The collection already carries `status`, `type` and `version`, so the
// live dot, the type label and the version in the status line are read
// rather than typed. What is NOT in the collection is the home page's own
// copy -- the one-line row blurbs and the ship notes are written for this
// fold and are shorter than any product-page field. They live in HOME
// below, keyed by id, and every product falls back to its tagline, so a
// fifth product still renders the day it is added.
import { getCollection } from 'astro:content';

const products = (await getCollection('products', ({ data }) => data.published))
  .sort((a, b) => a.data.order - b.data.order);
const [featured, ...rest] = products;

const TYPE_LABEL: Record<string, string> = {
  'salesforce-app': 'Salesforce app',
  'integration':    'Integration',
  'mobile-app':     'Mobile app',
  'desktop-app':    'Desktop app',
};

const STATUS_LABEL: Record<string, string> = {
  ga:      'Generally available',
  preview: 'Preview',
  beta:    'Beta',
};

type HomeCopy = {
  blurb: string;
  chips?: string[];
  cta?: string;
  ship?: [string, string];
};

const HOME: Record<string, HomeCopy> = {
  orgvitals: {
    blurb:
      'Find out what is wrong with your org before an audit does. 49 checks across ' +
      'security, code quality, automation, tech debt and performance, graded A to F, ' +
      'with the findings ranked so you know what to fix first. It runs on your ' +
      'machine, reads only, and never writes anything back to the org.',
    chips: ['Dependency graph', 'Cross-org compare', 'Historical trends'],
    cta:   'Scan your org free',
  },
  algobridge: {
    blurb:
      'Your Salesforce data in Postgres, ten seconds behind. Changes flow both ways, ' +
      'and every column edit is kept for 31 days.',
    ship: ['Docker · AWS ECS', 'MIT, self-hosted'],
  },
  pledgivo: {
    blurb:
      'Take a donation without leaving Salesforce. The gift lands as a standard ' +
      'Opportunity the moment it clears, so the reports and flows you already built ' +
      'keep working.',
    ship: ['AppExchange', 'Free to 200 gifts a year'],
  },
  insurealgo: {
    blurb:
      'Never miss a renewal. Countdowns and reminders at 10, 5 and 3 days, with every ' +
      'policy document in one place. No account, no server, no tracking.',
    ship: ['iOS · Android', 'Free'],
  },
};

// The screenshot and the scoring weights belong to OrgVitals, not to
// "whatever sorts first" -- the five weights are quoted from its own
// feature copy. Guarded on the id so a reorder drops the panel rather
// than captioning another product with OrgVitals' numbers.
const SHOT = {
  src: '/products/orgvitals/guide/03-dashboard.gif',
  alt:
    'The OrgVitals dashboard after scanning an org: an overall A-to-F grade with its ' +
    'score, the trend across previous scans, the five category scores, and a ranked ' +
    'list of what to fix first.',
};

const WEIGHTS: Array<[string, number]> = [
  ['Security', 30],
  ['Code quality', 20],
  ['Automation', 20],
  ['Tech debt', 20],
  ['Performance', 10],
];

const featuredCopy = HOME[featured.id];
const showScoring = featured.id === 'orgvitals';
---
<section class="section-press anim-fade-up" aria-labelledby="products-heading">
  <div class="section-press__head">
    <h2 id="products-heading" class="section-title section-title--xs section-title--tighter section-press__title">
      Software we built, and still run.
    </h2>
    <a class="section-press__all" href="/products/">All products &rarr;</a>
  </div>

  <article class="products-press__feature">
    <div class="products-press__featl">
      <span class:list={['products-press__status', { 'products-press__status--ga': featured.data.status === 'ga' }]}>
        <b class="products-press__dot" aria-hidden="true"></b>
        {STATUS_LABEL[featured.data.status]}{featured.data.version && ` v${featured.data.version}`}
        {' '}&middot; {TYPE_LABEL[featured.data.type]}
      </span>
      <h3 class="products-press__name">{featured.data.title}</h3>
      <p class="products-press__lede">{featuredCopy?.blurb ?? featured.data.tagline}</p>

      {featuredCopy?.chips && (
        <div class="products-press__chips">
          {featuredCopy.chips.map((chip) => <span class="products-press__chip">{chip}</span>)}
        </div>
      )}

      <div class="btn-row">
        {featuredCopy?.cta && featured.data.externalUrl && (
          <a class="btn btn-primary" href={featured.data.externalUrl} target="_blank" rel="noopener noreferrer">
            {featuredCopy.cta} &rarr;
          </a>
        )}
        <a class="btn btn-outline" href={`/products/${featured.id}/`}>See what it checks</a>
      </div>
    </div>

    <div class="products-press__featr">
      <figure class="products-press__shot">
        <img src={SHOT.src} alt={SHOT.alt} width="1000" height="627" loading="lazy" decoding="async" />
        <figcaption class="products-press__caption">
          Dashboard v{featured.data.version} &middot; scan of a demo org
        </figcaption>
      </figure>

      {showScoring && (
        <>
          <p class="products-press__wtlab">Category weight</p>
          <dl class="products-press__wt">
            {WEIGHTS.map(([label, pct]) => (
              <div>
                <dt>{label}</dt>
                <dd>
                  <span class="products-press__wbar" aria-hidden="true"><i style={`width:${pct}%`}></i></span>
                  <b>{pct}%</b>
                </dd>
              </div>
            ))}
          </dl>
          <p class="products-press__wtnote">
            Each finding carries a severity and subtracts from its category base. The five
            categories then roll up by these weights into the single grade.
          </p>
        </>
      )}
    </div>
  </article>

  <div class="products-press__rows">
    {rest.map((p) => (
      <div class="products-press__row">
        <span class="section-press__type">{TYPE_LABEL[p.data.type]}</span>
        <div>
          <h3 class="products-press__rname"><a href={`/products/${p.id}/`}>{p.data.title}</a></h3>
          <p class="products-press__rmeta">
            <span class:list={['products-press__status', { 'products-press__status--ga': p.data.status === 'ga' }]}>
              <b class="products-press__dot" aria-hidden="true"></b>
              {STATUS_LABEL[p.data.status]}
            </span>
          </p>
        </div>
        <p class="products-press__rdesc">{HOME[p.id]?.blurb ?? p.data.tagline}</p>
        {HOME[p.id]?.ship
          ? <span class="products-press__ship">{HOME[p.id].ship![0]}<em>{HOME[p.id].ship![1]}</em></span>
          : <span class="products-press__ship"></span>}
      </div>
    ))}
  </div>
</section>
