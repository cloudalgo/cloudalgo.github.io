<section id="hero-section" class="hero-section" style="background:#F5F5F2;padding-top:8rem;padding-bottom:5rem;overflow:hidden;position:relative;">

  <!-- Geometric decorative shapes -->
  <div id="hero-dot-1" style="position:absolute;top:15%;right:8%;width:12px;height:12px;border-radius:50%;background:#0A0A0A;opacity:0.12;" aria-hidden="true"></div>
  <div id="hero-dot-2" style="position:absolute;top:30%;right:15%;width:7px;height:7px;border-radius:50%;background:#0A0A0A;opacity:0.08;" aria-hidden="true"></div>
  <div id="hero-dot-3" style="position:absolute;bottom:25%;left:5%;width:9px;height:9px;border-radius:50%;border:1.5px solid #0A0A0A;opacity:0.12;" aria-hidden="true"></div>

  <div style="max-width:1278px;margin:0 auto;padding:0 1.5rem;">
    <div class="row align-items-center" style="gap:2rem 0;">

      <!-- Left column: text -->
      <div class="col-lg-6">
        <p class="section-label anim-fade-up" style="transition-delay:0.05s;">Salesforce &amp; Heroku Consulting</p>

        <h1 style="font-size:clamp(2.5rem,5.5vw,5rem);font-weight:900;letter-spacing:-0.03em;line-height:1.05;color:#0A0A0A;margin-bottom:1.5rem;">
          <span class="hero-line anim-fade-up" style="transition-delay:0.1s;">We make Salesforce</span><br/>
          <span class="hero-line anim-fade-up" style="transition-delay:0.18s;">actually work for</span><br/>
          <span class="hero-line anim-fade-up" style="transition-delay:0.26s;">your business.</span>
        </h1>

        <p class="paragraph-large anim-fade-up" style="max-width:520px;margin-bottom:2.25rem;color:#5A5A5A;transition-delay:0.34s;">
          CloudAlgo is a certified team of Salesforce architects and developers.
          70+ projects delivered, 12 years of combined experience.
        </p>

        <div style="display:flex;align-items:center;gap:1rem;flex-wrap:wrap;transition-delay:0.42s;" class="anim-fade-up">
          <a href="/contact" class="btn btn-primary">Book a Consultation &rarr;</a>
          <a href="/services" class="btn btn-outline">See our work</a>
        </div>
      </div>

      <!-- Right column: illustration -->
      <div id="hero-illustration" class="col-lg-6" style="display:flex;justify-content:center;align-items:center;padding-top:2rem;" aria-hidden="true">
        <svg viewBox="0 0 520 440" fill="none" xmlns="http://www.w3.org/2000/svg"
             style="width:100%;max-width:520px;height:auto;">

          <!-- Platform orbit ring -->
          <ellipse class="draw-stroke" style="animation-delay:0.1s;" cx="255" cy="150" rx="180" ry="140"
                    stroke="#0A0A0A" stroke-width="1.5" stroke-dasharray="3 6" opacity="0.22"/>

          <!-- Spokes: hub to each node -->
          <path d="M255 150 L110 320" stroke="#0A0A0A" stroke-width="1.5" stroke-dasharray="5 5" opacity="0.4"/>
          <path d="M255 150 L400 330" stroke="#0A0A0A" stroke-width="1.5" stroke-dasharray="5 5" opacity="0.4"/>
          <path d="M255 150 L441 110" stroke="#0A0A0A" stroke-width="1.5" stroke-dasharray="5 5" opacity="0.4"/>
          <path d="M255 150 L73 107" stroke="#0A0A0A" stroke-width="1.5" stroke-dasharray="5 5" opacity="0.4"/>
          <path d="M255 150 L255 380" stroke="#0A0A0A" stroke-width="1.5" stroke-dasharray="5 5" opacity="0.4"/>

          <!-- Central hub: Salesforce cloud -->
          <path class="draw-stroke" style="animation-delay:0.3s;" d="M195 205 C145 205 108 172 108 138 C108 106 132 81 163 77 C166 43 194 16 228 16 C258 16 284 35 293 62 C302 58 312 56 323 56 C358 56 387 85 387 120 C387 155 358 184 323 184 L195 205Z"
                stroke="#0A0A0A" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" fill="none" opacity="0.95"/>
          <path d="M175 155 L330 155" stroke="#0A0A0A" stroke-width="1.5" opacity="0.2"/>
          <path d="M155 135 L350 135" stroke="#0A0A0A" stroke-width="1.5" opacity="0.15"/>
          <circle cx="255" cy="120" r="5" fill="#0A0A0A" opacity="0.8"/>
          <circle cx="255" cy="120" r="12" stroke="#0A0A0A" stroke-width="1.2" fill="none" opacity="0.3"/>

          <!-- Node: Data -->
          <g class="draw-stroke" style="animation-delay:0.55s;" stroke="#0A0A0A" stroke-width="2" fill="none" opacity="0.75">
            <ellipse cx="90" cy="300" rx="38" ry="12"/>
            <path d="M52 300 L52 340 C52 347 69 353 90 353 C111 353 128 347 128 340 L128 300"/>
            <path d="M52 320 C52 327 69 333 90 333 C111 333 128 327 128 320" opacity="0.5"/>
          </g>
          <text x="90" y="372" text-anchor="middle" font-family="Outfit,sans-serif" font-size="11" font-weight="700" letter-spacing="0.06em" fill="#0A0A0A" opacity="0.55">DATA</text>

          <!-- Node: Automation -->
