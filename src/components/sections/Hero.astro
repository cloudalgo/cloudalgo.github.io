---
// Fold 1. Structure follows docs/superpowers/specs/assets/home-mock.html
// (.hp__hero). The entrance animation lives on the section wrapper, not
// on anything inside an island -- see the note in StatsBar.astro.
//
// The product counts are read rather than written: the mock states
// "2 GA, 2 preview" and that is true today, but it is a fact about the
// collection, and a fact about the collection should not be maintained
// by hand in a hero.
import { getCollection } from 'astro:content';

const products = await getCollection('products');
const ga = products.filter((p) => p.data.status === 'ga').length;
const preview = products.length - ga;
---
<section class="hero-press anim-fade-up">
  <div>
    <h1 class="hero-press__title">
      Most orgs do not need more Salesforce.
      They need <span class="hero-press__mark">less of the wrong Salesforce</span>.
    </h1>
    <div class="btn-row">
      <a class="btn btn-primary" href="/contact/">Book a consultation &rarr;</a>
      <a class="btn btn-outline" href="/products/">See the four products</a>
    </div>
  </div>
  <div class="hero-press__standfirst">
    <p>
      We are a four-person Salesforce and Heroku shop. We ship managed packages,
      move data between systems that were never meant to talk, and delete more
      configuration than we add.
    </p>
    <dl class="hero-press__facts">
      <div><dt>Founded</dt><dd>2019</dd></div>
      <div><dt>Practices</dt><dd>Consulting, Product, Support, Data</dd></div>
      <div><dt>Products</dt><dd>{ga} GA, {preview} preview</dd></div>
      <div><dt>Enquiries</dt><dd>sales@cloudalgo.com</dd></div>
    </dl>
  </div>
</section>
