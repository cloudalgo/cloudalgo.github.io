---
---
<section class="hero-section" style="background:#F5F5F2;padding-top:8rem;padding-bottom:5rem;overflow:hidden;position:relative;">

  <!-- Geometric decorative shapes -->
  <div style="position:absolute;top:15%;right:8%;width:12px;height:12px;border-radius:50%;background:#0A0A0A;opacity:0.12;" aria-hidden="true"></div>
  <div style="position:absolute;top:30%;right:15%;width:7px;height:7px;border-radius:50%;background:#0A0A0A;opacity:0.08;" aria-hidden="true"></div>
  <div style="position:absolute;bottom:25%;left:5%;width:9px;height:9px;border-radius:50%;border:1.5px solid #0A0A0A;opacity:0.12;" aria-hidden="true"></div>

  <div style="max-width:1278px;margin:0 auto;padding:0 1.5rem;">
    <div class="row align-items-center" style="gap:2rem 0;">

      <!-- Left column: text -->
      <div class="col-lg-6 anim-fade-up">
        <p class="section-label" style="transition-delay:0.05s;">Salesforce &amp; Heroku Consulting</p>

        <h1 style="font-size:clamp(2.5rem,5.5vw,5rem);font-weight:900;letter-spacing:-0.03em;line-height:1.05;color:#0A0A0A;margin-bottom:1.5rem;transition-delay:0.1s;">
          We make Salesforce<br/>
          actually work for<br/>
          your business.
        </h1>

        <p class="paragraph-large" style="max-width:520px;margin-bottom:2.25rem;color:#5A5A5A;transition-delay:0.2s;">
          CloudAlgo is a certified team of Salesforce architects and developers.
          70+ projects delivered, 12 years of combined experience.
        </p>

        <div style="display:flex;align-items:center;gap:1rem;flex-wrap:wrap;transition-delay:0.3s;" class="anim-fade-up">
          <a href="/contact" class="btn btn-primary">Book a Consultation &rarr;</a>
          <a href="/services" class="btn btn-outline">See our work</a>
        </div>
      </div>

      <!-- Right column: illustration -->
      <div class="col-lg-6" style="display:flex;justify-content:center;align-items:center;padding-top:2rem;" aria-hidden="true">
        <svg viewBox="0 0 520 440" fill="none" xmlns="http://www.w3.org/2000/svg"
             style="width:100%;max-width:520px;height:auto;">
          <!-- Cloud shape -->
          <path d="M160 240 C100 240 60 200 60 160 C60 124 88 96 124 92 C126 52 158 20 198 20 C232 20 261 42 272 73 C282 68 294 65 307 65 C348 65 382 99 382 140 C382 181 348 215 307 215 L160 240Z"
                stroke="#0A0A0A" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" fill="none" opacity="0.9"/>

          <!-- Cloud inner lines -->
          <path d="M140 185 L320 185" stroke="#0A0A0A" stroke-width="1.5" opacity="0.2"/>
          <path d="M120 165 L340 165" stroke="#0A0A0A" stroke-width="1.5" opacity="0.15"/>

          <!-- Data flow lines going down -->
          <path d="M200 240 L200 310" stroke="#0A0A0A" stroke-width="2" stroke-dasharray="6 5"/>
          <path d="M250 240 L250 330" stroke="#0A0A0A" stroke-width="2" stroke-dasharray="6 5"/>
          <path d="M300 240 L300 310" stroke="#0A0A0A" stroke-width="2" stroke-dasharray="6 5"/>

          <!-- Server / database box -->
          <rect x="140" y="310" width="220" height="90" rx="8"
                stroke="#0A0A0A" stroke-width="2.5" fill="none"/>
          <path d="M140 338 L360 338" stroke="#0A0A0A" stroke-width="1.5"/>
          <path d="M140 360 L360 360" stroke="#0A0A0A" stroke-width="1.5"/>
          <!-- Server dots -->
          <circle cx="164" cy="324" r="4" fill="#0A0A0A" opacity="0.8"/>
          <circle cx="180" cy="324" r="4" fill="#0A0A0A" opacity="0.4"/>
          <circle cx="196" cy="324" r="4" fill="#0A0A0A" opacity="0.2"/>
          <!-- Server bar lines -->
          <path d="M215 374 L320 374" stroke="#0A0A0A" stroke-width="2" stroke-linecap="round" opacity="0.3"/>
          <path d="M215 386 L290 386" stroke="#0A0A0A" stroke-width="2" stroke-linecap="round" opacity="0.2"/>

          <!-- Small chart / analytics panel -->
          <rect x="30" y="300" width="90" height="75" rx="6"
                stroke="#0A0A0A" stroke-width="2" fill="none" opacity="0.7"/>
          <polyline points="42,355 55,335 68,345 81,320 94,330 107,310"
                    stroke="#0A0A0A" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" fill="none" opacity="0.8"/>
          <path d="M42 365 L107 365" stroke="#0A0A0A" stroke-width="1.5" opacity="0.3"/>

          <!-- Connection line from server to chart -->
          <path d="M140 350 L120 350" stroke="#0A0A0A" stroke-width="1.5" stroke-dasharray="4 4" opacity="0.5"/>

          <!-- Right panel: CRM records -->
          <rect x="390" y="290" width="105" height="110" rx="6"
                stroke="#0A0A0A" stroke-width="2" fill="none" opacity="0.7"/>
          <path d="M404 316 L480 316" stroke="#0A0A0A" stroke-width="1.5" stroke-linecap="round" opacity="0.4"/>
          <path d="M404 332 L466 332" stroke="#0A0A0A" stroke-width="1.5" stroke-linecap="round" opacity="0.3"/>
          <path d="M404 348 L474 348" stroke="#0A0A0A" stroke-width="1.5" stroke-linecap="round" opacity="0.4"/>
          <path d="M404 364 L460 364" stroke="#0A0A0A" stroke-width="1.5" stroke-linecap="round" opacity="0.3"/>
          <path d="M404 380 L472 380" stroke="#0A0A0A" stroke-width="1.5" stroke-linecap="round" opacity="0.4"/>
          <circle cx="408" cy="305" r="5" stroke="#0A0A0A" stroke-width="1.5" fill="none" opacity="0.7"/>
          <path d="M406 303 L410 307 M406 307 L410 303" stroke="#0A0A0A" stroke-width="1.5" opacity="0.7"/>

          <!-- Connection from server to right panel -->
          <path d="M360 350 L390 340" stroke="#0A0A0A" stroke-width="1.5" stroke-dasharray="4 4" opacity="0.5"/>

          <!-- Floating checkmark badge -->
          <circle cx="390" cy="180" r="26" stroke="#0A0A0A" stroke-width="2" fill="none" opacity="0.6"/>
          <polyline points="378,180 386,188 402,172"
                    stroke="#0A0A0A" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" fill="none" opacity="0.8"/>

          <!-- Floating number badge -->
          <rect x="78" y="130" width="48" height="32" rx="16"
                stroke="#0A0A0A" stroke-width="2" fill="none" opacity="0.5"/>
          <text x="102" y="151" text-anchor="middle" font-family="Outfit,sans-serif" font-size="13" font-weight="800" fill="#0A0A0A" opacity="0.7">70+</text>

          <!-- Small gear icon -->
          <circle cx="440" cy="230" r="14" stroke="#0A0A0A" stroke-width="2" fill="none" opacity="0.5"/>
          <circle cx="440" cy="230" r="5" stroke="#0A0A0A" stroke-width="1.5" fill="none" opacity="0.5"/>
          <line x1="440" y1="212" x2="440" y2="217" stroke="#0A0A0A" stroke-width="2" stroke-linecap="round" opacity="0.5"/>
          <line x1="440" y1="243" x2="440" y2="248" stroke="#0A0A0A" stroke-width="2" stroke-linecap="round" opacity="0.5"/>
          <line x1="422" y1="230" x2="427" y2="230" stroke="#0A0A0A" stroke-width="2" stroke-linecap="round" opacity="0.5"/>
          <line x1="453" y1="230" x2="458" y2="230" stroke="#0A0A0A" stroke-width="2" stroke-linecap="round" opacity="0.5"/>
        </svg>
      </div>

    </div>
  </div>
</section>
