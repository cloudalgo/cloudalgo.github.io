---
import { getCollection } from 'astro:content';

// Fold 7. One lead post with its excerpt, two more in a ruled rail
// beside it -- the mock's shape, replacing three equal cards.
//
// Three tiles said "we have a blog". A lead with a rail says which post
// to read first, which is the only thing this fold has room to say.
//
// Read time is in the schema and deliberately not rendered here: the
// mock's row is category, title, date, and a fourth figure on a
// three-item fold is noise.
const posts = (await getCollection('blog', ({ data }) => data.published))
  .sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf())
  .slice(0, 3);

const [lead, ...rest] = posts;

const fmt = (d: Date) =>
  d.toLocaleDateString('en-GB', { day: '2-digit', month: 'short', year: 'numeric' });
---
<section class="section-press" aria-labelledby="journal-heading">
  <div class="section-press__head">
    <h2 id="journal-heading" class="section-title section-title--xs section-title--tighter section-press__title">
      From the journal.
    </h2>
    <a class="section-press__all" href="/blog/">All posts &rarr;</a>
  </div>

  <div class="journal-press">
    {lead && (
      <article class="journal-press__lead">
        <span class="journal-press__cat">{lead.data.category}</span>
        <h3 class="journal-press__title">
          <a href={`/blog/${lead.id}/`}>{lead.data.title}</a>
        </h3>
        <p class="journal-press__excerpt">{lead.data.excerpt}</p>
        <time class="journal-press__date" datetime={lead.data.date.toISOString()}>
          {fmt(lead.data.date)}
        </time>
      </article>
    )}

    {rest.length > 0 && (
      <div class="journal-press__side">
        {rest.map((p) => (
          <article>
            <span class="journal-press__cat">{p.data.category}</span>
            <h3 class="journal-press__title">
              <a href={`/blog/${p.id}/`}>{p.data.title}</a>
            </h3>
            <time class="journal-press__date" datetime={p.data.date.toISOString()}>
              {fmt(p.data.date)}
            </time>
          </article>
        ))}
      </div>
    )}
  </div>
</section>
