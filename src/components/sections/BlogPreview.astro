---
import { getCollection } from 'astro:content';
import BlogCard from '../ui/BlogCard.astro';

const allPosts = await getCollection('blog', ({ data }) => data.published);
const posts = allPosts
  .sort((a, b) => b.data.date.getTime() - a.data.date.getTime())
  .slice(0, 3);
---
<section style="background:#fff;padding:6rem 0;border-top:1px solid #E0E0DC;position:relative;overflow:hidden;">
  <!-- Parallax decorative shapes -->
  <div data-parallax="0.08" style="position:absolute;top:20px;right:-70px;width:250px;height:250px;border-radius:50%;border:1.5px solid #0A0A0A;opacity:0.04;pointer-events:none;" aria-hidden="true"></div>
  <div data-parallax="0.16" style="position:absolute;bottom:50px;left:4%;width:8px;height:8px;border-radius:50%;background:#0A0A0A;opacity:0.08;pointer-events:none;" aria-hidden="true"></div>
  <div data-parallax="0.22" style="position:absolute;top:18%;left:28%;width:5px;height:5px;border-radius:50%;background:#0A0A0A;opacity:0.06;pointer-events:none;" aria-hidden="true"></div>
  <div style="max-width:1278px;margin:0 auto;padding:0 1.5rem;">
    <div style="display:flex;align-items:flex-end;justify-content:space-between;margin-bottom:3rem;gap:1rem;flex-wrap:wrap;">
      <div>
        <p class="section-label anim-fade-up">Writing</p>
        <h2 class="anim-fade-up" style="font-size:clamp(2rem,3.5vw,3rem);font-weight:800;letter-spacing:-0.02em;margin:0;transition-delay:0.05s;">
          From the team
        </h2>
      </div>
      <a href="/blog" class="btn btn-outline" style="font-size:0.9375rem;padding:0.625rem 1.5rem;">
        View all posts &rarr;
      </a>
    </div>
    <div class="row">
      {posts.map((post) => (
        <div class="col-lg-4 col-md-4" style="margin-bottom:1.5rem;display:flex;">
          <BlogCard
            title={post.data.title}
            excerpt={post.data.excerpt}
            category={post.data.category}
            date={post.data.date}
            readTime={post.data.readTime}
            slug={post.id}
          />
        </div>
      ))}
    </div>
  </div>
</section>
