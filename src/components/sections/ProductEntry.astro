---
/**
 * One catalogue entry, printed as a specimen plate: a ruled header bar
 * carrying the number, the name, the ship status and the price; the
 * copy on one side; the figure on the other; and the specification as
 * a strip closing the plate along its bottom edge.
 *
 * The copy is a prop rather than a slot because all four entries say
 * the same things in the same order -- tagline, description,
 * capability chips, ways in -- and four slots per entry would let that
 * order drift. The figure is a slot because it is genuinely different
 * every time: a readout beside a screenshot, a drawn diagram, a
 * console next to a film, four phone screens.
 *
 * Two arrangements, and which one an entry takes is a fact about its
 * figure rather than a style choice. `beside` puts the figure in a
 * column next to the copy, which is right for a picture with a shape
 * of its own. `below` gives the copy the full width and hangs the
 * figure under it, which is what a diagram wants -- a flow squeezed
 * into half a plate wraps, and a wrapped flow is not a flow.
 *
 * The price moved out of the specification and into the header bar in
 * the same pass that made the spec a strip. It was the sixth row of a
 * six-row panel, which is the last place a reader looks, and it is one
 * of the two things they came to find out.
 */
import StatusPip from '@/components/ui/StatusPip.astro';
import SpecSheet from '@/components/ui/SpecSheet.astro';
import Button from '@/components/ui/Button.astro';

/** Mirrors SpecSheet's own SpecRow -- an .astro file's types are not
    importable, so the shape is restated rather than reached for. */
export interface SpecRow {
  term: string;
  detail: string;
}

export interface EntryAction {
  label: string;
  href: string;
  /** The one way in that the entry is actually recommending. */
  primary?: boolean;
}

interface Props {
  /** Anchor target, so the contents strip can reach this entry. */
  id: string;
  /** The product's own page. The name on the bar links to it -- the
      bar is the first thing a reader lands on from the contents strip
      and the last place they should have to hunt for a way in. */
  href: string;
  /** The entry's number, printed as given ("01"). */
  n: string;
  title: string;
  /** Raw collection value: 'ga' | 'preview' | 'beta'. */
  status: string;
  /** What it costs, in the header bar. Short enough to sit on the bar
      with the name and the state -- "Free", "Free — MIT". */
  price: string;
  /** The mono line under the price -- version, edition, platform.
      Whatever identifies this build. */
  meta: string;
  /** The one-sentence claim, set larger than the description. */
  tagline: string;
  description: string;
  /** Capability labels. Skimmed, not read -- keep each to a few words. */
  chips: string[];
  actions: EntryAction[];
  /** Five rows, printed as the strip along the plate's bottom edge.
      Five because the strip is a five-column grid; a sixth wraps to a
      row of one. */
  spec: SpecRow[];
  /** Where the figure sits. See the note above -- this follows from
      the figure's shape, not from taste. */
  figure?: 'beside' | 'below';
  class?: string;
}

const {
  id, href, n, title, status, price, meta,
  tagline, description, chips, actions, spec,
  figure = 'beside',
  class: className,
} = Astro.props;

/** An action pointing off-site opens in a new tab. Derived from the
    href rather than declared per action, so a URL that changes from
    a route to a domain cannot leave a stale flag behind. */
const isExternal = (href: string) => /^https?:\/\//.test(href);
---
<article class:list={['entry', figure === 'below' && 'entry--wide', className]} id={id}>
  <header class="entry__head">
    <span class="entry__n">{n}</span>
    <h3 class="entry__name">
      <a class="entry__link" href={href}>{title}<em aria-hidden="true">&#8599;</em></a>
    </h3>
    <StatusPip status={status} onInk class="entry__pip" />
    <span class="entry__badge">
      <b class="entry__price">{price}</b>
      <span class="entry__meta">{meta}</span>
    </span>
  </header>

  <div class="entry__body">
    <div class="entry__main">
      <p class="entry__tag">{tagline}</p>
      <p class="entry__desc">{description}</p>

      {/* Whatever this particular product can put on the page as
          evidence in its own right -- OrgVitals prints the weights
          behind its grade here. Between the description and the chips
          because it argues for the description; the chips are the
          index of features, and an index closes a section. */}
      <slot name="aside" />

      <ul class="entry__chips">
        {chips.map((chip) => <li class="entry__chip">{chip}</li>)}
      </ul>

      <div class="btn-row entry__actions">
        {actions.map((action) => (
          <Button
            href={action.href}
            variant={action.primary ? 'primary' : 'outline'}
            size="sm"
            external={isExternal(action.href)}
          >
            {action.label}
          </Button>
        ))}
      </div>
    </div>

    {/* The slotted figure IS the grid cell -- an EvidenceStrip lands
        here directly rather than inside a wrapper of ours, so the
        plate's seam is the figure's own border and not a second one
        drawn beside it. */}
    <slot name="figure" />
  </div>

  <SpecSheet rows={spec} layout="strip" />
</article>
