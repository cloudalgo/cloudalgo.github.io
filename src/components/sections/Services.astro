---
// Fold 4. Structure follows docs/superpowers/specs/assets/home-mock.html
// (the `04 services` block): four rows, same shape as the product rows
// above them, so a buyer and a developer read the page the same way.
//
// The right-hand cell is the join. `proves` is a reference into the
// products collection, so every service on this page points at
// something shipped -- which is the whole reason the field is required.
// This is also where "Why us" went: a section of claims with nothing
// attached to them became one claim per row, each next to the thing
// that earned it.
//
// Names and order come from the collection. The type label and the row
// blurb do not -- both are written for this fold and are shorter than
// any collection field -- so they live in HOME below, keyed by id, with
// the excerpt as the fallback. A fifth service renders the day it is
// added.
import { getCollection, getEntry } from 'astro:content';

const services = (await getCollection('services')).sort(
  (a, b) => a.data.order - b.data.order
);

const proofs = new Map(
  await Promise.all(
    services.map(async (s) => {
      const product = await getEntry(s.data.proves);
      return [s.id, product] as const;
    })
  )
);

type HomeCopy = { type: string; blurb: string };

const HOME: Record<string, HomeCopy> = {
  'salesforce-consulting': {
    type: 'Consulting',
    blurb:
      'The build, done so your admins can still change it. CRM configuration, ' +
      'Experience Cloud, custom Platform development, MuleSoft and Heroku.',
  },
  'product-development': {
    type: 'Product',
    blurb:
      'Get through security review the first time. 1GP and 2GP managed packages, ' +
      'and the ISV decisions that are expensive to reverse later.',
  },
  'support-and-managed-services': {
    type: 'Support',
    blurb:
      'Keep the org healthy between projects. Enhancements, health reviews and ' +
      'security fixes on a retainer, not an emergency call.',
  },
  'airflow-data-pipelines': {
    type: 'Data',
    blurb:
      'Move data between Salesforce and everything else, on a schedule that ' +
      'recovers itself. Airflow across ERP systems, databases and APIs.',
  },
};
---
<section class="section-press anim-fade-up" aria-labelledby="services-heading">
  <div class="section-press__head">
    <h2 id="services-heading" class="section-title section-title--xs section-title--tighter section-press__title">
      And the team that builds them.
    </h2>
    <a class="section-press__all" href="/services/">All services &rarr;</a>
  </div>

  <div class="services-press">
    {services.map((s) => {
      const proof = proofs.get(s.id);
      return (
        <div class="services-press__row">
          <span class="section-press__type">{HOME[s.id]?.type}</span>
          <h3 class="services-press__name"><a href={`/services/${s.id}/`}>{s.data.title}</a></h3>
          <p class="services-press__desc">{HOME[s.id]?.blurb ?? s.data.excerpt}</p>
          <span class="services-press__proves">
            Proven by
            {proof && (
              <em><a href={`/products/${proof.id}/`}>{proof.data.title}</a></em>
            )}
          </span>
        </div>
      );
    })}
  </div>
</section>
