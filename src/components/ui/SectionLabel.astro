---
/**
 * The small uppercase eyebrow that sits above a section heading.
 *
 * Always a <p> -- all 33 call sites were. Appearance lives in
 * styles/components/_section-label.scss.
 *
 * Most call sites also carry `anim-fade-up`, which Base.astro's
 * IntersectionObserver keys on; that stays a caller concern and composes
 * through `class` rather than becoming a prop, because whether an eyebrow
 * animates depends on the section around it, not on the eyebrow.
 */
import type { HTMLAttributes } from 'astro/types';

type Props = HTMLAttributes<'p'>;

const { class: className, ...rest } = Astro.props as Props;
---

<p class:list={['section-label', className]} {...rest}><slot /></p>
