---
/**
 * The small uppercase eyebrow that sits above a section heading.
 *
 * Always a <p> -- all 33 call sites were. Appearance lives in
 * styles/components/_section-label.scss.
 */
import type { HTMLAttributes } from 'astro/types';

type Props = HTMLAttributes<'p'>;

const { class: className, ...rest } = Astro.props as Props;
---

<p class:list={['section-label', className]} {...rest}><slot /></p>
