---
// src/components/ui/ServiceCard.astro
export interface Props {
  title: string;
  body: string;
  href: string;
  icon: string;
  delay?: number;
}
const { title, body, href, icon, delay = 0 } = Astro.props;
---
<article
  class="bg-[#1a1a1a] p-7 rounded-xl border-t-2 border-primary hover:-translate-y-1.5 hover:shadow-[0_16px_40px_rgba(247,90,65,0.18)] hover:bg-[#222] transition-all duration-200 anim-scale-pop"
  style={`transition-delay: ${delay}ms;`}
>
  <div class="text-3xl mb-4">{icon}</div>
  <h3 class="font-display font-extrabold text-white text-[17px] mb-2.5">{title}</h3>
  <p class="text-[13px] text-[#64748b] leading-relaxed mb-5">{body}</p>
  <a
    href={href}
    class="relative inline-flex text-[12px] font-extrabold text-primary after:absolute after:bottom-[-2px] after:left-0 after:h-px after:bg-primary after:w-0 hover:after:w-full after:transition-[width] after:duration-[250ms]"
  >
    Learn More →
  </a>
</article>
