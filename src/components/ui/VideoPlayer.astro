---
/**
 * VideoPlayer — the site's own player, so a film sits inside the design system
 * instead of inheriting whatever chrome the browser ships.
 *
 * Monochrome by construction: black scrim, white controls, one hairline
 * scrubber. Nothing here introduces a colour outside the palette.
 *
 * Progressive enhancement: the markup ships with the native `controls`
 * attribute and the custom bar hidden. The script removes `controls`, reveals
 * the bar, and wires it up — so a JS failure leaves a working player rather
 * than a poster with no way to start it.
 */
interface Props {
  src: string;
  poster?: string;
  captions?: string;
  /** Accessible name for the player. */
  title: string;
  /** Shown under the play seal before first play, e.g. "2 min 54 sec". */
  duration?: string;
  /** `dark` for use on a near-black section, `light` on white/grey. */
  tone?: 'light' | 'dark';
  /** CSS aspect-ratio for the frame. */
  ratio?: string;
  class?: string;
}

const {
  src,
  poster,
  captions,
  title,
  duration,
  tone = 'light',
  ratio = '16 / 9',
  class: className = '',
} = Astro.props;

// A cross-origin <track> only loads when the media element opts into CORS.
const isCrossOrigin = /^https?:\/\//.test(src) || (captions ? /^https?:\/\//.test(captions) : false);
---

<figure
  class:list={['cav', `cav--${tone}`, className]}
  style={`--cav-ratio:${ratio};`}
  data-cav
  data-started="false"
>
  <div class="cav-frame">
    <video
      class="cav-video"
      src={src}
      poster={poster}
      preload="metadata"
      playsinline
      controls
      crossorigin={isCrossOrigin ? 'anonymous' : undefined}
      aria-label={title}
      data-cav-video
    >
      {captions && (
        <track kind="captions" src={captions} srclang="en" label="English" />
      )}
      Your browser cannot play embedded video.
      <a href={src}>Download the film</a> instead.
    </video>

    <!-- Pre-roll: poster + one obvious thing to click. -->
    <button class="cav-seal" type="button" data-cav-seal>
      <span class="cav-seal-disc" aria-hidden="true">
        <svg viewBox="0 0 24 24" width="26" height="26" fill="none">
          <path d="M9 6.5 L18 12 L9 17.5 Z" fill="currentColor" />
        </svg>
      </span>
      <span class="cav-seal-text">
        <span class="cav-seal-title">Play the film</span>
        {duration && <span class="cav-seal-meta">{duration}</span>}
      </span>
    </button>

    <!-- Custom controls: hidden until the script takes over. -->
    <div class="cav-bar" data-cav-bar hidden>
      <button class="cav-btn cav-btn--play" type="button" data-cav-toggle aria-label="Play">
        <svg class="cav-i-play" viewBox="0 0 24 24" width="18" height="18" fill="none" aria-hidden="true">
          <path d="M8.5 5.5 L18 12 L8.5 18.5 Z" fill="currentColor" />
        </svg>
        <svg class="cav-i-pause" viewBox="0 0 24 24" width="18" height="18" fill="none" aria-hidden="true">
          <rect x="7" y="5.5" width="3.4" height="13" rx="1" fill="currentColor" />
          <rect x="13.6" y="5.5" width="3.4" height="13" rx="1" fill="currentColor" />
        </svg>
      </button>

      <span class="cav-time" data-cav-elapsed>0:00</span>

      <div
        class="cav-scrub"
        role="slider"
        tabindex="0"
        aria-label="Seek"
        aria-valuemin="0"
        aria-valuemax="100"
        aria-valuenow="0"
        aria-valuetext="0:00"
        data-cav-scrub
      >
        <span class="cav-track" aria-hidden="true">
          <span class="cav-buffered" data-cav-buffered></span>
          <span class="cav-played" data-cav-played></span>
          <span class="cav-knob" data-cav-knob></span>
        </span>
      </div>

      <span class="cav-time cav-time--total" data-cav-total>--:--</span>

      {captions && (
        <button class="cav-btn cav-btn--cc" type="button" data-cav-cc aria-pressed="false" aria-label="Captions">
          <span aria-hidden="true">CC</span>
        </button>
      )}

      <button class="cav-btn" type="button" data-cav-mute aria-label="Mute">
        <svg class="cav-i-sound" viewBox="0 0 24 24" width="18" height="18" fill="none" aria-hidden="true">
          <path d="M4.5 9.5 H7.8 L12 5.8 V18.2 L7.8 14.5 H4.5 Z" fill="currentColor" />
          <path d="M15.2 9.4 A3.6 3.6 0 0 1 15.2 14.6" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" />
          <path d="M17.7 7 A7 7 0 0 1 17.7 17" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" />
        </svg>
        <svg class="cav-i-muted" viewBox="0 0 24 24" width="18" height="18" fill="none" aria-hidden="true">
          <path d="M4.5 9.5 H7.8 L12 5.8 V18.2 L7.8 14.5 H4.5 Z" fill="currentColor" />
          <path d="M15.5 9.8 L20 14.2 M20 9.8 L15.5 14.2" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" />
        </svg>
      </button>

      <button class="cav-btn" type="button" data-cav-full aria-label="Full screen">
        <svg viewBox="0 0 24 24" width="18" height="18" fill="none" aria-hidden="true">
          <path d="M9 4.5 H4.5 V9 M15 4.5 H19.5 V9 M19.5 15 V19.5 H15 M9 19.5 H4.5 V15"
            stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" />
        </svg>
      </button>
    </div>
  </div>

  <figcaption class="cav-caption">{title}</figcaption>
</figure>

<style>
  /* ── Frame ───────────────────────────────────────────────────────────── */
  .cav {
    margin: 0;
    max-width: 100%;
  }

  .cav-frame {
    position: relative;
    aspect-ratio: var(--cav-ratio, 16 / 9);
    border-radius: 12px;
    overflow: hidden;
    background: var(--ca-black, var(--surface-inverse));
    border: 1px solid var(--ca-border, var(--border-default));
  }
  .cav--dark .cav-frame {
    border-color: var(--color-paper-a16);
    box-shadow: 0 24px 60px var(--color-shadow-a45);
  }
  .cav--light .cav-frame {
    box-shadow: 0 10px 34px var(--color-ink-a09);
  }

  .cav-video {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: contain;
    background: var(--ca-black, var(--surface-inverse));
  }

  .cav-caption {
    margin-top: 0.85rem;
    font-size: 0.8125rem;
    font-weight: 600;
    letter-spacing: 0.02em;
    color: var(--ca-secondary-black, var(--color-text));
  }
  .cav--dark .cav-caption { color: var(--color-on-inverse-muted); }

  /* ── Pre-roll seal ───────────────────────────────────────────────────── */
  .cav-seal {
    position: absolute;
    inset: 0;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: 0.9rem;
    width: 100%;
    border: 0;
    padding: 0;
    cursor: pointer;
    background: radial-gradient(ellipse at center, var(--color-ink-a18) 0%, var(--color-ink-a55) 100%);
    font-family: inherit;
    /* Hidden the moment playback starts; JS toggles this attribute. */
  }
  .cav-seal[hidden] { display: none; }

  .cav-seal-disc {
    display: grid;
    place-items: center;
    width: 74px;
    height: 74px;
    border-radius: 100px;
    background: var(--surface-card);
    color: var(--ca-black, var(--color-heading));
    padding-left: 4px; /* optically centre the triangle */
    transition: transform 0.25s ease, background 0.25s ease, color 0.25s ease;
  }
  .cav-seal:hover .cav-seal-disc,
  .cav-seal:focus-visible .cav-seal-disc {
    transform: scale(1.07);
    background: var(--ca-black, var(--surface-inverse));
    color: var(--color-on-inverse);
    box-shadow: 0 0 0 2px var(--focus-halo);
  }

  .cav-seal-text {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 0.2rem;
  }
  .cav-seal-title {
    font-size: 0.75rem;
    font-weight: 700;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--color-on-inverse);
  }
  .cav-seal-meta {
    font-size: 0.75rem;
    font-weight: 500;
    color: var(--color-on-inverse-a60);
    font-variant-numeric: tabular-nums;
  }

  .cav-seal:focus-visible { outline: 2px solid var(--focus-halo); outline-offset: -6px; }

  /* ── Control bar ─────────────────────────────────────────────────────── */
  .cav-bar {
    position: absolute;
    left: 0;
    right: 0;
    bottom: 0;
    display: flex;
    align-items: center;
    gap: 0.6rem;
    padding: 2.4rem 0.9rem 0.75rem;
    background: linear-gradient(to top, var(--color-ink-a92) 0%, var(--color-ink-a65) 45%, var(--color-ink-a00) 100%);
    opacity: 1;
    transform: translateY(0);
    transition: opacity 0.25s ease, transform 0.25s ease;
  }
  .cav-bar[hidden] { display: none; }
  /* Before first play the seal carries the whole invitation, duration included. */
  .cav[data-started='false'] .cav-bar { opacity: 0; pointer-events: none; }
  /* Idle during playback: the bar steps out of the way of the film. */
  .cav[data-idle='true'] .cav-bar {
    opacity: 0;
    transform: translateY(0.5rem);
    pointer-events: none;
  }

  .cav-btn {
    flex: 0 0 auto;
    display: grid;
    place-items: center;
    width: 34px;
    height: 34px;
    border-radius: 100px;
    border: 1px solid var(--color-paper-a22);
    background: var(--color-paper-a06);
    color: var(--color-on-inverse);
    cursor: pointer;
    padding: 0;
    transition: background 0.18s ease, border-color 0.18s ease, color 0.18s ease;
  }
  .cav-btn:hover { background: var(--surface-card); border-color: var(--focus-halo); color: var(--ca-black, var(--color-heading)); }
  .cav-btn:focus-visible { outline: 2px solid var(--focus-halo); outline-offset: 2px; }

  .cav-btn--play { width: 38px; height: 38px; background: var(--surface-card); border-color: var(--focus-halo); color: var(--ca-black, var(--color-heading)); }
  .cav-btn--play:hover { background: var(--color-paper-a86); }
  .cav-btn--play .cav-i-play { margin-left: 2px; }

  .cav-btn--cc {
    width: auto;
    padding: 0 0.6rem;
    font-family: inherit;
    font-size: 0.6875rem;
    font-weight: 700;
    letter-spacing: 0.06em;
  }
  .cav-btn--cc[aria-pressed='true'] {
    background: var(--surface-card);
    border-color: var(--focus-halo);
    color: var(--ca-black, var(--color-heading));
  }

  /* Icon swapping is driven by a single state class on the player. */
  .cav-i-pause,
  .cav-i-muted { display: none; }
  .cav[data-playing='true'] .cav-i-play { display: none; }
  .cav[data-playing='true'] .cav-i-pause { display: block; }
  .cav[data-muted='true'] .cav-i-sound { display: none; }
  .cav[data-muted='true'] .cav-i-muted { display: block; }

  .cav-time {
    flex: 0 0 auto;
    font-size: 0.75rem;
    font-weight: 600;
    color: var(--color-on-inverse-a85);
    font-variant-numeric: tabular-nums;
    letter-spacing: 0.02em;
    min-width: 2.6em;
    text-align: center;
  }
  .cav-time--total { color: var(--color-on-inverse-a50); }

  /* ── Scrubber ────────────────────────────────────────────────────────── */
  .cav-scrub {
    flex: 1 1 auto;
    min-width: 0;
    height: 24px;
    display: flex;
    align-items: center;
    cursor: pointer;
    touch-action: none;
  }
  .cav-scrub:focus-visible { outline: 2px solid var(--focus-halo); outline-offset: 3px; border-radius: 100px; }

  .cav-track {
    position: relative;
    display: block;
    width: 100%;
    height: 3px;
    border-radius: 100px;
    background: var(--color-paper-a24);
  }
  .cav-buffered,
  .cav-played {
    position: absolute;
    left: 0;
    top: 0;
    bottom: 0;
    border-radius: 100px;
    width: 0%;
  }
  .cav-buffered { background: var(--color-paper-a34); }
  .cav-played { background: var(--surface-card); }

  .cav-knob {
    position: absolute;
    top: 50%;
    left: 0;
    width: 11px;
    height: 11px;
    border-radius: 100px;
    background: var(--surface-card);
    transform: translate(-50%, -50%) scale(0.7);
    transition: transform 0.16s ease;
  }
  .cav-scrub:hover .cav-knob,
  .cav-scrub:focus-visible .cav-knob,
  .cav[data-scrubbing='true'] .cav-knob { transform: translate(-50%, -50%) scale(1); }

  /* Native text tracks sit above the bar rather than under it. */
  .cav-video::cue { font-family: inherit; }
  /* Lift cues clear of both the control bar and any text burned into the film. */
  .cav-video::-webkit-media-text-track-container { transform: translateY(-4.2rem); }

  @media (max-width: 600px) {
    .cav-bar { gap: 0.45rem; padding: 2rem 0.6rem 0.6rem; }
    .cav-time--total { display: none; }
    .cav-seal-disc { width: 60px; height: 60px; }
  }

  @media (prefers-reduced-motion: reduce) {
    .cav-seal-disc,
    .cav-bar,
    .cav-knob { transition: none; }
    .cav-seal:hover .cav-seal-disc { transform: none; }
  }
</style>

<script>
  // One initialiser for every player on the page. All DOM is authored in the
  // markup above so Astro's scoped styles apply; nothing is created here.
  type Player = HTMLElement;

  const fmt = (secs: number): string => {
    if (!Number.isFinite(secs) || secs < 0) return '0:00';
    const total = Math.floor(secs);
    const m = Math.floor(total / 60);
    const s = total % 60;
    return `${m}:${String(s).padStart(2, '0')}`;
  };

  function init(root: Player) {
    const video = root.querySelector<HTMLVideoElement>('[data-cav-video]');
    const bar = root.querySelector<HTMLElement>('[data-cav-bar]');
    const seal = root.querySelector<HTMLButtonElement>('[data-cav-seal]');
    if (!video || !bar || !seal) return;

    const toggle = root.querySelector<HTMLButtonElement>('[data-cav-toggle]');
    const muteBtn = root.querySelector<HTMLButtonElement>('[data-cav-mute]');
    const fullBtn = root.querySelector<HTMLButtonElement>('[data-cav-full]');
    const ccBtn = root.querySelector<HTMLButtonElement>('[data-cav-cc]');
    const scrub = root.querySelector<HTMLElement>('[data-cav-scrub]');
    const played = root.querySelector<HTMLElement>('[data-cav-played]');
    const buffered = root.querySelector<HTMLElement>('[data-cav-buffered]');
    const knob = root.querySelector<HTMLElement>('[data-cav-knob]');
    const elapsed = root.querySelector<HTMLElement>('[data-cav-elapsed]');
    const total = root.querySelector<HTMLElement>('[data-cav-total]');

    // Hand over from the native chrome only now that ours is ready.
    video.removeAttribute('controls');
    bar.hidden = false;

    let idleTimer: number | undefined;
    const wake = () => {
      root.dataset.idle = 'false';
      window.clearTimeout(idleTimer);
      if (!video.paused) {
        idleTimer = window.setTimeout(() => { root.dataset.idle = 'true'; }, 2400);
      }
    };

    const play = () => { void video.play(); };
    const flip = () => (video.paused ? play() : video.pause());

    seal.addEventListener('click', play);
    toggle?.addEventListener('click', flip);
    video.addEventListener('click', flip);

    video.addEventListener('play', () => {
      root.dataset.playing = 'true';
      root.dataset.started = 'true';
      seal.hidden = true;
      toggle?.setAttribute('aria-label', 'Pause');
      wake();
    });
    video.addEventListener('pause', () => {
      root.dataset.playing = 'false';
      toggle?.setAttribute('aria-label', 'Play');
      wake();
    });
    video.addEventListener('ended', () => {
      seal.hidden = false;
      root.dataset.idle = 'false';
    });

    // ── Progress ──
    const paint = () => {
      const d = video.duration;
      const pct = Number.isFinite(d) && d > 0 ? (video.currentTime / d) * 100 : 0;
      if (played) played.style.width = `${pct}%`;
      if (knob) knob.style.left = `${pct}%`;
      if (elapsed) elapsed.textContent = fmt(video.currentTime);
      scrub?.setAttribute('aria-valuenow', String(Math.round(pct)));
      scrub?.setAttribute('aria-valuetext', fmt(video.currentTime));
      if (buffered && video.buffered.length > 0 && Number.isFinite(d) && d > 0) {
        buffered.style.width = `${(video.buffered.end(video.buffered.length - 1) / d) * 100}%`;
      }
    };
    video.addEventListener('timeupdate', paint);
    video.addEventListener('progress', paint);
    video.addEventListener('loadedmetadata', () => {
      if (total) total.textContent = fmt(video.duration);
      paint();
    });
    if (video.readyState >= 1 && total) total.textContent = fmt(video.duration);

    // ── Seeking ──
    const seekTo = (clientX: number) => {
      if (!scrub || !Number.isFinite(video.duration)) return;
      const box = scrub.getBoundingClientRect();
      const ratio = Math.min(1, Math.max(0, (clientX - box.left) / box.width));
      video.currentTime = ratio * video.duration;
      paint();
    };
    scrub?.addEventListener('pointerdown', (e: PointerEvent) => {
      root.dataset.scrubbing = 'true';
      scrub.setPointerCapture(e.pointerId);
      seekTo(e.clientX);
    });
    scrub?.addEventListener('pointermove', (e: PointerEvent) => {
      if (root.dataset.scrubbing === 'true') seekTo(e.clientX);
    });
    const endScrub = () => { root.dataset.scrubbing = 'false'; };
    scrub?.addEventListener('pointerup', endScrub);
    scrub?.addEventListener('pointercancel', endScrub);

    const nudge = (delta: number) => {
      if (!Number.isFinite(video.duration)) return;
      video.currentTime = Math.min(video.duration, Math.max(0, video.currentTime + delta));
      paint();
    };
    scrub?.addEventListener('keydown', (e: KeyboardEvent) => {
      const step = e.shiftKey ? 30 : 5;
      if (e.key === 'ArrowRight' || e.key === 'ArrowUp') { nudge(step); e.preventDefault(); }
      else if (e.key === 'ArrowLeft' || e.key === 'ArrowDown') { nudge(-step); e.preventDefault(); }
      else if (e.key === 'Home') { video.currentTime = 0; paint(); e.preventDefault(); }
      else if (e.key === 'End' && Number.isFinite(video.duration)) { video.currentTime = video.duration; e.preventDefault(); }
    });

    // ── Sound, captions, full screen ──
    muteBtn?.addEventListener('click', () => { video.muted = !video.muted; });
    video.addEventListener('volumechange', () => {
      root.dataset.muted = String(video.muted || video.volume === 0);
      muteBtn?.setAttribute('aria-label', video.muted ? 'Unmute' : 'Mute');
    });

    ccBtn?.addEventListener('click', () => {
      const track = video.textTracks[0];
      if (!track) return;
      const on = track.mode !== 'showing';
      track.mode = on ? 'showing' : 'hidden';
      ccBtn.setAttribute('aria-pressed', String(on));
    });
    // Browsers may default a track to `showing`; start from a known state.
    if (video.textTracks[0]) video.textTracks[0].mode = 'hidden';

    fullBtn?.addEventListener('click', () => {
      const frame = root.querySelector('.cav-frame') as HTMLElement | null;
      if (!frame) return;
      if (document.fullscreenElement) void document.exitFullscreen();
      else void frame.requestFullscreen?.();
    });

    // ── Keyboard shortcuts, once the player has focus ──
    root.addEventListener('keydown', (e: KeyboardEvent) => {
      const onScrub = e.target === scrub;
      if (e.key === ' ' || e.key.toLowerCase() === 'k') {
        if (onScrub && e.key === ' ') return;
        flip();
        e.preventDefault();
      } else if (e.key.toLowerCase() === 'm') {
        video.muted = !video.muted;
      } else if (e.key.toLowerCase() === 'f') {
        fullBtn?.click();
      }
    });

    root.addEventListener('pointermove', wake);
    root.addEventListener('pointerleave', () => {
      if (!video.paused) root.dataset.idle = 'true';
    });
    root.addEventListener('focusin', wake);
  }

  document.querySelectorAll<HTMLElement>('[data-cav]').forEach(init);
</script>
