---
/**
 * VideoPlayer -- a film a reader sits down to watch, on the site's own
 * controller rather than whatever chrome the browser ships.
 *
 * The Timecode controller. Before the roll, a slate names the film and
 * its running time. During it, a floating deck carries an ember counter,
 * a timeline ruled every few seconds, and the keys. It steps away 2.5s
 * after the pointer stops and comes back on any touch.
 *
 * Behaviour is src/lib/player.ts, shared with VideoReel; the look is
 * components/_player.scss. Nothing here styles itself.
 *
 * Progressive enhancement: the video ships with native `controls`, and
 * the slate and deck stay hidden until the script marks the player
 * `data-wired`. A script that never runs leaves a working native
 * player rather than a slate with nothing behind it.
 *
 * Captions: pass `captions` only for a film WITHOUT captions burned into
 * the picture. The Pledgivo films carry their own, and a track on top
 * shows every line twice.
 */
import PlayerIcon from './PlayerIcon.astro';

interface Props {
  src: string;
  poster?: string;
  /** A WebVTT file. Omit it for a film with burned-in captions. */
  captions?: string;
  /** Whether captions start on. Default on: most people watch muted. */
  captionsOn?: boolean;
  /** The film's name: its accessible name and its name in analytics. */
  title: string;
  /** The slate's headline. Defaults to `title`. */
  heading?: string;
  /** The slate's small line above the headline, e.g. the product. */
  eyebrow?: string;
  /** Running time as the slate prints it, e.g. "2 min 54 sec". */
  duration?: string;
  /** CSS aspect-ratio for the frame. */
  ratio?: string;
  class?: string;
}

const {
  src,
  poster,
  captions,
  captionsOn = true,
  title,
  heading,
  eyebrow,
  duration,
  ratio = '16 / 9',
  class: className,
} = Astro.props;

// A cross-origin <track> only loads when the media element opts into CORS.
const crossOrigin = captions && /^https?:\/\//.test(captions) ? 'anonymous' : undefined;
const meta = [duration, captions && 'Captions in English'].filter(Boolean).join(' · ');
---
<div
  class:list={['player', 'player--film', className]}
  style={`--player-ratio:${ratio};`}
  data-player="film"
  data-cc-default={captionsOn ? 'true' : 'false'}
>
  <div class="player__media">
    <video
      class="player__video"
      src={src}
      poster={poster}
      preload="metadata"
      playsinline
      controls
      crossorigin={crossOrigin}
      aria-label={title}
      data-role="video"
    >
      {captions && <track kind="captions" src={captions} srclang="en" label="English" />}
      Your browser cannot play this film. <a href={src}>Download it</a> instead.
    </video>

    <div class="player__surface" data-role="surface" aria-hidden="true"></div>
    {captions && <div class="player__cue" data-role="cue" aria-hidden="true"></div>}
    <div class="player__spin" aria-hidden="true"></div>
    <div class="player__flash" data-role="flash" aria-hidden="true">
      <PlayerIcon name="play" /><PlayerIcon name="pause" />
    </div>

    {/* The whole slate starts the film; the button inside is what a
        keyboard reaches, and its click bubbles to the slate. */}
    <div class="player__slate" data-role="start">
      <div class="player__card">
        {eyebrow && <div class="player__eyebrow">{eyebrow}</div>}
        <div class="player__title">{heading ?? title}</div>
        {meta && <div class="player__meta">{meta}</div>}
        <button class="player__roll" type="button">
          <PlayerIcon name="play" /><PlayerIcon name="replay" />
          <span class="player__roll-start">Roll the film</span>
          <span class="player__roll-again">Roll it again</span>
        </button>
      </div>
    </div>

    <div class="player__deck">
      <div class="player__tc">
        <span data-role="elapsed" data-long>00:00:00</span>
        <span class="player__tc-of">of <span data-role="total" data-long>--:--:--</span></span>
      </div>

      <div
        class="player__ruler"
        role="slider"
        tabindex="0"
        aria-label="Seek"
        aria-valuemin="0"
        aria-valuemax="100"
        aria-valuenow="0"
        aria-valuetext="0:00"
        data-role="scrub"
      >
        <span class="player__base" aria-hidden="true"></span>
        <span class="player__buf" aria-hidden="true"></span>
        <span class="player__ticks" data-role="ticks" aria-hidden="true"></span>
        <span class="player__played" aria-hidden="true"></span>
        <span class="player__ghost" aria-hidden="true"></span>
        <span class="player__head" aria-hidden="true"></span>
        <span class="player__tip" data-role="tip" aria-hidden="true">0:00</span>
      </div>

      <div class="player__keys">
        <button class="player__btn player__btn--play" type="button" data-role="toggle" aria-label="Play">
          <PlayerIcon name="play" /><PlayerIcon name="pause" />
        </button>
        <button class="player__btn player__btn--extra" type="button" data-role="skip" data-skip="-10" aria-label="Back 10 seconds">
          <PlayerIcon name="back" />
        </button>
        <button class="player__btn player__btn--extra" type="button" data-role="skip" data-skip="10" aria-label="Forward 10 seconds">
          <PlayerIcon name="forward" />
        </button>
        <button class="player__btn player__btn--text player__btn--extra" type="button" data-role="speed" aria-label="Playback speed">1×</button>
        {captions && (
          <button class="player__btn" type="button" data-role="cc" aria-pressed={captionsOn ? 'true' : 'false'} aria-label="Captions">
            <PlayerIcon name="captions" />
          </button>
        )}
        <button class="player__btn" type="button" data-role="mute" aria-label="Mute">
          <PlayerIcon name="sound" /><PlayerIcon name="muted" />
        </button>
        <button class="player__btn" type="button" data-role="fs" aria-label="Full screen">
          <PlayerIcon name="fs-enter" /><PlayerIcon name="fs-exit" />
        </button>
      </div>
    </div>
  </div>
</div>

<script>
  import { initPlayers } from '@/lib/player';
  initPlayers();
</script>
