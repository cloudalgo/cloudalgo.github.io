---
/**
 * The tracking notice. It informs; it does not ask.
 *
 * Appearance lives in styles/components/_notice.scss; the reasoning is
 * in that file's header, including why it is not called a slip.
 *
 * ── Why it stopped asking ──
 * It was a gate: three buttons, a toggle, and analytics that ran only
 * for the readers who clicked the right one. The site's owner decided
 * measurement should cover every visitor instead, so the gate came out.
 * What remains is a statement of what this site records, acknowledged
 * with one button.
 *
 * A notice is still a legal surface, and an honest one is the whole
 * point of keeping it: every sentence here now describes what actually
 * happens. Nothing offers the reader a choice this page does not
 * honour. The register below the fold is retained in full as the
 * detailed disclosure -- minus its toggle, which controlled something
 * that no longer exists -- and the reader's real remaining control,
 * their browser, is named where the toggle used to be.
 *
 * ── Why HubSpot and Clarity are injected from here ──
 * Because tracker loading lives in one file, and this is it. GA4 is the
 * exception and loads from ConsentBootstrap.astro, which must run
 * during head parse to carry the consent declaration. Nothing in a
 * layout may add a fourth tracker.
 */
import Badge from '@/components/ui/Badge.astro';
// The controller is named from the register, not retyped here. This
// banner said "CloudAlgo Inc." while all seven instruments and the
// register itself said "CloudAlgo Private Limited" -- a US form against
// the Indian one the company is actually incorporated under, on the one
// surface that exists to make a data-protection claim.
import { ISSUER } from '@/data/legal';
---

<div id="ca-cookie-popup" class="notice ca-hidden" role="region" aria-label="Cookie preferences">

  <!-- ── The statement ── -->
  <div class="notice__ask">
    <span class="pip notice__pip">
      <b class="pip__dot" aria-hidden="true"></b>Analytics active
    </span>
    <h3 class="notice__title">We use cookies</h3>
    <p class="notice__body">
      We use cookies, including third-party tools (Google Analytics, HubSpot, Microsoft Clarity),
      to understand how visitors engage with our site and to improve our content and services.
      They run on every visit. No personal data is sold to third parties, and you can clear or
      block them in your browser at any time.
    </p>
    <div class="notice__acts">
      <button id="ca-btn-detail" class="btn btn-outline notice__btn">What we record</button>
      <button id="ca-btn-ack-s1" class="btn btn-primary notice__btn">Got it</button>
    </div>
  </div>

  <!-- ── The register ── -->
  <div class="notice__register">
    <div class="notice__head">
      <span class="notice__label">Details</span>
      <h3 class="notice__title">What this site records</h3>
      <p class="notice__sub">Essential and analytics cookies are both active on every visit. Your browser settings are where you turn them off.</p>
    </div>

    <div class="notice__scroll">

      <div class="notice__row">
        <div class="notice__row-top">
          <span class="notice__row-name">Analytics &amp; marketing cookies</span>
          <div class="notice__control">
            <Badge tone="solid" context="consent">Always on</Badge>
          </div>
        </div>
        <p class="notice__row-desc">
          Measure site traffic, understand user behaviour, and surface relevant content about
          CloudAlgo's Salesforce, Heroku, and AWS services. These load on every visit. To stop
          them, block or clear cookies for this site in your browser.
        </p>
        <ul class="notice__parties">
          <li class="notice__party">Google Analytics</li>
          <li class="notice__party">HubSpot</li>
          <li class="notice__party">Microsoft Clarity</li>
        </ul>
      </div>

      <div class="notice__row">
        <div class="notice__row-top">
          <span class="notice__row-name">Essential cookies</span>
          <div class="notice__control">
            <Badge tone="solid" context="consent">Always on</Badge>
          </div>
        </div>
        <p class="notice__row-desc">
          Required for page navigation, session continuity, form submissions, and stable
          delivery of the CloudAlgo website. These cannot be disabled.
        </p>
      </div>

      <p class="notice__responsible">
        Responsible as defined by data protection law: {ISSUER}.&nbsp;<a href="/page/privacy-policy/">Privacy policy</a>
      </p>

      <details class="notice__more" id="ca-cookie-detail">
        <summary class="notice__more-sum">Cookies and modifications, in full</summary>
        <div class="notice__doc">
          <h4>Cookies and Modifications</h4>
          <p>
            In the following paragraphs, we'll explain our purposes for using cookies and similar
            technologies on our websites, which cookies we place, and how you can remove or block
            them through your browser.
          </p>

          <h4>What are Cookies?</h4>
          <p>
            Cookies and web storage technologies, such as Local Storage and Session Storage,
            referred to as "cookies", facilitate your interaction with our websites. As soon as
            you visit our websites, cookies are downloaded by the internet browser to your end
            device, for example as a small text file. Third-party technologies, like scripts,
            pixels, and tags, which we integrate into our websites for analytics purposes, also
            place cookies on your end device.
          </p>

          <h4>Purposes of Cookies</h4>
          <p>Cookies take care of many different tasks that contribute to a seamless online experience. Some specific cookies are essential for the running and maintenance of our websites, because they enable us to:</p>
          <ul>
            <li>Provide you with the services of your preference at all times</li>
            <li>Present you with specific and relevant information</li>
            <li>Offer you a seamless and comfortable online experience</li>
          </ul>

          <h4>Recognition and Response</h4>
          <p>Cookies show us how you use and interact with our websites. This helps us to:</p>
          <ul>
            <li>Provide you with a more personal experience by bringing you to the most important pages more efficiently</li>
            <li>Remind us of some of your personal preferences</li>
            <li>Guide you to useful content or pages relevant to CloudAlgo's services</li>
          </ul>

          <h4>Continuous Improvements</h4>
          <p>Cookies help us understand how visitors use our websites and enable us to make improvements. For example, cookies make it possible to analyse what type of content is popular and create similar topics. This helps us to:</p>
          <ul>
            <li>Improve the design of our websites and provide you with a better online experience</li>
            <li>Try different approaches and present visitors with content most relevant to them</li>
          </ul>

          <h4>Advertising and Retargeting</h4>
          <p>Our websites may use cookies for retargeting purposes. This means cookies store information from your browsing history to track your interests and activity. This helps us, or our advertising partners, to present you with:</p>
          <ul>
            <li>Relevant advertising for our products on other websites, based on your visits here</li>
            <li>A combination of relevant and specific information so that displayed advertising matches your interests</li>
          </ul>

          <h4>Cookie Categories</h4>
          <p>
            Both data processing and associated cookies may be deployed on our websites. Depending
            on function and purpose, we have divided data processing into different categories.
            Please find further information on the various cookie categories at the start of this
            panel, under "Details".
          </p>

          <h4>What do you need to know about cookies?</h4>
          <p>
            A cookie is a small text file that stores internet settings. Almost every website uses
            cookies. When you visit a website for the first time, the cookies are downloaded by
            your internet browser. The next time you visit this website using the same end device,
            the website recognises you and displays content tailored to your personal needs and
            interests. The cookies mentioned below are synonymous with HTML5 Session Web Storage
            and HTML5 Local Web Storage.
          </p>

          <h4>First-Party Cookies</h4>
          <p>
            First-party cookies are cookies that we, or contracted service providers, place on the
            website and with which you interact if you continue to use our website.
          </p>

          <h4>Third-Party Cookies</h4>
          <p>
            Our websites may also contain content from other providers (third-party providers),
            who possibly use their own cookies. Third-party providers may place cookies during your
            visit to our websites that request information like, for example, whether you loaded one
            of our websites. Please go to the website of the third-party provider to learn more
            about their use of cookies. Cookies from third-party providers are blocked and deleted
            through your browser's settings, not through this panel.
          </p>

          <h4>Removing Cookies</h4>
          <p>
            The cookies described here are placed on every visit to our websites. We do not operate
            a per-visitor opt-out, so the control that matters is your browser's: it can block
            cookies for this site, delete the ones already stored, or refuse third-party cookies
            outright, and any of those decisions is honoured immediately because it takes effect
            before our code runs. Blocking them does not affect your access to any part of this
            site. If you would prefer we erase data we have already collected about your visits,
            write to us and we will do so.
          </p>

          <h4>Cookie Management in your browser</h4>
          <p>
            You can manage cookie settings via the features on our website, and also through
            changing your browser settings (enable, disable, and delete). Most browsers allow you
            to manage cookies by either accepting or rejecting all cookies. Go to the help section
            of your browser to learn more about how to manage and delete cookies. When you change
            your cookie settings, certain cookies will be blocked. In this case, you may not fully
            benefit from some features on our website.
          </p>
        </div>
      </details>

    </div><!-- /.notice__scroll -->

    <div class="notice__foot">
      <button id="ca-btn-ack-s2" class="btn btn-primary notice__btn">Got it</button>
    </div>
  </div><!-- /.notice__register -->

</div><!-- /#ca-cookie-popup -->

<script>
  /** The key records that the notice has been READ, nothing more. It is
   *  deliberately not the old `ca_cookie_consent`: that key stored an
   *  answer to a question this panel no longer asks, and reusing it
   *  would silently reinterpret a stored "declined" as acknowledgement
   *  of a statement its owner never saw. A new key also means every
   *  returning visitor is shown the new wording once, which is the
   *  point of having rewritten it. */
  const ACK_KEY = 'ca_notice_ack';

  let trackersInjected = false;

  /** HubSpot and Clarity, on every visit.
   *
   *  GA4 is not here: it loads from ConsentBootstrap.astro, which has to
   *  run during head parse to carry the consent declaration. These two
   *  have no such constraint, so they stay in the file that owns tracker
   *  injection. */
  function injectTrackers(): void {
    if (trackersInjected) return;
    trackersInjected = true;

    // HubSpot
    const hs = document.createElement('script');
    hs.async = true;
    hs.src = '//js.hs-scripts.com/21905808.js';
    document.head.appendChild(hs);

    // Microsoft Clarity
    const w = window as any;
    w['clarity'] = w['clarity'] || function () { (w['clarity'].q = w['clarity'].q || []).push(arguments); };
    const ct = document.createElement('script');
    ct.async = true;
    ct.src = 'https://www.clarity.ms/tag/wqcruv2yej';
    document.head.appendChild(ct);

    window.dispatchEvent(new Event('ca:trackers-ready'));
  }

  /** Storage throws outright in some privacy modes rather than returning
   *  null, and this script block owns the notice: an uncaught throw here
   *  means the notice never renders at all. Both accessors swallow. */
  function wasAcknowledged(): boolean {
    try {
      return localStorage.getItem(ACK_KEY) === '1';
    } catch {
      // Unreadable storage means we cannot know they have seen it. Show it.
      return false;
    }
  }

  function acknowledge(): void {
    try {
      localStorage.setItem(ACK_KEY, '1');
    } catch {
      // They will see the notice again next visit. Better than a dead handler.
    }
  }

  function hidePopup(): void {
    document.getElementById('ca-cookie-popup')?.classList.add('ca-hidden');
  }

  // ── On page load ──
  // Trackers run regardless. The notice is shown until it is read.
  injectTrackers();
  if (!wasAcknowledged()) {
    document.getElementById('ca-cookie-popup')?.classList.remove('ca-hidden');
  }

  // ── "What we record" opens the register ──
  document.getElementById('ca-btn-detail')?.addEventListener('click', () => {
    document.getElementById('ca-cookie-popup')?.classList.add('notice--open');
  });

  // ── "Got it", from either the statement or the register ──
  for (const id of ['ca-btn-ack-s1', 'ca-btn-ack-s2']) {
    document.getElementById(id)?.addEventListener('click', () => {
      acknowledge();
      hidePopup();
    });
  }
</script>
