---
/**
 * The last thing on an index page: one line, one qualification, and the
 * ways out of the page.
 *
 * Ruled off the content above rather than boxed -- it is the end of the
 * page, not another section of it. The footer proper is site
 * furniture and comes after; this is the page's own last word.
 *
 * ONE RULE BEFORE YOU REACH FOR THIS. The site footer already carries
 * "Book a consultation" on every single page. A closing block that asks
 * for the same thing puts the identical button on screen twice inside
 * one viewport, which is what happened on /products/ and is why that
 * page no longer uses this. So: a page gets a closing block only when it
 * has a closing intent the footer does not already serve -- read the next
 * case study, subscribe, download the thing. If the honest last word is
 * "talk to us", the footer has said it. Do not say it again.
 *
 * No caller today for exactly that reason. Kept because several of the
 * remaining pages plausibly do have a distinct last word; delete this and
 * its partial if they turn out not to.
 */
export interface ClosingAction {
  label: string;
  href: string;
  primary?: boolean;
}

interface Props {
  title: string;
  /** One line under the title. Omit for a bare sign-off. */
  note?: string;
  actions: ClosingAction[];
  class?: string;
}
const { title, note, actions, class: className } = Astro.props;

/** Derived rather than declared, for the reason given in ProductEntry. */
const isExternal = (href: string) => /^https?:\/\//.test(href);
---
<section class:list={['closing-cta', className]}>
  <div class="closing-cta__copy">
    <h2 class="closing-cta__title">{title}</h2>
    {note && <p class="closing-cta__note">{note}</p>}
  </div>

  <div class="closing-cta__actions">
    {actions.map((action) => (
      <a
        class:list={['btn', action.primary ? 'btn-primary' : 'btn-outline', 'btn-sm']}
        href={action.href}
        {...(isExternal(action.href) ? { target: '_blank', rel: 'noopener noreferrer' } : {})}
      >{action.label}</a>
    ))}
  </div>
</section>
