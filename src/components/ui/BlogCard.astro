---
// src/components/ui/BlogCard.astro
export interface Props {
  title: string;
  excerpt: string;
  category: string;
  date: Date;
  readTime: number;
  slug: string;
  delay?: number;
}
const { title, excerpt, category, date, readTime, slug, delay = 0 } = Astro.props;

const GRADIENTS: Record<string, string> = {
  Salesforce: 'linear-gradient(135deg, #f75a41, #ff8c42)',
  Heroku:     'linear-gradient(135deg, #111, #2a2a2a)',
  MuleSoft:   'linear-gradient(135deg, #f75a41, #111)',
  AWS:        'linear-gradient(135deg, #ff9900, #232f3e)',
  Product:    'linear-gradient(135deg, #6366f1, #111)',
};

const formattedDate = date.toLocaleDateString('en-US', { month: 'short', year: 'numeric' });
---
<a
  href={`/blog/${slug}`}
  class="group block bg-white rounded-xl overflow-hidden border border-[#e5e5e5] hover:-translate-y-1 hover:shadow-[0_12px_32px_rgba(0,0,0,0.10)] transition-all duration-200 anim-scale-pop"
  style={`transition-delay: ${delay}ms;`}
>
  <div class="h-40 w-full" style={`background: ${GRADIENTS[category] ?? GRADIENTS.Salesforce};`}></div>
  <div class="p-5">
    <div class="text-[9px] font-extrabold tracking-[2px] uppercase text-primary mb-2">{category}</div>
    <h4 class="font-display font-extrabold text-[14px] text-black leading-snug mb-2 group-hover:text-primary transition-colors">{title}</h4>
    <p class="text-[11px] text-[#6b7280] leading-relaxed mb-3 line-clamp-2">{excerpt}</p>
    <div class="text-[10px] text-[#aaa] font-semibold">{formattedDate} · {readTime} min read</div>
  </div>
</a>
