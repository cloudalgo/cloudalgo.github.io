---
export interface Props {
  title: string;
  excerpt: string;
  category: string;
  date: Date;
  readTime: number;
  slug: string;
  image?: string;
}
const { title, excerpt, category, date, readTime, slug, image } = Astro.props;

const GRADIENTS: Record<string, string> = {
  Salesforce: 'linear-gradient(135deg, #f75a41, #ff8c42)',
  Heroku:     'linear-gradient(135deg, #79589F, #4e3a6e)',
  MuleSoft:   'linear-gradient(135deg, #00a1e0, #0070a8)',
  AWS:        'linear-gradient(135deg, #ff9900, #232f3e)',
  Product:    'linear-gradient(135deg, #6366f1, #4338ca)',
};

const formattedDate = date.toLocaleDateString('en-US', { month: 'short', day: 'numeric', year: 'numeric' });
---
<div class="blog-grid-card">
  <a href={`/blog/${slug}`} class="blog-image-container" aria-label={title}>
    {image
      ? <img src={image} alt={title} style="height:100%;width:100%;object-fit:cover;" loading="lazy" />
      : <div style={`background: ${GRADIENTS[category] ?? GRADIENTS.Salesforce}; height:100%;width:100%;`}></div>
    }
  </a>
  <div class="card-body">
    <div class="badges mb-3">
      <span class="blog-badges">{category}</span>
    </div>
    <h3 class="card-title">
      <a href={`/blog/${slug}`}>{title}</a>
    </h3>
    <p class="card-text excerpt">{excerpt}</p>
    <p class="card-text meta">
      <small class="text-muted">{formattedDate} · {readTime} min read</small>
    </p>
  </div>
</div>
