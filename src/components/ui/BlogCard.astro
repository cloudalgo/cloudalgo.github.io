---
import { getBlogIllustration } from '../../data/blog-illustrations';
import Badge from '@/components/ui/Badge.astro';

export interface Props {
  title: string;
  excerpt: string;
  category: string;
  date: Date;
  readTime: number;
  slug: string;
  image?: string;
  author?: string;
  authorPhoto?: string;
  delay?: number;
}

const { title, excerpt, category, date, readTime, slug, author, authorPhoto, delay = 0 } = Astro.props;

const formattedDate = date.toLocaleDateString('en-US', { month: 'short', day: 'numeric', year: 'numeric' });
const authorName = author ?? 'CloudAlgo Team';

// Content-specific illustration takes priority; fall back to category illustration
const contentIllustration = getBlogIllustration(slug);

