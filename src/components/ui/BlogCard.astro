// Use content-specific illustration first, then category fallback
const illustrationSvg = contentIllustration || illustrations[category] || illustrations['Salesforce'];
---

<article
  class="card card--radius-xl blog-card-new"
  data-category={category}
  style={`animation-delay:${delay}ms`}
>
  <a href={`/blog/${slug}`} class="blog-card-thumb" aria-label={`Read: ${title}`} tabindex="-1">
    <div class="blog-card-illus" set:html={illustrationSvg} />
  </a>

  <div class="blog-card-body">
    <div class="blog-card-top">
      <Badge tone="outline" context="card-category">{category}</Badge>
      <span class="blog-read-time">{readTime} min read</span>
    </div>

    <h3 class="blog-card-title">
      <a href={`/blog/${slug}`}>{title}</a>
    </h3>

    <p class="blog-card-excerpt">{excerpt}</p>

    <div class="blog-card-meta">
      {authorPhoto && (
        <img src={authorPhoto} alt={authorName} class="blog-author-photo" loading="lazy" />
      )}
      <span class="blog-meta-text">
        <span class="blog-author-name">{authorName}</span>
        <span class="blog-meta-dot">·</span>
        <span>{formattedDate}</span>
      </span>
    </div>
  </div>
</article>

<style is:global>
/* ── Card entrance keyframe ─────────────────────────── */
@keyframes cardIn {
  from { opacity: 0; transform: translateY(18px); }
  to   { opacity: 1; transform: none; }
}

/* ── Card shell ─────────────────────────────────────── */
.blog-card-new {
  overflow: hidden;
  display: flex;
  flex-direction: column;
  width: 100%;
  transition: border-color 0.3s ease, box-shadow 0.3s ease;
  cursor: pointer;
  animation: cardIn 0.5s ease both;
}
.blog-card-new:hover {
  border-color: var(--border-strong);
  box-shadow: 0 8px 32px var(--shadow-ink);
}

/* ── Thumbnail area ─────────────────────────────────── */
.blog-card-thumb {
  display: block;
  overflow: hidden;
  height: 220px;
  background: var(--surface-tint);
  position: relative;
  flex-shrink: 0;
}
.blog-thumb-img {
  width: 100%;
  height: 100%;
  object-fit: cover;
  display: block;
  filter: grayscale(20%) contrast(1.05);
  transition: transform 0.55s cubic-bezier(0.25, 0.46, 0.45, 0.94),
              filter 0.4s ease;
}
.blog-card-new:hover .blog-thumb-img {
  transform: scale(1.06);
  filter: grayscale(0%) contrast(1.05);
}
.blog-card-illus {
  width: 100%;
  height: 100%;
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 0 1rem;
}
.blog-svg-illus {
  width: 100%;
  height: 100%;
  max-height: 200px;
}

/* ── Card body ──────────────────────────────────────── */
.blog-card-body {
  padding: 1.375rem 1.5rem 1.5rem;
  display: flex;
  flex-direction: column;
  flex: 1;
  gap: 0.625rem;
}
.blog-card-top {
  display: flex;
  align-items: center;
  justify-content: space-between;
}.blog-read-time {
  font-size: 0.75rem;
  color: var(--color-text-faint);
  font-weight: 500;
}
.blog-card-title {
  font-size: 1.0625rem;
  font-weight: 700;
  letter-spacing: -0.01em;
  line-height: 1.4;
  margin: 0;
}
.blog-card-title a {
  color: var(--color-heading);
  text-decoration: none;
  background-image: linear-gradient(var(--surface-inverse), var(--surface-inverse));
  background-position: 0 100%;
  background-repeat: no-repeat;
  background-size: 0% 1.5px;
  transition: background-size 0.3s ease;
}
.blog-card-new:hover .blog-card-title a {
  background-size: 100% 1.5px;
}
.blog-card-excerpt {
  font-size: 0.875rem;
  color: var(--color-text);
  line-height: 1.65;
  display: -webkit-box;
  -webkit-line-clamp: 2;
  -webkit-box-orient: vertical;
  overflow: hidden;
  margin: 0;
  flex: 1;
}
.blog-card-meta {
  display: flex;
  align-items: center;
  gap: 0.625rem;
  margin-top: auto;
  padding-top: 0.75rem;
  border-top: 1px solid var(--surface-tint);
}
.blog-author-photo {
  width: 28px;
  height: 28px;
  border-radius: 50%;
  object-fit: cover;
  border: 1.5px solid var(--border-default);
  flex-shrink: 0;
}
.blog-meta-text {
  font-size: 0.8125rem;
  color: var(--color-text-muted);
  display: flex;
  align-items: center;
  gap: 0.375rem;
}
.blog-author-name { font-weight: 600; color: var(--color-text); }
.blog-meta-dot { opacity: 0.5; }

/* ── Illustration hover animations ─────────────────── */
/* Salesforce: cloud floats, bolt pulses */
.blog-card-new:hover .sf-cloud {
  animation: blogFloat 2.2s ease-in-out infinite;
  transform-origin: center bottom;
}
.blog-card-new:hover .sf-bolt {
  animation: blogPulse 1.4s ease-in-out infinite;
}

/* Heroku: terminal lines appear, rocket drifts up */
.blog-card-new:hover .heroku-lines {
  animation: blogFadeIn 0.4s ease forwards;
}
.blog-card-new:hover .heroku-rocket {
  animation: blogFloat 2s ease-in-out infinite;
}
.blog-card-new:hover .heroku-success {
  animation: blogPulse 2s ease-in-out infinite;
}

/* MuleSoft: pulse dots animate in sequence */
.blog-card-new:hover .mule-pulse  { animation: blogPulse 1.6s ease-in-out 0s    infinite; }
.blog-card-new:hover .mule-pulse2 { animation: blogPulse 1.6s ease-in-out 0.4s  infinite; }
.blog-card-new:hover .mule-pulse3 { animation: blogPulse 1.6s ease-in-out 0.8s  infinite; }
.blog-card-new:hover .mule-pulse4 { animation: blogPulse 1.6s ease-in-out 1.2s  infinite; }
.blog-card-new:hover .mule-node1 { animation: blogScale 0.3s ease forwards; }
.blog-card-new:hover .mule-node3 { animation: blogScale 0.3s ease 0.1s forwards; }

/* AWS: cloud drifts, lambda pulses */
