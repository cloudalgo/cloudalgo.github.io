---
/**
 * A silent loop: a short film that runs beside a figure the way a
 * screenshot would, rather than a film a reader sits down to watch.
 * VideoPlayer is the one you watch -- it has a slate, a ruled timeline
 * and a duration, and it reports what was watched. This one has a
 * counter, a progress line and a single key, and reports nothing.
 *
 * That silence is deliberate. `video_start` / `video_progress` /
 * `video_complete` are VideoPlayer's names and they mean "a person
 * chose to watch this". A loop that fired them would file a view every
 * time anyone scrolled past, and the numbers those events exist to
 * produce would stop meaning anything.
 *
 * It is the Timecode controller's small form, run by the same engine
 * (src/lib/player.ts). Ambient by default, which is three things the
 * markup has to get right, none of them optional:
 *
 *  - `muted` + `playsinline` are what make autoplay legal at all. A
 *    browser that still refuses is handled, not assumed away: the
 *    poster stays up and the key works.
 *  - the file is fetched on FIRST INTERSECTION, never at page load --
 *    these are megabytes, and most readers never reach the fold.
 *  - the pause key is visible and permanent. WCAG 2.2.2 requires a stop
 *    for anything that moves for more than five seconds, and a loop is
 *    by definition longer than that.
 *
 * Under `prefers-reduced-motion: reduce` nothing is fetched and nothing
 * starts; the poster stands in and the key still works for a reader who
 * wants it after all.
 *
 * `ambient={false}` is the product viewer's step recording: the same
 * controls, but the page's own script sets the source and starts it.
 */
import PlayerIcon from './PlayerIcon.astro';

interface Props {
  /** Omit only with `ambient={false}`, where the page sets the source. */
  src?: string;
  /** Stands in before first play, and for a reader who never starts it.
      Effectively required for an ambient reel: without one the frame is
      a black rectangle. */
  poster?: string;
  /** What the film shows, for a reader who cannot watch it. */
  label: string;
  /** CSS aspect-ratio for the frame, e.g. "9 / 16". */
  ratio?: string;
  /** Runs itself on sight. False hands start and source to the page. */
  ambient?: boolean;
  class?: string;
}
const { src, poster, label, ratio = '9 / 16', ambient = true, class: className } = Astro.props;
---
<div
  class:list={['reel', 'player', 'player--loop', className]}
  style={`--reel-ratio:${ratio};`}
  data-player="loop"
  data-ambient={ambient ? '' : undefined}
>
  <video
    class="reel__video player__video"
    data-src={src}
    poster={poster}
    aria-label={label}
    preload="none"
    muted
    loop
    playsinline
    data-role="video"
  ></video>
  <div class="player__surface" data-role="surface" aria-hidden="true"></div>
  <div class="player__flash" data-role="flash" aria-hidden="true">
    <PlayerIcon name="play" /><PlayerIcon name="pause" />
  </div>
  <span class="player__chip" aria-hidden="true"><span data-role="elapsed" data-long>00:00:00</span></span>
  <span class="player__line" aria-hidden="true"></span>
  <button class="player__key" type="button" data-role="toggle" aria-label="Play">
    <PlayerIcon name="play" /><PlayerIcon name="pause" />
  </button>
</div>

<script>
  import { initPlayers } from '@/lib/player';
  initPlayers();
</script>
