---
/**
 * Engagements drawn against a calendar: one row each, a bar for a span of
 * work and a run of monthly ticks for something that does not end.
 *
 * This is the services index's answer to the catalogue's spec sheet, and
 * it exists because the two pages describe different kinds of thing. A
 * product is an OBJECT with attributes, so a table of properties
 * describes it completely. An engagement is a PERIOD OF TIME with a
 * shape, a rhythm and an ending -- so the figure that describes it has
 * to be measured against a calendar, not listed.
 *
 * The figure is drawn twice at two zoom levels. On /services/ each row is
 * a whole engagement across a year, and clicking one jumps to its spread.
 * On a detail page each row is one STAGE of a single engagement across
 * its own length, and there is nothing to click -- so `interactive`
 * switches the rows between anchors and plain elements rather than
 * forking the component. Everything else is the same drawing.
 *
 * Every position is a number out of `cols`, and that count is handed to
 * the stylesheet as --sched-cols rather than duplicated in it. Draw a
 * different span -- twelve months, twenty-four weeks -- by passing a
 * different `cols` and axis, and the gridlines, the marks and the bars
 * all move together.
 */
import type { Bar, LegendKey, AxisMark } from '@/data/engagements';

export interface ScheduleRow {
  /** Printed as given ("01"), and the same numeral the spread carries. */
  n: string;
  name: string;
  /** How long it runs, not what it is for. The contents strip above
      carries the benefit; this line carries the shape. */
  shape: string;
  /** In-page anchor to the spread. Required when `interactive`. */
  href?: string;
  /** A sentence under the label, on the detail page's zoom level: what
      happens during this stage. */
  detail?: string;
  /**
   * A span: `from` is where it starts, `typical` where it usually ends,
   * `most` the far end of the range. The solid part runs to `typical`
   * and the hatch on to `most`, so the range reads as a range.
   */
  bar?: Bar;
  /** More than one span on one row: a stage that repeats. */
  bars?: Bar[];
  /** Draws the ember cap on this row's bar: it is the handover. */
  end?: boolean;
  /** Position the rolling ticks start at. Omit for something that ends. */
  roll?: number;
}

interface Props {
  /** Axis marks and where they sit. Positions are out of `cols`. */
  axis: AxisMark[];
  /** The scale everything on the figure is measured against. */
  cols: number;
  rows: ScheduleRow[];
  /** The sentence after "Fig. NN", or -- when `note` -- the whole note. */
  caption: string;
  /** The figure's number, printed as given. */
  n?: string;
  /**
   * Print the caption as a note rather than a numbered figure caption.
   * A detail page carries one figure, so numbering it "Fig. 01" would be
   * a scheme of one; the index carries several and needs the numeral.
   */
  note?: boolean;
  /** Rows link to their spread. False on a detail page, where the rows
      are stages of the engagement you are already reading. */
  interactive?: boolean;
  /** Names the marks this figure actually draws. Defaults to all four. */
  keys?: LegendKey[];
  class?: string;
}
const {
  axis, cols, rows, caption, n = '01',
  note = false, interactive = true, keys, class: className,
} = Astro.props;

/* The four marks the figure can draw, named once here so the legend
   cannot drift from what the bars actually draw. A caller that draws
   only some of them passes its own subset. */
const KEYS: LegendKey[] = keys ?? [
  { mod: 'min',   label: 'Typical' },
  { mod: 'range', label: 'Range' },
  { mod: 'cap',   label: 'Handover' },
  { mod: 'roll',  label: 'Rolling month' },
];

const Row = interactive ? 'a' : 'div';

/** One row's spans, however many it has. */
const spans = (row: ScheduleRow): Bar[] => row.bars ?? (row.bar ? [row.bar] : []);
---
<figure class:list={['schedule', className]} style={`--sched-cols:${cols}`}>
  <div class="schedule__scroll">
    <div class="schedule__plot">
      {/* Decorative to a screen reader: the axis is a ruler for the bars,
          and each row already states its own length in words. */}
      <div class="schedule__axis" aria-hidden="true">
        {axis.map((mark) => <span style={`--at:${mark.at}`}>{mark.mark}</span>)}
      </div>

      {rows.map((row) => (
        <Row class="schedule__row" href={interactive ? row.href : undefined}>
          <span class="schedule__label">
            <span class="schedule__n">{row.n}</span>
            <span>
              <span class="schedule__name">{row.name}</span>
              <span class="schedule__shape">{row.shape}</span>
              {row.detail && <span class="schedule__detail">{row.detail}</span>}
            </span>
          </span>
          <span class="schedule__track">
            {spans(row).map((bar) => (
              <span
                class:list={['schedule__bar', row.end && 'schedule__bar--end']}
                style={`--a:${bar.from};--b:${bar.typical};--c:${bar.most}`}
              >
                <span class="schedule__min" />
              </span>
            ))}
            {row.roll !== undefined && (
              <span class="schedule__roll" style={`--from:${row.roll}`} />
            )}
          </span>
        </Row>
      ))}
    </div>
  </div>

  <div class="schedule__legend" aria-hidden="true">
    {KEYS.map((k) => (
      <span><i class:list={['schedule__key', `schedule__key--${k.mod}`]} />{k.label}</span>
    ))}
  </div>

  {note ? (
    <figcaption class="spine__note" set:html={caption} />
  ) : (
    /* The catalogue's caption class, deliberately: a figure is a figure on
       both pages, and giving this one its own would be a second numbering
       scheme saying the same thing. */
    <figcaption class="evidence__caption">
      <b class="evidence__n">Fig. {n}</b> {caption}
    </figcaption>
  )}
</figure>
