---import Button from '../ui/Button.astro';

const year = new Date().getFullYear()
---

<!-- ── "Let's build" CTA strip ───────────────────────────── -->
<section class="footer-cta">
  <div class="container">
    <h2>Let’s build something<br/>together.</h2>
    <Button href="/contact" variant="light">
      Start a project &rarr;
    </Button>
  </div>
</section>

<!-- ── Main footer ───────────────────────────────────────── -->
<footer class="ca-footer">

  <!-- Content -->
  <div class="ca-footer-inner">
    <div class="ca-footer-grid">

      <!-- Brand column -->
      <div class="ca-fbrand">
        <!-- Original logo in white for dark footer -->
        <a href="/" class="ca-fbrand-logo" aria-label="CloudAlgo home">
          <img src="/email-logo-white.svg" alt="CloudAlgo" width="174" height="32" style="display:block;margin-bottom:1.5rem;" />
        </a>
        <h2 class="ca-fbrand-talk">Let’s talk</h2>
        <a href="mailto:sales@cloudalgo.com" class="ca-fbrand-email-cta">&rarr; sales@cloudalgo.com</a>
        <p class="ca-fbrand-desc">
          CloudAlgo is a Salesforce Consulting Partner, founded in 2019. We build
          Salesforce and Heroku solutions that hold up long after we hand them over.
        </p>
        <div class="ca-fbrand-badges">
          <a href="https://appexchange.salesforce.com/appxConsultingListingDetail?listingId=a0N4V00000JdabDUAR&legacy=true"
             target="_blank" rel="noreferrer">
            <img src="/salesforce/Salesforce_Partner_Badge_RGB.webp"
                 alt="Certified Salesforce Partner"
                 width="446" height="474" loading="lazy" decoding="async"
                 style="height:72px;width:auto;" />
          </a>
          <a href="https://appexchange.salesforce.com/appxConsultingListingDetail?listingId=a0N4V00000JdabDUAR&legacy=true"
             target="_blank" rel="noreferrer">
            <img src="/salesforce/Available_On_Appexchange_Badge_RGB_Transparent.webp"
                 alt="Available on AppExchange"
                 width="446" height="474" loading="lazy" decoding="async"
                 style="height:72px;width:auto;" />
          </a>
        </div>
        <p class="ca-footer-copy">{year} &copy; cloudalgo.com, All rights reserved.</p>
      </div>

      <!-- Company links -->
      <div>
        <ul class="ca-flinks">
          <li><a href="/about">About</a></li>
          <li><a href="/services">Services</a></li>
          <li><a href="/products">Products</a></li>
          <li><a href="/blog">Blog</a></li>
          <li><a href="/page/disclaimer">Disclaimer</a></li>
        </ul>
      </div>

      <!-- Connect links -->
      <div>
        <ul class="ca-flinks">
          <li><a href="https://www.linkedin.com/company/cloudalgo" target="_blank" rel="noopener noreferrer">LinkedIn</a></li>
          <li><a href="https://github.com/cloudalgo" target="_blank" rel="noopener noreferrer">Github</a></li>
          <li><a href="https://twitter.com/cloudalgo" target="_blank" rel="noopener noreferrer">Twitter</a></li>
          <li><a href="/page/privacy-policy">Privacy Policy</a></li>
        </ul>
      </div>

    </div>
  </div>
</footer>

<style>
/* ── CTA strip (reuses global .footer-cta styles) ────────── */

/* ── Footer wrapper ──────────────────────────────────────── */
.ca-footer {
  background: var(--surface-inverse);
  color: var(--color-on-inverse-muted);
}

/* ── Content wrapper ─────────────────────────────────────── */
.ca-footer-inner {
  position: relative;
  z-index: 1;
  max-width: 1278px;
  margin: 0 auto;
  padding: 0 1.5rem 2.5rem;
}

/* ── Three-col grid ──────────────────────────────────────── */
.ca-footer-grid {
  display: grid;
  grid-template-columns: 2fr 1fr 1fr;
  gap: 3rem;
  padding: 4.5rem 0 3rem;
  align-items: start;
}
@media (max-width: 767px) {
  .ca-footer-grid { grid-template-columns: 1fr; gap: 2rem; padding: 3rem 0 2rem; }
}

/* Brand */
.ca-fbrand-talk {
  font-size: clamp(2rem, 4vw, 3rem);
  font-weight: 900;
  color: var(--color-on-inverse);
  letter-spacing: -0.04em;
  line-height: 1.1;
  margin-bottom: 0.5rem;
}
.ca-fbrand-email-cta {
  display: inline-block;
  color: var(--color-on-inverse-a60);
  font-size: 0.9375rem;
  text-decoration: none;
  margin-bottom: 1.75rem;
  transition: color 0.2s;
}
.ca-fbrand-email-cta:hover { color: var(--color-on-inverse); }
.ca-fbrand-desc {
  font-size: 0.875rem;
  line-height: 1.8;
  color: var(--color-on-inverse-a38);
  margin-bottom: 1.25rem;
  max-width: 320px;
}
.ca-fbrand-badges {
  display: flex;
  align-items: center;
  gap: 0.75rem;
  margin-bottom: 1.5rem;
}
.ca-footer-copy {
  font-size: 0.8rem;
  color: var(--color-on-inverse-a28);
}

/* Link columns */
.ca-flinks {
  list-style: none;
  padding: 0;
  margin: 0;
  display: flex;
  flex-direction: column;
  gap: 1.25rem;
  padding-top: 0.5rem;
}
.ca-flinks a {
  color: var(--color-on-inverse-muted);
  text-decoration: none;
  font-size: 0.9375rem;
  transition: color 0.2s;
}
.ca-flinks a:hover { color: var(--color-on-inverse); }
</style>
