---
---
<footer class="main-footer">
  <section class="footer">
    <div class="container">

      <div class="lets-talk">
        Let's talk
        <div>
          <span class="icon-arrow_forward"></span>
          <a href="mailto:sales@cloudalgo.com">sales@cloudalgo.com</a>
        </div>
      </div>

      <div class="row">
        <div class="col-md-7 align-self-center">
          <address>
            CloudAlgo, established in the year 2019, is a consulting firm that
            prioritizes its customers and a Salesforce Consulting Partner.
          </address>
          <div class="d-flex flex-wrap" style="gap:0.5rem;margin-bottom:1rem;">
            <div class="p-2">
              <a href="https://appexchange.salesforce.com/appxConsultingListingDetail?listingId=a0N4V00000JdabDUAR&legacy=true"
                 target="_blank" rel="noreferrer">
                <img src="/salesforce/Salesforce_Partner_Badge_RGB.png"
                     alt="Certified Salesforce Partner" style="height:100px;width:auto;" />
              </a>
            </div>
            <div class="p-2">
              <a href="https://appexchange.salesforce.com/appxConsultingListingDetail?listingId=a0N4V00000JdabDUAR&legacy=true"
                 target="_blank" rel="noreferrer">
                <img src="/salesforce/Available_On_Appexchange_Badge_RGB.png"
                     alt="Available on Salesforce AppExchange" style="height:100px;width:auto;" />
              </a>
            </div>
          </div>
          <div class="copy-right">
            {new Date().getFullYear()} © cloudalgo.com, All rights reserved.
          </div>
        </div>

        <div class="col-md-5 page-links">
          <ul class="list-unstyled">
            <li><a href="/about">About</a></li>
            <li><a href="/services">Services</a></li>
            <li><a href="/blog">Blogs</a></li>
          </ul>
          <ul class="list-unstyled">
            <li><a href="https://www.linkedin.com/company/cloudalgo" target="_blank" rel="noopener noreferrer">Linkedin</a></li>
            <li><a href="https://github.com/cloudalgo" target="_blank" rel="noopener noreferrer">Github</a></li>
            <li><a href="mailto:contact@cloudalgo.com">Contact</a></li>
          </ul>
        </div>
      </div>

    </div>
  </section>
</footer>
