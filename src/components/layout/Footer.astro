---
import { getCollection } from 'astro:content';
import BrandLockup from '@/components/ui/BrandLockup.astro';

// Folds 8 and 9: the consulting ask, then the colophon.
//
// Both are light. The mock draws them on the page surface with rules
// rather than fills -- the colophon is described there as "the masthead,
// mirrored at the foot", and the masthead is paper. The ember band is
// the page's ONE full-bleed inverted surface; a near-black CTA plus a
// near-black colophon would give it two more and cost the band the
// thing that makes it land.
//
// This is the only section task that changes every page, so the two
// legally-required links -- privacy policy and disclaimer -- were listed
// before the edit and both still render, now in the closing bar where
// they read as imprint rather than as navigation.
//
// Products and services come from their collections. A fifth of either
// appears here without a footer edit.

export interface Props {
  /** /contact/ passes false -- see the note in Page.astro. */
  cta?: boolean;
}

const { cta = true } = Astro.props;

const year = new Date().getFullYear();

const products = (await getCollection('products')).sort(
  (a, b) => a.data.order - b.data.order
);

const services = (await getCollection('services')).sort(
  (a, b) => a.data.order - b.data.order
);

---

<!-- ── Fold 8: the ask ─────────────────────────────────────── -->
{cta && (
<section class="footer-cta">
  <div>
    <h2>Tell us what your org is doing wrong.</h2>
    <p>
      We will tell you whether it needs a project, a retainer, one of our products,
      or nothing at all. The call costs you half an hour.
    </p>
  </div>
  <a class="btn btn-primary" href="/contact/">Book a consultation &rarr;</a>
</section>
)}

<!-- ── Fold 9: the colophon ────────────────────────────────── -->
<footer class="ca-footer">
  <div class="ca-footer-inner">
    <div class="ca-footer-head">
      <span class="ca-ftype">The colophon</span>
      <span class="ca-ftype">Jaipur &middot; India</span>
    </div>

    <div class="ca-footer-grid">
      <div class="ca-fbrand">
        <a href="/" class="ca-fbrand-logo" aria-label="CloudAlgo home">
          <BrandLockup class="brand-lockup--footer" />
        </a>
        <p class="ca-fbrand-desc">
          A Salesforce Consulting Partner since 2019. We build on Salesforce and
          Heroku, and we ship the four products listed here from the same bench.
        </p>
        <dl class="ca-fcontact">
          <div><dt>Sales</dt><dd><a href="mailto:sales@cloudalgo.com">sales@cloudalgo.com</a></dd></div>
          <div><dt>Phone</dt><dd><a href="tel:+916377360659">+91 6377-360659</a></dd></div>
          <div><dt>Studio</dt><dd>Jaipur, India</dd></div>
        </dl>
      </div>

      <div>
        <h3 class="ca-fcolhd">Products</h3>
        <ul class="ca-flinks">
          {products.map((p) => (
            <li>
              <a href={`/products/${p.id}/`}>{p.data.title}</a>
              <em>{p.data.status === 'ga' ? 'GA' : 'Preview'}</em>
            </li>
          ))}
        </ul>
      </div>

      <div>
        <h3 class="ca-fcolhd">Services</h3>
        <ul class="ca-flinks">
          {services.map((s) => (
            <li><a href={`/services/${s.id}/`}>{s.data.shortTitle}</a></li>
          ))}
        </ul>
      </div>

      <div>
        <h3 class="ca-fcolhd">Company</h3>
        <ul class="ca-flinks">
          <li><a href="/about/">About</a></li>
          <li><a href="/case-studies/">Case studies</a></li>
          <li><a href="/blog/">Journal</a></li>
          <li><a href="/contact/">Contact</a></li>
        </ul>
      </div>

      <div>
        <h3 class="ca-fcolhd">Elsewhere</h3>
        <ul class="ca-flinks">
          <li><a href="https://www.linkedin.com/company/cloudalgo" target="_blank" rel="noopener noreferrer">LinkedIn</a></li>
          <li><a href="https://github.com/cloudalgo" target="_blank" rel="noopener noreferrer">GitHub</a></li>
          <li>
            <a href="https://appexchange.salesforce.com/appxConsultingListingDetail?listingId=a0N4V00000JdabDUAR&legacy=true"
               target="_blank" rel="noopener noreferrer">AppExchange</a>
          </li>
          <li><a href="https://twitter.com/cloudalgo" target="_blank" rel="noopener noreferrer">Twitter</a></li>
        </ul>

        <h3 class="ca-fcolhd ca-fcolhd--spaced">Certified</h3>
        <div class="ca-fbadges">
          <a href="https://appexchange.salesforce.com/appxConsultingListingDetail?listingId=a0N4V00000JdabDUAR&legacy=true"
             target="_blank" rel="noreferrer">
            <img src="/salesforce/Salesforce_Partner_Badge_RGB.webp"
                 alt="Certified Salesforce Partner"
                 width="446" height="474" loading="lazy" decoding="async" />
          </a>
          <a href="https://appexchange.salesforce.com/appxConsultingListingDetail?listingId=a0N4V00000JdabDUAR&legacy=true"
             target="_blank" rel="noreferrer">
            <img src="/salesforce/Available_On_Appexchange_Badge_RGB_Transparent.webp"
                 alt="Available on AppExchange"
                 width="446" height="474" loading="lazy" decoding="async" />
          </a>
        </div>
      </div>
    </div>

    <div class="ca-footer-bar">
      <span class="ca-footer-copy">{year} &copy; cloudalgo.com. All rights reserved.</span>
      <span>
        <a href="/page/privacy-policy/">Privacy policy</a>
        &nbsp;&middot;&nbsp;
        <a href="/page/disclaimer/">Disclaimer</a>
      </span>
    </div>
  </div>
</footer>
