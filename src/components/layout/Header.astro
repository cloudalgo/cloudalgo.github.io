---
const navLinks = [
  { href: '/',              label: 'Home' },
  { href: '/services',      label: 'Services' },
  { href: '/products',      label: 'Products' },
  { href: '/case-studies',  label: 'Case Studies' },
  { href: '/about',         label: 'About Us' },
  { href: '/blog',          label: 'Blog' },
  { href: '/contact',       label: 'Contact' },
];
const currentPath = Astro.url.pathname;
const isActive = (href: string) =>
  href === '/' ? currentPath === '/' : currentPath.startsWith(href);
---

<header class="header" id="site-header">
  <div class="navbar">
    <a href="/" class="navbar-brand" aria-label="CloudAlgo home">
      <img src="/email-logo-dark.svg" alt="CloudAlgo" width="174" height="32" />
    </a>

    <nav class="nav-desktop">
      <ul class="nav-links">
        {navLinks.map(link => (
          <li>
            <a
              href={link.href}
              class:list={['nav-link', { active: isActive(link.href) }]}
              aria-current={isActive(link.href) ? 'page' : undefined}
            >
              {link.label}
            </a>
          </li>
        ))}
        <li>
          <a href="#schedule" class="nav-link join-us" id="book-btn-desktop">Book Consultation</a>
        </li>
      </ul>
    </nav>

    <!-- Animated hamburger toggle -->
    <button id="mobile-toggle" class="hamburger" aria-label="Toggle menu" aria-expanded="false" aria-controls="mobile-menu">
      <svg width="24" height="24" viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg">
        <line class="ham-top" x1="3" y1="6"  x2="21" y2="6"  stroke="var(--illus-ink)" stroke-width="2" stroke-linecap="round"/>
        <line class="ham-mid" x1="3" y1="12" x2="21" y2="12" stroke="var(--illus-ink)" stroke-width="2" stroke-linecap="round"/>
        <line class="ham-bot" x1="3" y1="18" x2="21" y2="18" stroke="var(--illus-ink)" stroke-width="2" stroke-linecap="round"/>
      </svg>
    </button>
  </div>

  <!-- Mobile menu (animated slide) -->
  <div id="mobile-menu" class="mobile-menu" inert>
    <ul style="list-style:none;margin:0;padding:0;display:flex;flex-direction:column;gap:0.5rem;">
      {navLinks.map(link => (
        <li>
          <a href={link.href}
             aria-current={isActive(link.href) ? 'page' : undefined}
             style="color:var(--color-heading);font-weight:600;font-size:1rem;display:block;padding:0.5rem 0;border-bottom:1px solid var(--border-default);">
            {link.label}
          </a>
        </li>
      ))}
      <li style="margin-top:0.75rem;">
        <a href="#schedule" id="book-btn-mobile"
           style="display:inline-flex;background:var(--surface-inverse);color:var(--color-on-inverse);padding:0.75rem 1.75rem;border-radius:100px;font-weight:700;font-size:0.9375rem;text-decoration:none;">
          Book Consultation
        </a>
      </li>
    </ul>
  </div>
</header>

<style>
/* ── Desktop nav / hamburger visibility ────────────────── */
/* Single 1024px switch: exactly one of the two is ever displayed. */
.nav-desktop { display: none; }
.hamburger { display: flex; }
@media (min-width: 1024px) {
  .nav-desktop { display: block; }
  .hamburger { display: none; }
}

/* ── Hamburger button ──────────────────────────────────── */
.hamburger {
  background: none;
  border: none;
  cursor: pointer;
  padding: 0.4rem;
  align-items: center;
  justify-content: center;
}

.ham-top,
.ham-mid,
.ham-bot {
  transform-box: fill-box;
  transform-origin: center;
  transition: transform 0.35s cubic-bezier(0.4, 0, 0.2, 1),
              opacity   0.25s ease;
}

/* Open: top rotates to \ , mid fades, bot rotates to / */
.hamburger.is-open .ham-top {
  transform: translateY(6px) rotate(45deg);
}
.hamburger.is-open .ham-mid {
  opacity: 0;
  transform: scaleX(0);
}
.hamburger.is-open .ham-bot {
  transform: translateY(-6px) rotate(-45deg);
}

/* ── Mobile menu slide ─────────────────────────────────── */
/* Hung below the fixed header rather than sat inside it, so opening it moves
   nothing else and the slide can run on transform/opacity. The previous
   max-height + padding pair relaid out the header on every frame, and the
   480px cap would have silently clipped a longer nav. */
.mobile-menu {
  position: absolute;
  top: 100%;
  left: 0;
  right: 0;
  background: var(--surface-card);
  border-top: 1px solid var(--border-default);
  padding: 1.25rem 1.5rem;
  /* A static cap, so it costs no per-frame layout. A nav too long for the
     screen scrolls instead of being cut off. */
  max-height: 75dvh;
  overflow-y: auto;
  overscroll-behavior: contain;
  opacity: 0;
  transform: translateY(-0.5rem);
  visibility: hidden;
  transition: opacity 0.28s cubic-bezier(0.4, 0, 0.2, 1),
              transform 0.28s cubic-bezier(0.4, 0, 0.2, 1),
              visibility 0s linear 0.28s;
}
.mobile-menu.is-open {
  opacity: 1;
  transform: translateY(0);
  visibility: visible;
  /* No delay on the way in, or the menu would stay invisible for the slide */
  transition: opacity 0.28s cubic-bezier(0.4, 0, 0.2, 1),
              transform 0.28s cubic-bezier(0.4, 0, 0.2, 1),
              visibility 0s;
}

@media (prefers-reduced-motion: reduce) {
  .ham-top,
  .ham-mid,
  .ham-bot,
  .mobile-menu,
  .mobile-menu.is-open {
    transition: none;
  }
}
</style>

<script>
  const header     = document.getElementById('site-header');
  const toggle     = document.getElementById('mobile-toggle');
  const mobileMenu = document.getElementById('mobile-menu');

  window.addEventListener('scroll', () => {
    if (window.scrollY > 10) header?.classList.add('scrolled');
    else header?.classList.remove('scrolled');
  }, { passive: true });

  function setMenuOpen(open: boolean) {
    toggle?.classList.toggle('is-open', open);
    toggle?.setAttribute('aria-expanded', String(open));
    mobileMenu?.classList.toggle('is-open', open);
    // `inert` keeps the collapsed menu out of the tab order and the a11y tree
    if (open) mobileMenu?.removeAttribute('inert');
    else mobileMenu?.setAttribute('inert', '');
  }

  toggle?.addEventListener('click', () => {
    setMenuOpen(!toggle.classList.contains('is-open'));
  });

  document.getElementById('book-btn-mobile')?.addEventListener('click', () => setMenuOpen(false));

  document.addEventListener('keydown', (e) => {
    if (e.key !== 'Escape' || !toggle?.classList.contains('is-open')) return;
    setMenuOpen(false);
    toggle.focus();
  });
</script>
