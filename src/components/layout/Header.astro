---
const navLinks = [
  { href: '/',              label: 'Home' },
  { href: '/services',      label: 'Services' },
  { href: '/products',      label: 'Products' },
  { href: '/case-studies',  label: 'Case Studies' },
  { href: '/about',         label: 'About Us' },
  { href: '/blog',          label: 'Blog' },
  { href: '/contact',       label: 'Contact' },
];
const currentPath = Astro.url.pathname;
---

<header class="header" id="site-header">
  <div class="navbar">
    <a href="/" class="navbar-brand" aria-label="CloudAlgo home">
      <img src="/logo.svg" alt="CloudAlgo" width="180" height="31" />
    </a>

    <nav class="hidden lg:block">
      <ul class="nav-links">
        {navLinks.map(link => (
          <li>
            <a
              href={link.href}
              class:list={['nav-link', { active: link.href === '/' ? currentPath === '/' : currentPath.startsWith(link.href) }]}
            >
              {link.label}
            </a>
          </li>
        ))}
        <li>
          <a href="#schedule" class="nav-link join-us" id="book-btn-desktop">Book Consultation</a>
        </li>
      </ul>
    </nav>

    <!-- Animated hamburger toggle -->
    <button id="mobile-toggle" class="hamburger lg:hidden" aria-label="Toggle menu" aria-expanded="false">
      <svg width="24" height="24" viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg">
        <line class="ham-top" x1="3" y1="6"  x2="21" y2="6"  stroke="#0A0A0A" stroke-width="2" stroke-linecap="round"/>
        <line class="ham-mid" x1="3" y1="12" x2="21" y2="12" stroke="#0A0A0A" stroke-width="2" stroke-linecap="round"/>
        <line class="ham-bot" x1="3" y1="18" x2="21" y2="18" stroke="#0A0A0A" stroke-width="2" stroke-linecap="round"/>
      </svg>
    </button>
  </div>

  <!-- Mobile menu (animated slide) -->
  <div id="mobile-menu" class="mobile-menu">
    <ul style="list-style:none;margin:0;padding:0;display:flex;flex-direction:column;gap:0.5rem;">
      {navLinks.map(link => (
        <li>
          <a href={link.href}
             style="color:#0A0A0A;font-weight:600;font-size:1rem;display:block;padding:0.5rem 0;border-bottom:1px solid #E0E0DC;">
            {link.label}
          </a>
        </li>
      ))}
      <li style="margin-top:0.75rem;">
        <a href="#schedule" id="book-btn-mobile"
           style="display:inline-flex;background:#0A0A0A;color:#fff;padding:0.75rem 1.75rem;border-radius:100px;font-weight:700;font-size:0.9375rem;text-decoration:none;">
          Book Consultation
        </a>
      </li>
    </ul>
  </div>
</header>

<style>
/* ── Hamburger button ──────────────────────────────────── */
.hamburger {
  background: none;
  border: none;
  cursor: pointer;
  padding: 0.4rem;
  align-items: center;
  justify-content: center;
}
/* Only apply flex when visible (mobile) */
@media (max-width: 1023px) {
  .hamburger { display: flex; }
}

.ham-top,
.ham-mid,
.ham-bot {
  transform-box: fill-box;
  transform-origin: center;
  transition: transform 0.35s cubic-bezier(0.4, 0, 0.2, 1),
              opacity   0.25s ease;
}

/* Open: top rotates to \ , mid fades, bot rotates to / */
.hamburger.is-open .ham-top {
  transform: translateY(6px) rotate(45deg);
}
.hamburger.is-open .ham-mid {
  opacity: 0;
  transform: scaleX(0);
}
.hamburger.is-open .ham-bot {
  transform: translateY(-6px) rotate(-45deg);
}

/* ── Mobile menu slide ─────────────────────────────────── */
.mobile-menu {
  max-height: 0;
  overflow: hidden;
  background: #fff;
  border-top: 1px solid transparent;
  padding: 0 1.5rem;
  transition: max-height 0.38s cubic-bezier(0.4, 0, 0.2, 1),
              padding    0.38s cubic-bezier(0.4, 0, 0.2, 1),
              border-color 0.2s ease;
}
.mobile-menu.is-open {
  max-height: 480px;
  padding: 1.25rem 1.5rem;
  border-top-color: #E0E0DC;
}
</style>

<script>
  const header     = document.getElementById('site-header');
  const toggle     = document.getElementById('mobile-toggle');
  const mobileMenu = document.getElementById('mobile-menu');

  window.addEventListener('scroll', () => {
    if (window.scrollY > 10) header?.classList.add('scrolled');
    else header?.classList.remove('scrolled');
  });

  toggle?.addEventListener('click', () => {
    const isOpen = toggle.classList.toggle('is-open');
    toggle.setAttribute('aria-expanded', String(isOpen));
    mobileMenu?.classList.toggle('is-open', isOpen);
  });

  document.getElementById('book-btn-mobile')?.addEventListener('click', () => {
    toggle?.classList.remove('is-open');
    toggle?.setAttribute('aria-expanded', 'false');
    mobileMenu?.classList.remove('is-open');
  });
</script>
