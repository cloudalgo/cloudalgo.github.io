---
import BrandLockup from '@/components/ui/BrandLockup.astro';

// Nav set and labels follow the approved mock (.hp__nav in
// docs/superpowers/specs/assets/home-mock.html): five destinations in
// sentence case, products first. Home is the wordmark and Contact is the
// button, so neither earns a second slot in the list.
const navLinks = [
  { href: '/products',      label: 'Products' },
  { href: '/services',      label: 'Services' },
  { href: '/case-studies',  label: 'Case studies' },
  { href: '/blog',          label: 'Journal' },
  { href: '/about',         label: 'About' },
];
const currentPath = Astro.url.pathname;
const isActive = (href: string) =>
  href === '/' ? currentPath === '/' : currentPath.startsWith(href);
---

<header class="header" id="site-header">
  <div class="navbar">
    <a href="/" class="navbar-brand" aria-label="CloudAlgo home">
      <BrandLockup />
    </a>

    <nav class="nav-desktop">
      <ul class="nav-links">
        {navLinks.map(link => (
          <li>
            <a
              href={link.href}
              class:list={['nav-link', { active: isActive(link.href) }]}
              aria-current={isActive(link.href) ? 'page' : undefined}
            >
              {link.label}
            </a>
          </li>
        ))}
      </ul>
    </nav>

    <!-- The bar's right-hand slot. The CTA left the nav list when the menu
         moved to the optical centre: with the button still inside it, the
         links centred around the button rather than around themselves. The
         hamburger shares the slot so the bar stays a three-column grid at
         every width -- a fourth child would wrap to a second row. -->
    <div class="navbar-actions">
      <a href="#schedule" class="nav-link join-us" id="book-btn-desktop">Book a consultation</a>

      <!-- Animated hamburger toggle -->
      <button id="mobile-toggle" class="hamburger" aria-label="Toggle menu" aria-expanded="false" aria-controls="mobile-menu">
        <svg width="24" height="24" viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg">
          <line class="ham-top" x1="3" y1="6"  x2="21" y2="6"  stroke="var(--illus-ink)" stroke-width="2" stroke-linecap="round"/>
          <line class="ham-mid" x1="3" y1="12" x2="21" y2="12" stroke="var(--illus-ink)" stroke-width="2" stroke-linecap="round"/>
          <line class="ham-bot" x1="3" y1="18" x2="21" y2="18" stroke="var(--illus-ink)" stroke-width="2" stroke-linecap="round"/>
        </svg>
      </button>
    </div>
  </div>

  <!-- Mobile menu (animated slide) -->
  <div id="mobile-menu" class="mobile-menu" inert>
    <ul class="mobile-menu__list">
      {navLinks.map(link => (
        <li>
          <a href={link.href}
             class="mobile-menu__link"
             aria-current={isActive(link.href) ? 'page' : undefined}>
            {link.label}
          </a>
        </li>
      ))}
      <li class="mobile-menu__cta">
        <a href="#schedule" id="book-btn-mobile" class="btn btn-primary">
          Book a consultation
        </a>
      </li>
    </ul>
  </div>
</header>

<style>
/* ── Desktop nav / hamburger visibility ────────────────── */
/* Single 1024px switch: exactly one of the two is ever displayed. */
.nav-desktop { display: none; }
.hamburger { display: flex; }
/* The desktop CTA switches on the same 1024px breakpoint as the links it
   used to sit beside; below it the mobile menu carries its own. */
.navbar-actions .join-us { display: none; }
@media (min-width: 1024px) {
  .nav-desktop { display: block; }
  .hamburger { display: none; }
  .navbar-actions .join-us { display: inline-block; }
}

/* ── Hamburger button ──────────────────────────────────── */
.hamburger {
  background: none;
  border: none;
  cursor: pointer;
  padding: 0.4rem;
  align-items: center;
  justify-content: center;
}

.ham-top,
.ham-mid,
.ham-bot {
  transform-box: fill-box;
  transform-origin: center;
  transition: transform 0.35s cubic-bezier(0.4, 0, 0.2, 1),
              opacity   0.25s ease;
}

/* Open: top rotates to \ , mid fades, bot rotates to / */
.hamburger.is-open .ham-top {
  transform: translateY(6px) rotate(45deg);
}
.hamburger.is-open .ham-mid {
  opacity: 0;
  transform: scaleX(0);
}
.hamburger.is-open .ham-bot {
  transform: translateY(-6px) rotate(-45deg);
}

/* ── Mobile menu slide ─────────────────────────────────── */
/* Hung below the fixed header rather than sat inside it, so opening it moves
   nothing else and the slide can run on transform/opacity. The previous
   max-height + padding pair relaid out the header on every frame, and the
   480px cap would have silently clipped a longer nav. */
.mobile-menu {
  position: absolute;
  top: 100%;
  left: 0;
  right: 0;
  background: var(--surface-card);
  border-top: 1px solid var(--border-default);
  padding: 1.25rem 1.5rem;
  /* A static cap, so it costs no per-frame layout. A nav too long for the
     screen scrolls instead of being cut off. */
  max-height: 75dvh;
  overflow-y: auto;
  overscroll-behavior: contain;
  opacity: 0;
  transform: translateY(-0.5rem);
  visibility: hidden;
  transition: opacity 0.28s cubic-bezier(0.4, 0, 0.2, 1),
              transform 0.28s cubic-bezier(0.4, 0, 0.2, 1),
              visibility 0s linear 0.28s;
}
.mobile-menu.is-open {
  opacity: 1;
  transform: translateY(0);
  visibility: visible;
  /* No delay on the way in, or the menu would stay invisible for the slide */
  transition: opacity 0.28s cubic-bezier(0.4, 0, 0.2, 1),
              transform 0.28s cubic-bezier(0.4, 0, 0.2, 1),
              visibility 0s;
}

@media (prefers-reduced-motion: reduce) {
  .ham-top,
  .ham-mid,
  .ham-bot,
  .mobile-menu,
  .mobile-menu.is-open {
    transition: none;
  }
}
</style>

<script>
  const header     = document.getElementById('site-header');
  const toggle     = document.getElementById('mobile-toggle');
  const mobileMenu = document.getElementById('mobile-menu');

  window.addEventListener('scroll', () => {
    if (window.scrollY > 10) header?.classList.add('scrolled');
    else header?.classList.remove('scrolled');
  }, { passive: true });

  function setMenuOpen(open: boolean) {
    toggle?.classList.toggle('is-open', open);
    toggle?.setAttribute('aria-expanded', String(open));
    mobileMenu?.classList.toggle('is-open', open);
    // `inert` keeps the collapsed menu out of the tab order and the a11y tree
    if (open) mobileMenu?.removeAttribute('inert');
    else mobileMenu?.setAttribute('inert', '');
  }

  toggle?.addEventListener('click', () => {
    setMenuOpen(!toggle.classList.contains('is-open'));
  });

  document.getElementById('book-btn-mobile')?.addEventListener('click', () => setMenuOpen(false));

  document.addEventListener('keydown', (e) => {
    if (e.key !== 'Escape' || !toggle?.classList.contains('is-open')) return;
    setMenuOpen(false);
    toggle.focus();
  });
</script>
