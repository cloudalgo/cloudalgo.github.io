---
const navLinks = [
  { href: '/',         label: 'Home' },
  { href: '/services', label: 'Services' },
  { href: '/about',    label: 'About Us' },
  { href: '/blog',     label: 'Blog' },
  { href: '/contact',  label: 'Contact' },
];
const currentPath = Astro.url.pathname;
---

<header class="header" id="site-header">
  <div class="navbar">
    <a href="/" class="navbar-brand">
      CloudAlgo
    </a>

    <nav class="hidden lg:block">
      <ul class="nav-links">
        {navLinks.map(link => (
          <li>
            <a
              href={link.href}
              class:list={['nav-link', { active: link.href === '/' ? currentPath === '/' : currentPath.startsWith(link.href) }]}
            >
              {link.label}
            </a>
          </li>
        ))}
        <li>
          <a href="#schedule" class="nav-link join-us" id="book-btn-desktop">Book Consultation</a>
        </li>
      </ul>
    </nav>

    <!-- Mobile toggle -->
    <button id="mobile-toggle" class="lg:hidden" aria-label="Toggle menu"
      style="background:none;border:none;cursor:pointer;padding:0.5rem;">
      <svg width="22" height="22" viewBox="0 0 22 22" fill="none" stroke="#0A0A0A" stroke-width="2" stroke-linecap="round">
        <line x1="2" y1="5" x2="20" y2="5"/>
        <line x1="2" y1="11" x2="20" y2="11"/>
        <line x1="2" y1="17" x2="20" y2="17"/>
      </svg>
    </button>
  </div>

  <!-- Mobile menu -->
  <div id="mobile-menu" style="display:none;background:#fff;border-top:1px solid #E0E0DC;padding:1.25rem 1.5rem;">
    <ul style="list-style:none;margin:0;padding:0;display:flex;flex-direction:column;gap:0.5rem;">
      {navLinks.map(link => (
        <li>
          <a href={link.href}
             style="color:#0A0A0A;font-weight:600;font-size:1rem;display:block;padding:0.5rem 0;border-bottom:1px solid #E0E0DC;">
            {link.label}
          </a>
        </li>
      ))}
      <li style="margin-top:0.75rem;">
        <a href="#schedule" id="book-btn-mobile"
           style="display:inline-flex;background:#0A0A0A;color:#fff;padding:0.75rem 1.75rem;border-radius:100px;font-weight:700;font-size:0.9375rem;text-decoration:none;">
          Book Consultation
        </a>
      </li>
    </ul>
  </div>
</header>

<script>
  const header = document.getElementById('site-header');
  const toggle = document.getElementById('mobile-toggle');
  const mobileMenu = document.getElementById('mobile-menu');

  window.addEventListener('scroll', () => {
    if (window.scrollY > 10) header?.classList.add('scrolled');
    else header?.classList.remove('scrolled');
  });

  toggle?.addEventListener('click', () => {
    if (mobileMenu) {
      const isOpen = mobileMenu.style.display !== 'none';
      mobileMenu.style.display = isOpen ? 'none' : 'block';
    }
  });

  document.getElementById('book-btn-mobile')?.addEventListener('click', () => {
    if (mobileMenu) mobileMenu.style.display = 'none';
  });
</script>
