---
import BrandLockup from '@/components/ui/BrandLockup.astro';

// Nav set and labels follow the approved mock (.hp__nav in
// docs/superpowers/specs/assets/home-mock.html): five destinations in
// sentence case, products first. Home is the wordmark and Contact is the
// button, so neither earns a second slot in the list.
//
// `cat` is the department each destination belongs to, and it appears only
// in the mobile index (Option 01 of the menu mock), where the entries are
// set large enough to carry a second line. The desktop bar has no room for
// it and does not need it -- five words across a bar are self-evident; five
// words down a phone screen are a list, and a list wants departments.
const navLinks = [
  { href: '/products/',      label: 'Products',     cat: 'Catalogue'   },
  { href: '/services/',      label: 'Services',     cat: 'Engagements' },
  { href: '/case-studies/',  label: 'Case studies', cat: 'Evidence'    },
  { href: '/blog/',          label: 'Journal',      cat: 'Writing'     },
  { href: '/about/',         label: 'About',        cat: 'The firm'    },
];
const currentPath = Astro.url.pathname;
const isActive = (href: string) =>
  href === '/' ? currentPath === '/' : currentPath.startsWith(href);
---

<header class="header" id="site-header">
  <div class="navbar">
    <a href="/" class="navbar-brand" aria-label="CloudAlgo home">
      <BrandLockup />
    </a>

    <nav class="nav-desktop">
      <ul class="nav-links">
        {navLinks.map(link => (
          <li>
            <a
              href={link.href}
              class:list={['nav-link', { active: isActive(link.href) }]}
              aria-current={isActive(link.href) ? 'page' : undefined}
            >
              {link.label}
            </a>
          </li>
        ))}
      </ul>
    </nav>

    <!-- The bar's right-hand slot. The CTA left the nav list when the menu
         moved to the optical centre: with the button still inside it, the
         links centred around the button rather than around themselves. The
         hamburger shares the slot so the bar stays a three-column grid at
         every width -- a fourth child would wrap to a second row. -->
    <div class="navbar-actions">
      <a href="#schedule" class="nav-link join-us" id="book-btn-desktop">Book a consultation</a>

      <!-- Animated hamburger toggle -->
      <button id="mobile-toggle" class="hamburger" aria-label="Toggle menu" aria-expanded="false" aria-controls="mobile-menu">
        <svg width="24" height="24" viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg">
          <line class="ham-top" x1="3" y1="6"  x2="21" y2="6"  stroke="var(--illus-ink)" stroke-width="2" stroke-linecap="round"/>
          <line class="ham-mid" x1="3" y1="12" x2="21" y2="12" stroke="var(--illus-ink)" stroke-width="2" stroke-linecap="round"/>
          <line class="ham-bot" x1="3" y1="18" x2="21" y2="18" stroke="var(--illus-ink)" stroke-width="2" stroke-linecap="round"/>
        </svg>
      </button>
    </div>
  </div>

  <!-- The mobile index. Styles live in styles/layout/_mobile-menu.scss;
       the shape is the mock's Option 01: a ruled head, five numbered
       entries with their department, and the way out at the foot.

       `--i` carries each entry's place in the stagger. It is an index, not
       a decoration, so it is set from the loop rather than hand-written. -->
  <nav id="mobile-menu" class="mobile-menu" aria-label="Site index" inert>
    <div class="mobile-menu__head">
      <span>Contents</span>
      <span>{navLinks.length} destinations</span>
    </div>

    <ul class="mobile-menu__list">
      {navLinks.map((link, i) => (
        <li class="mobile-menu__item" style={`--i:${i}`}>
          <a
            href={link.href}
            class="mobile-menu__link"
            aria-current={isActive(link.href) ? 'page' : undefined}
          >
            <span class="mobile-menu__n">{String(i + 1).padStart(2, '0')}</span>
            <span>
              <span class="mobile-menu__label">{link.label}</span>
              <span class="mobile-menu__cat">{link.cat}</span>
            </span>
          </a>
        </li>
      ))}
    </ul>

    <div class="mobile-menu__foot">
      <span class="mobile-menu__skip">Or skip the index</span>
      <a href="#schedule" id="book-btn-mobile" class="btn btn-primary">
        Book a consultation
      </a>
    </div>
  </nav>
</header>

<style>
/* ── Desktop nav / hamburger visibility ────────────────── */
/* Single 1024px switch: exactly one of the two is ever displayed. */
.nav-desktop { display: none; }
.hamburger { display: flex; }
/* The desktop CTA switches on the same 1024px breakpoint as the links it
   used to sit beside; below it the mobile menu carries its own. */
.navbar-actions .join-us { display: none; }
@media (min-width: 1024px) {
  .nav-desktop { display: block; }
  .hamburger { display: none; }
  .navbar-actions .join-us { display: inline-block; }
}

/* ── Hamburger button ──────────────────────────────────── */
.hamburger {
  background: none;
  border: none;
  cursor: pointer;
  padding: 0.4rem;
  align-items: center;
  justify-content: center;
  position: relative;
}

/* The tap target, grown without growing the button.
   The root drops to 85% below 1200px, so this button's 0.4rem padding
   renders at 5.4px and the whole control measured 34.9px square -- the one
   control on a phone page, under the WCAG 2.5.8 floor. Sizing the button
   itself to 44px fixes the target and breaks the bar: it is the tallest
   thing in the row, so the navbar went 62.1px -> 71.2px while --header-h
   still said 4.625rem, and every offset measured off that token (the hero's
   top padding, the index's, every scroll-margin) would have been wrong by
   8px.

   So the hit area is a pseudo-element instead: rendered, so it hit-tests
   and passes the hit to the button; absolutely positioned, so it does not
   participate in layout at all. The bar keeps its height, the icon keeps
   its place, and the finger gets its 44px.

   In px, not rem, deliberately: this is a measure of a fingertip, and a
   fingertip does not get 15% smaller because the root font-size did. */
.hamburger::after {
  content: '';
  position: absolute;
  top: 50%;
  left: 50%;
  translate: -50% -50%;
  width: 44px;
  height: 44px;
}

.ham-top,
.ham-mid,
.ham-bot {
  transform-box: fill-box;
  transform-origin: center;
  transition: transform 0.35s cubic-bezier(0.4, 0, 0.2, 1),
              opacity   0.25s ease;
}

/* Open: top rotates to \ , mid fades, bot rotates to / */
.hamburger.is-open .ham-top {
  transform: translateY(6px) rotate(45deg);
}
.hamburger.is-open .ham-mid {
  opacity: 0;
  transform: scaleX(0);
}
.hamburger.is-open .ham-bot {
  transform: translateY(-6px) rotate(-45deg);
}

@media (prefers-reduced-motion: reduce) {
  .ham-top,
  .ham-mid,
  .ham-bot {
    transition: none;
  }
}
</style>

<script>
  const header     = document.getElementById('site-header');
  const toggle     = document.getElementById('mobile-toggle');
  const mobileMenu = document.getElementById('mobile-menu');

  window.addEventListener('scroll', () => {
    if (window.scrollY > 10) header?.classList.add('scrolled');
    else header?.classList.remove('scrolled');
  }, { passive: true });

  /* The index covers the screen while it is open, so the page behind it
     must not scroll under the finger. `overscroll-behavior: contain` on the
     panel stops the chain once the list is at its end; this stops the page
     moving at all. Set on <html> rather than <body> because iOS Safari
     honours it there and not always here. */
  const scrollLock = document.documentElement;

  function setMenuOpen(open: boolean) {
    toggle?.classList.toggle('is-open', open);
    toggle?.setAttribute('aria-expanded', String(open));
    mobileMenu?.classList.toggle('is-open', open);
    scrollLock.classList.toggle('menu-open', open);
    // `inert` keeps the collapsed menu out of the tab order and the a11y tree
    if (open) mobileMenu?.removeAttribute('inert');
    else mobileMenu?.setAttribute('inert', '');
  }

  toggle?.addEventListener('click', () => {
    const opening = !toggle.classList.contains('is-open');
    setMenuOpen(opening);
    // Move focus into the index on open. Without this, a keyboard user's
    // next Tab lands on whatever follows the header in the document, and
    // the menu they just opened is behind them.
    if (opening) (mobileMenu?.querySelector('a') as HTMLElement | null)?.focus();
  });

  // Any link in the index closes it. Most navigate away and the state is
  // moot, but `#schedule` is an on-page anchor -- leaving the panel open
  // over the widget it just scrolled to is the bug this prevents.
  mobileMenu?.addEventListener('click', (e) => {
    if ((e.target as HTMLElement).closest('a')) setMenuOpen(false);
  });

  document.addEventListener('keydown', (e) => {
    if (!toggle?.classList.contains('is-open')) return;

    if (e.key === 'Escape') {
      setMenuOpen(false);
      toggle.focus();
      return;
    }

    /* Focus trap. The open index is the whole screen, so Tab must not walk
       out of it into a page the user cannot see. The cycle deliberately
       includes the toggle: it is the close button while the menu is open,
       and shutting the user out of it would leave Escape as the only way
       back -- which is a keyboard trap, not a focus trap. */
    if (e.key !== 'Tab' || !mobileMenu) return;

    const focusable = [
      toggle,
      ...Array.from(mobileMenu.querySelectorAll<HTMLElement>('a[href], button:not([disabled])')),
    ];
    if (focusable.length < 2) return;

    const first = focusable[0];
    const last  = focusable[focusable.length - 1];
    const active = document.activeElement;

    if (e.shiftKey && active === first) {
      e.preventDefault();
      last.focus();
    } else if (!e.shiftKey && active === last) {
      e.preventDefault();
      first.focus();
    }
  });

  /* Above the switch the desktop nav takes over and the panel is display:
     none. A menu left open across that boundary would keep the scroll lock
     on a page whose menu is no longer visible. */
  const wide = window.matchMedia('(min-width: 1024px)');
  wide.addEventListener('change', (e) => {
    if (e.matches && toggle?.classList.contains('is-open')) setMenuOpen(false);
  });
</script>
