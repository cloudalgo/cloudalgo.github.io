---
import { getCollection, render } from 'astro:content';
import Page from '../../layouts/Page.astro';
import { getBlogIllustration } from '../../data/blog-illustrations';

export async function getStaticPaths() {
  const posts = await getCollection('blog', ({ data }) => data.published);
  return posts.map(p => ({ params: { slug: p.id }, props: { post: p } }));
}

const { post } = Astro.props;
const { Content } = await render(post);

function ordinal(n: number): string {
  const s = ['th','st','nd','rd'];
  const v = n % 100;
  return n + (s[(v-20)%10] || s[v] || s[0]);
}
const d = post.data.date;
const months = ['January','February','March','April','May','June','July','August','September','October','November','December'];
const formattedDate = `${months[d.getMonth()]} ${ordinal(d.getDate())}, ${d.getFullYear()}`;

const author      = post.data.author ?? 'CloudAlgo Team';
const authorPhoto = post.data.authorPhoto ?? '';
const authorDesig = post.data.authorDesignation ?? 'Technical Architect';
const postUrl     = `https://cloudalgo.com/blog/${post.id}`;

const illustration = getBlogIllustration(post.id);

const schema = {
  "@context": "https://schema.org",
  "@type": "Article",
  "headline": post.data.title,
  "description": post.data.excerpt,
  "datePublished": post.data.date.toISOString(),
  "author": { "@type": "Organization", "name": "CloudAlgo", "url": "https://cloudalgo.com" },
  "publisher": {
    "@type": "Organization",
    "name": "CloudAlgo",
    "logo": { "@type": "ImageObject", "url": "https://cloudalgo.com/logo.svg" }
  },
  "url": postUrl,
  "image": "https://cloudalgo.com/og-default.jpg",
  "mainEntityOfPage": { "@type": "WebPage", "@id": postUrl }
};
---
<Page
  title={`${post.data.title} — CloudAlgo Blog`}
  description={post.data.excerpt}
  ogType="article"
  publishedTime={post.data.date.toISOString()}
  author={author}
  section={post.data.category}
  {schema}
>

  <!-- ── Page header — white, matches site style ── -->
  <div class="page-header" style="padding-bottom:2.5rem;">
    <div class="container">
      <nav class="breadcrumb">
        <a href="/blog">&larr; All articles</a>
      </nav>
      <span class="blog-badges" style="margin-bottom:1rem;display:inline-block;">{post.data.category}</span>
      <h1 class="post-title" style="font-size:clamp(1.875rem,4vw,3rem);line-height:1.15;margin-bottom:1.5rem;">{post.data.title}</h1>
      <div style="display:flex;align-items:center;gap:0.875rem;flex-wrap:wrap;">
        {authorPhoto && (
          <img src={authorPhoto} alt={author}
               width="44" height="44"
               style="width:44px;height:44px;border-radius:50%;object-fit:cover;border:1.5px solid #E0E0DC;flex-shrink:0;"
               loading="eager" decoding="async" />
        )}
        <div>
          <div style="font-size:0.9375rem;font-weight:700;color:#0A0A0A;">{author}</div>
          <div style="font-size:0.8125rem;color:#5A5A5A;">
            {authorDesig} &middot; {formattedDate} &middot; {post.data.readTime} min read
          </div>
        </div>
      </div>
    </div>
  </div>

  <!-- ── Illustration hero — dark strip ── -->
  <div class="post-hero-illus">
    <div class="container">
      {illustration
        ? <div class="post-hero-svg" set:html={illustration} />
        : post.data.image
          ? <div class="post-hero-img">
              <img src={post.data.image} alt={post.data.title} loading="eager" fetchpriority="high" decoding="async" />
            </div>
          : <div class="post-hero-fallback" aria-hidden="true">
              <svg viewBox="0 0 480 160" fill="none" style="width:60%;opacity:0.15">
                <rect x="40" y="20" width="400" height="120" rx="12" stroke="#fff" stroke-width="2"/>
                <path d="M40 56 L440 56" stroke="#fff" stroke-width="2" opacity="0.5"/>
                <path d="M80 80 L360 80M80 100 L300 100M80 120 L340 120" stroke="#fff" stroke-width="2" stroke-linecap="round" opacity="0.35"/>
              </svg>
            </div>
      }
    </div>
  </div>

  <!-- ── Sticky share bar ── -->
  <div class="sticky-share" id="sticky-share" role="group" aria-label="Share this article">
    <span class="sticky-share-label">Share</span>
    <a href={`https://twitter.com/intent/tweet?url=${encodeURIComponent(postUrl)}&text=${encodeURIComponent(post.data.title)}`}
       target="_blank" rel="noopener noreferrer" class="sticky-share-btn" title="Share on X" aria-label="Share on X">
      <svg xmlns="http://www.w3.org/2000/svg" width="17" height="17" fill="none" viewBox="0 0 18 18" aria-hidden="true">
        <path stroke="currentColor" stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5"
          d="M16.5 3.008c-.75.367-1.485.516-2.25.742-.84-.949-2.087-1.001-3.285-.553C9.767 3.646 8.983 4.742 9 6v.75c-2.434.062-4.601-1.046-6-3 0 0-3.136 5.575 3 8.25-1.404.935-2.804 1.566-4.5 1.5 2.481 1.352 5.185 1.817 7.525 1.138 2.685-.78 4.892-2.793 5.739-5.807.252-.916.378-1.864.373-2.814-.002-.187 1.132-2.08 1.363-3.01z"/>
      </svg>
      <span>X / Twitter</span>
    </a>
    <a href={`https://www.linkedin.com/sharing/share-offsite/?url=${encodeURIComponent(postUrl)}`}
       target="_blank" rel="noopener noreferrer" class="sticky-share-btn" title="Share on LinkedIn" aria-label="Share on LinkedIn">
      <svg xmlns="http://www.w3.org/2000/svg" width="17" height="17" fill="none" viewBox="0 0 24 24" aria-hidden="true">
        <path stroke="currentColor" stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5"
          d="M16 8a6 6 0 0 1 6 6v7h-4v-7a2 2 0 0 0-2-2 2 2 0 0 0-2 2v7h-4v-7a6 6 0 0 1 6-6zM2 9h4v12H2z"/>
        <circle cx="4" cy="4" r="2" stroke="currentColor" stroke-width="1.5"/>
      </svg>
      <span>LinkedIn</span>
    </a>
  </div>

  <!-- ── Article content ── -->
  <section class="blog-post-details">
    <div class="container">
      <div class="blog-content">
        <Content />
      </div>

    </div>
  </section>

  <!-- ── Bottom CTA ── -->
  <section class="blog-bottom-cta">
    <div class="container">
      <div class="blog-bottom-cta-inner">
        <div class="blog-bottom-cta-text">
          <p class="blog-bottom-cta-label">Work with us</p>
          <h2 class="blog-bottom-cta-title">Have a similar challenge?</h2>
          <p class="blog-bottom-cta-sub">Tell us about your integration or data problem — we'll scope it and respond within one business day.</p>
        </div>
        <div class="blog-bottom-cta-actions">
          <a href="/contact" class="blog-bottom-cta-primary">Start a conversation &rarr;</a>
          {post.data.relatedCaseStudy
            ? <a href={`/case-studies/${post.data.relatedCaseStudy}`} class="blog-bottom-cta-secondary">See case study &rarr;</a>
            : <a href="/case-studies" class="blog-bottom-cta-secondary">See case studies</a>
          }
        </div>
      </div>
    </div>
  </section>

</Page>

<style>
/* ── Illustration hero strip ────────────────────── */
.post-hero-illus {
  background: #F0EFEB;
  padding: 3rem 0;
  border-bottom: 1px solid #E0E0DC;
}
.post-hero-svg {
  width: 100%;
  background: #fff;
  border-radius: 12px;
  border: 1px solid #E0E0DC;
  overflow: hidden;
  display: flex;
  align-items: center;
  justify-content: center;
  min-height: 200px;
  padding: 2rem;
}
.post-hero-svg svg {
  width: 100%;
  height: auto;
  max-height: 280px;
  display: block;
  margin: 0 auto;
}
.post-hero-fallback {
  background: #fff;
  border-radius: 12px;
  border: 1px solid #E0E0DC;
  display: flex;
  align-items: center;
  justify-content: center;
  min-height: 200px;
}
.post-hero-img {
  width: 100%;
  background: #fff;
  border-radius: 12px;
  border: 1px solid #E0E0DC;
  overflow: hidden;
  display: flex;
  align-items: center;
  justify-content: center;
  min-height: 200px;
}
.post-hero-img img {
  width: 100%;
  height: auto;
  max-height: 420px;
  object-fit: cover;
  display: block;
}
/* Designed SVG hero panels carry text and layout — never crop them. */
.post-hero-img img[src$=".svg"] {
  max-height: none;
  object-fit: contain;
  margin: 0 auto;
}

/* ── Content section ────────────────────────────── */
.blog-post-details {
  background: #fff;
  padding-top: 3.5rem;
  padding-bottom: 5rem;
  font-size: 1.0625rem;
}

/* ── Reading layout ──────────────────────────────
   The page chrome spans the full 1278px container so the article lines
   up with every other page. Inside it, prose is held to a ~68ch measure
   while code, tables, figures and CTA blocks break out into a wider
   band — full-width structure, book-width text. */
:global(.blog-content) {
  display: grid;
  /* ~72 characters at 18px Outfit */
  grid-template-columns: minmax(0, 1fr) min(40rem, 100%) minmax(0, 1fr);
}
:global(.blog-content > *) {
  grid-column: 2;
  min-width: 0;
}
:global(.blog-content > pre),
:global(.blog-content > table),
:global(.blog-content > figure),
:global(.blog-content > hr),
:global(.blog-content > .blog-cta-inline),
:global(.blog-content > .blog-cta-block) {
  grid-column: 1 / -1;
  width: min(100%, 920px);
  justify-self: center;
}

/* ── Prose typography ───────────────────────────── */
:global(.blog-post-details .blog-content p) {
  font-size: 1.125rem;
  line-height: 1.8;
  margin-top: 1.5rem;
  color: #1F1F1F;
  text-wrap: pretty;
}
/* Standfirst — the opening paragraph sets the entry point. */
:global(.blog-post-details .blog-content > p:first-of-type) {
  font-size: 1.3125rem;
  line-height: 1.65;
  color: #3A3A3A;
  margin-top: 0;
  margin-bottom: 0.5rem;
}
:global(.blog-post-details .blog-content h2) {
  font-size: 2rem;
  line-height: 1.2;
  margin-top: 3.75rem;
  margin-bottom: 1rem;
  scroll-margin-top: 6rem;
  text-wrap: balance;
}
:global(.blog-post-details .blog-content h3) {
  font-size: 1.3125rem;
  line-height: 1.3;
  margin-top: 2.75rem;
  margin-bottom: 0.625rem;
  scroll-margin-top: 6rem;
  text-wrap: balance;
}
:global(.blog-post-details .blog-content li) {
  font-size: 1.125rem;
  line-height: 1.75;
  color: #1F1F1F;
  margin-bottom: 0.625rem;
}
:global(.blog-post-details .blog-content li p) {
  margin-top: 0.5rem;
}

/* Prose links read as links — underlined, not colour-only. */
:global(.blog-post-details .blog-content p a),
:global(.blog-post-details .blog-content li a),
:global(.blog-post-details .blog-content td a) {
  color: var(--ca-black);
  font-weight: 600;
  text-decoration: underline;
  text-decoration-thickness: 1px;
  text-underline-offset: 3px;
  text-decoration-color: rgba(10, 10, 10, 0.35);
  transition: text-decoration-color 0.2s ease, color 0.2s ease;
}
:global(.blog-post-details .blog-content p a:hover),
:global(.blog-post-details .blog-content li a:hover),
:global(.blog-post-details .blog-content td a:hover) {
  text-decoration-color: var(--ca-black);
  text-decoration-thickness: 2px;
}
:global(.blog-post-details .blog-content a:focus-visible) {
  outline: 2px solid var(--ca-black);
  outline-offset: 3px;
  border-radius: 2px;
}

/* ── Blockquote — a pull-quote, not a shout ─────── */
:global(.blog-post-details .blog-content blockquote) {
  font-weight: 500;
  font-size: 1.1875rem;
  line-height: 1.7;
  color: #1F1F1F;
  margin: 2.75rem 0;
  padding: 1.5rem 1.75rem;
  border-radius: 0 8px 8px 0;
}
:global(.blog-post-details .blog-content blockquote p) {
  font-size: inherit;
  line-height: inherit;
  color: inherit;
  margin-top: 0;
}
:global(.blog-post-details .blog-content blockquote p + p) {
  margin-top: 1rem;
}

/* ── Inline code — monochrome, matches the palette ─ */
:global(.blog-post-details .blog-content :not(pre) > code) {
  color: #0A0A0A;
  background: #F0EFEB;
  border: 1px solid #E0E0DC;
  font-size: 0.875em;
  word-break: break-word;
}

/* ── Code blocks — line-height 1 was unreadable ──── */
:global(.blog-post-details .blog-content pre code) {
  font-size: 0.8125rem;
  line-height: 1.65;
  padding: 1rem 1.25rem;
}
/* Shiki emits a literal newline between each .line; because .line is a
   flex box those newlines form their own line boxes and double the
   spacing. Zero the container's line-height and set it per line. */
:global(.blog-post-details .blog-content pre.has-line-numbers code) {
  line-height: 0;
}
:global(.blog-post-details .blog-content pre.has-line-numbers .line) {
  line-height: 1.65;
  padding: 0;
}
:global(.blog-post-details .blog-content pre.has-line-numbers .line::before) {
  line-height: 1.65;
  font-size: 0.75rem;
}

/* ── Section divider ────────────────────────────── */
:global(.blog-post-details .blog-content hr) {
  border: 0;
  border-top: 1px solid var(--ca-border);
  margin: 3.5rem auto;
  width: min(100%, 920px);
}

/* Captions were #999 on white — below AA contrast. */
:global(.blog-post-details .blog-content figcaption) {
  color: #5A5A5A;
  font-size: 0.875rem;
}

/* ── Article title measure ──────────────────────── */
.post-title {
  max-width: 22ch;
  text-wrap: balance;
}

@media (max-width: 767px) {
  :global(.blog-post-details .blog-content p),
  :global(.blog-post-details .blog-content li) {
    font-size: 1.0625rem;
    line-height: 1.75;
  }
  :global(.blog-post-details .blog-content > p:first-of-type) { font-size: 1.1875rem; }
  :global(.blog-post-details .blog-content h2) { font-size: 1.625rem; margin-top: 2.75rem; }
  :global(.blog-post-details .blog-content h3) { font-size: 1.1875rem; margin-top: 2rem; }
  :global(.blog-post-details .blog-content blockquote) { padding: 1.25rem 1.25rem; margin: 2rem 0; }
}


/* ── Blog content — tables ─────────────────────── */
:global(.blog-content table) {
  width: 100%;
  border-collapse: collapse;
  margin: 2rem 0;
  font-size: 0.9375rem;
  overflow-x: auto;
  display: block;
}
:global(.blog-content thead) {
  border-bottom: 2px solid #0A0A0A;
}
:global(.blog-content th) {
  text-align: left;
  font-weight: 700;
  font-size: 0.75rem;
  letter-spacing: 0.06em;
  text-transform: uppercase;
  color: #5A5A5A;
  padding: 0.625rem 1rem;
  white-space: nowrap;
}
:global(.blog-content td) {
  padding: 0.75rem 1rem;
  border-bottom: 1px solid #E0E0DC;
  vertical-align: top;
  line-height: 1.65;
}
:global(.blog-content tr:last-child td) {
  border-bottom: none;
}
:global(.blog-content tbody tr:hover) {
  background: #F5F5F2;
}

/* ── Sticky share bar ───────────────────────────── */
.sticky-share {
  position: fixed;
  bottom: 1.5rem;
  left: 50%;
  transform: translateX(-50%) translateY(calc(100% + 2rem));
  z-index: 90;
  display: inline-flex;
  align-items: center;
  gap: 0.375rem;
  padding: 0.4rem 0.75rem;
  background: rgba(255, 255, 255, 0.18);
  backdrop-filter: blur(28px) saturate(180%);
  -webkit-backdrop-filter: blur(28px) saturate(180%);
  border: 1px solid rgba(255, 255, 255, 0.5);
  border-radius: 100px;
  box-shadow: 0 4px 24px rgba(0, 0, 0, 0.08);
  white-space: nowrap;
  transition: transform 0.35s cubic-bezier(0.4, 0, 0.2, 1);
}
.sticky-share.is-visible {
  transform: translateX(-50%) translateY(0);
}

/* On wide screens the share bar moves out of the reading column into the
   left gutter, so it never sits on top of the prose. */
@media (min-width: 1200px) {
  .sticky-share {
    top: 50%;
    bottom: auto;
    left: max(1.5rem, calc(50% - 639px));
    flex-direction: column;
    gap: 0.5rem;
    padding: 0.75rem 0.5rem;
    /* The rail is only ~48px wide, so a -100% slide still leaves it
       peeking on screen — park it well clear of the left edge. */
    transform: translateY(-50%) translateX(calc(-100% - 6rem));
    opacity: 0;
    transition: transform 0.35s cubic-bezier(0.4, 0, 0.2, 1), opacity 0.25s ease;
  }
  .sticky-share.is-visible {
    transform: translateY(-50%) translateX(0);
    opacity: 1;
  }
  .sticky-share-label {
    display: none;
  }
}

@media (prefers-reduced-motion: reduce) {
  .sticky-share { transition: none; }
}
.sticky-share-label {
  font-size: 0.6875rem;
  font-weight: 700;
  color: rgba(0,0,0,0.4);
  letter-spacing: 0.1em;
  text-transform: uppercase;
  padding-right: 0.25rem;
}
.sticky-share-btn {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  width: 30px;
  height: 30px;
  background: rgba(10, 10, 10, 0.75);
  color: #fff;
  border-radius: 50%;
  text-decoration: none;
  transition: background 0.2s;
}
.sticky-share-btn:hover { background: #0A0A0A; }
.sticky-share-btn span { display: none; }

/* ── Code copy button ───────────────────────────── */
:global(.code-copy-btn) {
  position: absolute;
  top: 8px;
  right: 12px;
  background: rgba(255,255,255,0.08);
  color: rgba(255,255,255,0.55);
  border: 1px solid rgba(255,255,255,0.12);
  border-radius: 6px;
  padding: 0.2rem 0.625rem;
  font-size: 0.75rem;
  font-weight: 600;
  font-family: inherit;
  cursor: pointer;
  transition: background 0.2s, color 0.2s;
  z-index: 1;
}
:global(.code-copy-btn:hover) {
  background: rgba(255,255,255,0.15);
  color: #fff;
}

/* ── Inline blog CTA block — must be :global so JS-created element gets styles ── */
:global(.blog-cta-block) {
  margin: 3rem 0 2rem;
  background: #0A0A0A;
  border-radius: 16px;
  padding: 2.5rem 2.75rem;
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 2rem;
  flex-wrap: wrap;
}
:global(.blog-cta-block h3) {
  font-size: 1.25rem;
  font-weight: 800;
  color: #fff;
  letter-spacing: -0.02em;
  margin: 0 0 0.625rem;
}
:global(.blog-cta-block p) {
  font-size: 0.9375rem;
  color: rgba(255,255,255,0.55);
  line-height: 1.7;
  margin: 0;
  max-width: 480px;
}
:global(.blog-cta-block a) {
  flex-shrink: 0;
  display: inline-flex;
  align-items: center;
  background: #fff;
  color: #0A0A0A;
  font-weight: 700;
  font-size: 0.9375rem;
  padding: 0.75rem 1.75rem;
  border-radius: 100px;
  text-decoration: none;
  transition: opacity 0.2s;
  white-space: nowrap;
}
:global(.blog-cta-block a:hover) { opacity: 0.85; }
@media (max-width: 600px) {
  :global(.blog-cta-block) { padding: 1.75rem; flex-direction: column; align-items: flex-start; }
}

/* ── End-of-post hr + p CTA callout ── */
:global(.blog-cta-inline) {
  margin: 2.5rem 0 1rem;
  background: #0A0A0A;
  border-radius: 12px;
  padding: 2rem 2.25rem;
  display: flex;
  flex-direction: column;
  gap: 1.5rem;
}
:global(.blog-cta-inline p) {
  color: rgba(255,255,255,0.75);
  font-size: 0.9375rem;
  line-height: 1.75;
  margin: 0;
}
:global(.blog-cta-inline__buttons) {
  display: flex;
  flex-wrap: wrap;
  gap: 0.75rem;
}
:global(.blog-cta-inline__buttons a) {
  display: inline-flex;
  align-items: center;
  padding: 0.625rem 1.5rem;
  border-radius: 100px;
  font-size: 0.875rem;
  font-weight: 700;
  text-decoration: none;
  white-space: nowrap;
  transition: opacity 0.2s;
}
:global(.blog-cta-inline__buttons a:first-child) {
  background: #fff;
  color: #0A0A0A;
}
:global(.blog-cta-inline__buttons a:not(:first-child)) {
  background: transparent;
  color: #fff;
  border: 1.5px solid rgba(255,255,255,0.4);
}
:global(.blog-cta-inline__buttons a:hover) { opacity: 0.8; }

/* ── Bottom CTA ── */
.blog-bottom-cta {
  background: #0A0A0A;
  padding: 4rem 0;
}
.blog-bottom-cta-inner {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 2.5rem;
  flex-wrap: wrap;
}
.blog-bottom-cta-label {
  font-size: 0.75rem;
  font-weight: 700;
  letter-spacing: 0.12em;
  text-transform: uppercase;
  color: rgba(255,255,255,0.35);
  margin-bottom: 0.625rem;
}
.blog-bottom-cta-title {
  font-size: clamp(1.625rem, 3vw, 2.25rem);
  font-weight: 900;
  letter-spacing: -0.03em;
  color: #fff;
  margin-bottom: 0.625rem;
  line-height: 1.1;
}
.blog-bottom-cta-sub {
  font-size: 0.9375rem;
  color: rgba(255,255,255,0.45);
  line-height: 1.7;
  max-width: 400px;
}
.blog-bottom-cta-actions {
  display: flex;
  flex-direction: column;
  gap: 0.75rem;
  flex-shrink: 0;
}
.blog-bottom-cta-primary {
  display: inline-flex;
  align-items: center;
  background: #fff;
  color: #0A0A0A;
  padding: 0.8rem 1.625rem;
  border-radius: 100px;
  font-weight: 700;
  font-size: 0.9375rem;
  text-decoration: none;
  transition: opacity 150ms, transform 150ms;
  white-space: nowrap;
}
.blog-bottom-cta-primary:hover { opacity: 0.88; transform: translateY(-1px); color: #0A0A0A; }
.blog-bottom-cta-secondary {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  background: transparent;
  color: rgba(255,255,255,0.55);
  padding: 0.8rem 1.625rem;
  border-radius: 100px;
  border: 1px solid rgba(255,255,255,0.2);
  font-weight: 600;
  font-size: 0.9375rem;
  text-decoration: none;
  transition: color 150ms, border-color 150ms;
  white-space: nowrap;
}
.blog-bottom-cta-secondary:hover { color: #fff; border-color: rgba(255,255,255,0.5); }
@media (max-width: 767px) {
  .blog-bottom-cta-inner { flex-direction: column; align-items: flex-start; }
  .blog-bottom-cta-actions { flex-direction: row; flex-wrap: wrap; }
}
</style>

<script>
  // Code block enhancements
  document.querySelectorAll('.blog-content pre').forEach(pre => {
    const lines = pre.querySelectorAll('.line');

    // Add dynamic line numbers + shrink empty lines
    lines.forEach((line, i) => {
      line.setAttribute('data-ln', String(i + 1));
      if ((line.textContent ?? '').trim() === '') {
        (line as HTMLElement).style.cssText = 'height:4px;min-height:0;overflow:hidden;display:block;';
      }
    });
    if (lines.length) pre.classList.add('has-line-numbers');

    // Copy button
    const btn = document.createElement('button');
    btn.className = 'code-copy-btn';
    btn.type = 'button';
    btn.setAttribute('aria-live', 'polite');
    btn.textContent = 'Copy';
    btn.addEventListener('click', () => {
      const code = Array.from(lines).map(l => l.textContent ?? '').join('\n');
      navigator.clipboard.writeText(code).then(() => {
        btn.textContent = 'Copied!';
        setTimeout(() => { btn.textContent = 'Copy'; }, 2000);
      });
    });
    pre.appendChild(btn);
  });

  // Sticky share bar — show after 300px, hide near footer
  const stickyShare = document.getElementById('sticky-share');
  const footer = document.querySelector('footer');
  function updateShareBar() {
    if (!stickyShare) return;
    const scrolled = window.scrollY > 300;
    const nearFooter = footer
      ? window.scrollY + window.innerHeight >= (footer as HTMLElement).offsetTop - 80
      : false;
    stickyShare.classList.toggle('is-visible', scrolled && !nearFooter);
  }
  window.addEventListener('scroll', updateShareBar, { passive: true });
  updateShareBar();

  // hr + p → inline CTA callout (end-of-post CTAs)
  document.querySelectorAll('.blog-content hr').forEach(hr => {
    const p = hr.nextElementSibling;
    if (!p || p.tagName !== 'P') return;
    const links = Array.from(p.querySelectorAll('a')) as HTMLAnchorElement[];
    if (!links.length) return;

    // Collect text nodes that appear before the first link
    let bodyText = '';
    for (const node of Array.from(p.childNodes)) {
      if (node.nodeType === Node.TEXT_NODE) {
        bodyText += node.textContent ?? '';
      } else if ((node as Element).tagName === 'A') {
        break;
      }
    }
    bodyText = bodyText.replace(/[,\s]+$/, '').trim();

    const wrapper = document.createElement('div');
    wrapper.className = 'blog-cta-inline';

    // Body paragraph (text before the links)
    if (bodyText) {
      const textP = document.createElement('p');
      textP.textContent = bodyText;
      wrapper.appendChild(textP);
    }

    // Buttons row
    const btns = document.createElement('div');
    btns.className = 'blog-cta-inline__buttons';
    links.forEach(a => {
      const btn = document.createElement('a');
      btn.href = a.getAttribute('href') ?? '#';
      btn.textContent = (a.textContent?.trim() ?? 'Learn more') + ' →';
      btns.appendChild(btn);
    });
    wrapper.appendChild(btns);

    hr.parentNode?.insertBefore(wrapper, hr);
    hr.remove();
    p.remove();
  });

  document.querySelectorAll('.blog-content h3').forEach(h3 => {
    const siblings: Element[] = [];
    let node = h3.nextElementSibling;
    let hasLink = false;
    while (node && node.tagName !== 'H3') {
      siblings.push(node);
      if (node.querySelector('a[href*="contact"]')) hasLink = true;
      node = node.nextElementSibling;
    }
    if (!hasLink) return;

    const wrapper = document.createElement('div');
    wrapper.className = 'blog-cta-block';

    // Left: heading + body text
    const textDiv = document.createElement('div');
    textDiv.appendChild(h3.cloneNode(true));
    siblings.forEach(s => {
      if (s.tagName !== 'P' || s.querySelector('a[href*="contact"]')) return;
      textDiv.appendChild(s.cloneNode(true));
    });
    wrapper.appendChild(textDiv);

    // Right: primary CTA button with arrow
    siblings.forEach(s => {
      const a = s.querySelector('a[href*="contact"]') as HTMLAnchorElement | null;
      if (a) {
        const clone = a.cloneNode(true) as HTMLAnchorElement;
        clone.textContent = (clone.textContent?.trim() || 'Get in touch') + ' →';
        wrapper.appendChild(clone);
      }
    });

    h3.parentNode?.insertBefore(wrapper, h3);
    h3.remove();
    siblings.forEach(s => s.remove());
  });
</script>
