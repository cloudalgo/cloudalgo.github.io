---
/**
 * One journal entry: the filed record, opened.
 *
 * `/blog/` states every entry as a dated record in an archive. This is
 * one of those records at reading size, and it keeps the archive's
 * furniture rather than inventing its own: the same masthead, the same
 * plate, the same pencil mark following the reader, the same pairing of
 * a write-up with the study it produced.
 *
 * Four folds:
 *   1. the head    -- the shared masthead, with the filing slip beside it
 *   2. the record  -- the plate, the prose, and a sticky contents rail
 *   3. the pair    -- the study on the other side, when there is one
 *   4. the close   -- the practice this entry came out of, then the
 *                     entries either side of it in the run
 *
 * The right-hand column reads as one ruled strip -- filing slip, then
 * contents -- because both draw the same edge in the same place: the
 * stand's rule runs to the foot of the head, and the rail picks it up
 * again below. That is why `.page-head--entry` stretches its grid, and
 * why the plate sits inside the document column rather than running the
 * full width and cutting the strip in half.
 *
 * Nothing on this page is written down twice. The subject, the length,
 * the byline and the plate come off the entry; the study comes off
 * `@/data/case-studies`; the practice comes off `@/data/blog-services`;
 * the contents rail is built from the entry's own h2s.
 */
import { getCollection, render } from 'astro:content';
import { organization, orgRef, breadcrumbs, abs } from '@/data/schema';
import { socialCard } from '@/build/social-cards';
import Page from '@/layouts/Page.astro';
import PageMasthead from '@/components/ui/PageMasthead.astro';
import ArchivePlate from '@/components/ui/ArchivePlate.astro';
import SubscribeBlock from '@/components/ui/SubscribeBlock.astro';
import EngagementPager from '@/components/sections/EngagementPager.astro';
import { BLOG_PLATES, plateCaption } from '@/data/blog-plates';
import { getEntryService } from '@/data/blog-services';
import { caseStudies } from '@/data/case-studies';

export async function getStaticPaths() {
  /* Newest first, the order the archive prints -- the pager walks this
     same run, so "next" means the row under this one on /blog/. */
  const posts = (await getCollection('blog', ({ data }) => data.published))
    .sort((a, b) => b.data.date.getTime() - a.data.date.getTime());

  return posts.map((post, i) => ({
    params: { slug: post.id },
    props: { post, newer: posts[i - 1], older: posts[i + 1], total: posts.length },
  }));
}

const { post, newer, older, total } = Astro.props;
const { Content, headings } = await render(post);

const stamp = (d: Date) =>
  d.toLocaleDateString('en-GB', { day: '2-digit', month: 'short', year: 'numeric' });
const shortStamp = (d: Date) =>
  d.toLocaleDateString('en-GB', { day: '2-digit', month: 'short' });

const author = post.data.author ?? 'CloudAlgo Team';
const postUrl = `https://cloudalgo.com/blog/${post.id}/`;
const length = `${post.data.readTime} minute${post.data.readTime === 1 ? '' : 's'}`;

/* The study on the other side, if this entry has one. The blog schema
   types `relatedCaseStudy` as a bare string, so nothing else checks it. */
const study = post.data.relatedCaseStudy
  ? caseStudies.find((c) => c.id === post.data.relatedCaseStudy)
  : undefined;
if (post.data.relatedCaseStudy && !study) {
  throw new Error(
    `/blog/${post.id}: names case study "${post.data.relatedCaseStudy}", which has no `
      + 'entry in src/data/case-studies.ts.'
  );
}

/* The practice this entry came out of, and the service page it routes to.
   Resolved against the collection so a map pointing nowhere fails the
   build rather than shipping a dead link at the foot of the page. */
const service = getEntryService(post.id, post.data.category);
const services = await getCollection('services');
const servicePage = services.find((s) => s.id === service.id);
if (!servicePage) {
  throw new Error(
    `/blog/${post.id}: service "${service.id}" from src/data/blog-services.ts has no `
      + 'file in src/content/services/.'
  );
}

/* The head's filing slip. "Pairs with" is only true of the entries that
   have a client behind them. */
const facts = [
  { term: 'Filed', detail: stamp(post.data.date) },
  { term: 'Subject', detail: post.data.category },
  { term: 'Length', detail: length },
  { term: 'Written by', detail: author },
  ...(study ? [{ term: 'Pairs with', detail: `Study ${study.index}` }] : []),
];

/* The contents rail. Only h2s: an entry's h3s are steps inside a section,
   and a rail that lists them stops being a place and becomes the text
   again. Entries too short to have sections get no rail. */
const toc = headings.filter((h) => h.depth === 2);

/* The enlarged plate. Sixteen entries have a picture; the six that do not
   get the integration they are about, drawn -- and the drawing gets a
   caption, because a diagram nobody can name is decoration. */
const plate = BLOG_PLATES[post.id];
const caption = plate ? plateCaption(plate) : '';

const shareText = encodeURIComponent(post.data.title);
const shareUrl = encodeURIComponent(postUrl);

/* Either end of the run has no neighbour in that direction, and the
   archive is where a reader who ran out of entries wants to go. */
const entryLink = (p: typeof post) => ({
  href: `/blog/${p.id}/`,
  n: shortStamp(p.data.date),
  name: p.data.title,
  shape: `${p.data.category} · ${p.data.readTime} min`,
});
const archiveLink = {
  href: '/blog/',
  name: 'The whole archive',
  shape: `${total} entries, newest first`,
};

/* An entry's `image` is also its Article image, and Google will only take a
   crawlable bitmap for that slot. The entries headed by a drawing name the
   bitmap the build draws from it, not the SVG the rich-result pipeline would
   reject -- the same file the social card names, by the same rule. */
const cardPath = post.data.image
  ? (socialCard(post.data.image) ?? (/\.svg$/i.test(post.data.image) ? null : post.data.image))
  : null;
const articleImage = `https://cloudalgo.com${cardPath ?? '/og-default.jpg'}`;

/* The suffix names the section, which is worth a result's space until it
   costs the headline its own words. Sixty characters is what a result
   shows; an entry whose headline already fills that keeps the headline
   and drops the suffix, because Google prints the site name beside the
   result either way. */
const head = post.data.seoTitle ?? post.data.title;
const headTitle = head.length <= 41 ? `${head} — CloudAlgo Journal` : head;
const headDescription = post.data.seoDescription ?? post.data.excerpt;

const schema = [
  {
    '@type': 'BlogPosting',
    '@id': postUrl,
    headline: post.data.title,
    description: headDescription,
    datePublished: post.data.date.toISOString(),
    /* The byline the page prints, credited to the person who wrote it. It
       used to say the author was the company, which is the one thing the
       masthead never claims. */
    author: post.data.author
      ? {
          '@type': 'Person',
          name: post.data.author,
          ...(post.data.authorDesignation ? { jobTitle: post.data.authorDesignation } : {}),
          worksFor: orgRef,
        }
      : orgRef,
    publisher: orgRef,
    url: postUrl,
    image: articleImage,
    isPartOf: { '@id': abs('/blog/') },
    inLanguage: 'en',
    timeRequired: `PT${post.data.readTime}M`,
    articleSection: post.data.category,
    mainEntityOfPage: { '@type': 'WebPage', '@id': postUrl },
  },
  organization,
  /* The same three crumbs the masthead prints, ending on the subject
     rather than the title -- a declared trail that does not match the
     rendered one is what gets the rich result dropped. */
  breadcrumbs(
    [
      { label: 'Home', href: '/' },
      { label: 'Journal', href: '/blog/' },
      { label: post.data.category },
    ],
    postUrl,
  ),
];
---
<Page
  title={headTitle}
  description={headDescription}
  image={post.data.image}
  ogType="article"
  publishedTime={post.data.date.toISOString()}
  author={author}
  section={post.data.category}
  {schema}
>
  {/* ── 1. The head ─────────────────────────────────────── */}
  <PageMasthead
    class="page-head--entry"
    crumbs={[
      { label: 'Home', href: '/' },
      { label: 'Journal', href: '/blog/' },
      { label: post.data.category },
    ]}
    facts={facts}
  >
    <Fragment slot="title">{post.data.title}</Fragment>
    <Fragment slot="lede">{post.data.excerpt}</Fragment>
  </PageMasthead>

  {/* ── 2. The record ───────────────────────────────────── */}
  <div class="record">
    <div class="record__doc">
      <figure
        class:list={[
          'plate-hero',
          plate ? 'plate-hero--drawn' : 'plate-hero--photo',
        ]}
      >
        <ArchivePlate id={post.id} image={post.data.image} size="hero" alt={post.data.title} />
        {caption && <figcaption>{caption}</figcaption>}
      </figure>

      <article class="prose">
        <Content />
        <div class="record__end">
          <span>End of entry</span>
          <span>Filed {stamp(post.data.date)} &middot; {post.data.category}</span>
        </div>
      </article>
    </div>

    <aside class="record__rail" aria-label="About this entry">
      {toc.length > 0 && (
        <nav aria-labelledby="rail-contents">
          {/* The meter carries the rail's own label as well as the count,
              so the heading is stated once. The number is set by the same
              observer that moves the pencil mark, and it counts sections
              rather than reporting a percentage -- see _record.scss. */}
          <p class="rail__meter">
            <span id="rail-contents">In this entry</span>
            <span>
              <b data-rail-n>01</b>
              <span class="rail__meter-total"> / {String(toc.length).padStart(2, '0')}</span>
            </span>
          </p>
          <ul class="rail__toc">
            {toc.map((h, i) => (
              <li>
                <a class="rail__link" href={`#${h.slug}`}>
                  <span class="rail__n">{String(i + 1).padStart(2, '0')}</span>
                  <span class="rail__t">{h.text}</span>
                </a>
              </li>
            ))}
          </ul>
        </nav>
      )}

      <div class="rail__share">
        <span class="rail__label" id="rail-share">Send it on</span>
        <p class="rail__links" aria-labelledby="rail-share">
          <a href={`https://twitter.com/intent/tweet?url=${shareUrl}&text=${shareText}`}
             target="_blank" rel="noopener noreferrer">X</a>
          <i aria-hidden="true">&middot;</i>
          <a href={`https://www.linkedin.com/sharing/share-offsite/?url=${shareUrl}`}
             target="_blank" rel="noopener noreferrer">LinkedIn</a>
          <i aria-hidden="true">&middot;</i>
          {/* An anchor, not a button: without JS it is still the link to
              this entry, which is what "copy link" was for. */}
          <a href={postUrl} data-copy-link>Copy link</a>
        </p>
      </div>
    </aside>
  </div>

  {/* ── 3. The pair ─────────────────────────────────────── */}
  {study && (
    <section class="section-press" aria-labelledby="pair-heading">
      <div class="section-press__head">
        <h2 id="pair-heading" class="section-title section-title--xs section-title--tighter section-press__title">
          The other side of this one.
        </h2>
        <span class="section-press__note">Same job, written twice</span>
      </div>

      <p class="section-press__lede">
        This entry is how it was built. The study is what it changed, and who for.
      </p>

      <ul class="pairs">
        <li class="pairs__row">
          <div class="pairs__half">
            <span class="pairs__key">This entry &mdash; how it was built</span>
            <span class="pairs__title">{post.data.title}</span>
            <span class="pairs__foot">
              {post.data.category} &middot; {length} &middot; {stamp(post.data.date)}
            </span>
          </div>
          <span class="pairs__arrow" aria-hidden="true">&rarr;</span>
          <div class="pairs__half">
            <span class="pairs__key">The study &mdash; what it changed</span>
            <a class="pairs__title" href={`/case-studies/${study.id}/`}>
              <span class="pairs__n">{study.index}</span>{study.detailTitle}
            </a>
            <span class="pairs__foot">
              {study.ledger.client} &middot; {study.ledger.when} &middot;
              {' '}{study.metric} {study.ledger.figLabel}
            </span>
          </div>
        </li>
      </ul>
    </section>
  )}

  {/* ── 4. The close ────────────────────────────────────── */}
  <section class="entry-close" aria-labelledby="close-heading">
    <div class="entry-close__inner">
      <div class="entry-close__body">
        <p class="entry-close__kicker">{servicePage.data.title}</p>
        <h2 id="close-heading" class="entry-close__title">This is the work, not the write-up.</h2>
        <p class="entry-close__note">
          Every entry in the journal came out of a build. This one was done under
          {' '}{servicePage.data.shortTitle.toLowerCase()} &mdash; {service.does}.
        </p>
        <div class="btn-row entry-close__actions">
          <a class="btn btn-light" href={`/services/${servicePage.id}/`}>See the service &rarr;</a>
          <a class="btn btn-ghost-inverse" href="/contact/">Book a consultation</a>
        </div>
      </div>
      <dl class="entry-close__slip">
        <div><dt>Filed under</dt><dd>{post.data.category}</dd></div>
        <div><dt>Practice</dt><dd>{servicePage.data.shortTitle}</dd></div>
        {study && <div><dt>Evidence</dt><dd>Study {study.index}</dd></div>}
      </dl>
    </div>
  </section>

  <SubscribeBlock source={`blog:${post.id}`} />

  <EngagementPager
    prev={newer ? entryLink(newer) : archiveLink}
    next={older ? entryLink(older) : archiveLink}
  />
</Page>

<script>
  /* The rail follows the reader.
     The entry's h2s are measured against a reading line a little above
     the middle of the viewport; the last one to have passed it is the
     section you are in, and the pencil mark moves to its row. The mark
     is the archive's, kept: on the index it followed the pointer down
     the run, here it follows the reader down the entry. */
  const links = [...document.querySelectorAll<HTMLAnchorElement>('.rail__link')];
  /* `getElementById`, not `querySelector('#' + id)`. A heading that opens
     with a numeral -- "1. You need an external id" -- slugs to an id that
     opens with one too, and an id is free to do that while a CSS selector
     is not: `#1-you-need...` is a parse error, and querySelector THROWS on
     it. Thrown here it took the whole module with it, so on those entries
     the rail, the listen bar and every copy button were simply absent.
     getElementById takes a plain string and never parses. */
  const sections = links
    .map((a) => document.getElementById(decodeURIComponent(a.hash.slice(1))))
    .filter((el): el is HTMLElement => el instanceof HTMLElement);

  if (sections.length > 0) {
    const meter = document.querySelector<HTMLElement>('[data-rail-n]');

    /* MEASURED, NOT REMEMBERED, and that is a correction rather than a
       preference. This was an IntersectionObserver over a band, adding a
       heading to a set as it entered and dropping it as it left. An
       observer reports a CHANGE of state, though, and a heading that
       crosses the whole band between two frames never changes one: it is
       outside the band before and outside it after, so nothing is
       delivered and the set keeps an answer from further up the page.
       The everyday way to trigger that is to click a link in this very
       rail -- the jump lands you in section five with the mark still on
       section one. Reading the positions each time cannot go stale.

       The line sits at 45% of the viewport: the foot of the band the
       observer used, so the section changes at the same place it always
       did. */
    const mark = () => {
      const line = window.innerHeight * 0.45;
      let current = -1;
      sections.forEach((el, i) => {
        if (el.getBoundingClientRect().top < line) current = i;
      });
      links.forEach((a, i) => a.classList.toggle('is-here', i === current));
      /* The same fact in words, for the reader who wants a position
         rather than a place. It is driven from here rather than from a
         second watcher because two readings of one set of headings would
         eventually disagree about which section you are in. */
      if (meter) meter.textContent = String(Math.max(current, 0) + 1).padStart(2, '0');
    };

    /* Coalesced into one frame: a scroll fires far faster than the page
       can paint, and the answer only changes once per painted frame. */
    let queued = false;
    const schedule = () => {
      if (queued) return;
      queued = true;
      requestAnimationFrame(() => { queued = false; mark(); });
    };

    addEventListener('scroll', schedule, { passive: true });
    addEventListener('resize', schedule, { passive: true });
    mark();
  }

  /* Copy link. The anchor is a working link to this entry without JS;
     with it, the click copies instead and the label says so. */
  const copy = document.querySelector<HTMLAnchorElement>('[data-copy-link]');
  copy?.addEventListener('click', async (e) => {
    if (!navigator.clipboard) return;
    e.preventDefault();
    const label = copy.textContent;
    try {
      await navigator.clipboard.writeText(copy.href);
      copy.textContent = 'Copied';
    } catch {
      copy.textContent = 'Press Ctrl+C';
    }
    window.setTimeout(() => { copy.textContent = label; }, 2000);
  });

  /* Copy, on a code block.
     Added here rather than by the markdown pass that builds the bar,
     because a copy button with no clipboard behind it is a lie. The bar
     itself is worth rendering without JS -- it names the language -- and
     this is the half that is not. */
  if (navigator.clipboard) {
    for (const bar of document.querySelectorAll<HTMLElement>('.code__bar')) {
      const block = bar.parentElement?.querySelector('pre');
      if (!block) continue;
      const btn = document.createElement('button');
      btn.type = 'button';
      btn.className = 'code__copy';
      btn.textContent = 'Copy';
      btn.addEventListener('click', async () => {
        try {
          await navigator.clipboard.writeText((block.textContent ?? '').replace(/\n+$/, ''));
          btn.textContent = 'Copied';
        } catch {
          btn.textContent = 'Blocked';
        }
        window.setTimeout(() => { btn.textContent = 'Copy'; }, 2000);
      });
      bar.append(btn);
    }
  }

  /* ── Listen to the entry ───────────────────────────────
     The entry read aloud, in the browser's own voice.

     `speechSynthesis` rather than an audio file per entry: nothing to
     render, nothing to host, and it works on an entry published five
     minutes ago. The cost is a voice we do not choose -- it is whichever
     one the reader's OS ships. If pre-rendered audio ever arrives, it
     replaces this script and leaves the bar's markup and styles alone.

     The whole control is built here, so it does not exist where it
     cannot work. */
  const prose = document.querySelector<HTMLElement>('.prose');
  const rail = document.querySelector<HTMLElement>('.record__rail');
  const synth = window.speechSynthesis;

  if (prose && rail && synth) {
    const RATES = [1, 1.25, 1.5, 0.75];
    const PLAY = '<svg viewBox="0 0 14 14" aria-hidden="true"><path d="M2 0l10 7-10 7z"/></svg>';
    const PAUSE = '<svg viewBox="0 0 14 14" aria-hidden="true"><path d="M1 0h4v14H1zM9 0h4v14H9z"/></svg>';

    const bar = document.createElement('div');
    bar.className = 'listen';
    bar.innerHTML = `
      <div class="listen__top">
        <button type="button" class="listen__play" aria-label="Read this entry aloud">${PLAY}</button>
        <span class="listen__text">
          <span class="listen__title">Listen</span>
          <span class="listen__sub">00:00</span>
        </span>
        <button type="button" class="listen__rate">1&times;</button>
      </div>
      <div class="listen__track"><i></i></div>`;
    rail.prepend(bar);

    const play = bar.querySelector<HTMLButtonElement>('.listen__play')!;
    const rateBtn = bar.querySelector<HTMLButtonElement>('.listen__rate')!;
    const sub = bar.querySelector<HTMLElement>('.listen__sub')!;
    const track = bar.querySelector<HTMLElement>('.listen__track i')!;

    /* Cut the entry into sentences, once, on the first press.
       Every sentence is wrapped so it can be marked while it is spoken,
       and that costs a few hundred DOM nodes -- so a reader who never
       presses play never pays for it.

       Inline elements are not split. A sentence running through a link
       comes back as two pieces carrying the SAME index, which is why the
       mark is applied to every element with the index rather than to
       one: a highlight that stopped at a link would look like a bug. */
    const BLOCK = 'p, h2, h3, li, figcaption';
    const says: string[] = [];

    const split = () => {
      if (says.length) return;
      let i = 0;
      const blocks = [...prose.querySelectorAll<HTMLElement>(BLOCK)].filter(
        /* A block holding another block is a container, not a paragraph;
           reading both would read its words twice. Code is skipped
           outright -- an Apex snippet read aloud is noise. */
        (b) => !b.querySelector(BLOCK) && !b.closest('pre, .code'),
      );

      for (const block of blocks) {
        const walker = document.createTreeWalker(block, NodeFilter.SHOW_TEXT);
        const texts: Text[] = [];
        for (let n = walker.nextNode(); n; n = walker.nextNode()) {
          if (n.nodeValue && n.nodeValue.trim()) texts.push(n as Text);
        }

        let open = false;
        for (const node of texts) {
          const parts = (node.nodeValue ?? '').match(/[^.!?]+[.!?]*\s*/g) ?? [];
          const frag = document.createDocumentFragment();
          for (const part of parts) {
            if (!open) { i += 1; says.push(''); open = true; }
            says[i - 1] += part;
            const span = document.createElement('span');
            span.dataset.say = String(i);
            span.textContent = part;
            frag.append(span);
            if (/[.!?]["')\]]?\s*$/.test(part)) open = false;
          }
          node.replaceWith(frag);
        }
      }
    };

    let at = 0;
    let playing = false;
    let began = false;
    let rate = 0;
    let ticker = 0;
    let since = 0;
    let banked = 0;

    /* Which run of the reading an utterance belongs to. Every
       `synth.cancel()` bumps it, and an utterance captures it when it is
       created, so a callback arriving from a cancelled run can tell that
       it is stale. A boolean cannot do this job: `cancel()` fires the
       outstanding utterance's `onerror` ASYNCHRONOUSLY, so a flag dropped
       and restored around the call is already back to `true` by the time
       the callback reads it, and the dead utterance advances the index --
       a sentence skipped, and two voices over each other. */
    let run = 0;

    const still = window.matchMedia('(prefers-reduced-motion: reduce)');

    const clear = () => {
      for (const el of prose.querySelectorAll('.is-speaking')) el.classList.remove('is-speaking');
    };

    const mark = (n: number) => {
      clear();
      const parts = prose.querySelectorAll<HTMLElement>(`[data-say="${n}"]`);
      parts.forEach((el) => el.classList.add('is-speaking'));
      track.style.width = `${Math.round((n / says.length) * 100)}%`;

      /* Follow along, but only when the sentence has left the window.
         Scrolling on every sentence would take the page away from a
         reader who is following the text with their eyes. */
      const first = parts[0];
      if (!first) return;
      const box = first.getBoundingClientRect();
      if (box.top > 0 && box.bottom < window.innerHeight) return;
      first.scrollIntoView({ block: 'center', behavior: still.matches ? 'auto' : 'smooth' });
    };

    const tick = () => {
      const secs = Math.floor((banked + (playing ? Date.now() - since : 0)) / 1000);
      const pad = (n: number) => String(n).padStart(2, '0');
      sub.textContent = `${pad(Math.floor(secs / 60))}:${pad(secs % 60)}`;
    };

    const say = () => {
      /* Skip whitespace-only runs without speaking them; the indices have
         to stay aligned with the spans, so nothing is filtered out of the
         list, only passed over. */
      while (at < says.length && !says[at].trim()) at += 1;
      if (at >= says.length) { done(); return; }

      const u = new SpeechSynthesisUtterance(says[at]);
      const mine = run;
      u.rate = RATES[rate];
      u.onstart = () => { if (mine === run) mark(at + 1); };
      const next = () => { if (mine === run && playing) { at += 1; say(); } };
      u.onend = next;
      u.onerror = next;
      synth.speak(u);
    };

    const beat = () => {
      ticker = window.setInterval(() => {
        tick();
        /* Chrome stops speaking after about fifteen seconds unless
           something pokes it. `resume()` on a synth that is not paused is
           a no-op, so this is safe to run every second. */
        synth.resume();
      }, 1000);
    };

    const showPlay = (label: string) => {
      play.innerHTML = PLAY;
      play.setAttribute('aria-label', label);
    };

    const hold = () => {
      playing = false;
      banked += Date.now() - since;
      window.clearInterval(ticker);
      synth.pause();
      showPlay('Resume reading');
    };

    /* `finished` is the difference between the end of the entry and a
       stop, and only the track can tell them apart: a read that ran out
       of sentences leaves it full, a read that was stopped empties it and
       puts the clock back to zero. Everything else about the two is the
       same -- the bar goes back to Play, and no state survives. */
    const done = (finished = true) => {
      playing = false;
      began = false;
      at = 0;
      banked = 0;
      run += 1;
      window.clearInterval(ticker);
      synth.cancel();
      clear();
      track.style.width = finished ? '100%' : '0%';
      if (!finished) tick();
      showPlay('Read this entry aloud');
    };

    play.addEventListener('click', () => {
      if (playing) { hold(); return; }

      play.innerHTML = PAUSE;
      play.setAttribute('aria-label', 'Pause reading');
      playing = true;
      since = Date.now();
      beat();

      if (began) { synth.resume(); return; }
      split();
      began = true;
      banked = 0;
      at = 0;
      track.style.width = '0%';
      say();
    });

    /* The label carries the speed, because the button's visible text IS
       the speed and an `aria-label` REPLACES that text rather than adding
       to it. Labelled only "Reading speed", the one control whose whole
       job is to report the current rate would announce everything about
       itself except the rate. */
    const showRate = () => {
      rateBtn.textContent = `${RATES[rate]}×`;
      rateBtn.setAttribute('aria-label', `Reading speed, ${RATES[rate]} times`);
    };
    showRate();

    rateBtn.addEventListener('click', () => {
      rate = (rate + 1) % RATES.length;
      showRate();
      /* An utterance's rate is fixed once it is speaking, so the current
         sentence is cancelled and started again at the new speed. The
         cancel is what `run` exists for: it will fire the outstanding
         utterance's `onerror`, after this handler has returned, and
         without the bump that callback would advance past the sentence
         we are restarting. */
      if (!playing) return;
      run += 1;
      synth.cancel();
      say();
    });

    /* Speech outlives the page in several browsers: leave the entry mid
       sentence and it keeps reading into whatever you opened next. So the
       reading is stopped on the way out -- and stopped THROUGH `done`,
       because a bare `cancel()` silences the voice while leaving a bar
       that still says Pause and a track still part-full. A page restored
       from the back/forward cache is not reloaded and its script does not
       run again, so the reader would come back to a paused-looking
       control over silence; `pageshow` puts it right for the case where
       the browser restored a page `pagehide` had already reset. */
    window.addEventListener('pagehide', () => done(false));
    window.addEventListener('pageshow', (e) => { if (e.persisted) done(false); });
  }
</script>
