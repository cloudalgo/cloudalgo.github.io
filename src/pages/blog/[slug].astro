---
/**
 * One journal entry: the filed record, opened.
 *
 * `/blog/` states every entry as a dated record in an archive. This is
 * one of those records at reading size, and it keeps the archive's
 * furniture rather than inventing its own: the same masthead, the same
 * plate, the same pencil mark following the reader, the same pairing of
 * a write-up with the study it produced.
 *
 * Four folds:
 *   1. the head    -- the shared masthead, with the filing slip beside it
 *   2. the record  -- the plate, the prose, and a sticky contents rail
 *   3. the pair    -- the study on the other side, when there is one
 *   4. the close   -- the practice this entry came out of, then the
 *                     entries either side of it in the run
 *
 * The right-hand column reads as one ruled strip -- filing slip, then
 * contents -- because both draw the same edge in the same place: the
 * stand's rule runs to the foot of the head, and the rail picks it up
 * again below. That is why `.page-head--entry` stretches its grid, and
 * why the plate sits inside the document column rather than running the
 * full width and cutting the strip in half.
 *
 * Nothing on this page is written down twice. The subject, the length,
 * the byline and the plate come off the entry; the study comes off
 * `@/data/case-studies`; the practice comes off `@/data/blog-services`;
 * the contents rail is built from the entry's own h2s.
 */
import { getCollection, render } from 'astro:content';
import Page from '@/layouts/Page.astro';
import PageMasthead from '@/components/ui/PageMasthead.astro';
import ArchivePlate from '@/components/ui/ArchivePlate.astro';
import EngagementPager from '@/components/sections/EngagementPager.astro';
import { BLOG_PLATES, plateCaption } from '@/data/blog-plates';
import { getEntryService } from '@/data/blog-services';
import { caseStudies } from '@/data/case-studies';

export async function getStaticPaths() {
  /* Newest first, the order the archive prints -- the pager walks this
     same run, so "next" means the row under this one on /blog/. */
  const posts = (await getCollection('blog', ({ data }) => data.published))
    .sort((a, b) => b.data.date.getTime() - a.data.date.getTime());

  return posts.map((post, i) => ({
    params: { slug: post.id },
    props: { post, newer: posts[i - 1], older: posts[i + 1], total: posts.length },
  }));
}

const { post, newer, older, total } = Astro.props;
const { Content, headings } = await render(post);

const stamp = (d: Date) =>
  d.toLocaleDateString('en-GB', { day: '2-digit', month: 'short', year: 'numeric' });
const shortStamp = (d: Date) =>
  d.toLocaleDateString('en-GB', { day: '2-digit', month: 'short' });

const author = post.data.author ?? 'CloudAlgo Team';
const postUrl = `https://cloudalgo.com/blog/${post.id}/`;
const length = `${post.data.readTime} minute${post.data.readTime === 1 ? '' : 's'}`;

/* The study on the other side, if this entry has one. The blog schema
   types `relatedCaseStudy` as a bare string, so nothing else checks it. */
const study = post.data.relatedCaseStudy
  ? caseStudies.find((c) => c.id === post.data.relatedCaseStudy)
  : undefined;
if (post.data.relatedCaseStudy && !study) {
  throw new Error(
    `/blog/${post.id}: names case study "${post.data.relatedCaseStudy}", which has no `
      + 'entry in src/data/case-studies.ts.'
  );
}

/* The practice this entry came out of, and the service page it routes to.
   Resolved against the collection so a map pointing nowhere fails the
   build rather than shipping a dead link at the foot of the page. */
const service = getEntryService(post.id, post.data.category);
const services = await getCollection('services');
const servicePage = services.find((s) => s.id === service.id);
if (!servicePage) {
  throw new Error(
    `/blog/${post.id}: service "${service.id}" from src/data/blog-services.ts has no `
      + 'file in src/content/services/.'
  );
}

/* The head's filing slip. "Pairs with" is only true of the entries that
   have a client behind them. */
const facts = [
  { term: 'Filed', detail: stamp(post.data.date) },
  { term: 'Subject', detail: post.data.category },
  { term: 'Length', detail: length },
  { term: 'Written by', detail: author },
  ...(study ? [{ term: 'Pairs with', detail: `Study ${study.index}` }] : []),
];

/* The contents rail. Only h2s: an entry's h3s are steps inside a section,
   and a rail that lists them stops being a place and becomes the text
   again. Entries too short to have sections get no rail. */
const toc = headings.filter((h) => h.depth === 2);

/* The enlarged plate. Sixteen entries have a picture; the six that do not
   get the integration they are about, drawn -- and the drawing gets a
   caption, because a diagram nobody can name is decoration. */
const plate = BLOG_PLATES[post.id];
const caption = plate ? plateCaption(plate) : '';

const shareText = encodeURIComponent(post.data.title);
const shareUrl = encodeURIComponent(postUrl);

/* Either end of the run has no neighbour in that direction, and the
   archive is where a reader who ran out of entries wants to go. */
const entryLink = (p: typeof post) => ({
  href: `/blog/${p.id}/`,
  n: shortStamp(p.data.date),
  name: p.data.title,
  shape: `${p.data.category} · ${p.data.readTime} min`,
});
const archiveLink = {
  href: '/blog/',
  name: 'The whole archive',
  shape: `${total} entries, newest first`,
};

const schema = {
  '@context': 'https://schema.org',
  '@type': 'Article',
  headline: post.data.title,
  description: post.data.excerpt,
  datePublished: post.data.date.toISOString(),
  author: { '@type': 'Organization', name: 'CloudAlgo', url: 'https://cloudalgo.com' },
  publisher: {
    '@type': 'Organization',
    name: 'CloudAlgo',
    logo: { '@type': 'ImageObject', url: 'https://cloudalgo.com/logo.svg' },
  },
  url: postUrl,
  image: post.data.image
    ? `https://cloudalgo.com${post.data.image}`
    : 'https://cloudalgo.com/og-default.jpg',
  mainEntityOfPage: { '@type': 'WebPage', '@id': postUrl },
};
---
<Page
  title={`${post.data.title} — CloudAlgo Journal`}
  description={post.data.excerpt}
  image={post.data.image}
  ogType="article"
  publishedTime={post.data.date.toISOString()}
  author={author}
  section={post.data.category}
  {schema}
>
  {/* ── 1. The head ─────────────────────────────────────── */}
  <PageMasthead
    class="page-head--entry anim-fade-up"
    crumbs={[
      { label: 'Home', href: '/' },
      { label: 'Journal', href: '/blog/' },
      { label: post.data.category },
    ]}
    facts={facts}
  >
    <Fragment slot="title">{post.data.title}</Fragment>
    <Fragment slot="lede">{post.data.excerpt}</Fragment>
  </PageMasthead>

  {/* ── 2. The record ───────────────────────────────────── */}
  <div class="record">
    <div class="record__doc">
      <figure
        class:list={[
          'plate-hero',
          'anim-fade-up',
          plate ? 'plate-hero--drawn' : 'plate-hero--photo',
        ]}
      >
        <ArchivePlate id={post.id} image={post.data.image} size="hero" alt={post.data.title} />
        {caption && <figcaption>{caption}</figcaption>}
      </figure>

      <article class="prose anim-fade-up">
        <Content />
        <div class="record__end">
          <span>End of entry</span>
          <span>Filed {stamp(post.data.date)} &middot; {post.data.category}</span>
        </div>
      </article>
    </div>

    <aside class="record__rail" aria-label="About this entry">
      {toc.length > 0 && (
        <nav aria-labelledby="rail-contents">
          <span class="rail__label" id="rail-contents">In this entry</span>
          <ul class="rail__toc">
            {toc.map((h, i) => (
              <li>
                <a class="rail__link" href={`#${h.slug}`}>
                  <span class="rail__n">{String(i + 1).padStart(2, '0')}</span>
                  <span class="rail__t">{h.text}</span>
                </a>
              </li>
            ))}
          </ul>
        </nav>
      )}

      <div class="rail__share">
        <span class="rail__label" id="rail-share">Send it on</span>
        <p class="rail__links" aria-labelledby="rail-share">
          <a href={`https://twitter.com/intent/tweet?url=${shareUrl}&text=${shareText}`}
             target="_blank" rel="noopener noreferrer">X</a>
          <i aria-hidden="true">&middot;</i>
          <a href={`https://www.linkedin.com/sharing/share-offsite/?url=${shareUrl}`}
             target="_blank" rel="noopener noreferrer">LinkedIn</a>
          <i aria-hidden="true">&middot;</i>
          {/* An anchor, not a button: without JS it is still the link to
              this entry, which is what "copy link" was for. */}
          <a href={postUrl} data-copy-link>Copy link</a>
        </p>
      </div>
    </aside>
  </div>

  {/* ── 3. The pair ─────────────────────────────────────── */}
  {study && (
    <section class="section-press" aria-labelledby="pair-heading">
      <div class="section-press__head anim-fade-up">
        <h2 id="pair-heading" class="section-title section-title--xs section-title--tighter section-press__title">
          The other side of this one.
        </h2>
        <span class="section-press__note">Same job, written twice</span>
      </div>

      <p class="section-press__lede anim-fade-up">
        This entry is how it was built. The study is what it changed, and who for.
      </p>

      <ul class="pairs anim-fade-up">
        <li class="pairs__row">
          <div class="pairs__half">
            <span class="pairs__key">This entry &mdash; how it was built</span>
            <span class="pairs__title">{post.data.title}</span>
            <span class="pairs__foot">
              {post.data.category} &middot; {length} &middot; {stamp(post.data.date)}
            </span>
          </div>
          <span class="pairs__arrow" aria-hidden="true">&rarr;</span>
          <div class="pairs__half">
            <span class="pairs__key">The study &mdash; what it changed</span>
            <a class="pairs__title" href={`/case-studies/${study.id}/`}>
              <span class="pairs__n">{study.index}</span>{study.detailTitle}
            </a>
            <span class="pairs__foot">
              {study.ledger.client} &middot; {study.ledger.when} &middot;
              {' '}{study.metric} {study.ledger.figLabel}
            </span>
          </div>
        </li>
      </ul>
    </section>
  )}

  {/* ── 4. The close ────────────────────────────────────── */}
  <section class="entry-close anim-fade-up" aria-labelledby="close-heading">
    <div class="entry-close__inner">
      <div class="entry-close__body">
        <p class="entry-close__kicker">{servicePage.data.title}</p>
        <h2 id="close-heading" class="entry-close__title">This is the work, not the write-up.</h2>
        <p class="entry-close__note">
          Every entry in the journal came out of a build. This one was done under
          {' '}{servicePage.data.shortTitle.toLowerCase()} &mdash; {service.does}.
        </p>
        <div class="btn-row entry-close__actions">
          <a class="btn btn-light" href={`/services/${servicePage.id}/`}>See the service &rarr;</a>
          <a class="btn btn-ghost-inverse" href="/contact/">Book a consultation</a>
        </div>
      </div>
      <dl class="entry-close__slip">
        <div><dt>Filed under</dt><dd>{post.data.category}</dd></div>
        <div><dt>Practice</dt><dd>{servicePage.data.shortTitle}</dd></div>
        {study && <div><dt>Evidence</dt><dd>Study {study.index}</dd></div>}
      </dl>
    </div>
  </section>

  <EngagementPager
    class="anim-fade-up"
    prev={newer ? entryLink(newer) : archiveLink}
    next={older ? entryLink(older) : archiveLink}
  />
</Page>

<script>
  /* The rail follows the reader.
     One observer over the entry's h2s marks the section currently under
     the top of the viewport, and the pencil mark moves to its row. The
     mark is the archive's, kept: on the index it followed the pointer
     down the run, here it follows the reader down the entry. */
  const links = [...document.querySelectorAll<HTMLAnchorElement>('.rail__link')];
  const sections = links
    .map((a) => document.querySelector(a.hash))
    .filter((el): el is Element => el instanceof Element);

  if (sections.length > 0) {
    const seen = new Set<Element>();

    const mark = () => {
      /* The last section whose head has passed the reading line, so a
         long section stays marked all the way down rather than clearing
         the moment its heading scrolls away. */
      let current = -1;
      sections.forEach((el, i) => {
        if (seen.has(el)) current = i;
      });
      links.forEach((a, i) => a.classList.toggle('is-here', i === current));
    };

    const io = new IntersectionObserver(
      (entries) => {
        for (const e of entries) {
          if (e.boundingClientRect.top < 0 || e.isIntersecting) seen.add(e.target);
          else seen.delete(e.target);
        }
        mark();
      },
      /* The reading line: a band from just under the fixed header down to
         the middle of the viewport. */
      { rootMargin: '-15% 0px -55% 0px', threshold: 0 }
    );
    sections.forEach((el) => io.observe(el));
  }

  /* Copy link. The anchor is a working link to this entry without JS;
     with it, the click copies instead and the label says so. */
  const copy = document.querySelector<HTMLAnchorElement>('[data-copy-link]');
  copy?.addEventListener('click', async (e) => {
    if (!navigator.clipboard) return;
    e.preventDefault();
    const label = copy.textContent;
    try {
      await navigator.clipboard.writeText(copy.href);
      copy.textContent = 'Copied';
    } catch {
      copy.textContent = 'Press Ctrl+C';
    }
    window.setTimeout(() => { copy.textContent = label; }, 2000);
  });
</script>
