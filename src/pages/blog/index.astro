---
import { getCollection } from 'astro:content';
import Page from '../../layouts/Page.astro';
import BlogCard from '../../components/ui/BlogCard.astro';
import { getBlogIllustration } from '../../data/blog-illustrations';

const allPublished = (await getCollection('blog', ({ data }) => data.published))
  .sort((a, b) => b.data.date.getTime() - a.data.date.getTime());

const featuredPost = allPublished.find(p => p.data.featured === 'editors-pick') ?? allPublished[0];
const otherPosts   = allPublished.filter(p => p !== featuredPost);

const featuredIllustration = featuredPost ? getBlogIllustration(featuredPost.id) : '';

const categories = ['All', ...Array.from(new Set(allPublished.map(p => p.data.category)))];

const formatDate = (d: Date) =>
  d.toLocaleDateString('en-US', { month: 'short', day: 'numeric', year: 'numeric' });
---
<Page
  title="Blog — Salesforce & Heroku Insights | CloudAlgo"
  description="Technical articles on Salesforce development, Heroku architecture, MuleSoft integration, and AWS from CloudAlgo's certified consultants."
>

  <!-- Page header — two-column: text left, paper plane animation right -->
  <div class="page-header">
    <div class="container blog-header-layout">

      <!-- Text block — plane is absolute so does not shrink this -->
      <div class="blog-header-text">
        <nav class="breadcrumb">
          <a href="/">Home</a><span>&rarr;</span><span>Blog</span>
        </nav>
        <h1>From the team</h1>
        <p>Technical deep-dives on Salesforce, Heroku, MuleSoft, Airflow, and AWS from engineers who build with them every day.</p>
      </div>

      <!-- Animation panel — absolutely positioned, zero effect on flow -->
      <div class="blog-header-plane" aria-hidden="true">
        <svg viewBox="0 0 340 270" fill="none" xmlns="http://www.w3.org/2000/svg" class="plane-svg">
          <defs>
            <clipPath id="ca-blog-scene-clip">
              <rect width="340" height="270"/>
            </clipPath>
            <clipPath id="ca-blog-spine-clip">
              <path d="M30 102 L318 128 L30 152 Z"/>
            </clipPath>
            <!-- Gradient mask: fades lines in from right edge, out to left edge -->
            <linearGradient id="ca-blog-line-fade" x1="0" y1="0" x2="340" y2="0" gradientUnits="userSpaceOnUse">
              <stop offset="0%"   stop-color="white" stop-opacity="0"/>
              <stop offset="18%"  stop-color="white" stop-opacity="1"/>
              <stop offset="82%"  stop-color="white" stop-opacity="1"/>
              <stop offset="100%" stop-color="white" stop-opacity="0"/>
            </linearGradient>
            <mask id="ca-blog-line-mask" maskUnits="userSpaceOnUse">
              <rect x="0" y="0" width="340" height="270" fill="url(#ca-blog-line-fade)"/>
            </mask>
          </defs>

          <!-- Sky elements clipped to SVG bounds -->
          <g clip-path="url(#ca-blog-scene-clip)">

            <!-- Horizontal dashes — 2× wide group, scrolls −340px for seamless loop -->
            <!-- Gradient mask fades them in from right, out to left -->
            <g class="blog-lines-stream" mask="url(#ca-blog-line-mask)">
              <!-- Set A: x 0–340 -->
              <line x1="32"  y1="90"  x2="72"  y2="90"  stroke="#0A0A0A" stroke-width="1.2" stroke-linecap="round" opacity="0.5"/>
              <line x1="162" y1="106" x2="197" y2="106" stroke="#0A0A0A" stroke-width="1"   stroke-linecap="round" opacity="0.45"/>
              <line x1="258" y1="118" x2="300" y2="118" stroke="#0A0A0A" stroke-width="1.2" stroke-linecap="round" opacity="0.5"/>
              <line x1="80"  y1="134" x2="116" y2="134" stroke="#0A0A0A" stroke-width="1"   stroke-linecap="round" opacity="0.45"/>
              <line x1="218" y1="150" x2="255" y2="150" stroke="#0A0A0A" stroke-width="1.2" stroke-linecap="round" opacity="0.5"/>
              <line x1="46"  y1="164" x2="84"  y2="164" stroke="#0A0A0A" stroke-width="1"   stroke-linecap="round" opacity="0.45"/>
              <line x1="142" y1="178" x2="180" y2="178" stroke="#0A0A0A" stroke-width="1.2" stroke-linecap="round" opacity="0.5"/>
              <line x1="292" y1="190" x2="332" y2="190" stroke="#0A0A0A" stroke-width="1"   stroke-linecap="round" opacity="0.45"/>
              <!-- Set B: x 340–680 (identical, offset by 340 for seamless loop) -->
              <line x1="372" y1="90"  x2="412" y2="90"  stroke="#0A0A0A" stroke-width="1.2" stroke-linecap="round" opacity="0.5"/>
              <line x1="502" y1="106" x2="537" y2="106" stroke="#0A0A0A" stroke-width="1"   stroke-linecap="round" opacity="0.45"/>
              <line x1="598" y1="118" x2="640" y2="118" stroke="#0A0A0A" stroke-width="1.2" stroke-linecap="round" opacity="0.5"/>
              <line x1="420" y1="134" x2="456" y2="134" stroke="#0A0A0A" stroke-width="1"   stroke-linecap="round" opacity="0.45"/>
              <line x1="558" y1="150" x2="595" y2="150" stroke="#0A0A0A" stroke-width="1.2" stroke-linecap="round" opacity="0.5"/>
              <line x1="386" y1="164" x2="424" y2="164" stroke="#0A0A0A" stroke-width="1"   stroke-linecap="round" opacity="0.45"/>
              <line x1="482" y1="178" x2="520" y2="178" stroke="#0A0A0A" stroke-width="1.2" stroke-linecap="round" opacity="0.5"/>
              <line x1="632" y1="190" x2="672" y2="190" stroke="#0A0A0A" stroke-width="1"   stroke-linecap="round" opacity="0.45"/>
            </g>

            <!-- Clouds — outer g holds SVG y-position; inner g gets CSS translateX animation.
                 Separating them prevents CSS transform from wiping the SVG translate attribute. -->
            <g transform="translate(250,108)">
              <g class="blog-cloud blog-cloud-1">
                <path d="M-38,10 C-38,-2 -30,-10 -20,-10 C-18,-22 -8,-28 2,-28 C12,-28 18,-22 20,-12 C28,-12 36,-4 36,10 Z"
                      fill="white" stroke="#0A0A0A" stroke-width="1.5" stroke-linejoin="round"/>
              </g>
            </g>
            <g transform="translate(100,208)">
              <g class="blog-cloud blog-cloud-2">
                <path d="M-24,7 C-24,0 -18,-5 -11,-5 C-10,-13 -4,-18 3,-18 C10,-18 15,-13 16,-6 C22,-6 26,0 26,7 Z"
                      fill="white" stroke="#0A0A0A" stroke-width="1.2" stroke-linejoin="round"/>
              </g>
            </g>
            <g transform="translate(290,238)">
              <g class="blog-cloud blog-cloud-3">
                <path d="M-30,8 C-30,-2 -23,-8 -14,-8 C-12,-17 -5,-22 4,-22 C12,-22 18,-17 20,-9 C27,-9 32,-2 32,8 Z"
                      fill="white" stroke="#0A0A0A" stroke-width="1.3" stroke-linejoin="round"/>
              </g>
            </g>

          </g>

          <!-- Paper plane — 50% scaled, bobs gently -->
          <g class="blog-plane-group">
            <g transform="translate(170,134) scale(0.5) translate(-170,-134)">

              <!-- Face fills -->
              <path d="M22 18 L318 128 L30 102 Z"        fill="white"/>
              <path d="M30 102 L318 128 L30 152 Z"       fill="white"/>
              <path d="M30 152 L318 128 L18 250 Z"       fill="white"/>
              <path d="M22 18 L30 102 L30 152 L18 250 Z" fill="white"/>

              <!-- Vertical hatching on spine -->
              <g clip-path="url(#ca-blog-spine-clip)" opacity="0.88">
                <line x1="45"  y1="88" x2="45"  y2="168" stroke="#0A0A0A" stroke-width="1.6"/>
                <line x1="63"  y1="88" x2="63"  y2="168" stroke="#0A0A0A" stroke-width="1.6"/>
                <line x1="81"  y1="88" x2="81"  y2="168" stroke="#0A0A0A" stroke-width="1.6"/>
                <line x1="99"  y1="88" x2="99"  y2="168" stroke="#0A0A0A" stroke-width="1.6"/>
                <line x1="117" y1="88" x2="117" y2="168" stroke="#0A0A0A" stroke-width="1.6"/>
                <line x1="135" y1="88" x2="135" y2="168" stroke="#0A0A0A" stroke-width="1.6"/>
                <line x1="153" y1="88" x2="153" y2="168" stroke="#0A0A0A" stroke-width="1.6"/>
                <line x1="171" y1="88" x2="171" y2="168" stroke="#0A0A0A" stroke-width="1.6"/>
                <line x1="189" y1="88" x2="189" y2="168" stroke="#0A0A0A" stroke-width="1.6"/>
                <line x1="207" y1="88" x2="207" y2="168" stroke="#0A0A0A" stroke-width="1.6"/>
                <line x1="225" y1="88" x2="225" y2="168" stroke="#0A0A0A" stroke-width="1.6"/>
                <line x1="243" y1="88" x2="243" y2="168" stroke="#0A0A0A" stroke-width="1.6"/>
                <line x1="261" y1="88" x2="261" y2="168" stroke="#0A0A0A" stroke-width="1.6"/>
                <line x1="279" y1="88" x2="279" y2="168" stroke="#0A0A0A" stroke-width="1.6"/>
                <line x1="297" y1="88" x2="297" y2="168" stroke="#0A0A0A" stroke-width="1.6"/>
              </g>

              <!-- Outline: full silhouette with spine notch for 3-D fold look -->
              <path d="M22 18 L318 128 L18 250 L30 152 L30 102 Z"
                    stroke="#0A0A0A" stroke-width="3.5" stroke-linejoin="round" fill="none"/>
              <line x1="30" y1="102" x2="318" y2="128" stroke="#0A0A0A" stroke-width="2.5" stroke-linecap="round"/>
              <line x1="30" y1="152" x2="318" y2="128" stroke="#0A0A0A" stroke-width="2.5" stroke-linecap="round"/>

            </g>
          </g>
        </svg>
      </div>

      <!-- Filter row — lives outside the text div so border-top spans full width -->
      <div class="blog-filter-row" role="tablist" aria-label="Filter by category">
        {categories.map((cat, i) => (
          <button
            class:list={['blog-filter-btn', { 'blog-filter-btn--active': i === 0 }]}
            data-cat={cat === 'All' ? 'all' : cat}
            role="tab"
            aria-selected={i === 0 ? 'true' : 'false'}
            type="button"
          >
            {cat}
          </button>
        ))}
        <span class="blog-filter-count" id="visible-count">{allPublished.length} articles</span>
      </div>

    </div>
  </div>

  <!-- Featured post — full-width editorial card -->
  {featuredPost && (
    <section class="blog-featured-wrap">
      <div class="container">

        <a href={`/blog/${featuredPost.id}`} class="blog-featured-card" aria-label={`Read: ${featuredPost.data.title}`}>

          <!-- Left: text panel -->
          <div class="blog-featured-body">

            <div class="blog-featured-top">
              <span class="blog-featured-badge">Featured</span>
              <span class="blog-featured-cat">{featuredPost.data.category}</span>
            </div>

            <h2 class="blog-featured-title">{featuredPost.data.title}</h2>
            <p class="blog-featured-excerpt">{featuredPost.data.excerpt}</p>

            <div class="blog-featured-footer">
              <div class="blog-featured-meta">
                {featuredPost.data.authorPhoto && (
                  <img src={featuredPost.data.authorPhoto} alt={featuredPost.data.author ?? ''}
                       class="blog-featured-avatar" loading="eager" />
                )}
                <span class="blog-featured-byline">
                  {featuredPost.data.author ?? 'CloudAlgo Team'}
                  <span style="opacity:0.5"> · </span>
                  {formatDate(featuredPost.data.date)}
                  <span style="opacity:0.5"> · </span>
                  {featuredPost.data.readTime} min read
                </span>
              </div>
              <span class="blog-featured-cta">Read article →</span>
            </div>

          </div>

          <!-- Right: illustration panel -->
          <div class="blog-featured-illus-panel" aria-hidden="true">
            {featuredIllustration
              ? <div class="blog-featured-illus-svg" set:html={featuredIllustration} />
              : <div class="blog-featured-illus-empty" />
            }
          </div>

        </a>

      </div>
    </section>
  )}

  <!-- All articles grid -->
  <section class="blog-grid-wrap">
    <div class="container">
      {otherPosts.length > 0 && (
        <>
          <div class="blog-grid" id="blog-grid">
            {otherPosts.map((post, i) => (
              <div class={`blog-grid-item${i >= 9 ? ' hidden-post' : ''}`}
                   data-category={post.data.category}>
                <BlogCard
                  title={post.data.title}
                  excerpt={post.data.excerpt}
                  category={post.data.category}
                  date={post.data.date}
                  readTime={post.data.readTime}
                  slug={post.id}
                  image={post.data.image}
                  author={post.data.author}
                  authorPhoto={post.data.authorPhoto}
                  delay={Math.min(i % 3, 2) * 80}
                />
              </div>
            ))}
          </div>
          {otherPosts.length > 9 && (
            <div style="text-align:center;margin-top:3rem;">
              <button id="load-more-btn" class="btn btn-outline" type="button">
                Load more articles
              </button>
            </div>
          )}
        </>
      )}
    </div>
  </section>

</Page>

<style>
/* ── Blog hero layout — plane absolute, text+filter in normal flow ── */
.blog-header-layout {
  position: relative;
}
.blog-header-text {
  padding-right: 460px; /* reserve space on right for the absolute plane */
}
.blog-header-plane {
  position: absolute;
  right: 0;
  top: 50%;
  transform: translateY(-50%);
  width: 440px;
  pointer-events: none;
}
.plane-svg {
  width: 100%;
  height: auto;
  display: block;
  overflow: visible;
}

/* ── Plane float — 2.5s (2× speed) ───────────── */
.blog-plane-group {
  transform-box: fill-box;
  transform-origin: center center;
  animation: blog-plane-float 2.5s ease-in-out infinite;
}
@keyframes blog-plane-float {
  0%,  100% { transform: translateY(0)     rotate(0deg); }
  30%        { transform: translateY(-12px) rotate(-2deg); }
  70%        { transform: translateY(8px)   rotate(1.5deg); }
}

/* ── Lines scroll — 3.5s (2× speed) ──────────── */
.blog-lines-stream {
  animation: blog-lines-scroll 3.5s linear infinite;
}
@keyframes blog-lines-scroll {
  0%   { transform: translateX(0); }
  100% { transform: translateX(-340px); }
}

/* ── Clouds drift — all durations and delays halved ─ */
.blog-cloud-1 {
  animation: blog-cloud-drift-a 4.5s ease-in-out infinite;
  animation-fill-mode: backwards;
}
.blog-cloud-2 {
  animation: blog-cloud-drift-b 3.5s ease-in-out infinite;
  animation-delay: 1.25s;
  animation-fill-mode: backwards;
}
.blog-cloud-3 {
  animation: blog-cloud-drift-c 4.25s ease-in-out infinite;
  animation-delay: 2.5s;
  animation-fill-mode: backwards;
}
@keyframes blog-cloud-drift-a {
  0%   { transform: translateX(135px);  opacity: 0; }
  25%  { opacity: 0.85; }
  75%  { opacity: 0.85; }
  100% { transform: translateX(-295px); opacity: 0; }
}
@keyframes blog-cloud-drift-b {
  0%   { transform: translateX(270px);  opacity: 0; }
  25%  { opacity: 0.8; }
  75%  { opacity: 0.8; }
  100% { transform: translateX(-135px); opacity: 0; }
}
@keyframes blog-cloud-drift-c {
  0%   { transform: translateX(85px);   opacity: 0; }
  25%  { opacity: 0.8; }
  75%  { opacity: 0.8; }
  100% { transform: translateX(-330px); opacity: 0; }
}

@media (prefers-reduced-motion: reduce) {
  .blog-plane-group,
  .blog-lines-stream,
  .blog-cloud-1,
  .blog-cloud-2,
  .blog-cloud-3 { animation: none; }
}

/* ── Responsive ───────────────────────────────── */
@media (max-width: 991px) {
  .blog-header-text  { padding-right: 310px; }
  .blog-header-plane { width: 300px; }
}
@media (max-width: 767px) {
  .blog-header-text  { padding-right: 0; }
  .blog-header-plane { display: none; }
}

/* ── Filter row (sits inside .page-header) ──── */
.blog-filter-row {
  display: flex;
  align-items: center;
  gap: 0.25rem;
  flex-wrap: wrap;
  margin-top: 2rem;
  padding-top: 1.5rem;
  border-top: 1px solid #E0E0DC;
}
.blog-filter-btn {
  background: none;
  border: 1.5px solid #E0E0DC;
  border-radius: 100px;
  padding: 0.375rem 1rem;
  font-size: 0.875rem;
  font-weight: 600;
  color: #5A5A5A;
  cursor: pointer;
  font-family: 'Outfit', sans-serif;
  transition: all 0.2s;
  white-space: nowrap;
}
.blog-filter-btn:hover {
  color: #0A0A0A;
  border-color: #0A0A0A;
  background: #fff;
}
.blog-filter-btn--active {
  background: #0A0A0A;
  color: #fff;
  border-color: #0A0A0A;
}
.blog-filter-count {
  margin-left: auto;
  font-size: 0.8125rem;
  color: #aaa;
  font-weight: 500;
}

/* ── Featured card — split layout ───────────── */
.blog-featured-wrap {
  background: #0A0A0A;
  padding: 2.5rem 0;
  border-bottom: 1px solid #222;
}
.blog-featured-card {
  display: grid;
  grid-template-columns: 55% 45%;
  text-decoration: none;
  border-radius: 14px;
  overflow: hidden;
  min-height: 380px;
  background: #111;
  border: 1px solid rgba(255,255,255,0.08);
  transition: border-color 0.3s;
}
.blog-featured-card:hover {
  border-color: rgba(255,255,255,0.2);
}

/* Left: text panel */
.blog-featured-body {
  padding: 2.5rem;
  display: flex;
  flex-direction: column;
  justify-content: center;
  gap: 1rem;
  background: #0A0A0A;
}

/* Right: illustration panel */
.blog-featured-illus-panel {
  background: #F5F5F2;
  border-left: 1px solid #E0E0DC;
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 2rem;
  overflow: hidden;
  position: relative;
  transition: background 0.3s;
}
.blog-featured-card:hover .blog-featured-illus-panel {
  background: #efefeb;
}
.blog-featured-illus-svg {
  width: 100%;
}
.blog-featured-illus-svg svg {
  width: 100%;
  height: auto;
  opacity: 0.85;
  transition: opacity 0.4s ease, transform 0.5s ease;
}
.blog-featured-card:hover .blog-featured-illus-svg svg {
  opacity: 1;
  transform: scale(1.03);
}
.blog-featured-illus-empty {
  width: 100%;
  height: 100%;
  background: #f5f5f2;
}
.blog-featured-top {
  display: flex;
  align-items: center;
  gap: 0.625rem;
  margin-bottom: 0.25rem;
}
.blog-featured-badge {
  background: #fff;
  color: #0A0A0A;
  font-size: 0.625rem;
  font-weight: 700;
  letter-spacing: 0.1em;
  text-transform: uppercase;
  padding: 0.25rem 0.625rem;
  border-radius: 100px;
}
.blog-featured-cat {
  font-size: 0.6875rem;
  font-weight: 700;
  letter-spacing: 0.1em;
  text-transform: uppercase;
  color: rgba(255,255,255,0.65);
  border: 1px solid rgba(255,255,255,0.25);
  padding: 0.2rem 0.625rem;
  border-radius: 100px;
}
.blog-featured-title {
  font-size: clamp(1.5rem, 3vw, 2.5rem);
  font-weight: 900;
  letter-spacing: -0.03em;
  color: #fff;
  line-height: 1.15;
  margin: 0;
  max-width: 680px;
  transition: opacity 0.2s;
}
.blog-featured-card:hover .blog-featured-title { opacity: 0.85; }
.blog-featured-excerpt {
  font-size: 0.9375rem;
  color: rgba(255,255,255,0.7);
  line-height: 1.65;
  display: -webkit-box;
  -webkit-line-clamp: 2;
  -webkit-box-orient: vertical;
  overflow: hidden;
  max-width: 620px;
  margin: 0;
}
.blog-featured-footer {
  display: flex;
  align-items: center;
  justify-content: space-between;
  flex-wrap: wrap;
  gap: 1rem;
  margin-top: 0.5rem;
  padding-top: 1rem;
  border-top: 1px solid rgba(255,255,255,0.15);
}
.blog-featured-meta {
  display: flex;
  align-items: center;
  gap: 0.625rem;
}
.blog-featured-avatar {
  width: 32px;
  height: 32px;
  border-radius: 50%;
  object-fit: cover;
  border: 1.5px solid rgba(255,255,255,0.3);
  flex-shrink: 0;
}
.blog-featured-byline {
  font-size: 0.8125rem;
  color: rgba(255,255,255,0.65);
}
.blog-featured-cta {
  font-size: 0.9375rem;
  font-weight: 700;
  color: #fff;
  padding: 0.5rem 1.25rem;
  border: 1.5px solid rgba(255,255,255,0.4);
  border-radius: 100px;
  transition: background 0.2s, border-color 0.2s;
}
.blog-featured-card:hover .blog-featured-cta {
  background: rgba(255,255,255,0.12);
  border-color: rgba(255,255,255,0.7);
}

/* ── All articles grid ───────────────────────── */
.blog-grid-wrap {
  background: #F5F5F2;
  padding: 3.5rem 0 5rem;
}
.blog-grid {
  display: grid;
  grid-template-columns: repeat(2, 1fr);
  gap: 1.5rem;
}
.blog-grid-item { display: flex; }
.blog-grid-item.hidden-post { display: none; }

@media (min-width: 992px) {
  .blog-grid { grid-template-columns: repeat(3, 1fr); }
}
@media (max-width: 767px) {
  .blog-featured-card { grid-template-columns: 1fr; }
  .blog-featured-illus-panel { min-height: 200px; border-left: none; border-top: 1px solid rgba(255,255,255,0.07); }
  .blog-featured-body { padding: 1.75rem; }
  .blog-featured-title { font-size: 1.375rem; }
  .blog-grid { grid-template-columns: 1fr; }
  .blog-filter-count { display: none; }
}
</style>

<script>
// ── Category filter ──────────────────────────────────
const filterBtns = document.querySelectorAll<HTMLButtonElement>('.blog-filter-btn');
const allItems   = document.querySelectorAll<HTMLElement>('.blog-grid-item');
const countEl    = document.getElementById('visible-count');

filterBtns.forEach(btn => {
  btn.addEventListener('click', () => {
    const cat = btn.dataset.cat ?? 'all';
    filterBtns.forEach(b => {
      b.classList.remove('blog-filter-btn--active');
      b.setAttribute('aria-selected', 'false');
    });
    btn.classList.add('blog-filter-btn--active');
    btn.setAttribute('aria-selected', 'true');

    let visible = 0;
    allItems.forEach(item => {
      const match = cat === 'all' || item.dataset.category === cat;
      item.style.display = match ? 'flex' : 'none';
      if (match) visible++;
    });
    if (countEl) countEl.textContent = `${visible} article${visible !== 1 ? 's' : ''}`;
  });
});

// ── Load more ────────────────────────────────────────
document.getElementById('load-more-btn')?.addEventListener('click', function () {
  document.querySelectorAll<HTMLElement>('.hidden-post').forEach(el => {
    el.style.display = 'flex';
    el.classList.remove('hidden-post');
  });
  this.style.display = 'none';
  const total = document.querySelectorAll('.blog-grid-item').length;
  if (countEl) countEl.textContent = `${total} articles`;
});

// ── Magnetic hover on cards ──────────────────────────
document.querySelectorAll<HTMLElement>('.blog-card-thumb').forEach(thumb => {
  const raw = thumb.querySelector<HTMLElement>('.blog-card-illus, .blog-thumb-img');
  if (!raw) return;
  const el: HTMLElement = raw;

  let rafId = 0;
  let lx = 0, ly = 0;
  function lerp(a: number, b: number, t: number) { return a + (b - a) * t; }
  function spring(toX: number, toY: number) {
    function step() {
      lx = lerp(lx, toX, 0.14);
      ly = lerp(ly, toY, 0.14);
      el.style.transform = `translate(${lx}px, ${ly}px)`;
      if (Math.abs(lx - toX) > 0.05 || Math.abs(ly - toY) > 0.05)
        rafId = requestAnimationFrame(step);
      else
        el.style.transform = `translate(${toX}px, ${toY}px)`;
    }
    cancelAnimationFrame(rafId);
    rafId = requestAnimationFrame(step);
  }
  thumb.addEventListener('mousemove', (e: MouseEvent) => {
    const r = thumb.getBoundingClientRect();
    spring(((e.clientX - r.left) / r.width - 0.5) * 14,
           ((e.clientY - r.top)  / r.height - 0.5) * 10);
  });
  thumb.addEventListener('mouseleave', () => spring(0, 0));
});
</script>
