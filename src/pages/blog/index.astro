---
/**
 * The journal index, as an archive.
 *
 * A product is an object and gets a spec sheet; an engagement is a period
 * of time and gets a schedule; a case study is a change of state and gets
 * a ledger. A journal entry is a DATED RECORD, so this page is an archive:
 * one standing entry we would hand you first, then every entry on the site
 * as a ruled row in reverse chronology, broken by year and filterable by
 * subject. No cards, no excerpts, no load-more -- the whole run is here.
 *
 * Every count, date and length below is read off the collection at build
 * time rather than written down, so a twenty-third entry cannot leave the
 * stand claiming twenty-two. The case-study pairings are resolved against
 * `@/data/case-studies` and throw if one points nowhere: the blog schema
 * types `relatedCaseStudy` as a bare string, so nothing else checks it.
 */
import Page from '@/layouts/Page.astro';
import PageMasthead from '@/components/ui/PageMasthead.astro';
import ArchivePlate from '@/components/ui/ArchivePlate.astro';
import { getCollection } from 'astro:content';
import { caseStudies } from '@/data/case-studies';

const posts = (await getCollection('blog', ({ data }) => data.published))
  .sort((a, b) => b.data.date.getTime() - a.data.date.getTime());

const n = posts.length;
const minutes = posts.reduce((sum, p) => sum + p.data.readTime, 0);
const newest = posts[0];
const oldest = posts[n - 1];

/** Subjects and bylines in order of how much of the archive each carries. */
function byFrequency(values: string[]): string[] {
  const counts = new Map<string, number>();
  for (const v of values) counts.set(v, (counts.get(v) ?? 0) + 1);
  return [...counts.keys()].sort((a, b) => counts.get(b)! - counts.get(a)!);
}
const categoryCount = new Map<string, number>();
for (const p of posts) {
  categoryCount.set(p.data.category, (categoryCount.get(p.data.category) ?? 0) + 1);
}
const categories = byFrequency(posts.map((p) => p.data.category));

/* The house byline is not a person, so it is not a name in the stand. */
const authors = byFrequency(
  posts.map((p) => p.data.author ?? 'CloudAlgo Team')
).filter((a) => a !== 'CloudAlgo Team');

const stamp = (d: Date) =>
  d.toLocaleDateString('en-GB', { day: '2-digit', month: 'short', year: 'numeric' });
const monthYear = (d: Date) =>
  d.toLocaleDateString('en-GB', { month: 'long', year: 'numeric' });
const iso = (d: Date) => d.toISOString().slice(0, 10);
const year = (d: Date) => String(d.getFullYear());

/* Counts that sit inside a sentence are spelled; counts in the stand, the
   sift bar or a row stay as figures. A numeral mid-prose reads as data,
   and every one of these is read aloud as a word. */
const ONES = ('zero one two three four five six seven eight nine ten eleven twelve thirteen '
  + 'fourteen fifteen sixteen seventeen eighteen nineteen').split(' ');
const TENS = ['', '', 'twenty', 'thirty', 'forty', 'fifty', 'sixty', 'seventy', 'eighty', 'ninety'];
function words(k: number, cap = false): string {
  let s: string;
  if (k < 20) s = ONES[k];
  else if (k < 100) s = TENS[Math.floor(k / 10)] + (k % 10 ? `-${ONES[k % 10]}` : '');
  else s = String(k);
  return cap ? s[0].toUpperCase() + s.slice(1) : s;
}

/* The entries with a client on the other side, in study order. */
const studies = new Map(caseStudies.map((c) => [c.id, c]));
const paired = posts.filter((p) => p.data.relatedCaseStudy);
for (const p of paired) {
  if (!studies.has(p.data.relatedCaseStudy!)) {
    throw new Error(
      `/blog/: "${p.id}" names case study "${p.data.relatedCaseStudy}", which has no entry `
        + 'in src/data/case-studies.ts.'
    );
  }
}
paired.sort((a, b) =>
  studies.get(a.data.relatedCaseStudy!)!.index.localeCompare(
    studies.get(b.data.relatedCaseStudy!)!.index));

/* The one we would hand you first: newest of the editor's picks, else
   newest overall. */
const standing = posts.find((p) => p.data.featured === 'editors-pick') ?? newest;

/* The year headings are rendered inline with the rows, so each row knows
   whether it opens a year. */
const rows = posts.map((p, i) => ({
  post: p,
  opensYear: i === 0 || year(p.data.date) !== year(posts[i - 1].data.date),
}));
---
<Page
  title="Journal — CloudAlgo | Everything here came out of a job we were actually doing"
  description={`${n} write-ups on Salesforce, Heroku, MuleSoft and AWS integration work, newest first `
    + '— each one a problem that cost us an afternoon, and the fix that ended it.'}
>
  <PageMasthead
    crumbs={[{ label: 'Home', href: '/' }, { label: 'Journal' }]}
    facts={[
      { term: 'Entries',    detail: String(n) },
      { term: 'Newest',     detail: monthYear(newest.data.date) },
      { term: 'Oldest',     detail: monthYear(oldest.data.date) },
      { term: 'Subjects',   detail: categories.join(' · ') },
      { term: 'Written by', detail: authors.join(' · ') },
      { term: 'End to end', detail: `${minutes} minutes` },
    ]}
  >
    <Fragment slot="title">
      Everything here came out of a job we were <span class="mark mark--draw">actually doing</span>.
    </Fragment>
    <Fragment slot="lede">
      No roadmaps, no predictions, no rewriting the release notes in our own words.
      {' '}{words(n, true)} entries below, newest first &mdash; each one a problem that cost us an
      afternoon, and the fix that ended it. {words(paired.length, true)} have a client on the other
      side, and those are named.
    </Fragment>
  </PageMasthead>

  <section class="section-press" aria-labelledby="standing-heading">
    <div class="section-press__head anim-fade-up">
      <h2 id="standing-heading" class="section-title section-title--xs section-title--tighter section-press__title">
        Start here.
      </h2>
      <span class="section-press__note">The one we would hand you first</span>
    </div>

    <div class="standing anim-fade-up">
      <div class="standing__body">
        <p class="standing__meta">
          <span>{stamp(standing.data.date)}</span><i>&middot;</i>
          <span>{standing.data.category.toUpperCase()}</span><i>&middot;</i>
          <span>{standing.data.readTime} min</span>
        </p>
        <h3 class="standing__title">
          <a href={`/blog/${standing.id}/`}>{standing.data.title}</a>
        </h3>
        <p class="standing__excerpt">{standing.data.excerpt}</p>
        <a class="standing__go" href={`/blog/${standing.id}/`}>Read the entry &rarr;</a>
      </div>

      <aside class="standing__side">
        {standing.data.image && (
          <figure class="standing__fig">
            <img src={standing.data.image} alt="" width="640" height="360" loading="lazy" decoding="async" />
          </figure>
        )}
        <dl class="standing__slip">
          <div><dt>Written by</dt><dd>{standing.data.author ?? 'CloudAlgo Team'}</dd></div>
          <div><dt>Length</dt><dd>{standing.data.readTime} minutes</dd></div>
          <div><dt>Filed under</dt><dd>{standing.data.category}</dd></div>
        </dl>
      </aside>
    </div>
  </section>

  <section class="section-press" aria-labelledby="run-heading">
    <div class="section-press__head anim-fade-up">
      <h2 id="run-heading" class="section-title section-title--xs section-title--tighter section-press__title">
        The archive.
      </h2>
      <span class="section-press__note">Newest first &middot; whole run on one page</span>
    </div>

    {/* Every count here is read off the collection, so a subject with
        nothing filed under it cannot appear and the bar doubles as the
        breakdown. */}
    <div class="sift anim-fade-up" role="group" aria-label="Filter entries by subject">
      <button type="button" class="sift__btn is-on" data-cat="all" aria-pressed="true">
        All<span class="sift__n">{n}</span>
      </button>
      {categories.map((cat) => (
        <button type="button" class="sift__btn" data-cat={cat} aria-pressed="false">
          {cat}<span class="sift__n">{categoryCount.get(cat)}</span>
        </button>
      ))}
      <span class="sift__count" role="status" data-total={n}>Showing all {n}</span>
    </div>

    <div class="run anim-fade-up">
      {rows.map(({ post, opensYear }) => (
        <>
          {opensYear && (
            <p class="run__year" data-year={year(post.data.date)}>{year(post.data.date)}</p>
          )}
          <a
            class="run__row"
            href={`/blog/${post.id}/`}
            data-cat={post.data.category}
            data-year={year(post.data.date)}
          >
            <ArchivePlate id={post.id} image={post.data.image} />
            <time class="run__date" datetime={iso(post.data.date)}>{stamp(post.data.date)}</time>
            <span class="run__cat">{post.data.category}</span>
            <span class="run__title">
              {post.data.title}
              {post.data.relatedCaseStudy && (
                <span class="run__mark">
                  case study {studies.get(post.data.relatedCaseStudy)!.index}
                </span>
              )}
            </span>
            <span class="run__len">{post.data.readTime} min</span>
          </a>
        </>
      ))}
    </div>

    <p class="run__none" hidden>Nothing filed under that subject yet.</p>
  </section>

  <section class="section-press" aria-labelledby="pairs-heading">
    <div class="section-press__head anim-fade-up">
      <h2 id="pairs-heading" class="section-title section-title--xs section-title--tighter section-press__title">
        {words(paired.length, true)} of them have a client behind them.
      </h2>
      <span class="section-press__note">The write-up, and the outcome it produced</span>
    </div>

    <ul class="pairs anim-fade-up">
      {paired.map((p) => {
        const cs = studies.get(p.data.relatedCaseStudy!)!;
        return (
          <li class="pairs__row">
            <div class="pairs__half">
              <span class="pairs__key">The write-up</span>
              <a class="pairs__title" href={`/blog/${p.id}/`}>{p.data.title}</a>
              <span class="pairs__foot">{p.data.category} &middot; {p.data.readTime} min</span>
            </div>
            <span class="pairs__arrow" aria-hidden="true">&rarr;</span>
            <div class="pairs__half">
              <span class="pairs__key">The outcome</span>
              <a class="pairs__title" href={`/case-studies/${cs.id}/`}>
                <span class="pairs__n">{cs.index}</span>{cs.ledger.client}
              </a>
              <span class="pairs__foot">Case study &middot; {cs.ledger.when}</span>
            </div>
          </li>
        );
      })}
    </ul>

    <p class="pairs__foot-note">
      The other {words(n - paired.length)} have no client attached &mdash; they came out of work we
      cannot name, or out of an afternoon lost to something small enough that nobody bills for it.
      {' '}<a href="/case-studies/">All {words(caseStudies.length)} case studies</a> are indexed
      separately.
    </p>
  </section>
</Page>

<script>
  /* The sift. One subject at a time, or all of them: a row hides when its
     subject is not the chosen one, and a year heading hides when nothing
     is left under it. Filtering happens here rather than in the URL
     because the whole archive is already on the page -- there is nothing
     to fetch, and a filter is not a destination worth a back-button
     entry. */
  (function () {
    const bar = document.querySelector<HTMLElement>('.sift');
    const run = document.querySelector<HTMLElement>('.run');
    if (!bar || !run) return;

    const buttons = Array.from(bar.querySelectorAll<HTMLButtonElement>('.sift__btn'));
    const count = bar.querySelector<HTMLElement>('.sift__count');
    const rows = Array.from(run.querySelectorAll<HTMLElement>('.run__row'));
    const years = Array.from(run.querySelectorAll<HTMLElement>('.run__year'));
    const none = document.querySelector<HTMLElement>('.run__none');
    const total = Number(count?.dataset.total ?? rows.length);

    function apply(cat: string): void {
      let shown = 0;
      for (const row of rows) {
        const on = cat === 'all' || row.dataset.cat === cat;
        row.hidden = !on;
        if (on) shown++;
      }
      for (const heading of years) {
        heading.hidden = !rows.some(
          (row) => !row.hidden && row.dataset.year === heading.dataset.year
        );
      }
      if (none) none.hidden = shown > 0;
      if (count) {
        count.textContent = cat === 'all' ? `Showing all ${total}` : `Showing ${shown} of ${total}`;
      }
    }

    for (const button of buttons) {
      button.addEventListener('click', () => {
        for (const other of buttons) {
          const on = other === button;
          other.classList.toggle('is-on', on);
          other.setAttribute('aria-pressed', String(on));
        }
        apply(button.dataset.cat ?? 'all');
      });
    }
  })();
</script>
