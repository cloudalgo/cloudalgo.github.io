---
import Page from '../layouts/Page.astro';
import Button from '../components/ui/Button.astro';
---
<Page
  title="Page Not Found — CloudAlgo"
  description="That page doesn't exist or has moved. Head back to CloudAlgo — Salesforce & Heroku consulting, products, and case studies."
>
  <section style="background:var(--surface-page);min-height:80vh;display:flex;align-items:center;justify-content:center;padding:6rem 1.5rem;text-align:center;">
    <div>
      <div style="font-size:clamp(6rem,15vw,12rem);font-weight:900;color:var(--color-text-ghost);line-height:1;letter-spacing:-0.05em;font-family:var(--font-heading);user-select:none;" aria-hidden="true">
        404
      </div>
      <h1 style="font-size:clamp(1.75rem,3vw,2.5rem);font-weight:800;color:var(--color-heading);margin:1rem 0 0.75rem;letter-spacing:-0.03em;">
        Page not found
      </h1>
      <p style="color:var(--color-text);font-size:1rem;margin-bottom:2.5rem;max-width:380px;margin-left:auto;margin-right:auto;">
        That page doesn't exist or has moved. Let's get you back on track.
      </p>
      <Button href="/" variant="primary">Back to home &rarr;</Button>
    </div>
  </section>
</Page>
