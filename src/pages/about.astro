---
/**
 * /about/ — one layout family per fold, and a ground that changes
 * underneath them.
 *
 * The brief for this page was that its previous draft was four folds of
 * one texture (ruled head + mono note + ruled rows), which is the
 * texture every other index page already uses. So no two folds here
 * share an arrangement:
 *
 *   .page-head  paper  masthead + standing data column
 *   .oath       ink    one sentence, full bleed, nothing else
 *   .bench      paper  image-led two-up, the only faces on the site
 *   .wontdo     paper  hanging heading, display type, no rules
 *   .tenure     sunk   a measured chart, not a list
 *
 * The chart's rows are derived from `@/data/case-studies` rather than
 * written down -- sector, length and open state all come from each
 * study's own ledger, so a sixth study cannot leave this page claiming
 * five, and a study whose duration changes cannot leave a bar behind.
 * The one string per row this file owns is the sub-label, which is
 * copy, and the build throws if it names a study that has no row.
 */
import Page from '@/layouts/Page.astro';
import PageMasthead from '@/components/ui/PageMasthead.astro';
import Button from '@/components/ui/Button.astro';
import { caseStudies } from '@/data/case-studies';

/* The chart axis. Eight months holds the three closed engagements with
   room left, and the two open ones run past it on purpose. */
const AXIS_MONTHS = 8;

/* The one line per row this page writes: what the engagement was, in
   the words a reader scanning the chart needs. The platform half of
   `ledger.tags` ("Salesforce & Heroku") names the stack, not the job. */
const SUBTITLES: Record<string, string> = {
  'salesforce-emr-sync': 'Salesforce to EMR sync',
  'salesforce-netsuite-sync': 'Salesforce to NetSuite sync',
  'health-portal-mulesoft-integration': 'Portal, Salesforce and logistics',
  'enterprise-data-pipeline': 'CRM and ERP into one pipeline',
  'nonprofit-web-platform': 'Platform rebuild, CRM connected',
};

const ids = new Set(caseStudies.map((c) => c.id));
for (const id of Object.keys(SUBTITLES)) {
  if (!ids.has(id)) {
    throw new Error(`about.astro: the tenure chart labels "${id}", which has no study.`);
  }
}

const rows = caseStudies.map((c) => {
  const label = SUBTITLES[c.id];
  if (!label) {
    throw new Error(`about.astro: study "${c.id}" has no tenure sub-label.`);
  }
  const months = Number(c.ledger.when.match(/^(\d+) months?$/)?.[1]);
  const open = Number.isNaN(months);
  /* An open engagement's length is whatever its duration states in
     full -- "Ongoing (2+ years)" is a claim, "Ongoing engagement" is
     not, and the chart must not invent the difference. */
  const span = c.duration.match(/\(([^)]+)\)/)?.[1];
  return {
    href: `/case-studies/${c.id}/`,
    sector: c.ledger.tags.split(' · ')[0],
    label,
    open,
    months,
    span,
    length: open ? (span ?? 'Still running') : c.ledger.when,
    width: open ? undefined : `${(months / AXIS_MONTHS) * 100}%`,
  };
});

/* Closed engagements ascend; the open ones follow, the unquantified one
   before the one that states a span, so the axis keeps climbing. */
rows.sort((a, b) => {
  if (a.open !== b.open) return a.open ? 1 : -1;
  if (a.open) return (a.span ? 1 : 0) - (b.span ? 1 : 0);
  return a.months - b.months;
});

const closed = rows.filter((r) => !r.open);
const openRows = rows.filter((r) => r.open);
const longestClosed = Math.max(...closed.map((r) => r.months));
const stated = openRows.find((r) => r.span);
if (!stated) {
  throw new Error('about.astro: the chart footnote cites an open engagement with a stated span, and none has one.');
}

/* Counting words rather than digits, because the sentence is prose --
   and counted here so the footnote cannot drift from the chart. */
const WORDS = ['zero', 'one', 'two', 'three', 'four', 'five', 'six', 'seven', 'eight', 'nine'];
const word = (n: number) => WORDS[n] ?? String(n);
const Word = (n: number) => {
  const w = word(n);
  return w.charAt(0).toUpperCase() + w.slice(1);
};

import { organization, orgRef, breadcrumbs, abs } from '@/data/schema';

const schema = [
  {
    '@type': 'AboutPage',
    '@id': abs('/about/'),
    url: abs('/about/'),
    name: 'About CloudAlgo',
    // An AboutPage's subject IS the organisation; saying so is what lets a
    // crawler treat this page as the company's own account of itself
    // rather than as one more page that mentions it.
    mainEntity: orgRef,
    isPartOf: { '@id': abs('/') + '#website' },
    publisher: orgRef,
    inLanguage: 'en',
  },
  organization,
  breadcrumbs([{ label: 'Home', href: '/' }, { label: 'About' }], abs('/about/')),
];

---

<Page
  {schema}
  title="About CloudAlgo — small on purpose since 2019"
  description="A Salesforce and Heroku consulting partner in Jaipur. Two co-founders, one rule we build against, and the work we turn down in order to hold it."
>

  <PageMasthead
    crumbs={[{ label: 'Home', href: '/' }, { label: 'About' }]}
    facts={[
      { term: 'Founded',     detail: '2019' },
      { term: 'Studio',      detail: 'Jaipur, India' },
      { term: 'Partner',     detail: 'Salesforce Consulting Partner' },
      { term: 'Projects',    detail: '70+ for 15+ clients' },
      { term: 'First reply', detail: 'Within one working day' },
    ]}
  >
    <Fragment slot="title">
      Since 2019, and still <span class="mark mark--draw">small on purpose</span>.
    </Fragment>
    <Fragment slot="lede">
      A Salesforce and Heroku consulting partner working out of Jaipur. Seventy-plus projects,
      fifteen-plus clients, four products of our own. What follows is the part most consultancies
      leave out &mdash; the one rule we build against, the work we turn down to hold it, and how
      long the engagements actually last.
    </Fragment>
    <Fragment slot="actions">
      <Button href="/contact/" variant="primary" size="sm">Tell us what your org is doing wrong &rarr;</Button>
      <Button href="/case-studies/" variant="outline" size="sm">Read the {word(caseStudies.length)} studies</Button>
    </Fragment>
  </PageMasthead>

  <section class="oath" aria-labelledby="oath-heading">
    <div class="oath__inner anim-fade-up">
      <h2 id="oath-heading" class="oath__say">
        Every org we hand back is one your own admin can change <em>without calling us</em>.
      </h2>
      <span class="oath__sign">One rule, held since 2019</span>
    </div>
  </section>

  <section class="section-press" aria-labelledby="bench-heading">
    <div class="bench__head anim-fade-up">
      <h2 id="bench-heading" class="bench__lead">Two people sign the work.</h2>
      <p class="bench__note">
        CloudAlgo has two co-founders, and both of them are on the build. Whoever you speak to on
        the first call is one of the two people who will be in your org, and neither of us has
        stopped writing Apex.
      </p>
    </div>

    <div class="bench anim-fade-up">
      <div class="bench__who">
        {/* The portrait is a specified empty frame, not stock and not an
            initials disc: a placeholder that looks finished is a
            placeholder that ships by accident. */}
        <div class="bench__shot" role="img" aria-label="Portrait of Sandeep Kumar to be supplied">
          <span>Portrait</span>
          <b>4:5 &middot; to supply</b>
        </div>
        <h3 class="bench__name">Sandeep Kumar
          <span class="bench__since">Co-founder &middot; certified since 2014</span>
        </h3>
        <p class="bench__role">
          Fifteen-plus years in software, based in Jaipur. Holds the architect-track certifications
          the integration work leans on &mdash; integration architecture, and sharing and
          visibility. Writes apex-lint, and builds OrgVitals.
        </p>
        <p class="bench__certs">Integration Architecture Designer<em>2019</em><i>&middot;</i>Sharing and Visibility Designer<em>2019</em><i>&middot;</i>Platform App Builder<em>2018</em><i>&middot;</i>Administrator<em>2014</em><i>&middot;</i>Force.com Developer<em>2014</em><i>&middot;</i>Force.com Advanced Developer<i>&middot;</i>Sales Cloud Consultant<i>&middot;</i>Service Cloud Consultant</p>
      </div>

      <div class="bench__who">
        <div class="bench__shot" role="img" aria-label="Portrait of Vikash Agarwal to be supplied">
          <span>Portrait</span>
          <b>4:5 &middot; to supply</b>
        </div>
        <h3 class="bench__name">Vikash Agarwal
          <span class="bench__since">Co-founder &middot; certified since 2016</span>
        </h3>
        <p class="bench__role">
          Fifteen-plus years in software, also in Jaipur. Holds the mobile solutions architecture
          certification, and writes on Apex and on Salesforce security. Builds OrgVitals and
          Pledgivo.
        </p>
        <p class="bench__certs">Mobile Solutions Architecture Designer<em>2017</em><i>&middot;</i>Administrator<em>2017</em><i>&middot;</i>Platform Developer I<em>2016</em></p>
      </div>

      <div class="bench__foot">
        <span class="bench__key">What we build on</span>
        <p class="bench__run">Salesforce<i>&middot;</i>Heroku<i>&middot;</i>MuleSoft<i>&middot;</i>Apex<i>&middot;</i>LWC<i>&middot;</i>SOQL<i>&middot;</i>REST / SOAP APIs<i>&middot;</i>Node.js<i>&middot;</i>PostgreSQL<i>&middot;</i>AWS</p>
      </div>
    </div>
  </section>

  <section class="section-press" aria-labelledby="wontdo-heading">
    <div class="wontdo anim-fade-up">
      <h2 id="wontdo-heading" class="wontdo__lead">
        Four things we will not do, and what each one costs us.
      </h2>
      <div class="wontdo__list">
        <div>
          <p class="wontdo__say"><b>We will not</b> build anything your admin cannot change without us.</p>
          <p class="wontdo__cost"><span>Costs us</span> &mdash; the change requests</p>
        </div>
        <div>
          <p class="wontdo__say"><b>We will not</b> quote before we have been inside the org.</p>
          <p class="wontdo__cost"><span>Costs us</span> &mdash; a slower first invoice</p>
        </div>
        <div>
          <p class="wontdo__say"><b>We will not</b> write Apex where configuration would have held.</p>
          <p class="wontdo__cost"><span>Costs us</span> &mdash; the billable hours</p>
        </div>
        <div>
          <p class="wontdo__say"><b>We will not</b> leave without the handover.</p>
          <p class="wontdo__cost"><span>Costs us</span> &mdash; the second engagement</p>
        </div>
      </div>
    </div>
  </section>

  <section class="tenure" aria-labelledby="tenure-heading">
    <div class="tenure__inner">
      <div class="section-press__head anim-fade-up">
        <h2 id="tenure-heading" class="section-title section-title--xs section-title--tighter section-press__title">
          How long the work actually lasts.
        </h2>
        <span class="section-press__note">
          {Word(caseStudies.length)} published studies &mdash; engagement length
        </span>
      </div>

      <div class="tenure__chart anim-fade-up">
        {rows.map((r) => (
          <a class:list={['tenure__row', r.open && 'tenure__row--open']} href={r.href}>
            <span class="tenure__name">
              <span class="tenure__sector">{r.sector}</span>
              <span class="tenure__what">{r.label}</span>
            </span>
            <span class="tenure__track">
              <span class="tenure__bar" style={r.width ? `--w:${r.width}` : undefined}></span>
            </span>
            <span class="tenure__len">{r.length}</span>
          </a>
        ))}

        <div class="tenure__axis">
          <span class="tenure__scale">
            {Array.from({ length: AXIS_MONTHS / 2 + 1 }, (_, i) => <span>{i * 2}</span>)}
          </span>
          <span class="tenure__unit">Months</span>
        </div>
      </div>

      <p class="tenure__foot anim-fade-up">
        {Word(closed.length)} of the {word(rows.length)} closed inside {word(longestClosed)} months.
        {' '}{Word(openRows.length)} are still open &mdash; one of them past {stated.span?.replace(/^2\+ /, 'two ')},
        still shipping against the architecture we put in.
        {' '}<a href="/case-studies/">Read the {word(caseStudies.length)} studies &rarr;</a>
      </p>
    </div>
  </section>

</Page>
