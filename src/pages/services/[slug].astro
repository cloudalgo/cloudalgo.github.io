---
// src/pages/services/[slug].astro
import { getCollection, render } from 'astro:content';
import Page from '../../layouts/Page.astro';

export async function getStaticPaths() {
  const services = await getCollection('services');
  return services.map(s => ({ params: { slug: s.id }, props: { service: s } }));
}

const { service } = Astro.props;
const { Content } = await render(service);
---
<Page
  title={`${service.data.title} — CloudAlgo`}
  description={service.data.excerpt}
>
  <section class="bg-[#111] px-6 py-24">
    <div class="max-w-3xl mx-auto">
      <a href="/services" class="text-[12px] font-bold text-[#64748b] hover:text-primary transition-colors mb-8 inline-block">
        ← Back to Services
      </a>
      <div class="text-4xl mb-4">{service.data.icon}</div>
      <h1 class="font-display font-black text-white leading-tight mb-4 anim-fade-up"
          style="font-size: clamp(32px, 5vw, 52px); letter-spacing: -1.5px;">
        {service.data.title}
      </h1>
      <p class="text-[16px] text-[#94a3b8] font-semibold leading-relaxed">
        {service.data.excerpt}
      </p>
    </div>
  </section>

  <section class="bg-white px-6 py-16">
    <div class="max-w-3xl mx-auto prose prose-lg prose-headings:font-display prose-headings:font-extrabold prose-a:text-primary">
      <Content />
    </div>
  </section>
</Page>
