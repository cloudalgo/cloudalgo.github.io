  { num: '01', label: 'Discovery', desc: 'We map your current state, integrations, and pain points before writing a line of code.' },
  { num: '02', label: 'Define', desc: 'Requirements, constraints, and success criteria documented and signed off.' },
  { num: '03', label: 'Architect', desc: 'Technical design review and architecture decisions made with your team.' },
  { num: '04', label: 'Develop & Test', desc: 'Sprint-based delivery with daily standups and sandbox demos.' },
  { num: '05', label: 'Deploy', desc: 'Coordinated go-live with rollback plan, post-deploy validation, and documentation.' },
  { num: '06', label: 'Support', desc: 'Hypercare period, knowledge transfer, and optional managed services handoff.' },
