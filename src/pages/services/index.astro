// Fail the build rather than ship a dead "read the full scope" link: the
// spread's secondary button is generated from `slug`, and a rename in the
// collection would otherwise 404 silently in production.
for (const e of ENGAGEMENTS) {
  if (!bySlug.has(e.slug)) {
    throw new Error(`services/index.astro: no service content file for "${e.slug}"`);
  }
}

