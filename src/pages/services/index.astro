// Seven engagements: a figure that draws them all against a calendar, a
// spread each, a table that routes a symptom to one of them, and the
// checklist every one of them ends on.
//
// The catalogue page next door is deliberately NOT the model here. A
// product is an object with attributes, so /products/ gives each one a
// spec sheet and a status pip. An engagement is a period of time with a
// shape, a rhythm and an ending -- so every device on this page encodes
// duration or commitment instead: the schedule draws length, the track
// draws sequence, the terms list states what you are committing to, and
// the closing band says what you are left holding. The two pages share
// the design system and share almost no structure, on purpose.
//
// The pricing MECHANISMS ("fixed scope, or time & materials", "per process
// automated") are true as written. There is no money on this page, and none
// should be invented here.

const services = await getCollection('services');
const bySlug = new Map(services.map((s) => [s.id, s]));

// The proof stamp is the collection's, not this page's. Four practices have
// proof -- a product they shipped, or a counted figure -- and the schema is
// the one place that records which. Printing it from there means a service
// that ships a product, or finally counts its projects, changes one file and
// the stamp follows; a hardcoded copy here would have been a second truth to
// keep in sync, and the kind that goes stale silently because nothing checks
// a string against a string. The three practices with no proof yet resolve to
// undefined, and fall back to the descriptive `stamp.note` below.
const proofStamp = new Map(
  await Promise.all(
    services.map(async (s) => {
      const product = s.data.proves ? await getEntry(s.data.proves) : undefined;
      const claim = product ? product.data.title : s.data.provenBy;
      return [s.id, claim ? `Proven by ${claim}` : undefined] as const;
    })
  )
);

// Typical lengths, in one table because each one is printed twice -- once in
// the schedule's row label, once in the spread's terms -- and two copies of a
// number are two chances to correct only one of them.
//
// NONE OF THESE SIX IS SOURCED. They are the delivery team's estimates, not
// figures taken from a contract or measured across delivered projects, which
// is why the figure caption says "typical, not contractual". Correct them here
// and both printings follow.
//
// NO PRICE BELONGS ON THIS PAGE. That is a decided policy, not a gap waiting
// to be filled: rates are quoted after the first call, once there is a scope
// to put a number against, and the routing table's footnote says so in as many
// words. The `Priced` terms row on each engagement gives the MECHANISM -- fixed
// scope, per phase, per process, by tier -- which is what a buyer needs to
// compare shapes. A figure here would be a rate card nobody agreed to.
const TYPICAL: Record<string, { range: string; qualifier?: string }> = {
  'salesforce-consulting':  { range: '6–12 weeks' },
  'product-development':    { range: '12–24 weeks' },
  'mulesoft-integration':   { range: '8–16 weeks' },
  'mulesoft-rpa':           { range: '4–8 weeks', qualifier: 'per process' },
  'aws-cloud-solutions':    { range: '4–12 weeks' },
  'airflow-data-pipelines': { range: '6–10 weeks' },
};

/** The schedule's row label, under the name: "Project · 6–12 weeks". */
const runs = (slug: string) => `Project · ${TYPICAL[slug].range}`;

/** The terms row. Carries the qualifier the schedule label has no room for --
    RPA is priced and scheduled per process, and the figure is meaningless
    without that word. */
const lengthOf = (slug: string) =>
  [TYPICAL[slug].range, TYPICAL[slug].qualifier].filter(Boolean).join(' ');

type Engagement = {
  /** Content-collection id. Also the "read the full scope" target. */
  slug: string;
  /** Printed as given, and the same numeral on every device below. */
  n: string;
  /** In-page anchor. Short, because it is read in a URL bar. */
  id: string;
  /** The name this page uses. Shorter than the collection title where
      the collection's spends its first word restating "Salesforce". */
  name: string;
  /** The contents strip: what the engagement is FOR. */
  contents: string;
  /** The schedule: how long it RUNS. Different fact, same row. */
  shape: string;
  /** Months. Solid to `typical`, hatched on to `most`. */
  bar?: { from: number; typical: number; most: number };
  /** Month the rolling ticks start. */
  roll?: number;
  /**
   * The spread's stamp. `shape` is what you are buying. The second line is
   * the practice's proof, taken from the collection -- and where a practice
   * has none, `note` stands in its place with a true statement of scope
   * instead. A descriptive stamp is not a weaker proof, it is a different
   * kind of sentence, and printing it as one would be the invented claim
   * this page went out of its way to remove.
   */
  stamp: { shape: string; note?: string };
  tagline: string;
  lead: string;
  track: Array<{ n: string; name: string; detail: string }>;
  ending?: 'handover' | 'rolling';
  caveat?: string;
  stackLabel?: string;
  stack: string;
  terms: Array<{ term: string; detail: string }>;
  /** The first step THIS engagement asks for. Seven engagements had
      seven identical "Book a consultation" buttons in an early draft,
      which is the same ask printed seven times rather than seven
      different first meetings. */
  cta: string;
};

