---
<Page
  title="Salesforce Consulting Services — CloudAlgo"
  description="End-to-end Salesforce consulting: CRM implementation, AppExchange product development, MuleSoft integration, and managed services. Certified partner with 70+ projects delivered."
>

  <!-- Page header -->
  <PageHeader
    style="padding-bottom:4rem;"
    crumbs={[{ label: 'Home', href: '/' }, { label: 'Services' }]}
    title="Expert services for the Salesforce ecosystem."
    titleStyle="max-width:680px;line-height:1.05;"
    lead="From CRM implementation to AppExchange products, MuleSoft integrations, AWS pipelines, and ongoing managed support — we cover the full stack, end to end."
    leadStyle="max-width:560px;margin-top:1.25rem;"
  >
      <!-- Quick stats row -->
      <div style="display:flex;gap:2.5rem;margin-top:2.5rem;flex-wrap:wrap;">
        {[['5', 'Service areas'],['70+','Projects delivered'],['12+','Years combined experience'],['1 day','Response time']].map(([num, label]) => (
          <div>
            <div class="stat-num stat-num--sm stat-num--leading-inherit">{num}</div>
            <div class="stat-label" style="margin-top:0.1rem;">{label}</div>
          </div>
        ))}
      </div>
  </PageHeader>

  <!-- Service sections -->
  {services.map((svc, i) => {
    const isEven = i % 2 === 0;
    return (
      <section style={`background:${isEven ? 'var(--surface-card)' : 'var(--surface-page)'};padding:5.5rem 0;border-top:1px solid var(--border-default);`}>
        <div class="container">
          <div class="row align-items-center" style="gap:3rem 0;">

            <!-- Text column — alternates side -->
            <div class={`col-lg-6 ${isEven ? '' : 'order-lg-2'} anim-fade-up`}>
              <SectionLabel class="section-label--block" style="margin-bottom:0.75rem;">
                {svc.number}
              </SectionLabel>
              <h2 class="section-title section-title--md section-title--tight" style="margin-bottom:0.875rem;line-height:1.15;">
                {svc.title}
              </h2>
              <p style="font-size:1rem;font-weight:600;color:var(--color-heading);margin-bottom:1rem;line-height:1.5;">
                {svc.tagline}
              </p>
              <p class="paragraph-large" style="margin-bottom:2rem;color:var(--color-text);">
                {svc.description}
              </p>
              <ul style="list-style:none;padding:0;margin:0 0 2rem;display:flex;flex-direction:column;gap:0.875rem;">
                {svc.features.map(f => (
                  <li style="display:flex;gap:0.875rem;align-items:flex-start;">
                    <svg width="18" height="18" viewBox="0 0 18 18" fill="none" style="flex-shrink:0;margin-top:0.175rem;">
                      <rect x="0.75" y="0.75" width="16.5" height="16.5" rx="4.25" stroke="var(--illus-ink)" stroke-width="1.5"/>
                      <path d="M5.5 9L7.8 11.5L12.5 6.5" stroke="var(--illus-ink)" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/>
                    </svg>
                    <span style="font-size:0.9375rem;color:var(--color-text);line-height:1.65;">
                      <strong style="color:var(--color-heading);">{f.label} — </strong>{f.desc}
                    </span>
                  </li>
                ))}
              </ul>
              {svc.id && (
                <Button href={`/services/${svc.id}`} variant="outline" size="sm">
                  Learn more &rarr;
                </Button>
              )}
            </div>

            <!-- Illustration column -->
            <div class={`col-lg-6 ${isEven ? '' : 'order-lg-1'} anim-scale-pop`}
                 style="display:flex;justify-content:center;align-items:center;padding:1.5rem 0;"
                 aria-hidden="true"
                 set:html={svc.svg}
            />

          </div>
        </div>
      </section>
    );
  })}

  <!-- Process -->
  <section style="background:var(--surface-inverse);padding:6rem 0;border-top:1px solid var(--border-on-inverse);">
    <div class="container">
      <SectionLabel class="section-label--block" style="color:var(--color-on-inverse-faint);margin-bottom:0.75rem;">
        How we work
      </SectionLabel>
      <h2 class="section-title section-title--tight section-title--inverse anim-fade-up" style="margin-bottom:3.5rem;">
        Our delivery process
      </h2>
      <div class="row" style="gap:1.5rem 0;">
        {steps.map((step, i) => (
          <div class="col-lg-4 col-md-6 anim-fade-up" style={`transition-delay:${i * 0.07}s`}>
            <div style="padding:1.75rem;border:1px solid var(--color-paper-a12);border-radius:12px;height:100%;">
              <div class="stat-num stat-num--on-inverse-ghost stat-num--leading-inherit" style="margin-bottom:0.75rem;">{step.num}</div>
              <div style="font-size:1rem;font-weight:700;color:var(--color-on-inverse);margin-bottom:0.5rem;">{step.label}</div>
              <div style="font-size:0.9rem;color:var(--color-on-inverse-muted);line-height:1.65;">{step.desc}</div>
            </div>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- Trust signals -->
  <section style="background:var(--surface-page);padding:4rem 0;border-top:1px solid var(--border-default);">
    <div class="container">
      <div class="row align-items-center" style="gap:2rem 0;">
        <div class="col-lg-5">
          <h2 class="section-title section-title--xs section-title--tight" style="margin-bottom:1rem;">
            Certified. Experienced. Responsive.
          </h2>
          <p style="color:var(--color-text);font-size:1rem;line-height:1.7;">
            Every engagement is led by certified Salesforce architects. We don't hand off to junior developers once the deal is signed.
          </p>
        </div>
        <div class="col-lg-7">
          <div style="display:grid;grid-template-columns:repeat(2,1fr);gap:1rem;">
            {[
              { label: 'Salesforce Certified Architects', sub: 'Admin, Dev, Architect tracks' },
              { label: 'Salesforce Partner', sub: 'Authorized consulting partner' },
              { label: '< 1 Business Day', sub: 'Response time for all enquiries' },
              { label: 'Fixed-scope or retainer', sub: 'Flexible engagement models' },
            ].map(item => (
              <div style="background:var(--surface-card);border:1px solid var(--border-default);border-radius:12px;padding:1.25rem 1.5rem;">
                <div style="font-size:0.9375rem;font-weight:700;color:var(--color-heading);margin-bottom:0.25rem;">{item.label}</div>
                <div style="font-size:0.8125rem;color:var(--color-text);">{item.sub}</div>
              </div>
            ))}
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- CTA -->
  <section style="background:var(--surface-card);padding:6rem 0;border-top:1px solid var(--border-default);text-align:center;">
    <div class="container">
      <h2 class="section-title section-title--heavy section-title--tighter" style="margin-bottom:1.25rem;">
        Ready to get started?
      </h2>
