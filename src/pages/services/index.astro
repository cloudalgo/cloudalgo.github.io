---
import { getCollection, getEntry } from 'astro:content';
import Page from '@/layouts/Page.astro';
import PageMasthead from '@/components/ui/PageMasthead.astro';
import ContentsBar from '@/components/ui/ContentsBar.astro';
import ServiceSchedule from '@/components/ui/ServiceSchedule.astro';
import ServiceSpread from '@/components/sections/ServiceSpread.astro';
import SlaWindows from '@/components/ui/SlaWindows.astro';
import RouteTable from '@/components/ui/RouteTable.astro';
import ClosingManifest from '@/components/sections/ClosingManifest.astro';
import { ENGAGEMENTS, WINDOWS } from '@/data/engagements';
import { organization, orgRef, breadcrumbs, abs, SITE_ID } from '@/data/schema';

// Seven engagements: a figure that draws them all against a calendar, a
// spread each, a table that routes a symptom to one of them, and the
// checklist every one of them ends on.
//
// The catalogue page next door is deliberately NOT the model here. A
// product is an object with attributes, so /products/ gives each one a
// spec sheet and a status pip. An engagement is a period of time with a
// shape, a rhythm and an ending -- so every device on this page encodes
// duration or commitment instead: the schedule draws length, the track
// draws sequence, the terms list states what you are committing to, and
// the closing band says what you are left holding. The two pages share
// the design system and share almost no structure, on purpose.
//
// The pricing MECHANISMS ("fixed scope, or time & materials", "per process
// automated") are true as written. There is no money on this page, and none
// should be invented here.

const services = await getCollection('services');
const bySlug = new Map(services.map((s) => [s.id, s]));

// The proof stamp is the collection's, not this page's. Four practices have
// proof -- a product they shipped, or a counted figure -- and the schema is
// the one place that records which. Printing it from there means a service
// that ships a product, or finally counts its projects, changes one file and
// the stamp follows; a hardcoded copy here would have been a second truth to
// keep in sync, and the kind that goes stale silently because nothing checks
// a string against a string. The three practices with no proof yet resolve to
// undefined, and fall back to the descriptive `stamp.note` below.
const proofStamp = new Map(
  await Promise.all(
    services.map(async (s) => {
      const product = s.data.proves ? await getEntry(s.data.proves) : undefined;
      const claim = product ? product.data.title : s.data.provenBy;
      return [s.id, claim ? `Proven by ${claim}` : undefined] as const;
    })
  )
);

// The seven engagements themselves live in `src/data/engagements.ts`,
// along with the typical lengths and the retainer's response windows.
// This page prints those records as a figure and seven spreads; each
// /services/<slug>/ page prints the SAME records as a spine and a scope
// document, one zoom level in. Two pages, one set of facts.
//
// NO PRICE BELONGS ON THIS PAGE. That is a decided policy, not a gap waiting
// to be filled: rates are quoted after the first call, once there is a scope
// to put a number against, and the routing table's footnote says so in as many
// words. The `Priced` terms row on each engagement gives the MECHANISM -- fixed
// scope, per phase, per process, by tier -- which is what a buyer needs to
// compare shapes. A figure here would be a rate card nobody agreed to.

// Fail the build rather than ship a dead "read the full scope" link: the
// spread's secondary button is generated from `slug`, and a rename in the
// collection would otherwise 404 silently in production.
for (const e of ENGAGEMENTS) {
  if (!bySlug.has(e.slug)) {
    throw new Error(`services/index.astro: no service content file for "${e.slug}"`);
  }
}

// The routing table is written in the buyer's words, not ours: every stub
// is a sentence somebody has actually said on a first call. The last row
// points off the page on purpose -- "we do not know what shape the org is
// in" is answered by a free scanner, not by an engagement.
const ROUTES = [
  {
    symptom: 'Nobody can change a flow safely',
    href: '#consulting',
    label: '01 — Consulting & implementation',
    gloss: 'Automation debt is a build problem. It gets untangled, not patched.',
  },
  {
    symptom: 'A product, and a Security Review date',
    href: '#product',
    label: '02 — Product development',
    gloss: 'Bring the packaging decision too, even if you think it is settled.',
  },
  {
    symptom: 'Six systems, and none of them agree',
    href: '#mulesoft',
    label: '03 — MuleSoft integration',
    gloss: 'Point-to-point integration is not a bug count, it is an architecture bill.',
  },
  {
    symptom: 'Somebody rekeys a portal into Salesforce every morning',
    href: '#rpa',
    label: '04 — MuleSoft RPA',
    gloss: 'If that system has an API you want 03. If it never will, you want this.',
  },
  {
    symptom: 'The AWS bill grew and nobody can say why',
    href: '#aws',
    label: '05 — AWS cloud solutions',
    gloss: 'Starts with a review, so the first answer is what to switch off.',
  },
  {
    symptom: 'The warehouse is a day behind',
    href: '#pipelines',
    label: '06 — Airflow data pipelines',
    gloss: 'Usually an API-limit problem wearing a scheduling costume.',
  },
  {
    symptom: 'Tickets pile up, nobody owns the org',
    href: '#support',
    label: '07 — Support & managed services',
    gloss: 'Starts with a health review, so the first month is diagnosis.',
  },
  {
    symptom: 'We do not know what shape the org is in',
    href: '/products/#orgvitals',
    label: 'Run OrgVitals first — free',
    gloss: 'It is a scanner, not a sales call. Bring us the grade if you still want to talk.',
    out: true,
  },
];

const MANIFEST = [
  {
    title: 'The repository',
    detail:
      'Every line of Apex, LWC, Flow metadata and DAG, in your git, under your account. No vendor ' +
      'repo, no licence to keep paying.',
  },
  {
    title: 'The runbook',
    detail:
      'How it deploys, what breaks first, and what to check at 2am. Written during the build, not ' +
      'reconstructed at the end.',
  },
  {
    title: 'A working session with your admins',
    detail:
      'Live, on the parts they will own, with their questions. Not a recorded walkthrough nobody ' +
      'watches twice.',
  },
  {
    title: 'The written record',
    detail:
      'Architecture note, health report, submission record, ticket history — whichever of them ' +
      'your engagement produced.',
  },
];

// Seven service cells and one that is not a service. The eighth fills the
// second row of a four-across grid, which a seven-item set would otherwise
// leave ragged, and it earns the space: the commonest state a reader
// arrives in is not knowing which of the seven is theirs.
const contents = [
  ...ENGAGEMENTS.map((e) => ({
    n: e.n,
    title: e.name,
    href: `#${e.id}`,
    blurb: e.contents,
  })),
  {
    n: '→',
    title: 'Not sure which?',
    href: '#route-heading',
    blurb: 'Say the problem out loud — the table below has a row for it',
  },
];

// Seven engagements as a graph rather than a bare list. Each entry is a
// Service with a named provider -- the same `@id` the rest of the site
// resolves the firm to -- so the list describes seven things CloudAlgo
// does, not seven links that happen to sit together. Trailing slashes
// throughout: the site serves directories, and a ListItem URL that 301s
// is a hop nobody needs.
const crumbs = [{ label: 'Home', href: '/' }, { label: 'Services' }];

const servicesSchema = [
  {
    '@type': 'CollectionPage',
    '@id': abs('/services/'),
    url: abs('/services/'),
    name: 'Services — seven engagements, and what each one ends with',
    isPartOf: { '@id': SITE_ID },
    publisher: orgRef,
    inLanguage: 'en',
    mainEntity: {
      '@type': 'ItemList',
      name: 'CloudAlgo Services',
      numberOfItems: ENGAGEMENTS.length,
      itemListElement: ENGAGEMENTS.map((e, i) => ({
        '@type':  'ListItem',
        position: i + 1,
        item: {
          '@type': 'Service',
          name: bySlug.get(e.slug)!.data.title,
          description: bySlug.get(e.slug)!.data.excerpt,
          url: abs(`/services/${e.slug}/`),
          provider: orgRef,
          areaServed: 'Worldwide',
        },
      })),
    },
  },
  organization,
  breadcrumbs(crumbs, abs('/services/')),
];
---
<Page
  title="Services — seven engagements, and what each one ends with"
  description="Salesforce consulting, AppExchange product development, MuleSoft integration and RPA, AWS architecture, Airflow pipelines and a support retainer — seven in all."
  schema={servicesSchema}
>
  <PageMasthead
    {crumbs}
    facts={[
      { term: 'Engagements', detail: '7' },
      { term: 'Platforms',   detail: 'Salesforce · MuleSoft · AWS' },
      { term: 'Delivered',   detail: '70+ projects' },
      { term: 'Smallest',    detail: '10 hrs / month' },
      { term: 'Emergency',   detail: 'Unlimited P1, every tier' },
      { term: 'Proven by',   detail: 'OrgVitals · Pledgivo · AlgoBridge' },
      { term: 'Enquiries',   detail: 'contact@cloudalgo.com' },
    ]}
  >
    <Fragment slot="title">
      Seven engagements. You end up <span class="mark mark--draw">owning it</span>, every time.
    </Fragment>
    <Fragment slot="lede">
      Six of the seven end with the repository, the runbook and a session with your admins. The
      seventh is a retainer you can stop the month it stops earning its place. Either way, nothing
      we leave behind needs us on call to keep running.
    </Fragment>
  </PageMasthead>

  <ContentsBar items={contents} label="Services" class="contents-bar--8 anim-fade-up" />

  <section class="section-press" aria-labelledby="shapes-heading">
    <div class="section-press__head anim-fade-up">
      <h2 id="shapes-heading" class="section-title section-title--xs section-title--tighter section-press__title">
        Seven shapes, drawn to scale.
      </h2>
      <span class="section-press__note">Six months, left to right</span>
    </div>

    {/* The scale is seven month-columns, and the seven marks sit one
        per column. That leaves a column past "06" rather than ending
        the plot on it -- which is where the retainer's rolling ticks
        run, and the room a six-month bar needs to read as a bar. */}
    <ServiceSchedule
      class="anim-fade-up"
      cols={7}
      axis={[
        { at: 0, mark: 'Month 0' }, { at: 1, mark: '01' }, { at: 2, mark: '02' },
        { at: 3, mark: '03' }, { at: 4, mark: '04' }, { at: 5, mark: '05' },
        { at: 6, mark: '06' },
      ]}
      rows={ENGAGEMENTS.map((e) => ({
        n: e.n,
        name: e.name,
        shape: e.shape,
        href: `#${e.id}`,
        bar: e.bar,
        roll: e.roll,
      }))}
      caption="six of the seven end, and the ember mark is that ending — repository, runbook, admin session. The seventh is a retainer, and runs until you stop it. Lengths are typical, not contractual."
    />
  </section>

  <section class="section-press" aria-labelledby="engagements-heading">
    <div class="section-press__head anim-fade-up">
      <h2 id="engagements-heading" class="section-title section-title--xs section-title--tighter section-press__title">
        What each one actually involves.
      </h2>
      <span class="section-press__note">Scope, sequence and terms</span>
    </div>

    {ENGAGEMENTS.map((e) => (
      <ServiceSpread
        class="anim-fade-up"
        id={e.id}
        n={e.n}
        name={e.name}
        shape={e.stamp.shape}
        proof={proofStamp.get(e.slug) ?? e.stamp.note}
        tagline={e.tagline}
        lead={e.lead}
        track={e.track}
        ending={e.ending}
        caveat={e.caveat}
        stackLabel={e.stackLabel}
        stack={e.stack}
        terms={e.terms}
        actions={[
          { label: `${e.cta} →`, href: '/contact/', primary: true },
          { label: 'Read the full scope', href: `/services/${e.slug}/` },
        ]}
      >
        {e.id === 'support' && (
          <SlaWindows slot="detail" windows={WINDOWS}>
            <b>Initial response, written into the contract</b> — not the sales deck. Unlimited P1
            on Essentials, Growth and Enterprise alike.
          </SlaWindows>
        )}
      </ServiceSpread>
    ))}
  </section>

  <section class="section-press" aria-labelledby="route-heading">
    <div class="section-press__head anim-fade-up">
      <h2 id="route-heading" class="section-title section-title--xs section-title--tighter section-press__title">
        Start here if this is you.
      </h2>
      <span class="section-press__note">Eight symptoms, one row each</span>
    </div>

    <RouteTable
      class="anim-fade-up"
      corner="On the call"
      destination="Where that goes"
      rows={ROUTES}
      caption="Common problems and which engagement handles each one."
    >
      <p class="compare-note anim-fade-up" slot="footnote">
        One answer is the same in every row: the first call is about your org, not our engagement
        types. We do not publish rates — the number comes after that call, once there is a scope to
        put one against. If none of the seven fits, we will say so and point you at whoever does it
        properly.
      </p>
    </RouteTable>
  </section>

  <ClosingManifest
    class="anim-fade-up"
    labelledby="manifest-heading"
    kicker="The last week of every engagement"
    items={MANIFEST}
  >
    <Fragment slot="title">Owning it is a checklist, not a promise.</Fragment>
    <Fragment slot="note">
      Seven shapes, one ending. Whichever of them you buy, the closing week is the same four items,
      and none of them needs us on call afterwards. That is the test we build against — and the
      reason three of the seven are proven by software we run ourselves.
    </Fragment>
    <a class="btn btn-light btn-sm" slot="actions" href="/case-studies/">Read the case studies &rarr;</a>
  </ClosingManifest>

</Page>
