---
/**
 * Five case studies, stated as what stopped being true.
 *
 * A product is an object and gets a spec sheet; an engagement is a period
 * of time and gets a schedule. A case study is neither -- it is a CHANGE
 * OF STATE, so both devices on this page encode one. The ledger sets each
 * study out as was/now with the figure that settles it, and the claims
 * index reads the same five rows the other way round: a claim first, then
 * the studies that carry it, cited by number into the ledger above.
 *
 * Every string on the page comes from `@/data/case-studies` -- the index
 * copy from each study's `ledger` block, the figure from its `metric`.
 * The masthead's countable facts are counted here rather than written
 * down, so a sixth study cannot leave the stand claiming five.
 */
import Page from '@/layouts/Page.astro';
import PageMasthead from '@/components/ui/PageMasthead.astro';
import { caseStudies } from '@/data/case-studies';

/* "Ongoing" is the one `when` value that is not a length, which makes it
   the one that answers "still running". Counted, not asserted. */
const ongoing = caseStudies.filter((c) => c.ledger.when === 'Ongoing').length;

const industries = [...new Set(caseStudies.map((c) => c.ledger.tags.split(' · ')[0]))];

/* The shortest engagement, off the same field the rows print. Studies
   with no number in `when` are the open-ended ones and have no length to
   compare. */
const months = caseStudies
  .map((c) => Number(c.ledger.when.match(/^(\d+) months?$/)?.[1]))
  .filter((n) => !Number.isNaN(n));
const shortest = `${Math.min(...months)} months`;

/* Four claims about the set, each carried by the rows it names. A claim
   nothing links back to is an assertion, and this page's whole argument
   is that it does not make those -- so the chips are real anchors and
   every study id here is checked against the data below. */
const CLAIMS = [
  {
    text: 'All five removed a manual step somebody did every working day.',
    cites: ['01', '02', '03', '04', '05'],
  },
  {
    text: 'Three connect Salesforce to a system that was never built to talk to it.',
    cites: ['03', '04', '05'],
  },
  {
    text: 'Two are still running long after the first release — which is the only review of an architecture that counts.',
    cites: ['01', '02'],
  },
  {
    text: 'One had no API to integrate with at all, so we drove the browser instead.',
    cites: ['03'],
  },
];

/* Fail the build rather than ship a chip that scrolls nowhere. */
const indexes = new Set(caseStudies.map((c) => c.index));
for (const claim of CLAIMS) {
  for (const n of claim.cites) {
    if (!indexes.has(n)) {
      throw new Error(`case-studies.astro: claim cites study "${n}", which has no row.`);
    }
  }
}
---
<Page
  title="Case studies — CloudAlgo | Five things that are no longer true"
  description="Five Salesforce, MuleSoft and Heroku engagements stated as a change of state: what was true before, what is true now, and the one number that settles each of them."
>
  <PageMasthead
    crumbs={[{ label: 'Home', href: '/' }, { label: 'Case studies' }]}
    facts={[
      { term: 'Studies',       detail: String(caseStudies.length) },
      { term: 'Industries',    detail: industries.join(' · ') },
      { term: 'Platforms',     detail: 'Salesforce · MuleSoft · Heroku · NetSuite · Airflow' },
      { term: 'Shortest',      detail: shortest },
      { term: 'Longest',       detail: '2+ years' },
      { term: 'Still running', detail: `${ongoing} of ${caseStudies.length}` },
      { term: 'Enquiries',     detail: 'contact@cloudalgo.com' },
    ]}
  >
    <Fragment slot="title">
      Five companies. Five things that are <span class="mark mark--draw">no longer true</span>.
    </Fragment>
    <Fragment slot="lede">
      Each of these began as a sentence somebody was tired of saying &mdash; &ldquo;we re-key that by
      hand&rdquo;, &ldquo;the data is a day old&rdquo;, &ldquo;that system has no API&rdquo;. Below is
      what replaced each sentence, how long it took, and the one number that settles it.
    </Fragment>
  </PageMasthead>

  <section class="section-press" aria-labelledby="ledger-heading">
    <div class="section-press__head anim-fade-up">
      <h2 id="ledger-heading" class="section-title section-title--xs section-title--tighter section-press__title">
        What stopped being true.
      </h2>
      <span class="section-press__note">Struck through: the way it used to work</span>
    </div>

    <div class="ledger anim-fade-up">
      {caseStudies.map((cs) => (
        <a class="ledger__row" id={`cs-${cs.index}`} href={`/case-studies/${cs.id}/`}>
          <span class="ledger__n">{cs.index}</span>
          <span class="ledger__who">
            <span class="ledger__client">{cs.ledger.client}</span>
            <span class="ledger__tags">{cs.ledger.tags}</span>
            <span class="ledger__when">{cs.ledger.when}</span>
          </span>
          <span class="ledger__states">
            <span class="ledger__state ledger__state--was">
              <span class="ledger__key">was</span><s>{cs.ledger.was}</s>
            </span>
            <span class="ledger__state ledger__state--now">
              <span class="ledger__key">now</span>{cs.ledger.now}
            </span>
          </span>
          <span class="ledger__metric">
            <span class="ledger__figure">{cs.metric}</span>
            <span class="ledger__figlabel">{cs.ledger.figLabel}</span>
          </span>
        </a>
      ))}
    </div>
  </section>

  <section class="section-press" aria-labelledby="common-heading">
    <div class="section-press__head anim-fade-up">
      <h2 id="common-heading" class="section-title section-title--xs section-title--tighter section-press__title">
        What the five have in common.
      </h2>
      <span class="section-press__note">Four claims, and who carries them</span>
    </div>

    <ul class="claims anim-fade-up">
      {CLAIMS.map((claim) => (
        <li class="claims__row">
          <p class="claims__text">{claim.text}</p>
          <span class="claims__cites">
            {claim.cites.map((n) => (
              <a href={`#cs-${n}`} class="claims__cite" aria-label={`Study ${n}`}>{n}</a>
            ))}
          </span>
        </li>
      ))}
    </ul>

    {/* One line on purpose: Astro trims the whitespace at a markup
        boundary, so a line break either side of the link would weld it
        to the words next to it. */}
    <p class="claims__foot">Not sure which of these is your situation? <a href="/services/" class="claims__out">Start from the seven engagements</a> &mdash; each one names the shape of the work and what it ends with.</p>
  </section>
</Page>
