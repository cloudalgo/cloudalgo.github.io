---
import Page from '../layouts/Page.astro';
import { caseStudies } from '../data/case-studies';

---

<Page
  title="Case Studies — CloudAlgo | Real Data Engineering Results"
  description="Real outcomes from CloudAlgo's data engineering engagements. See how we've delivered production-grade pipelines, measurable performance gains, and zero-manual-intervention data systems for enterprise clients."
>

  <!-- ── Hero ── -->
  <div class="cs-hero">
    <div class="container">
      <div class="cs-hero-split">
        <div class="cs-hero-text">
          <nav class="breadcrumb">
            <a href="/">Home</a>
            <span>&rarr;</span>
            <span>Case Studies</span>
          </nav>
          <p class="section-label">Results that speak</p>
          <h1 class="cs-hero-title">What we've built.<br/>What it delivered.</h1>
          <p class="cs-hero-sub">Real engagements. Measurable outcomes every time.</p>
        </div>
        <div class="cs-hero-illo" aria-hidden="true">
          <svg viewBox="0 0 480 340" fill="none" xmlns="http://www.w3.org/2000/svg" class="cs-hero-svg">
            <!-- ── Doc 3: back, rotated left ── -->
            <g transform="rotate(-13 230 175)">
              <rect x="120" y="38" width="220" height="272" rx="12" fill="#f0f0ec" stroke="rgba(10,10,10,0.18)" stroke-width="1.5"/>
              <rect x="120" y="38" width="220" height="44" rx="12" fill="rgba(10,10,10,0.15)"/>
              <rect x="120" y="60" width="220" height="22" fill="rgba(10,10,10,0.15)"/>
              <rect x="140" y="98" width="138" height="8" rx="2" fill="rgba(10,10,10,0.09)"/>
              <rect x="140" y="113" width="106" height="7" rx="2" fill="rgba(10,10,10,0.07)"/>
              <rect x="140" y="127" width="122" height="7" rx="2" fill="rgba(10,10,10,0.07)"/>
            </g>
            <!-- ── Doc 2: middle, slightly rotated ── -->
            <g transform="rotate(-5 230 175)">
              <rect x="120" y="38" width="220" height="272" rx="12" fill="#f8f8f5" stroke="rgba(10,10,10,0.42)" stroke-width="1.5"/>
              <rect x="120" y="38" width="220" height="44" rx="12" fill="rgba(10,10,10,0.65)"/>
              <rect x="120" y="60" width="220" height="22" fill="rgba(10,10,10,0.65)"/>
              <text x="230" y="66" text-anchor="middle" font-family="Outfit,sans-serif" font-size="10" font-weight="700" fill="rgba(255,255,255,0.55)">Case Study</text>
              <rect x="140" y="98" width="152" height="8" rx="2" fill="rgba(10,10,10,0.13)"/>
              <rect x="140" y="113" width="116" height="7" rx="2" fill="rgba(10,10,10,0.1)"/>
              <text x="230" y="178" text-anchor="middle" font-family="Outfit,sans-serif" font-size="32" font-weight="900" fill="rgba(10,10,10,0.22)">&lt;15m</text>
            </g>
            <!-- ── Doc 1: front, straight ── -->
            <rect x="120" y="38" width="220" height="272" rx="12" fill="#fff" stroke="rgba(10,10,10,0.82)" stroke-width="2"/>
            <rect x="120" y="38" width="220" height="44" rx="12" fill="#0A0A0A"/>
            <rect x="120" y="60" width="220" height="22" fill="#0A0A0A"/>
            <text x="230" y="65" text-anchor="middle" font-family="Outfit,sans-serif" font-size="11" font-weight="700" fill="#fff">Case Study Report</text>
            <rect x="140" y="98" width="152" height="9" rx="3" fill="rgba(10,10,10,0.14)"/>
            <rect x="140" y="115" width="118" height="7" rx="2" fill="rgba(10,10,10,0.09)"/>
            <rect x="140" y="129" width="136" height="7" rx="2" fill="rgba(10,10,10,0.09)"/>
            <line x1="140" y1="150" x2="320" y2="150" stroke="rgba(10,10,10,0.08)" stroke-width="1.5"/>
            <rect x="140" y="159" width="180" height="68" rx="8" fill="rgba(10,10,10,0.05)"/>
            <text x="230" y="193" text-anchor="middle" font-family="Outfit,sans-serif" font-size="30" font-weight="900" fill="#0A0A0A">&lt;15m</text>
            <text x="230" y="214" text-anchor="middle" font-family="Outfit,sans-serif" font-size="9" font-weight="500" fill="rgba(10,10,10,0.5)">data freshness</text>
            <rect x="140" y="243" width="124" height="7" rx="2" fill="rgba(10,10,10,0.09)"/>
            <rect x="140" y="257" width="146" height="7" rx="2" fill="rgba(10,10,10,0.07)"/>
            <rect x="140" y="275" width="80" height="20" rx="10" stroke="rgba(10,10,10,0.25)" stroke-width="1.5"/>
            <text x="180" y="289" text-anchor="middle" font-family="Outfit,sans-serif" font-size="8" font-weight="700" fill="rgba(10,10,10,0.5)">Data Eng.</text>
            <rect x="228" y="275" width="72" height="20" rx="10" stroke="rgba(10,10,10,0.25)" stroke-width="1.5"/>
            <text x="264" y="289" text-anchor="middle" font-family="Outfit,sans-serif" font-size="8" font-weight="700" fill="rgba(10,10,10,0.5)">Airflow</text>
            <!-- floating badge -->
            <rect x="346" y="50" width="90" height="30" rx="15" fill="#0A0A0A"/>
            <text x="391" y="69" text-anchor="middle" font-family="Outfit,sans-serif" font-size="11" font-weight="700" fill="#fff">1 study</text>
            <!-- decorative dots -->
            <circle cx="66"  cy="130" r="4"   fill="rgba(10,10,10,0.07)"/>
            <circle cx="56"  cy="188" r="2.5" fill="rgba(10,10,10,0.05)"/>
            <circle cx="458" cy="155" r="4"   fill="rgba(10,10,10,0.07)"/>
            <circle cx="464" cy="225" r="2.5" fill="rgba(10,10,10,0.05)"/>
          </svg>
        </div>
      </div>
    </div>
  </div>

  <!-- ── Cards grid ── -->
  <section class="cs-grid-section">
    <div class="container">
      <div class="cs-grid">
        {caseStudies.map((cs) => (
          <article
            class="cs-card"
            onclick={`window.location='/case-studies/${cs.id}'`}
            style="cursor:pointer;"
          >
            <div class="cs-card-metric-bg" aria-hidden="true">{cs.metric}</div>

            <div class="cs-card-illo" aria-hidden="true">
              {cs.id === 'enterprise-data-pipeline' && (
                <svg viewBox="0 0 320 160" fill="none" class="cs-illo-svg">
                  <rect x="16" y="10"  width="288" height="28" rx="5" stroke="#0A0A0A" stroke-width="1.5" opacity="0.15" fill="rgba(10,10,10,0.02)"/>
                  <rect x="16" y="48"  width="288" height="28" rx="5" stroke="#0A0A0A" stroke-width="1.5" opacity="0.28" fill="rgba(10,10,10,0.03)"/>
                  <rect x="16" y="86"  width="288" height="28" rx="5" stroke="#0A0A0A" stroke-width="1.5" opacity="0.48" fill="rgba(10,10,10,0.05)"/>
                  <rect x="16" y="124" width="288" height="28" rx="5" stroke="#0A0A0A" stroke-width="1.5" opacity="0.72" fill="rgba(10,10,10,0.07)"/>
                  <text x="30" y="29"  font-family="Outfit,sans-serif" font-size="9" font-weight="800" fill="#0A0A0A" opacity="0.3"  letter-spacing="0.08em">STAGING</text>
                  <text x="30" y="67"  font-family="Outfit,sans-serif" font-size="9" font-weight="800" fill="#0A0A0A" opacity="0.45" letter-spacing="0.08em">BRONZE</text>
                  <text x="30" y="105" font-family="Outfit,sans-serif" font-size="9" font-weight="800" fill="#0A0A0A" opacity="0.65" letter-spacing="0.08em">SILVER</text>
                  <text x="30" y="143" font-family="Outfit,sans-serif" font-size="9" font-weight="800" fill="#0A0A0A" opacity="0.85" letter-spacing="0.08em">GOLD</text>
                  <path d="M160 40 L160 46" stroke="#0A0A0A" stroke-width="1.5" opacity="0.28" stroke-linecap="round"/>
                  <path d="M157 43 L160 48 L163 43" stroke="#0A0A0A" stroke-width="1.5" opacity="0.28" stroke-linecap="round" stroke-linejoin="round"/>
                  <path d="M160 78 L160 84" stroke="#0A0A0A" stroke-width="1.5" opacity="0.42" stroke-linecap="round"/>
                  <path d="M157 81 L160 86 L163 81" stroke="#0A0A0A" stroke-width="1.5" opacity="0.42" stroke-linecap="round" stroke-linejoin="round"/>
                  <path d="M160 116 L160 122" stroke="#0A0A0A" stroke-width="1.5" opacity="0.6" stroke-linecap="round"/>
                  <path d="M157 119 L160 124 L163 119" stroke="#0A0A0A" stroke-width="1.5" opacity="0.6" stroke-linecap="round" stroke-linejoin="round"/>
                  <rect x="208" y="124" width="88" height="28" rx="5" fill="#0A0A0A"/>
                  <text x="252" y="143" text-anchor="middle" font-family="Outfit,sans-serif" font-size="10" font-weight="800" fill="#fff">&lt;15 min</text>
                </svg>
              )}
            </div>

            <div class="cs-card-body">
              <div class="cs-card-header">
                <span class="cs-card-index">{cs.index}</span>
                <span class="cs-card-industry">{cs.industry}</span>
                <span class="cs-card-service">{cs.service}</span>
              </div>
              <h2 class="cs-card-company">{cs.company}</h2>
              <p class="cs-card-headline">{cs.headline}</p>
              <div class="cs-card-metric-row">
                <span class="cs-card-metric-num">{cs.metric}</span>
                <span class="cs-card-metric-desc">{cs.metricLabel}</span>
              </div>
              <p class="cs-card-summary">{cs.summary}</p>
              <div class="cs-card-meta">
                <span class="cs-card-result">{cs.result}</span>
                <span class="cs-card-duration">{cs.duration}</span>
              </div>
              <div class="cs-card-tags">
                {cs.tags.slice(0, 5).map(tag => (
                  <span class="cs-tag">{tag}</span>
                ))}
              </div>
              <a href={`/case-studies/${cs.id}`} class="cs-card-link">
                Read full case study &rarr;
              </a>
            </div>
          </article>
        ))}
      </div>
    </div>
  </section>

  <!-- ── CTA ── -->
  <section class="cs-cta">
    <div class="container">
      <div class="cs-cta-inner">
        <div class="cs-cta-text">
          <p class="cs-cta-label">Ready to get started?</p>
          <h2 class="cs-cta-title">Your result could be next.</h2>
          <p class="cs-cta-sub">Tell us about your data challenge. We'll scope it and respond within one business day.</p>
        </div>
        <div class="cs-cta-actions">
          <a href="/contact" class="cs-cta-btn-primary">Start a conversation &rarr;</a>
          <a href="#schedule" class="cs-cta-btn-secondary">Book a 30-min call</a>
        </div>
      </div>
    </div>
  </section>

</Page>

<style>
/* ── Hero ── */
.cs-hero {
  background: #F5F5F2;
  padding-top: 7rem;
  padding-bottom: 3rem;
  border-bottom: 1px solid #E0E0DC;
  overflow: hidden;
}
.cs-hero-split {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 2rem;
  align-items: center;
}
.cs-hero-title {
  font-size: clamp(2.75rem, 5vw, 4.5rem);
  font-weight: 900;
  letter-spacing: -0.04em;
  line-height: 1.05;
  color: #0A0A0A;
  margin: 0.75rem 0 1.25rem;
}
.cs-hero-sub { font-size: 1rem; color: #5A5A5A; line-height: 1.75; max-width: 440px; }
.cs-hero-illo { display: flex; justify-content: center; align-items: center; }
.cs-hero-svg  { width: 100%; max-width: 480px; height: auto; }

/* ── Grid ── */
.cs-grid-section { background: #fff; padding: 4rem 0 5rem; }
.cs-grid {
  display: grid;
  grid-template-columns: 1fr;
  gap: 1.5rem;
  max-width: 900px;
  margin: 0 auto;
}

/* Card */
.cs-card {
  background: #fff;
  border: 1px solid #E0E0DC;
  border-radius: 16px;
  overflow: hidden;
  position: relative;
  transition: transform 220ms cubic-bezier(0.34,1.56,0.64,1), box-shadow 220ms ease, border-color 220ms ease;
}
.cs-card:hover {
  transform: translateY(-4px);
  box-shadow: 0 12px 40px rgba(10,10,10,0.1), 0 2px 8px rgba(10,10,10,0.06);
  border-color: #0A0A0A;
}
.cs-card-metric-bg {
  position: absolute;
  top: 8px; right: 16px;
  font-size: 7rem;
  font-weight: 900;
  letter-spacing: -0.05em;
  color: #0A0A0A;
  opacity: 0.04;
  font-family: 'Outfit', sans-serif;
  line-height: 1;
  pointer-events: none;
  user-select: none;
  z-index: 0;
}
.cs-card-illo {
  background: #F5F5F2;
  border-bottom: 1px solid #E0E0DC;
  padding: 2.5rem 6rem;
  display: flex;
  align-items: center;
  justify-content: center;
  height: 240px;
  position: relative;
  z-index: 1;
}
.cs-illo-svg { width: 100%; height: 100%; }
.cs-card-body { padding: 1.75rem; position: relative; z-index: 1; }
.cs-card-header {
  display: flex;
  align-items: center;
  gap: 0.5rem;
  margin-bottom: 0.75rem;
  flex-wrap: wrap;
}
.cs-card-index {
  font-size: 0.7rem;
  font-weight: 900;
  color: rgba(10,10,10,0.25);
  font-family: 'Outfit', sans-serif;
  letter-spacing: 0.08em;
}
.cs-card-industry, .cs-card-service {
  font-size: 0.7rem;
  font-weight: 700;
  letter-spacing: 0.08em;
  text-transform: uppercase;
  color: #5A5A5A;
  background: #F5F5F2;
  border: 1px solid #E0E0DC;
  border-radius: 100px;
  padding: 0.2rem 0.625rem;
}
.cs-card-company {
  font-size: 1.375rem;
  font-weight: 900;
  letter-spacing: -0.02em;
  color: #0A0A0A;
  margin-bottom: 0.375rem;
  line-height: 1.2;
}
.cs-card-headline {
  font-size: 0.875rem;
  color: #5A5A5A;
  font-style: italic;
  margin-bottom: 1.25rem;
  line-height: 1.5;
}
.cs-card-metric-row {
  display: flex;
  align-items: baseline;
  gap: 0.625rem;
  margin-bottom: 1rem;
  padding-bottom: 1rem;
  border-bottom: 1px solid #E0E0DC;
}
.cs-card-metric-num {
  font-size: 2.5rem;
  font-weight: 900;
  letter-spacing: -0.04em;
  color: #0A0A0A;
  font-family: 'Outfit', sans-serif;
  line-height: 1;
}
.cs-card-metric-desc {
  font-size: 0.8rem;
  color: #5A5A5A;
  font-weight: 500;
  line-height: 1.4;
  max-width: 200px;
}
.cs-card-summary {
  font-size: 0.875rem;
  color: #5A5A5A;
  line-height: 1.75;
  margin-bottom: 1rem;
}
.cs-card-meta {
  display: flex;
  justify-content: space-between;
  align-items: flex-start;
  gap: 0.5rem;
  margin-bottom: 1rem;
  font-size: 0.75rem;
}
.cs-card-result { color: #0A0A0A; font-weight: 600; line-height: 1.4; flex: 1; }
.cs-card-duration {
  color: #5A5A5A;
  font-weight: 500;
  white-space: nowrap;
  padding: 0.2rem 0.625rem;
  background: #F5F5F2;
  border: 1px solid #E0E0DC;
  border-radius: 100px;
  flex-shrink: 0;
}
.cs-card-tags { display: flex; flex-wrap: wrap; gap: 0.375rem; }
.cs-tag {
  font-size: 0.7rem;
  font-weight: 600;
  color: #5A5A5A;
  background: #fff;
  border: 1px solid #E0E0DC;
  border-radius: 100px;
  padding: 0.2rem 0.625rem;
}
.cs-card-link {
  display: inline-flex;
  align-items: center;
  margin-top: 1rem;
  font-size: 0.8125rem;
  font-weight: 700;
  color: #0A0A0A;
  text-decoration: none;
  border-bottom: 1.5px solid #E0E0DC;
  padding-bottom: 1px;
  transition: border-color 150ms, opacity 150ms;
}
.cs-card-link:hover { border-color: #0A0A0A; opacity: 0.7; color: #0A0A0A; }

/* ── CTA ── */
.cs-cta { background: #0A0A0A; padding: 5rem 0; }
.cs-cta-inner { display: flex; align-items: center; justify-content: space-between; gap: 3rem; flex-wrap: wrap; }
.cs-cta-label { font-size: 0.75rem; font-weight: 700; letter-spacing: 0.12em; text-transform: uppercase; color: rgba(255,255,255,0.4); margin-bottom: 0.75rem; }
.cs-cta-title { font-size: clamp(2rem, 3.5vw, 3rem); font-weight: 900; letter-spacing: -0.03em; color: #fff; margin-bottom: 0.75rem; line-height: 1.1; }
.cs-cta-sub { font-size: 0.9375rem; color: rgba(255,255,255,0.5); line-height: 1.7; max-width: 420px; }
.cs-cta-actions { display: flex; flex-direction: column; gap: 0.75rem; flex-shrink: 0; }
.cs-cta-btn-primary { display: inline-flex; align-items: center; background: #fff; color: #0A0A0A; padding: 0.875rem 1.75rem; border-radius: 100px; font-weight: 700; font-size: 0.9375rem; text-decoration: none; transition: opacity 150ms, transform 150ms; white-space: nowrap; }
.cs-cta-btn-primary:hover { opacity: 0.88; transform: translateY(-1px); color: #0A0A0A; }
.cs-cta-btn-secondary { display: inline-flex; align-items: center; justify-content: center; background: transparent; color: rgba(255,255,255,0.6); padding: 0.875rem 1.75rem; border-radius: 100px; border: 1px solid rgba(255,255,255,0.2); font-weight: 600; font-size: 0.9375rem; text-decoration: none; transition: color 150ms, border-color 150ms; white-space: nowrap; }
.cs-cta-btn-secondary:hover { color: #fff; border-color: rgba(255,255,255,0.5); }

/* ── Responsive ── */
@media (max-width: 1024px) { .cs-grid { grid-template-columns: 1fr; } }
@media (max-width: 767px) {
  .cs-hero       { padding-top: 5.5rem; padding-bottom: 2rem; }
  .cs-hero-split { grid-template-columns: 1fr; }
  .cs-hero-illo  { display: none; }
  .cs-hero-title { font-size: 2.75rem; }
  .cs-cta-inner  { flex-direction: column; align-items: flex-start; }
  .cs-cta-actions { flex-direction: row; flex-wrap: wrap; }
}
</style>
