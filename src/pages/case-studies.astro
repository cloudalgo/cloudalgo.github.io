---
import Page from '../layouts/Page.astro';
import { caseStudies } from '../data/case-studies';
import Breadcrumb from '@/components/ui/Breadcrumb.astro';
import SectionLabel from '../components/ui/SectionLabel.astro';
import Badge from '@/components/ui/Badge.astro';

---

<Page
  title="Case Studies — CloudAlgo | Salesforce, Heroku & MuleSoft Results"
  description="Real outcomes from CloudAlgo's Salesforce, Heroku, and MuleSoft engagements — bidirectional CRM integrations, EMR automation, and data pipelines built for healthcare, distribution, and non-profit clients."
>

  <!-- ── Hero ── -->
  <div class="cs-hero">
    <div class="container">
      <div class="cs-hero-split">
        <div class="cs-hero-text">
          <Breadcrumb items={[{ label: 'Home', href: '/' }, { label: 'Case Studies' }]} />
          <SectionLabel>Results that speak</SectionLabel>
          <h1 class="cs-hero-title">What we've built.<br/>What it delivered.</h1>
          <p class="cs-hero-sub">Real engagements, real constraints, and the numbers they moved.</p>
        </div>
        <div class="cs-hero-illo" aria-hidden="true">
          <svg viewBox="0 0 480 340" fill="none" xmlns="http://www.w3.org/2000/svg" class="cs-hero-svg">
            <!-- ── Doc 3: back, rotated left ── -->
            <g transform="rotate(-13 230 175)">
              <rect x="120" y="38" width="220" height="272" rx="12" fill="var(--surface-tint)" stroke="rgba(var(--ink-900-rgb), 0.18)" stroke-width="1.5"/>
              <rect x="120" y="38" width="220" height="44" rx="12" fill="rgba(var(--ink-900-rgb), 0.15)"/>
              <rect x="120" y="60" width="220" height="22" fill="rgba(var(--ink-900-rgb), 0.15)"/>
              <rect x="140" y="98" width="138" height="8" rx="2" fill="rgba(var(--ink-900-rgb), 0.09)"/>
              <rect x="140" y="113" width="106" height="7" rx="2" fill="rgba(var(--ink-900-rgb), 0.07)"/>
              <rect x="140" y="127" width="122" height="7" rx="2" fill="rgba(var(--ink-900-rgb), 0.07)"/>
            </g>
            <!-- ── Doc 2: middle, slightly rotated ── -->
            <g transform="rotate(-5 230 175)">
              <rect x="120" y="38" width="220" height="272" rx="12" fill="var(--surface-wash)" stroke="rgba(var(--ink-900-rgb), 0.42)" stroke-width="1.5"/>
              <rect x="120" y="38" width="220" height="44" rx="12" fill="rgba(var(--ink-900-rgb), 0.65)"/>
              <rect x="120" y="60" width="220" height="22" fill="rgba(var(--ink-900-rgb), 0.65)"/>
              <text x="230" y="66" text-anchor="middle" font-family="Outfit,sans-serif" font-size="10" font-weight="700" fill="rgba(var(--paper-000-rgb), 0.55)">Case Study</text>
              <rect x="140" y="98" width="152" height="8" rx="2" fill="rgba(var(--ink-900-rgb), 0.13)"/>
              <rect x="140" y="113" width="116" height="7" rx="2" fill="rgba(var(--ink-900-rgb), 0.1)"/>
              <text x="230" y="178" text-anchor="middle" font-family="Outfit,sans-serif" font-size="32" font-weight="900" fill="rgba(var(--ink-900-rgb), 0.22)">&lt;15m</text>
            </g>
            <!-- ── Doc 1: front, straight ── -->
            <rect x="120" y="38" width="220" height="272" rx="12" fill="var(--illus-surface)" stroke="rgba(var(--ink-900-rgb), 0.82)" stroke-width="2"/>
            <rect x="120" y="38" width="220" height="44" rx="12" fill="var(--illus-ink)"/>
            <rect x="120" y="60" width="220" height="22" fill="var(--illus-ink)"/>
            <text x="230" y="65" text-anchor="middle" font-family="Outfit,sans-serif" font-size="11" font-weight="700" fill="var(--illus-surface)">Case Study Report</text>
            <rect x="140" y="98" width="152" height="9" rx="3" fill="rgba(var(--ink-900-rgb), 0.14)"/>
            <rect x="140" y="115" width="118" height="7" rx="2" fill="rgba(var(--ink-900-rgb), 0.09)"/>
            <rect x="140" y="129" width="136" height="7" rx="2" fill="rgba(var(--ink-900-rgb), 0.09)"/>
            <line x1="140" y1="150" x2="320" y2="150" stroke="rgba(var(--ink-900-rgb), 0.08)" stroke-width="1.5"/>
            <rect x="140" y="159" width="180" height="68" rx="8" fill="rgba(var(--ink-900-rgb), 0.05)"/>
            <text x="230" y="193" text-anchor="middle" font-family="Outfit,sans-serif" font-size="30" font-weight="900" fill="var(--illus-ink)">&lt;15m</text>
            <text x="230" y="214" text-anchor="middle" font-family="Outfit,sans-serif" font-size="9" font-weight="500" fill="rgba(var(--ink-900-rgb), 0.5)">data freshness</text>
            <rect x="140" y="243" width="124" height="7" rx="2" fill="rgba(var(--ink-900-rgb), 0.09)"/>
            <rect x="140" y="257" width="146" height="7" rx="2" fill="rgba(var(--ink-900-rgb), 0.07)"/>
            <rect x="140" y="275" width="80" height="20" rx="10" stroke="rgba(var(--ink-900-rgb), 0.25)" stroke-width="1.5"/>
            <text x="180" y="289" text-anchor="middle" font-family="Outfit,sans-serif" font-size="8" font-weight="700" fill="rgba(var(--ink-900-rgb), 0.5)">Data Eng.</text>
            <rect x="228" y="275" width="72" height="20" rx="10" stroke="rgba(var(--ink-900-rgb), 0.25)" stroke-width="1.5"/>
            <text x="264" y="289" text-anchor="middle" font-family="Outfit,sans-serif" font-size="8" font-weight="700" fill="rgba(var(--ink-900-rgb), 0.5)">Airflow</text>
            <!-- floating badge -->
            <rect x="346" y="50" width="90" height="30" rx="15" fill="var(--illus-ink)"/>
            <text x="391" y="69" text-anchor="middle" font-family="Outfit,sans-serif" font-size="11" font-weight="700" fill="var(--illus-surface)">5 studies</text>
            <!-- decorative dots -->
            <circle cx="66"  cy="130" r="4"   fill="rgba(var(--ink-900-rgb), 0.07)"/>
            <circle cx="56"  cy="188" r="2.5" fill="rgba(var(--ink-900-rgb), 0.05)"/>
            <circle cx="458" cy="155" r="4"   fill="rgba(var(--ink-900-rgb), 0.07)"/>
            <circle cx="464" cy="225" r="2.5" fill="rgba(var(--ink-900-rgb), 0.05)"/>
          </svg>
        </div>
      </div>
    </div>
  </div>

  <!-- ── Cards grid ── -->
  <section class="cs-grid-section">
    <div class="container">
      <div class="cs-grid">
        {caseStudies.map((cs) => (
          <article
            class="card card--radius-2xl card--lift cs-card"
            onclick={`window.location='/case-studies/${cs.id}'`}
            style="cursor:pointer;"
          >
            <div class="stat-num stat-num--3xl stat-num--tighter cs-card-metric-bg" aria-hidden="true">{cs.metric}</div>

            <div class="cs-card-illo" aria-hidden="true">
              {cs.id === 'nonprofit-web-platform' && (
                <svg viewBox="0 0 320 160" fill="none" class="cs-illo-svg">
                  <!-- Layer 1: Frontend -->
                  <rect x="16" y="12" width="288" height="30" rx="5" stroke="var(--illus-ink)" stroke-width="1.5" opacity="0.15" fill="rgba(var(--ink-900-rgb), 0.02)"/>
                  <text x="30" y="31" font-family="Outfit,sans-serif" font-size="9" font-weight="800" fill="var(--illus-ink)" opacity="0.30" letter-spacing="0.08em">NEXT.JS 14 · REACT 18</text>
                  <!-- Arrow 1→2 -->
                  <path d="M160 44 L160 50" stroke="var(--illus-ink)" stroke-width="1.5" opacity="0.25" stroke-linecap="round"/>
                  <path d="M157 47 L160 52 L163 47" stroke="var(--illus-ink)" stroke-width="1.5" opacity="0.25" stroke-linecap="round" stroke-linejoin="round"/>
                  <!-- Layer 2: Backend -->
                  <rect x="16" y="52" width="288" height="30" rx="5" stroke="var(--illus-ink)" stroke-width="1.5" opacity="0.32" fill="rgba(var(--ink-900-rgb), 0.04)"/>
                  <text x="30" y="71" font-family="Outfit,sans-serif" font-size="9" font-weight="800" fill="var(--illus-ink)" opacity="0.52" letter-spacing="0.08em">NODE.JS API · HEROKU</text>
                  <!-- Arrow 2→3 -->
                  <path d="M160 84 L160 90" stroke="var(--illus-ink)" stroke-width="1.5" opacity="0.35" stroke-linecap="round"/>
                  <path d="M157 87 L160 92 L163 87" stroke="var(--illus-ink)" stroke-width="1.5" opacity="0.35" stroke-linecap="round" stroke-linejoin="round"/>
                  <!-- Integration nodes -->
                  <rect x="16" y="92" width="72" height="28" rx="5" stroke="var(--illus-ink)" stroke-width="1.5" opacity="0.45" fill="rgba(var(--ink-900-rgb), 0.05)"/>
                  <text x="52" y="110" text-anchor="middle" font-family="Outfit,sans-serif" font-size="8" font-weight="800" fill="var(--illus-ink)" opacity="0.65">Salesforce</text>
                  <rect x="96" y="92" width="52" height="28" rx="5" stroke="var(--illus-ink)" stroke-width="1.5" opacity="0.45" fill="rgba(var(--ink-900-rgb), 0.05)"/>
                  <text x="122" y="110" text-anchor="middle" font-family="Outfit,sans-serif" font-size="8" font-weight="800" fill="var(--illus-ink)" opacity="0.65">Stripe</text>
                  <rect x="156" y="92" width="60" height="28" rx="5" stroke="var(--illus-ink)" stroke-width="1.5" opacity="0.45" fill="rgba(var(--ink-900-rgb), 0.05)"/>
                  <text x="186" y="110" text-anchor="middle" font-family="Outfit,sans-serif" font-size="8" font-weight="800" fill="var(--illus-ink)" opacity="0.65">Cognito</text>
                  <!-- Metric badge -->
                  <rect x="224" y="92" width="80" height="28" rx="5" fill="var(--illus-ink)"/>
                  <text x="264" y="110" text-anchor="middle" font-family="Outfit,sans-serif" font-size="10" font-weight="800" fill="var(--illus-surface)">2+ yrs</text>
                  <!-- Sub-row: additional integrations label -->
                  <text x="16" y="140" font-family="Outfit,sans-serif" font-size="8" font-weight="600" fill="var(--illus-ink)" opacity="0.22" letter-spacing="0.05em">Segment · Marketing Cloud · Framer Motion · React Query</text>
                </svg>
              )}
              {cs.id === 'enterprise-data-pipeline' && (
                <svg viewBox="0 0 320 160" fill="none" class="cs-illo-svg">
                  <rect x="16" y="10"  width="288" height="28" rx="5" stroke="var(--illus-ink)" stroke-width="1.5" opacity="0.15" fill="rgba(var(--ink-900-rgb), 0.02)"/>
                  <rect x="16" y="48"  width="288" height="28" rx="5" stroke="var(--illus-ink)" stroke-width="1.5" opacity="0.28" fill="rgba(var(--ink-900-rgb), 0.03)"/>
                  <rect x="16" y="86"  width="288" height="28" rx="5" stroke="var(--illus-ink)" stroke-width="1.5" opacity="0.48" fill="rgba(var(--ink-900-rgb), 0.05)"/>
                  <rect x="16" y="124" width="288" height="28" rx="5" stroke="var(--illus-ink)" stroke-width="1.5" opacity="0.72" fill="rgba(var(--ink-900-rgb), 0.07)"/>
                  <text x="30" y="29"  font-family="Outfit,sans-serif" font-size="9" font-weight="800" fill="var(--illus-ink)" opacity="0.3"  letter-spacing="0.08em">STAGING</text>
                  <text x="30" y="67"  font-family="Outfit,sans-serif" font-size="9" font-weight="800" fill="var(--illus-ink)" opacity="0.45" letter-spacing="0.08em">BRONZE</text>
                  <text x="30" y="105" font-family="Outfit,sans-serif" font-size="9" font-weight="800" fill="var(--illus-ink)" opacity="0.65" letter-spacing="0.08em">SILVER</text>
                  <text x="30" y="143" font-family="Outfit,sans-serif" font-size="9" font-weight="800" fill="var(--illus-ink)" opacity="0.85" letter-spacing="0.08em">GOLD</text>
                  <path d="M160 40 L160 46" stroke="var(--illus-ink)" stroke-width="1.5" opacity="0.28" stroke-linecap="round"/>
                  <path d="M157 43 L160 48 L163 43" stroke="var(--illus-ink)" stroke-width="1.5" opacity="0.28" stroke-linecap="round" stroke-linejoin="round"/>
                  <path d="M160 78 L160 84" stroke="var(--illus-ink)" stroke-width="1.5" opacity="0.42" stroke-linecap="round"/>
                  <path d="M157 81 L160 86 L163 81" stroke="var(--illus-ink)" stroke-width="1.5" opacity="0.42" stroke-linecap="round" stroke-linejoin="round"/>
                  <path d="M160 116 L160 122" stroke="var(--illus-ink)" stroke-width="1.5" opacity="0.6" stroke-linecap="round"/>
                  <path d="M157 119 L160 124 L163 119" stroke="var(--illus-ink)" stroke-width="1.5" opacity="0.6" stroke-linecap="round" stroke-linejoin="round"/>
                  <rect x="208" y="124" width="88" height="28" rx="5" fill="var(--illus-ink)"/>
                  <text x="252" y="143" text-anchor="middle" font-family="Outfit,sans-serif" font-size="10" font-weight="800" fill="var(--illus-surface)">&lt;15 min</text>
                </svg>
              )}
              {cs.id === 'salesforce-netsuite-sync' && (
                <svg viewBox="0 0 320 160" fill="none" class="cs-illo-svg">
                  <rect x="16" y="10"  width="288" height="28" rx="5" stroke="var(--illus-ink)" stroke-width="1.5" opacity="0.15" fill="rgba(var(--ink-900-rgb), 0.02)"/>
                  <rect x="16" y="48"  width="288" height="28" rx="5" stroke="var(--illus-ink)" stroke-width="1.5" opacity="0.28" fill="rgba(var(--ink-900-rgb), 0.03)"/>
                  <rect x="16" y="86"  width="288" height="28" rx="5" stroke="var(--illus-ink)" stroke-width="1.5" opacity="0.48" fill="rgba(var(--ink-900-rgb), 0.05)"/>
                  <rect x="16" y="124" width="288" height="28" rx="5" stroke="var(--illus-ink)" stroke-width="1.5" opacity="0.72" fill="rgba(var(--ink-900-rgb), 0.07)"/>
                  <text x="30" y="29"  font-family="Outfit,sans-serif" font-size="9" font-weight="800" fill="var(--illus-ink)" opacity="0.30" letter-spacing="0.08em">SALESFORCE CRM</text>
                  <text x="30" y="67"  font-family="Outfit,sans-serif" font-size="9" font-weight="800" fill="var(--illus-ink)" opacity="0.45" letter-spacing="0.08em">MULESOFT ANYPOINT</text>
                  <text x="30" y="105" font-family="Outfit,sans-serif" font-size="9" font-weight="800" fill="var(--illus-ink)" opacity="0.65" letter-spacing="0.08em">NETSUITE ERP</text>
                  <text x="30" y="143" font-family="Outfit,sans-serif" font-size="9" font-weight="800" fill="var(--illus-ink)" opacity="0.85" letter-spacing="0.08em">ORDERS · INVOICES · PAYMENTS</text>
                  <!-- down arrow 1→2 -->
                  <path d="M160 40 L160 46" stroke="var(--illus-ink)" stroke-width="1.5" opacity="0.28" stroke-linecap="round"/>
                  <path d="M157 43 L160 48 L163 43" stroke="var(--illus-ink)" stroke-width="1.5" opacity="0.28" stroke-linecap="round" stroke-linejoin="round"/>
                  <!-- dashed return 2→1 -->
                  <path d="M150 46 L150 40" stroke="var(--illus-ink)" stroke-width="1.2" opacity="0.14" stroke-linecap="round" stroke-dasharray="3 2"/>
                  <!-- down arrow 2→3 -->
                  <path d="M160 78 L160 84" stroke="var(--illus-ink)" stroke-width="1.5" opacity="0.42" stroke-linecap="round"/>
                  <path d="M157 81 L160 86 L163 81" stroke="var(--illus-ink)" stroke-width="1.5" opacity="0.42" stroke-linecap="round" stroke-linejoin="round"/>
                  <!-- dashed return 3→2 -->
                  <path d="M150 84 L150 78" stroke="var(--illus-ink)" stroke-width="1.2" opacity="0.18" stroke-linecap="round" stroke-dasharray="3 2"/>
                  <!-- down arrow 3→4 -->
                  <path d="M160 116 L160 122" stroke="var(--illus-ink)" stroke-width="1.5" opacity="0.60" stroke-linecap="round"/>
                  <path d="M157 119 L160 124 L163 119" stroke="var(--illus-ink)" stroke-width="1.5" opacity="0.60" stroke-linecap="round" stroke-linejoin="round"/>
                  <!-- metric badge -->
                  <rect x="214" y="124" width="82" height="28" rx="5" fill="var(--illus-ink)"/>
                  <text x="255" y="143" text-anchor="middle" font-family="Outfit,sans-serif" font-size="10" font-weight="800" fill="var(--illus-surface)">0 re-entry</text>
                </svg>
              )}
              {cs.id === 'salesforce-emr-sync' && (
                <svg viewBox="0 0 320 160" fill="none" class="cs-illo-svg">
                  <rect x="16" y="10"  width="288" height="28" rx="5" stroke="var(--illus-ink)" stroke-width="1.5" opacity="0.15" fill="rgba(var(--ink-900-rgb), 0.02)"/>
                  <rect x="16" y="48"  width="288" height="28" rx="5" stroke="var(--illus-ink)" stroke-width="1.5" opacity="0.28" fill="rgba(var(--ink-900-rgb), 0.03)"/>
                  <rect x="16" y="86"  width="288" height="28" rx="5" stroke="var(--illus-ink)" stroke-width="1.5" opacity="0.48" fill="rgba(var(--ink-900-rgb), 0.05)"/>
                  <rect x="16" y="124" width="288" height="28" rx="5" stroke="var(--illus-ink)" stroke-width="1.5" opacity="0.72" fill="rgba(var(--ink-900-rgb), 0.07)"/>
                  <text x="30" y="29"  font-family="Outfit,sans-serif" font-size="9" font-weight="800" fill="var(--illus-ink)" opacity="0.3"  letter-spacing="0.08em">SALESFORCE CRM</text>
                  <text x="30" y="67"  font-family="Outfit,sans-serif" font-size="9" font-weight="800" fill="var(--illus-ink)" opacity="0.45" letter-spacing="0.08em">RABBITMQ QUEUE</text>
                  <text x="30" y="105" font-family="Outfit,sans-serif" font-size="9" font-weight="800" fill="var(--illus-ink)" opacity="0.65" letter-spacing="0.08em">HEROKU WORKER · PUPPETEER</text>
                  <text x="30" y="143" font-family="Outfit,sans-serif" font-size="9" font-weight="800" fill="var(--illus-ink)" opacity="0.85" letter-spacing="0.08em">FUSION EMR PORTAL</text>
                  <path d="M160 40 L160 46" stroke="var(--illus-ink)" stroke-width="1.5" opacity="0.28" stroke-linecap="round"/>
                  <path d="M157 43 L160 48 L163 43" stroke="var(--illus-ink)" stroke-width="1.5" opacity="0.28" stroke-linecap="round" stroke-linejoin="round"/>
                  <path d="M160 78 L160 84" stroke="var(--illus-ink)" stroke-width="1.5" opacity="0.42" stroke-linecap="round"/>
                  <path d="M157 81 L160 86 L163 81" stroke="var(--illus-ink)" stroke-width="1.5" opacity="0.42" stroke-linecap="round" stroke-linejoin="round"/>
                  <path d="M160 116 L160 122" stroke="var(--illus-ink)" stroke-width="1.5" opacity="0.6" stroke-linecap="round"/>
                  <path d="M157 119 L160 124 L163 119" stroke="var(--illus-ink)" stroke-width="1.5" opacity="0.6" stroke-linecap="round" stroke-linejoin="round"/>
                  <rect x="220" y="124" width="76" height="28" rx="5" fill="var(--illus-ink)"/>
                  <text x="258" y="143" text-anchor="middle" font-family="Outfit,sans-serif" font-size="10" font-weight="800" fill="var(--illus-surface)">0 errors</text>
                </svg>
              )}
              {cs.id === 'health-portal-mulesoft-integration' && (
                <svg viewBox="0 0 320 160" fill="none" class="cs-illo-svg">
                  <rect x="16" y="10"  width="288" height="28" rx="5" stroke="var(--illus-ink)" stroke-width="1.5" opacity="0.15" fill="rgba(var(--ink-900-rgb), 0.02)"/>
                  <rect x="16" y="48"  width="288" height="28" rx="5" stroke="var(--illus-ink)" stroke-width="1.5" opacity="0.28" fill="rgba(var(--ink-900-rgb), 0.03)"/>
                  <rect x="16" y="86"  width="288" height="28" rx="5" stroke="var(--illus-ink)" stroke-width="1.5" opacity="0.48" fill="rgba(var(--ink-900-rgb), 0.05)"/>
                  <rect x="16" y="124" width="288" height="28" rx="5" stroke="var(--illus-ink)" stroke-width="1.5" opacity="0.72" fill="rgba(var(--ink-900-rgb), 0.07)"/>
                  <text x="30" y="29"  font-family="Outfit,sans-serif" font-size="9" font-weight="800" fill="var(--illus-ink)" opacity="0.30" letter-spacing="0.08em">HEALTH PORTAL</text>
                  <text x="30" y="67"  font-family="Outfit,sans-serif" font-size="9" font-weight="800" fill="var(--illus-ink)" opacity="0.45" letter-spacing="0.08em">MULESOFT ANYPOINT · 8 APPS</text>
                  <text x="30" y="105" font-family="Outfit,sans-serif" font-size="9" font-weight="800" fill="var(--illus-ink)" opacity="0.65" letter-spacing="0.08em">SALESFORCE CRM</text>
                  <text x="30" y="143" font-family="Outfit,sans-serif" font-size="9" font-weight="800" fill="var(--illus-ink)" opacity="0.85" letter-spacing="0.08em">LOGISTICS PLATFORM · KITS</text>
                  <path d="M160 40 L160 46" stroke="var(--illus-ink)" stroke-width="1.5" opacity="0.28" stroke-linecap="round"/>
                  <path d="M157 43 L160 48 L163 43" stroke="var(--illus-ink)" stroke-width="1.5" opacity="0.28" stroke-linecap="round" stroke-linejoin="round"/>
                  <path d="M150 46 L150 40" stroke="var(--illus-ink)" stroke-width="1.2" opacity="0.14" stroke-linecap="round" stroke-dasharray="3 2"/>
                  <path d="M160 78 L160 84" stroke="var(--illus-ink)" stroke-width="1.5" opacity="0.42" stroke-linecap="round"/>
                  <path d="M157 81 L160 86 L163 81" stroke="var(--illus-ink)" stroke-width="1.5" opacity="0.42" stroke-linecap="round" stroke-linejoin="round"/>
                  <path d="M150 84 L150 78" stroke="var(--illus-ink)" stroke-width="1.2" opacity="0.18" stroke-linecap="round" stroke-dasharray="3 2"/>
                  <path d="M160 116 L160 122" stroke="var(--illus-ink)" stroke-width="1.5" opacity="0.60" stroke-linecap="round"/>
                  <path d="M157 119 L160 124 L163 119" stroke="var(--illus-ink)" stroke-width="1.5" opacity="0.60" stroke-linecap="round" stroke-linejoin="round"/>
                  <rect x="218" y="124" width="78" height="28" rx="5" fill="var(--illus-ink)"/>
                  <text x="257" y="143" text-anchor="middle" font-family="Outfit,sans-serif" font-size="10" font-weight="800" fill="var(--illus-surface)">5 min sync</text>
                </svg>
              )}
            </div>

            <div class="cs-card-body">
              <div class="cs-card-header">
                <span class="ordinal ordinal--wide ordinal--watermark-strong">{cs.index}</span>
                <span class="cs-card-industry">{cs.industry}</span>
                <span class="cs-card-service">{cs.service}</span>
              </div>
              <h2 class="cs-card-company">{cs.company}</h2>
              <p class="cs-card-headline">{cs.headline}</p>
              <div class="cs-card-metric-row">
                <span class="stat-num stat-num--lg stat-num--tight">{cs.metric}</span>
                <span class="stat-label stat-label--sm cs-card-metric-desc">{cs.metricLabel}</span>
              </div>
              <p class="cs-card-summary">{cs.summary}</p>
              <div class="cs-card-meta">
                <span class="cs-card-result">{cs.result}</span>
                <span class="cs-card-duration">{cs.duration}</span>
              </div>
              <div class="cs-card-tags">
