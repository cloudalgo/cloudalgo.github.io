---
import Page from '../layouts/Page.astro';
import { caseStudies } from '../data/case-studies';

---

<Page
  title="Case Studies — CloudAlgo | Salesforce & Heroku Results"
  description="Real outcomes from CloudAlgo's Salesforce, Heroku, MuleSoft, and AppExchange engagements. See how we've delivered measurable results for clients across retail, healthcare, energy, insurance, manufacturing, and pharma."
>

  <!-- ── Hero ── -->
  <div class="cs-hero">
    <div class="container">
      <div class="cs-hero-split">
        <div class="cs-hero-text">
          <nav class="breadcrumb">
            <a href="/">Home</a>
            <span>&rarr;</span>
            <span>Case Studies</span>
          </nav>
          <p class="section-label">Results that speak</p>
          <h1 class="cs-hero-title">What we've built.<br/>What it delivered.</h1>
          <p class="cs-hero-sub">Six engagements across six industries. Measurable outcomes every time.</p>
        </div>
        <div class="cs-hero-illo" aria-hidden="true">
          <svg viewBox="0 0 480 340" fill="none" xmlns="http://www.w3.org/2000/svg" class="cs-hero-svg">

            <!-- ── Doc 3: back, rotated left ── -->
            <g transform="rotate(-13 230 175)">
              <rect x="120" y="38" width="220" height="272" rx="12" fill="#f0f0ec" stroke="rgba(10,10,10,0.18)" stroke-width="1.5"/>
              <rect x="120" y="38" width="220" height="44" rx="12" fill="rgba(10,10,10,0.15)"/>
              <rect x="120" y="60" width="220" height="22" fill="rgba(10,10,10,0.15)"/>
              <rect x="140" y="98" width="138" height="8" rx="2" fill="rgba(10,10,10,0.09)"/>
              <rect x="140" y="113" width="106" height="7" rx="2" fill="rgba(10,10,10,0.07)"/>
              <rect x="140" y="127" width="122" height="7" rx="2" fill="rgba(10,10,10,0.07)"/>
            </g>

            <!-- ── Doc 2: middle, slightly rotated ── -->
            <g transform="rotate(-5 230 175)">
              <rect x="120" y="38" width="220" height="272" rx="12" fill="#f8f8f5" stroke="rgba(10,10,10,0.42)" stroke-width="1.5"/>
              <rect x="120" y="38" width="220" height="44" rx="12" fill="rgba(10,10,10,0.65)"/>
              <rect x="120" y="60" width="220" height="22" fill="rgba(10,10,10,0.65)"/>
              <text x="230" y="66" text-anchor="middle" font-family="Outfit,sans-serif" font-size="10" font-weight="700" fill="rgba(255,255,255,0.55)">Case Study</text>
              <rect x="140" y="98" width="152" height="8" rx="2" fill="rgba(10,10,10,0.13)"/>
              <rect x="140" y="113" width="116" height="7" rx="2" fill="rgba(10,10,10,0.1)"/>
              <text x="230" y="178" text-anchor="middle" font-family="Outfit,sans-serif" font-size="32" font-weight="900" fill="rgba(10,10,10,0.22)">18×</text>
            </g>

            <!-- ── Doc 1: front, straight ── -->
            <rect x="120" y="38" width="220" height="272" rx="12" fill="#fff" stroke="rgba(10,10,10,0.82)" stroke-width="2"/>
            <!-- header -->
            <rect x="120" y="38" width="220" height="44" rx="12" fill="#0A0A0A"/>
            <rect x="120" y="60" width="220" height="22" fill="#0A0A0A"/>
            <text x="230" y="65" text-anchor="middle" font-family="Outfit,sans-serif" font-size="11" font-weight="700" fill="#fff">Case Study Report</text>
            <!-- content lines -->
            <rect x="140" y="98" width="152" height="9" rx="3" fill="rgba(10,10,10,0.14)"/>
            <rect x="140" y="115" width="118" height="7" rx="2" fill="rgba(10,10,10,0.09)"/>
            <rect x="140" y="129" width="136" height="7" rx="2" fill="rgba(10,10,10,0.09)"/>
            <!-- separator -->
            <line x1="140" y1="150" x2="320" y2="150" stroke="rgba(10,10,10,0.08)" stroke-width="1.5"/>
            <!-- metric block -->
            <rect x="140" y="159" width="180" height="68" rx="8" fill="rgba(10,10,10,0.05)"/>
            <text x="230" y="193" text-anchor="middle" font-family="Outfit,sans-serif" font-size="30" font-weight="900" fill="#0A0A0A">40%</text>
            <text x="230" y="214" text-anchor="middle" font-family="Outfit,sans-serif" font-size="9" font-weight="500" fill="rgba(10,10,10,0.5)">faster deployment</text>
            <!-- more content lines -->
            <rect x="140" y="243" width="124" height="7" rx="2" fill="rgba(10,10,10,0.09)"/>
            <rect x="140" y="257" width="146" height="7" rx="2" fill="rgba(10,10,10,0.07)"/>
            <!-- tag badges -->
            <rect x="140" y="275" width="66" height="20" rx="10" stroke="rgba(10,10,10,0.25)" stroke-width="1.5"/>
            <text x="173" y="289" text-anchor="middle" font-family="Outfit,sans-serif" font-size="8" font-weight="700" fill="rgba(10,10,10,0.5)">Salesforce</text>
            <rect x="214" y="275" width="52" height="20" rx="10" stroke="rgba(10,10,10,0.25)" stroke-width="1.5"/>
            <text x="240" y="289" text-anchor="middle" font-family="Outfit,sans-serif" font-size="8" font-weight="700" fill="rgba(10,10,10,0.5)">Heroku</text>

            <!-- floating badge -->
            <rect x="346" y="50" width="90" height="30" rx="15" fill="#0A0A0A"/>
            <text x="391" y="69" text-anchor="middle" font-family="Outfit,sans-serif" font-size="11" font-weight="700" fill="#fff">6 studies</text>

            <!-- decorative dots -->
            <circle cx="66"  cy="130" r="4"   fill="rgba(10,10,10,0.07)"/>
            <circle cx="56"  cy="188" r="2.5" fill="rgba(10,10,10,0.05)"/>
            <circle cx="458" cy="155" r="4"   fill="rgba(10,10,10,0.07)"/>
            <circle cx="464" cy="225" r="2.5" fill="rgba(10,10,10,0.05)"/>
          </svg>
        </div>
      </div>
    </div>
  </div>

  <!-- ── Filter tabs ── -->
  <div class="cs-filter-bar">
    <div class="container">
      <div class="cs-filters">
        {['All', 'Salesforce', 'Heroku', 'MuleSoft', 'AppExchange'].map((f, i) => (
          <button
            class={`cs-filter-btn${i === 0 ? ' active' : ''}`}
            data-filter={f === 'All' ? 'all' : f}
          >
            {f}
          </button>
        ))}
      </div>
    </div>
  </div>

  <!-- ── Cards grid ── -->
  <section class="cs-grid-section">
    <div class="container">
      <div class="cs-grid">
        {caseStudies.map((cs) => (
          <article
            class="cs-card anim-fade-up"
            data-service={cs.service}
            onclick={`window.location='/case-studies/${cs.id}'`}
            style="cursor:pointer;"
          >
            <!-- Giant background metric -->
            <div class="cs-card-metric-bg" aria-hidden="true">{cs.metric}</div>

            <!-- Card top: illustration -->
            <div class="cs-card-illo" aria-hidden="true">
              {cs.id === 'retailscale' && (
                <svg viewBox="0 0 320 160" fill="none" class="cs-illo-svg">
                  <!-- Bar chart — full width, tall bars -->
                  <rect x="16"  y="100" width="44" height="56"  rx="4" stroke="#0A0A0A" stroke-width="2" opacity="0.2"/>
                  <rect x="76"  y="68"  width="44" height="88"  rx="4" stroke="#0A0A0A" stroke-width="2" opacity="0.38"/>
                  <rect x="136" y="40"  width="44" height="116" rx="4" stroke="#0A0A0A" stroke-width="2" opacity="0.56"/>
                  <rect x="196" y="16"  width="44" height="140" rx="4" stroke="#0A0A0A" stroke-width="2" opacity="0.75"/>
                  <rect x="256" y="4"   width="44" height="152" rx="4" fill="rgba(10,10,10,0.06)" stroke="#0A0A0A" stroke-width="2" opacity="0.9"/>
                  <!-- Trend line -->
                  <path d="M38 100 C76 80 114 56 158 40 C202 22 240 12 278 8" stroke="#0A0A0A" stroke-width="2" stroke-dasharray="6 4" opacity="0.45" stroke-linecap="round"/>
                  <circle cx="278" cy="8" r="5" fill="#0A0A0A" opacity="0.7"/>
                  <!-- Baseline -->
                  <line x1="8" y1="158" x2="312" y2="158" stroke="#0A0A0A" stroke-width="1.5" opacity="0.12"/>
                </svg>
              )}
              {cs.id === 'medbridge' && (
                <svg viewBox="0 0 320 160" fill="none" class="cs-illo-svg">
                  <!-- Large outer rings -->
                  <circle cx="160" cy="80" r="72" stroke="#0A0A0A" stroke-width="2" opacity="0.12"/>
                  <circle cx="160" cy="80" r="50" stroke="#0A0A0A" stroke-width="2" opacity="0.22"/>
                  <circle cx="160" cy="80" r="28" stroke="#0A0A0A" stroke-width="2" opacity="0.35"/>
                  <!-- Large cross -->
                  <path d="M160 18 L160 142 M96 80 L224 80" stroke="#0A0A0A" stroke-width="3" stroke-linecap="round" opacity="0.65"/>
                  <!-- Speed badge top-right -->
                  <rect x="234" y="10" width="74" height="34" rx="17" fill="#0A0A0A" opacity="0.85"/>
                  <text x="271" y="32" text-anchor="middle" font-family="Outfit,sans-serif" font-size="14" font-weight="900" fill="#fff">18×</text>
                  <!-- Decorative dots -->
                  <circle cx="36"  cy="24"  r="4" fill="#0A0A0A" opacity="0.15"/>
                  <circle cx="284" cy="140" r="4" fill="#0A0A0A" opacity="0.15"/>
                </svg>
              )}
              {cs.id === 'gridflow' && (
                <svg viewBox="0 0 320 160" fill="none" class="cs-illo-svg">
                  <!-- Three large connected nodes -->
                  <circle cx="60"  cy="80" r="38" stroke="#0A0A0A" stroke-width="2" opacity="0.28"/>
                  <circle cx="160" cy="80" r="38" stroke="#0A0A0A" stroke-width="2" opacity="0.5"/>
                  <circle cx="260" cy="80" r="38" stroke="#0A0A0A" stroke-width="2" opacity="0.72"/>
                  <!-- Connector lines with arrows -->
                  <line x1="98"  y1="80" x2="122" y2="80" stroke="#0A0A0A" stroke-width="2" stroke-dasharray="4 3" opacity="0.5"/>
                  <path d="M118 74 L124 80 L118 86" stroke="#0A0A0A" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" opacity="0.5"/>
                  <line x1="198" y1="80" x2="222" y2="80" stroke="#0A0A0A" stroke-width="2" stroke-dasharray="4 3" opacity="0.5"/>
                  <path d="M218 74 L224 80 L218 86" stroke="#0A0A0A" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" opacity="0.5"/>
                  <!-- Labels -->
                  <text x="60"  y="77" text-anchor="middle" font-family="Outfit,sans-serif" font-size="11" font-weight="800" fill="#0A0A0A" opacity="0.45">SAP</text>
                  <text x="60"  y="91" text-anchor="middle" font-family="Outfit,sans-serif" font-size="9"  font-weight="600" fill="#0A0A0A" opacity="0.35">ERP</text>
                  <text x="160" y="77" text-anchor="middle" font-family="Outfit,sans-serif" font-size="11" font-weight="800" fill="#0A0A0A" opacity="0.65">Mule</text>
                  <text x="160" y="91" text-anchor="middle" font-family="Outfit,sans-serif" font-size="9"  font-weight="600" fill="#0A0A0A" opacity="0.5">Soft</text>
                  <text x="260" y="77" text-anchor="middle" font-family="Outfit,sans-serif" font-size="11" font-weight="800" fill="#0A0A0A" opacity="0.8">SF</text>
                  <text x="260" y="91" text-anchor="middle" font-family="Outfit,sans-serif" font-size="9"  font-weight="600" fill="#0A0A0A" opacity="0.65">CRM</text>
                </svg>
              )}
              {cs.id === 'shieldinsure' && (
                <svg viewBox="0 0 320 160" fill="none" class="cs-illo-svg">
                  <!-- Shield — centred, tall -->
                  <path d="M160 8 L268 48 L268 104 C268 140 216 158 160 158 C104 158 52 140 52 104 L52 48 Z"
                        stroke="#0A0A0A" stroke-width="2" opacity="0.15"/>
                  <path d="M160 24 L248 58 L248 100 C248 130 208 146 160 146 C112 146 72 130 72 100 L72 58 Z"
                        stroke="#0A0A0A" stroke-width="2" opacity="0.32"/>
                  <path d="M160 42 L228 68 L228 98 C228 120 200 132 160 132 C120 132 92 120 92 98 L92 68 Z"
                        stroke="#0A0A0A" stroke-width="2" opacity="0.5"/>
                  <!-- Big checkmark -->
                  <path d="M120 90 L146 116 L202 70" stroke="#0A0A0A" stroke-width="4" stroke-linecap="round" stroke-linejoin="round" opacity="0.72"/>
                </svg>
              )}
              {cs.id === 'partsco' && (
                <svg viewBox="0 0 320 160" fill="none" class="cs-illo-svg">
                  <!-- Quote document left -->
                  <rect x="16" y="16" width="110" height="128" rx="6" stroke="#0A0A0A" stroke-width="2" opacity="0.28"/>
                  <rect x="28" y="34" width="86" height="14" rx="3" fill="#0A0A0A" opacity="0.12"/>
                  <rect x="28" y="56" width="70" height="8"  rx="2" fill="#0A0A0A" opacity="0.09"/>
                  <rect x="28" y="72" width="78" height="8"  rx="2" fill="#0A0A0A" opacity="0.09"/>
                  <rect x="28" y="88" width="60" height="8"  rx="2" fill="#0A0A0A" opacity="0.09"/>
                  <!-- Arrow -->
                  <path d="M136 80 L184 80" stroke="#0A0A0A" stroke-width="2.5" stroke-dasharray="5 3" opacity="0.5" stroke-linecap="round"/>
                  <path d="M178 73 L186 80 L178 87" stroke="#0A0A0A" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" opacity="0.6"/>
                  <!-- Approved doc right (dark) -->
                  <rect x="194" y="16" width="110" height="128" rx="6" fill="#0A0A0A" opacity="0.82"/>
                  <text x="249" y="68"  text-anchor="middle" font-family="Outfit,sans-serif" font-size="11" font-weight="700" fill="rgba(255,255,255,0.7)">Approved</text>
                  <text x="249" y="92"  text-anchor="middle" font-family="Outfit,sans-serif" font-size="26" font-weight="900" fill="#fff">1d</text>
                  <text x="249" y="112" text-anchor="middle" font-family="Outfit,sans-serif" font-size="9"  font-weight="500" fill="rgba(255,255,255,0.5)">was 5 days</text>
                  <!-- Checkmark on doc -->
                  <path d="M232 125 L242 135 L270 115" stroke="rgba(255,255,255,0.6)" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"/>
                </svg>
              )}
              {cs.id === 'lifesciences' && (
                <svg viewBox="0 0 320 160" fill="none" class="cs-illo-svg">
                  <!-- App listing card -->
                  <rect x="40" y="12" width="240" height="136" rx="10" stroke="#0A0A0A" stroke-width="2" opacity="0.25"/>
                  <!-- App icon -->
                  <rect x="56" y="28" width="44" height="44" rx="8" stroke="#0A0A0A" stroke-width="2" opacity="0.4"/>
                  <path d="M68 50 L74 56 L88 44" stroke="#0A0A0A" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" opacity="0.6"/>
                  <!-- App name lines -->
                  <rect x="112" y="34" width="128" height="12" rx="3" fill="#0A0A0A" opacity="0.15"/>
                  <rect x="112" y="52" width="90"  height="8"  rx="2" fill="#0A0A0A" opacity="0.09"/>
                  <!-- Star row -->
                  <text x="56" y="106" font-family="Outfit,sans-serif" font-size="18" fill="#0A0A0A" opacity="0.45">★★★★★</text>
                  <text x="56" y="124" font-family="Outfit,sans-serif" font-size="10" font-weight="600" fill="#0A0A0A" opacity="0.35">4.8 · 200+ enterprise customers</text>
                  <!-- Verified badge -->
                  <circle cx="268" cy="28" r="18" fill="#0A0A0A" opacity="0.85"/>
                  <path d="M260 28 L265 33 L278 22" stroke="#fff" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"/>
                </svg>
              )}
            </div>

            <!-- Card body -->
            <div class="cs-card-body">
              <div class="cs-card-header">
                <span class="cs-card-index">{cs.index}</span>
                <span class="cs-card-industry">{cs.industry}</span>
              </div>
              <h2 class="cs-card-company">{cs.company}</h2>
              <div class="cs-card-metric-row">
                <span class="cs-card-metric-num">{cs.metric}</span>
                <span class="cs-card-metric-desc">{cs.metricLabel}</span>
              </div>
              <p class="cs-card-summary">{cs.summary}</p>
              <div class="cs-card-meta">
                <span class="cs-card-result">{cs.result}</span>
                <span class="cs-card-duration">{cs.duration}</span>
              </div>
              <div class="cs-card-tags">
                {cs.tags.map(tag => (
                  <span class="cs-tag">{tag}</span>
                ))}
              </div>
              <a href={`/case-studies/${cs.id}`} class="cs-card-link">
                Read case study &rarr;
              </a>
            </div>
          </article>
        ))}
      </div>
    </div>
  </section>

  <!-- ── CTA ── -->
  <section class="cs-cta">
    <div class="container">
      <div class="cs-cta-inner">
        <div class="cs-cta-text">
          <p class="cs-cta-label">Ready to get started?</p>
          <h2 class="cs-cta-title">Your result could be next.</h2>
          <p class="cs-cta-sub">Tell us about your project. We'll scope it and respond within one business day.</p>
        </div>
        <div class="cs-cta-actions">
          <a href="/contact" class="cs-cta-btn-primary">Start a conversation &rarr;</a>
          <a href="#schedule" class="cs-cta-btn-secondary">Book a 30-min call</a>
        </div>
      </div>
    </div>
  </section>

</Page>

<style>
/* ── Hero ───────────────────────────────────────────── */
.cs-hero {
  background: #F5F5F2;
  padding-top: 7rem;
  padding-bottom: 3rem;
  border-bottom: 1px solid #E0E0DC;
  overflow: hidden;
}
.cs-hero-split {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 2rem;
  align-items: center;
}
.cs-hero-title {
  font-size: clamp(2.75rem, 5vw, 4.5rem);
  font-weight: 900;
  letter-spacing: -0.04em;
  line-height: 1.05;
  color: #0A0A0A;
  margin: 0.75rem 0 1.25rem;
}
.cs-hero-sub {
  font-size: 1rem;
  color: #5A5A5A;
  line-height: 1.75;
  max-width: 420px;
}
.cs-hero-illo { display: flex; justify-content: center; align-items: center; }
.cs-hero-svg  { width: 100%; max-width: 480px; height: auto; }

/* ── Filter bar ─────────────────────────────────────── */
.cs-filter-bar {
  background: #fff;
  border-bottom: 1px solid #E0E0DC;
  position: sticky;
  top: 64px;
  z-index: 10;
}
.cs-filters {
  display: flex;
  gap: 0;
  padding: 0;
  overflow-x: auto;
  scrollbar-width: none;
}
.cs-filters::-webkit-scrollbar { display: none; }
.cs-filter-btn {
  background: none;
  border: none;
  border-bottom: 2px solid transparent;
  padding: 1rem 1.375rem;
  font-size: 0.875rem;
  font-weight: 600;
  font-family: 'Outfit', sans-serif;
  color: #5A5A5A;
  cursor: pointer;
  white-space: nowrap;
  transition: color 150ms, border-color 150ms;
}
.cs-filter-btn:hover { color: #0A0A0A; }
.cs-filter-btn.active {
  color: #0A0A0A;
  border-bottom-color: #0A0A0A;
}

/* ── Grid ───────────────────────────────────────────── */
.cs-grid-section {
  background: #F5F5F2;
  padding: 4rem 0 5rem;
}
.cs-grid {
  display: grid;
  grid-template-columns: repeat(2, 1fr);
  gap: 1.5rem;
}

/* Card */
.cs-card {
  background: #fff;
  border: 1px solid #E0E0DC;
  border-radius: 16px;
  overflow: hidden;
  position: relative;
  transition: transform 220ms cubic-bezier(0.34,1.56,0.64,1),
              box-shadow 220ms ease,
              border-color 220ms ease;
}
.cs-card:hover {
  transform: translateY(-4px);
  box-shadow: 0 12px 40px rgba(10,10,10,0.1), 0 2px 8px rgba(10,10,10,0.06);
  border-color: #0A0A0A;
}

/* Giant background metric */
.cs-card-metric-bg {
  position: absolute;
  top: 8px;
  right: 16px;
  font-size: 7rem;
  font-weight: 900;
  letter-spacing: -0.05em;
  color: #0A0A0A;
  opacity: 0.04;
  font-family: 'Outfit', sans-serif;
  line-height: 1;
  pointer-events: none;
  user-select: none;
  z-index: 0;
}

/* Illustration area */
.cs-card-illo {
  background: #F5F5F2;
  border-bottom: 1px solid #E0E0DC;
  padding: 2rem 3rem;
  display: flex;
  align-items: center;
  justify-content: center;
  height: 220px;
  position: relative;
  z-index: 1;
}
.cs-illo-svg { width: 100%; height: 100%; }

/* Card body */
.cs-card-body {
  padding: 1.75rem;
  position: relative;
  z-index: 1;
}
.cs-card-header {
  display: flex;
  align-items: center;
  gap: 0.75rem;
  margin-bottom: 0.625rem;
}
.cs-card-index {
  font-size: 0.7rem;
  font-weight: 900;
  color: rgba(10,10,10,0.25);
  font-family: 'Outfit', sans-serif;
  letter-spacing: 0.08em;
}
.cs-card-industry {
  font-size: 0.7rem;
  font-weight: 700;
  letter-spacing: 0.08em;
  text-transform: uppercase;
  color: #5A5A5A;
  background: #F5F5F2;
  border: 1px solid #E0E0DC;
  border-radius: 100px;
  padding: 0.2rem 0.625rem;
}
.cs-card-company {
  font-size: 1.25rem;
  font-weight: 900;
  letter-spacing: -0.02em;
  color: #0A0A0A;
  margin-bottom: 0.875rem;
  line-height: 1.2;
}
.cs-card-metric-row {
  display: flex;
  align-items: baseline;
  gap: 0.625rem;
  margin-bottom: 0.875rem;
  padding-bottom: 0.875rem;
  border-bottom: 1px solid #E0E0DC;
}
.cs-card-metric-num {
  font-size: 2.25rem;
  font-weight: 900;
  letter-spacing: -0.04em;
  color: #0A0A0A;
  font-family: 'Outfit', sans-serif;
  line-height: 1;
}
.cs-card-metric-desc {
  font-size: 0.8rem;
  color: #5A5A5A;
  font-weight: 500;
  line-height: 1.4;
  max-width: 160px;
}
.cs-card-summary {
  font-size: 0.875rem;
  color: #5A5A5A;
