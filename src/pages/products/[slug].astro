    <path d="M312 190 L332 190" stroke="#0A0A0A" stroke-width="1" opacity="0.12" stroke-dasharray="3 2"/>
    <path d="M312 220 L332 230" stroke="#0A0A0A" stroke-width="1" opacity="0.12" stroke-dasharray="3 2"/>
    <!-- Bottom badge -->
    <rect x="78" y="314" width="304" height="28" rx="8" fill="#0A0A0A" fill-opacity="0.05" stroke="#0A0A0A" stroke-width="1.5" opacity="0.45"/>
    <text x="230" y="332" text-anchor="middle" font-family="Outfit,sans-serif" font-size="10" font-weight="700" fill="#0A0A0A" opacity="0.65">NPSP Optional · Person Account Ready</text>
  </svg>`,
  'orgvitals': `<svg viewBox="0 0 460 380" fill="none" xmlns="http://www.w3.org/2000/svg" style="width:100%;max-width:460px;height:auto;">
    <!-- Desktop app window -->
    <rect x="70" y="54" width="320" height="228" rx="12" stroke="#0A0A0A" stroke-width="2.5"/>
    <rect x="70" y="54" width="320" height="36" rx="12" fill="#0A0A0A" fill-opacity="0.05"/>
