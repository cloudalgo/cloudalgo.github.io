---
/**
 * One product, in full.
 *
 * The catalogue at /products/ already prints every product's tagline,
 * chips, six-row spec panel and actions. This page is deliberately built
 * out of what the catalogue WITHHELD -- the capabilities, the whole
 * techStack, the prerequisites, the roadmap, the recordings, the price
 * and the body prose -- because a detail page that restates its index is
 * a second index with a longer URL.
 *
 * It opens on `.transit` rather than on a description. Every product
 * here moves data along a path and makes one claim about a boundary it
 * never crosses: OrgVitals never writes back to the org, Pledgivo never
 * lets a card number reach Apex, AlgoBridge never runs a record through
 * our infrastructure, InsureAlgo never leaves the handset. That claim is
 * the reason a buyer reads past the first screen, and it used to be
 * buried in paragraph three.
 *
 * FACTS come from the collection file, the ARGUMENT from
 * src/data/product-pages.ts. Neither file has to be touched to edit the
 * other, and a fifth product fails this page's build with a named error
 * rather than rendering a headline-shaped hole.
 *
 * Three folds are gated on their data and simply do not render without
 * it. AlgoBridge is a daemon with no interface, so it has no viewer;
 * InsureAlgo has no techStack, so it has no readout; only OrgVitals has
 * a roadmap. An absent fold is the honest answer -- a placeholder that
 * says "coming soon" is not.
 */
import { getCollection, render } from 'astro:content';
import Page from '@/layouts/Page.astro';
import PageMasthead from '@/components/ui/PageMasthead.astro';
import CtaBand from '@/components/ui/CtaBand.astro';
import { TYPE_LABEL, STATUS_LABEL } from '@/data/product-labels';
import { productPages } from '@/data/product-pages';

export async function getStaticPaths() {
  const products = await getCollection('products', ({ data }) => data.published);
  return products.map(p => ({ params: { slug: p.id } }));
}

const { slug } = Astro.params;

const all = (await getCollection('products', ({ data }) => data.published))
  .sort((a, b) => a.data.order - b.data.order);

const product = all.find(p => p.id === slug);
if (!product) throw new Error(`products/[slug].astro: no published product with id "${slug}".`);

const { data } = product;
const { Content } = await render(product);

const page = productPages[product.id];
if (!page) {
  throw new Error(
    `products/[slug].astro: "${product.id}" has no entry in src/data/product-pages.ts. ` +
    'A product file without page copy would render a headline-shaped hole, so it fails here instead.',
  );
}

/* The hero mark. `mark` is a verbatim substring of `headline`; if an
   edit breaks that, the build fails rather than shipping a headline
   with no emphasis and no explanation why. Same guard as
   case-studies/[slug].astro, for the same reason. */
if (!page.headline.includes(page.mark)) {
  throw new Error(
    `products/[slug].astro: mark "${page.mark}" is not in headline "${page.headline}" (${product.id}).`,
  );
}
const at = page.headline.indexOf(page.mark);
const markedTitle =
  page.headline.slice(0, at) +
  `<span class="mark mark--draw">${page.mark}</span>` +
  page.headline.slice(at + page.mark.length);

/* `lastUpdated` is a free string in the schema and two products use it
   as one: three are ISO dates, Pledgivo's is "August 2026". Only an
   unambiguous date is reformatted -- anything else is printed as the
   author wrote it rather than run through a parser that would invent a
   first-of-the-month. */
const isoDay = /^\d{4}-\d{2}-\d{2}$/;
const released = !data.lastUpdated
  ? null
  : isoDay.test(data.lastUpdated)
    ? new Date(`${data.lastUpdated}T00:00:00Z`).toLocaleDateString('en-GB', {
        day: 'numeric', month: 'long', year: 'numeric', timeZone: 'UTC',
      })
    : data.lastUpdated;

const facts = [
  ...(data.version ? [{ term: 'Version', detail: data.version }] : []),
  ...(released ? [{ term: 'Released', detail: released }] : []),
  ...page.facts,
];

const shots = data.screenshots ?? [];
const video = data.video;
/** Two figures, so the counter in the viewer bar does not jump width. */
const pad = (n: number) => String(n).padStart(2, '0');

const tiers = data.pricing ?? [];

interface Link { href: string; label: string; external?: boolean }
const isExternal = (href: string) => /^https?:/.test(href);

const getIt: Link[] = [];
if (data.externalUrl) {
  getIt.push({ href: data.externalUrl, label: page.links.external, external: true });
}
if (data.guideUrl) {
  getIt.push({
    href: data.guideUrl,
    label: page.links.guide ?? 'The guide',
    external: isExternal(data.guideUrl),
  });
}
if (data.issuesUrl) {
  getIt.push({ href: data.issuesUrl, label: 'Report an issue', external: true });
}

const legal: Link[] = (data.legal ?? []).map(l => ({ href: l.href, label: l.label }));

/* The rest of the catalogue, read off the collection rather than listed
   here -- a fifth product should appear on the other four pages without
   anyone remembering to add it. */
const elsewhere: Link[] = all
  .filter(p => p.id !== product.id)
  .map(p => ({
    href: `/products/${p.id}/`,
    label: `${p.data.title} — ${productPages[p.id]?.short ?? p.data.title}`,
  }));

const columns = [
  { label: 'Get it', links: getIt },
  { label: 'Legal', links: legal },
  { label: 'The rest of the catalogue', links: elsewhere },
].filter(c => c.links.length > 0);

const siteBase = 'https://cloudalgo.com';

const osMap: Record<string, string> = {
  'salesforce-app': 'Salesforce',
  'mobile-app':     'iOS, Android',
  'integration':    'Linux, Docker',
  'desktop-app':    'macOS, Windows, Linux',
};

const softwareApp: Record<string, unknown> = {
  '@type':             'SoftwareApplication',
  name:                data.title,
  description:         data.tagline,
  applicationCategory: 'BusinessApplication',
  operatingSystem:     osMap[data.type] ?? 'Web',
  url:                 `${siteBase}/products/${slug}`,
  provider: { '@type': 'Organization', name: 'CloudAlgo', url: siteBase },
};
if (data.externalUrl) softwareApp.downloadUrl = data.externalUrl;
if (data.status === 'ga') {
  softwareApp.offers = { '@type': 'Offer', price: '0', priceCurrency: 'USD' };
}

const schema: object[] = [
  softwareApp,
  {
    '@type': 'BreadcrumbList',
    itemListElement: [
      { '@type': 'ListItem', position: 1, name: 'Home',      item: `${siteBase}/` },
      { '@type': 'ListItem', position: 2, name: 'Products',  item: `${siteBase}/products/` },
      { '@type': 'ListItem', position: 3, name: data.title,  item: `${siteBase}/products/${slug}/` },
    ],
  },
];
---
<Page
  title={data.seoTitle ?? `${data.title} — ${TYPE_LABEL[data.type] ?? 'Product'} — CloudAlgo`}
  description={data.excerpt}
  canonicalURL={`${siteBase}/products/${slug}/`}
  schema={schema}
>
  <PageMasthead
    class="page-head--product"
    standClass="release"
    crumbs={[
      { label: 'Home', href: '/' },
      { label: 'Products', href: '/products/' },
      { label: data.title },
    ]}
  >
    <Fragment slot="title" set:html={markedTitle} />
    <Fragment slot="lede" set:html={page.lede} />

    <Fragment slot="actions">
      {data.externalUrl && (
        <a class="btn btn-primary" href={data.externalUrl} target="_blank" rel="noopener noreferrer">
          {page.cta.primary} &rarr;
        </a>
      )}
      {data.guideUrl && page.cta.secondary && (
        <a
          class="btn btn-outline"
          href={data.guideUrl}
          {...isExternal(data.guideUrl) ? { target: '_blank', rel: 'noopener noreferrer' } : {}}
        >{page.cta.secondary}</a>
      )}
      {/* The catalogue's Pledgivo entry promises "Watch the tour" and
          points at this page, so this page owes the player. */}
      {video && (
        <a class="btn btn-outline" href="#tour">
          Watch the tour{video.duration ? ` · ${video.duration}` : ''}
        </a>
      )}
    </Fragment>

    <Fragment slot="stand">
      <span class:list={['pip', 'release__pip', data.status === 'ga' && 'pip--ga']}>
        <b class="pip__dot" aria-hidden="true"></b>{STATUS_LABEL[data.status] ?? data.status}
      </span>
      <dl>
        {facts.map(f => (
          <div><dt>{f.term}</dt><dd>{f.detail}</dd></div>
        ))}
      </dl>
    </Fragment>
  </PageMasthead>

  {/* ── 1 · The transit ─────────────────────────────────── */}
  <section class="section-press" aria-labelledby="transit-heading">
    <div class="section-press__head anim-fade-up">
      <h2 id="transit-heading" class="section-title section-title--xs section-title--tighter section-press__title">
        {page.folds.transit.title}
      </h2>
      <span class="section-press__note">{page.folds.transit.note}</span>
    </div>

    <div class="transit anim-fade-up">
      <div class="transit__port transit__port--in">
        <span class="transit__port-label">{page.transit.source.label}</span>
        <span class="transit__port-name">{page.transit.source.name}</span>
        <span class="transit__port-note">{page.transit.source.note}</span>
      </div>

      <div class="transit__flow transit__flow--in" aria-hidden="true">
        <span class="transit__flow-tag">{page.transit.inTag}</span>
      </div>

      <div class="transit__estate">
        <span class="transit__estate-label">{page.transit.estate}</span>
        <ol class="transit__stages">
          {page.transit.stages.map((s, i) => (
            <li class="transit__stage anim-fade-up" style={`--i:${i}`}>
              <span class="transit__n">{pad(i + 1)}</span>
              <span class="transit__name">{s.name}</span>
              <span class="transit__what">{s.what}</span>
            </li>
          ))}
        </ol>
      </div>

      {page.transit.out && (
        <>
          <div
            class:list={['transit__flow', 'transit__flow--out', page.transit.out.dashed && 'transit__flow--opt']}
            aria-hidden="true"
          >
            <span class="transit__flow-tag">{page.transit.out.tag}</span>
          </div>

          <div class="transit__port transit__port--out">
            <span class="transit__port-label">{page.transit.out.label}</span>
            <span class="transit__port-name">{page.transit.out.name}</span>
            <span class="transit__port-note">{page.transit.out.note}</span>
          </div>
        </>
      )}
    </div>

    {/* The boundary claim is authored here and set above the prose; the
        prose itself is the collection file's own body, rendered rather
        than restated, so an edit to the markdown lands on the page. */}
    <div class="brief anim-fade-up">
      <p class="brief__lead">{page.claim}</p>
      <Content />
      {legal.length > 0 && (
        <p class="brief__refs">
          Full detail: {legal.map((l, i) => (
            <>{i > 0 && (i === legal.length - 1 ? ' and ' : ', ')}<a class="link-draw" href={l.href}>{l.label}</a></>
          ))}.
        </p>
      )}
    </div>
  </section>

  {/* ── 2 · Capabilities ────────────────────────────────── */}
  <section class="section-press" aria-labelledby="cap-heading">
    <div class="section-press__head anim-fade-up">
      <h2 id="cap-heading" class="section-title section-title--xs section-title--tighter section-press__title">
        {page.folds.cap.title}
      </h2>
      <span class="section-press__note">{page.folds.cap.note}</span>
    </div>

    <ol class="cap">
      {data.features.map((f, i) => (
        <li class="cap__row anim-fade-up" style={`--i:${i}`}>
          <span class="cap__n">{pad(i + 1)}</span>
          <h3 class="cap__name">{f.title}</h3>
          <p class="cap__what">{f.description}</p>
        </li>
      ))}
    </ol>
  </section>

  {/* ── 3 · The viewer ──────────────────────────────────── */}
  {page.folds.viewer && (shots.length > 0 || video) && (
    <section class="section-press" id="tour" aria-labelledby="view-heading">
      <div class="section-press__head anim-fade-up">
        <h2 id="view-heading" class="section-title section-title--xs section-title--tighter section-press__title">
          {page.folds.viewer.title}
        </h2>
        <span class="section-press__note">{page.folds.viewer.note}</span>
      </div>

      {shots.length > 0 ? (
        <figure class="viewer anim-fade-up" id="viewer" style={`--shots:${shots.length}`}>
          <div class="viewer__frame">
            <div class="viewer__bar">
              <span class="viewer__bar-n">01 / {pad(shots.length)}</span>
              <span class="viewer__bar-t">{shots[0].step}</span>
            </div>
            {/* The still is what the stage opens on, for every step. A
                step that also has a recording swaps the still for the
                clip -- straight away when motion is fine, on a press
                when the reader has asked for less of it. The clip is
                `preload="none"`, so a step nobody opens costs nothing. */}
            <div class="viewer__stage">
              <img
                class="viewer__shot"
                src={shots[0].src}
                alt={shots[0].alt}
                loading="lazy"
                decoding="async"
              />
              <video class="viewer__clip" controls loop muted playsinline preload="none" hidden></video>
            </div>
            {shots.some(s => s.clip) && (
              <div class="viewer__hold" hidden>
                <p class="viewer__hold-t">This step was recorded. The still above is the same view, held.</p>
                <button class="viewer__play" type="button">Play &ldquo;{shots[0].step}&rdquo; &rarr;</button>
              </div>
            )}
          </div>

          <figcaption class="viewer__cap">{shots[0].cap}</figcaption>

          <ol class="viewer__strip">
            {shots.map((s, i) => (
              <li>
                <button
                  class:list={['viewer__thumb', i === 0 && 'is-on']}
                  type="button"
                  aria-pressed={i === 0 ? 'true' : 'false'}
                  data-shot={s.src}
                  data-alt={s.alt}
                  data-cap={s.cap}
                  data-clip={s.clip}
                >
                  <span class="viewer__thumb-n">{pad(i + 1)}</span>
                  <span class="viewer__thumb-t">{s.step}</span>
                </button>
              </li>
            ))}
          </ol>

          {/* The plain pictures, for a reader with no script at all. */}
          <noscript>
            <div class="viewer__noscript">
              {shots.map(s => <img src={s.src} alt={s.alt} loading="lazy" />)}
            </div>
          </noscript>
        </figure>
      ) : video && (
        <figure class="viewer anim-fade-up">
          <div class="viewer__frame">
            <div class="viewer__bar">
              {video.duration && <span class="viewer__bar-n">{video.duration}</span>}
              <span class="viewer__bar-t">{video.heading ?? 'The tour'}</span>
            </div>
            <video class="viewer__video" controls preload="none" poster={video.poster} playsinline>
              <source src={video.src} type="video/mp4" />
              {video.captions && (
                <track kind="captions" src={video.captions} srclang="en" label="English" default />
              )}
            </video>
          </div>
          <figcaption class="viewer__cap">{video.title}</figcaption>
        </figure>
      )}
    </section>
  )}

  {/* ── 4 · The readout ─────────────────────────────────── */}
  {page.folds.readout && data.techStack && data.techStack.length > 0 && (
    <section class="section-press" aria-labelledby="spec-heading">
      <div class="section-press__head anim-fade-up">
        <h2 id="spec-heading" class="section-title section-title--xs section-title--tighter section-press__title">
          {page.folds.readout.title}
        </h2>
        <span class="section-press__note">{page.folds.readout.note}</span>
      </div>

      <dl class="readout">
        {data.techStack.map((row, i) => (
          <div class="readout__cell anim-fade-up" style={`--i:${i}`}>
            <dt>{row.label}</dt>
            <dd>{row.value}</dd>
          </div>
        ))}
      </dl>
    </section>
  )}

  {/* ── 5 · Terms ───────────────────────────────────────── */}
  <section class="section-press" aria-labelledby="terms-heading">
    <div class="section-press__head anim-fade-up">
      <h2 id="terms-heading" class="section-title section-title--xs section-title--tighter section-press__title">
        {page.folds.terms.title}
      </h2>
      <span class="section-press__note">{page.folds.terms.note}</span>
    </div>

    <div class="terms">
      <div class="terms__price anim-fade-up">
        <span class="terms__label">Price</span>
        <p class="terms__figure">{page.price.figure}</p>
        <p class="terms__gloss">{page.price.gloss}</p>
        {/* One tier is the figure above and nothing more to say. Where
            the file carries several, they are printed rather than
            summarised away. */}
        {tiers.length > 1 && (
          <dl class="terms__tiers">
            {tiers.map(t => (
              <div><dt>{t.tier}</dt><dd>{t.price}</dd></div>
            ))}
          </dl>
        )}
      </div>

      <div class="terms__needs anim-fade-up">
        <span class="terms__label">Before you install</span>
        <ol class="terms__list">
          {(data.requirements ?? []).map(r => (
            <li>
              <span class:list={['terms__mark', r.optional && 'terms__mark--opt']} aria-hidden="true"></span>
              <span class="terms__text">{r.need}</span>
            </li>
          ))}
        </ol>
      </div>
    </div>
  </section>

  {/* ── 6 · Ahead ───────────────────────────────────────── */}
  {page.folds.ahead && data.roadmap && data.roadmap.length > 0 && (
    <section class="section-press" aria-labelledby="ahead-heading">
      <div class="section-press__head anim-fade-up">
        <h2 id="ahead-heading" class="section-title section-title--xs section-title--tighter section-press__title">
          {page.folds.ahead.title}
        </h2>
        <span class="section-press__note">{page.folds.ahead.note}</span>
      </div>

      <ol class="ahead">
        {data.roadmap.map((r, i) => (
          <li class:list={['ahead__row', 'anim-fade-up', i === 0 && 'is-shipped']} style={`--i:${i}`}>
            <span class="ahead__v">{r.version}</span>
            <span class="ahead__state">{i === 0 ? 'Shipped' : i === 1 ? 'In build' : 'Planned'}</span>
            <h3 class="ahead__theme">{r.theme}</h3>
            <p class="ahead__what">{r.description}</p>
          </li>
        ))}
      </ol>
    </section>
  )}

  {/* ── 7 · Colophon ────────────────────────────────────── */}
  <section class="section-press" aria-labelledby="colo-heading">
    <div class="section-press__head anim-fade-up">
      <h2 id="colo-heading" class="section-title section-title--xs section-title--tighter section-press__title">
        {page.folds.colophon.title}
      </h2>
      <span class="section-press__note">{page.folds.colophon.note}</span>
    </div>

    <div class="colophon anim-fade-up">
      {columns.map(col => (
        <div class="colophon__col">
          <span class="colophon__label">{col.label}</span>
          <ul>
            {col.links.map(l => (
              <li>
                <a
                  class="link-draw"
                  href={l.href}
                  {...l.external ? { target: '_blank', rel: 'noopener noreferrer' } : {}}
                >{l.label}{l.external && <span aria-hidden="true"> &#8599;</span>}</a>
              </li>
            ))}
          </ul>
        </div>
      ))}
    </div>
  </section>

  {/* The one place this page breaks the site's no-closing-CTA rule. A
      product page ends on a thing the reader can download by themselves,
      and the band is what says the harder half is still a conversation. */}
  <CtaBand class="anim-fade-up" labelledby="band-ask">
    <div>
      <h2 id="band-ask" class="band-press__ask">
        {page.band.ask} <em>{page.band.emphasis}</em>
      </h2>
      <p class="band-press__note">{page.band.note}</p>
    </div>

    <div class="band-press__actions">
      <a class="btn btn-secondary btn-sm" href="/services/">See the services &rarr;</a>
      <a class="btn btn-light btn-sm" href="mailto:contact@cloudalgo.com">Email contact@cloudalgo.com</a>
    </div>
  </CtaBand>
</Page>

<script>
  /* The step viewer.

     Every step has a still; some steps also have a recording. Selecting a
     step always shows its still first, which costs one small image, and
     the recording replaces it only when there is one -- immediately when
     motion is fine, on a press when the reader has asked for less of it.
     The clip element is `preload="none"` and its `src` is cleared on the
     way out, so a step nobody opens is never fetched and a step left
     behind stops playing. The <noscript> block underneath holds the
     plain stills for a reader with no script at all. */
  (() => {
    const viewer = document.getElementById('viewer');
    if (!viewer) return;

    const shot = viewer.querySelector<HTMLImageElement>('.viewer__shot');
    const clip = viewer.querySelector<HTMLVideoElement>('.viewer__clip');
    const hold = viewer.querySelector<HTMLElement>('.viewer__hold');
    const play = viewer.querySelector<HTMLButtonElement>('.viewer__play');
    const cap  = viewer.querySelector<HTMLElement>('.viewer__cap');
    const barN = viewer.querySelector<HTMLElement>('.viewer__bar-n');
    const barT = viewer.querySelector<HTMLElement>('.viewer__bar-t');
    const thumbs = [...viewer.querySelectorAll<HTMLButtonElement>('.viewer__thumb')];
    /* `hold` and `play` are absent on a viewer whose steps are all
       stills -- InsureAlgo's four phone screens -- so they are optional
       here where the rest are not. */
    if (!shot || !clip || !cap || !barN || !barT || !thumbs.length) return;

    const still = window.matchMedia('(prefers-reduced-motion: reduce)');
    const total = String(thumbs.length).padStart(2, '0');
    const nameOf = (btn: HTMLButtonElement) =>
      btn.querySelector('.viewer__thumb-t')?.textContent ?? '';

    let current = thumbs[0];

    /** Puts the step's still on the stage and stops whatever was playing. */
    const showStill = (btn: HTMLButtonElement) => {
      clip.pause();
      clip.hidden = true;
      clip.removeAttribute('src');
      clip.load(); // drops the buffered clip rather than leaving it decoding
      shot.src = btn.dataset.shot ?? '';
      shot.alt = btn.dataset.alt ?? '';
      shot.hidden = false;
    };

    /** Loads the recording. Called on press, and on select when motion is fine. */
    const run = (btn: HTMLButtonElement) => {
      const src = btn.dataset.clip;
      if (!src) return;
      clip.src = src;
      clip.poster = btn.dataset.shot ?? '';
      shot.hidden = true;
      clip.hidden = false;
      if (hold) hold.hidden = true;
      void clip.play().catch(() => {
        /* Autoplay refused. The controls are there; the still is not. */
      });
    };

    const select = (btn: HTMLButtonElement) => {
      current = btn;
      thumbs.forEach((t) => {
        const on = t === btn;
        t.classList.toggle('is-on', on);
        t.setAttribute('aria-pressed', String(on));
      });
      cap.textContent = btn.dataset.cap ?? '';
      barN.textContent = `${btn.querySelector('.viewer__thumb-n')?.textContent ?? ''} / ${total}`;
      barT.textContent = nameOf(btn);

      showStill(btn);
      if (hold) hold.hidden = true;

      /* A step that is just a picture: the still is the whole step. */
      if (!btn.dataset.clip) return;

      if (still.matches && hold && play) {
        /* Held. The button names the step so the press is a decision,
           not a mystery. */
        play.textContent = `Play “${nameOf(btn)}” →`;
        hold.hidden = false;
      } else {
        run(btn);
      }
    };

    thumbs.forEach((t) => t.addEventListener('click', () => select(t)));
    play?.addEventListener('click', () => run(current));
    still.addEventListener('change', () => select(current));
    select(thumbs[0]);
  })();
</script>
