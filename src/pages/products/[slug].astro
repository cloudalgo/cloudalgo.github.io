    <!-- In-window footer -->
    <text x="230" y="274" text-anchor="middle" font-family="Outfit,sans-serif" font-size="9" font-weight="600" fill="#0A0A0A" opacity="0.4">49 scanners · read-only · runs locally</text>
    <!-- Floating badges -->
    <rect x="76" y="302" width="106" height="28" rx="100" fill="#fff" stroke="#0A0A0A" stroke-width="1.5" opacity="0.75"/>
