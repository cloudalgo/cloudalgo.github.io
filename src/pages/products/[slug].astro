    <circle cx="142" cy="180" r="46" stroke="#0A0A0A" stroke-width="6" fill="none" opacity="0.1"/>
    <circle cx="142" cy="180" r="46" stroke="#0A0A0A" stroke-width="6" fill="none" stroke-dasharray="225 289" stroke-linecap="round" transform="rotate(-90 142 180)" opacity="0.7"/>
    <text x="142" y="196" text-anchor="middle" font-family="Outfit,sans-serif" font-size="46" font-weight="900" fill="#0A0A0A">B</text>
    <text x="142" y="250" text-anchor="middle" font-family="Outfit,sans-serif" font-size="12" font-weight="700" fill="#0A0A0A" opacity="0.6">78 / 100</text>
    <!-- Right: category score bars -->
    <text x="210" y="118" font-family="Outfit,sans-serif" font-size="8" font-weight="700" fill="#0A0A0A" opacity="0.55" letter-spacing="0.05em">SECURITY</text>
    <rect x="210" y="124" width="168" height="8" rx="4" fill="#0A0A0A" opacity="0.08"/>
