    <rect x="190" y="302" width="86" height="28" rx="100" fill="#0A0A0A" opacity="0.85"/>
    <text x="233" y="320" text-anchor="middle" font-family="Outfit,sans-serif" font-size="10" font-weight="700" fill="#fff">Read-only</text>
    <rect x="284" y="302" width="100" height="28" rx="100" fill="#fff" stroke="#0A0A0A" stroke-width="1.5" opacity="0.75"/>
    <text x="334" y="320" text-anchor="middle" font-family="Outfit,sans-serif" font-size="10" font-weight="700" fill="#0A0A0A" opacity="0.85">Local-first</text>
  </svg>`,
};
const illustration = illustrations[slug] ?? '';

// Distinct monochrome line icons per feature (keyed by the `icon` field).
// Inner SVG markup only; rendered inside a 24×24 <svg> using currentColor.
const featureIcons: Record<string, string> = {
  scan:     `<circle cx="10.5" cy="10.5" r="6.5" stroke="currentColor" stroke-width="1.6"/><path d="M15.3 15.3 L20.5 20.5" stroke="currentColor" stroke-width="1.6" stroke-linecap="round"/><path d="M7.5 10.5 H13.5" stroke="currentColor" stroke-width="1.6" stroke-linecap="round"/>`,
  grade:    `<path d="M4.5 16.5 A7.5 7.5 0 0 1 19.5 16.5" stroke="currentColor" stroke-width="1.6" fill="none" stroke-linecap="round"/><path d="M12 16.5 L16 10.5" stroke="currentColor" stroke-width="1.6" stroke-linecap="round"/><circle cx="12" cy="16.5" r="1.4" fill="currentColor"/>`,
  triage:   `<path d="M4 5.5 H20 L13.8 12.5 V19 L10.2 17 V12.5 Z" stroke="currentColor" stroke-width="1.6" stroke-linejoin="round" fill="none"/>`,
  graph:    `<circle cx="6" cy="7" r="2.3" stroke="currentColor" stroke-width="1.6"/><circle cx="18" cy="9" r="2.3" stroke="currentColor" stroke-width="1.6"/><circle cx="11" cy="18" r="2.3" stroke="currentColor" stroke-width="1.6"/><path d="M8.2 7.6 L15.8 8.7 M7 8.9 L10 15.9" stroke="currentColor" stroke-width="1.4" stroke-linecap="round"/>`,
  compare:  `<rect x="3.5" y="5" width="7" height="14" rx="1.6" stroke="currentColor" stroke-width="1.6"/><rect x="13.5" y="5" width="7" height="14" rx="1.6" stroke="currentColor" stroke-width="1.6"/>`,
  ai:       `<path d="M12 4 L13.5 9 L18.5 10.5 L13.5 12 L12 17 L10.5 12 L5.5 10.5 L10.5 9 Z" stroke="currentColor" stroke-width="1.4" stroke-linejoin="round" fill="none"/><path d="M17.5 15 L18.2 17.3 L20.5 18 L18.2 18.7 L17.5 21 L16.8 18.7 L14.5 18 L16.8 17.3 Z" fill="currentColor"/>`,
  audit:    `<rect x="5" y="4.5" width="14" height="16" rx="2" stroke="currentColor" stroke-width="1.6"/><rect x="9" y="3" width="6" height="3.4" rx="1.1" stroke="currentColor" stroke-width="1.6"/><path d="M8.5 12.5 L11 15 L15.5 10" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"/>`,
  bell:     `<path d="M6 16.5 H18 L16.3 14 V10 A4.3 4.3 0 0 0 7.7 10 V14 Z" stroke="currentColor" stroke-width="1.6" stroke-linejoin="round"/><path d="M10 19.5 A2 2 0 0 0 14 19.5" stroke="currentColor" stroke-width="1.6" stroke-linecap="round"/>`,
  camera:   `<rect x="3.5" y="7" width="17" height="12.5" rx="2.5" stroke="currentColor" stroke-width="1.6"/><path d="M8.5 7 L10 4.5 H14 L15.5 7" stroke="currentColor" stroke-width="1.6" stroke-linejoin="round"/><circle cx="12" cy="13.2" r="3.2" stroke="currentColor" stroke-width="1.6"/>`,
  campaign: `<path d="M4 10 V14 L15 18 V6 Z" stroke="currentColor" stroke-width="1.6" stroke-linejoin="round"/><path d="M15 8.5 A3.5 3.5 0 0 1 15 15.5" stroke="currentColor" stroke-width="1.6"/><path d="M6.5 14.7 V18 A1.6 1.6 0 0 0 9.7 18 V15.8" stroke="currentColor" stroke-width="1.6"/>`,
  clock:    `<circle cx="12" cy="12" r="8" stroke="currentColor" stroke-width="1.6"/><path d="M12 7.5 V12 L15 14" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"/>`,
  cloud:    `<path d="M8 17.5 H16.5 A3.5 3.5 0 0 0 16.8 10.5 A5 5 0 0 0 7.2 11 A3.5 3.5 0 0 0 8 17.5 Z" stroke="currentColor" stroke-width="1.6" stroke-linejoin="round"/>`,
  lock:     `<rect x="5.5" y="10.5" width="13" height="9.5" rx="2" stroke="currentColor" stroke-width="1.6"/><path d="M8.5 10.5 V8 A3.5 3.5 0 0 1 15.5 8 V10.5" stroke="currentColor" stroke-width="1.6"/><circle cx="12" cy="15" r="1.3" fill="currentColor"/>`,
  objects:  `<path d="M12 4 L20 8 L12 12 L4 8 Z" stroke="currentColor" stroke-width="1.6" stroke-linejoin="round"/><path d="M4 12 L12 16 L20 12" stroke="currentColor" stroke-width="1.6" stroke-linejoin="round"/><path d="M4 16 L12 20 L20 16" stroke="currentColor" stroke-width="1.6" stroke-linejoin="round"/>`,
  oss:      `<path d="M9 7.5 L4.5 12 L9 16.5 M15 7.5 L19.5 12 L15 16.5" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"/>`,
  portal:   `<rect x="4" y="5" width="16" height="14" rx="2" stroke="currentColor" stroke-width="1.6"/><path d="M4 9 H20" stroke="currentColor" stroke-width="1.6"/><circle cx="6.7" cy="7" r="0.7" fill="currentColor"/><circle cx="8.9" cy="7" r="0.7" fill="currentColor"/>`,
  refresh:  `<path d="M19 12 A7 7 0 1 1 16.4 6.6" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" fill="none"/><path d="M16.4 3.5 V7 H12.9" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"/>`,
  shield:   `<path d="M12 3.5 L19 6 V11 C19 15.5 16 19 12 20.5 C8 19 5 15.5 5 11 V6 Z" stroke="currentColor" stroke-width="1.6" stroke-linejoin="round"/><path d="M9 11.5 L11.3 13.8 L15.5 9" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"/>`,
  stripe:   `<rect x="3.5" y="6" width="17" height="12" rx="2" stroke="currentColor" stroke-width="1.6"/><path d="M3.5 10 H20.5" stroke="currentColor" stroke-width="1.6"/><path d="M7 14.5 H11" stroke="currentColor" stroke-width="1.6" stroke-linecap="round"/>`,
  sync:     `<path d="M5 10 A7 7 0 0 1 16.8 6.7 L18.5 8.5 M18.5 5 V8.5 H15" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" fill="none"/><path d="M19 14 A7 7 0 0 1 7.2 17.3 L5.5 15.5 M5.5 19 V15.5 H9" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" fill="none"/>`,
};
const DEFAULT_FEAT_ICON = `<rect x="3" y="3" width="18" height="18" rx="4.5" stroke="currentColor" stroke-width="1.6"/><path d="M8 12 L11 15 L16.5 8.5" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"/>`;
const featIcon = (name: string) => featureIcons[name] ?? DEFAULT_FEAT_ICON;

const hasPricingOrReqs = (data.pricing && data.pricing.length > 0) ||
  (data.requirements && data.requirements.length > 0);
---

<Page
  title={data.seoTitle ?? `${data.title} — CloudAlgo Products`}
  description={data.tagline}
  schema={productSchema}
>

  <!-- ① Hero — white bg, matches .page-header -->
  <div class="page-header" style="padding-bottom:3rem;">
    <div class="container">
      <nav class="breadcrumb">
        <a href="/">Home</a>
        <span>&rarr;</span>
        <a href="/products">Products</a>
        <span>&rarr;</span>
        <span aria-current="page">{data.title}</span>
      </nav>
      <div style="display:grid;grid-template-columns:1fr auto;gap:3rem;align-items:center;margin-top:1.5rem;" class="prod-hero-grid">
        <div>
          <p class="section-label">{typeLabel(data.type)}</p>
          <div style="display:flex;align-items:center;gap:0.625rem;margin-bottom:0.75rem;flex-wrap:wrap;">
            {data.status === 'ga' ? (
              <span style="background:#0A0A0A;color:#fff;font-size:0.65rem;font-weight:700;padding:3px 10px;border-radius:100px;text-transform:uppercase;letter-spacing:0.06em;">
                {statusLabel(data.status)}
              </span>
            ) : (
              <span style="border:1.5px solid #0A0A0A;color:#0A0A0A;font-size:0.65rem;font-weight:700;padding:3px 10px;border-radius:100px;text-transform:uppercase;letter-spacing:0.06em;">
                {statusLabel(data.status)}
              </span>
            )}
            {data.version && (
              <span style="font-size:0.8rem;color:#5A5A5A;">v{data.version}</span>
            )}
            {data.lastUpdated && (
              <span style="font-size:0.8rem;color:#5A5A5A;">&middot; Updated {data.lastUpdated}</span>
            )}
          </div>
          <h1 style="font-size:clamp(2rem,4vw,3rem);margin-bottom:0.75rem;">{data.title}</h1>
          <p style="font-size:1.0625rem;color:#5A5A5A;line-height:1.7;max-width:520px;margin-bottom:1.5rem;">
            {data.tagline}
          </p>
          <div style="display:flex;gap:0.75rem;flex-wrap:wrap;">
            {data.externalUrl ? (
              <a href={data.externalUrl} target="_blank" rel="noopener noreferrer" class="btn btn-primary">
                {data.type === 'mobile-app' ? 'Get the App ↗' : data.type === 'desktop-app' ? 'Download ↗' : 'Get started ↗'}
              </a>
            ) : (
              <a href="/contact" class="btn btn-primary">Join waitlist &rarr;</a>
            )}
            {data.type === 'mobile-app' ? (
              <a href={`/apps/insurealgo/privacy`} class="btn btn-outline">Privacy Policy</a>
            ) : data.guideUrl ? (
              <a href={data.guideUrl} class="btn btn-outline">User Guide &rarr;</a>
            ) : data.issuesUrl ? (
              <a href={data.issuesUrl} target="_blank" rel="noopener noreferrer" class="btn btn-outline">Log an issue ↗</a>
            ) : (
              <a href="/contact" class="btn btn-outline">Book a demo</a>
            )}
          </div>
        </div>
        {illustration && (
          <div style="width:460px;flex-shrink:0;" aria-hidden="true" set:html={illustration} class="prod-hero-illo" />
        )}
      </div>
    </div>
  </div>

  <!-- ② Key features — grey bg -->
  <section style="background:#F5F5F2;padding:5rem 0;border-bottom:1px solid #E0E0DC;">
    <div class="container">
      <p class="section-label anim-fade-up">What it does</p>
      <h2 class="feat-heading anim-fade-up">Key Features</h2>
      <div class="feat-grid">
        {data.features.map((f, i) => (
          <div class="feat-card anim-fade-up" style={`transition-delay:${i * 0.06}s;`}>
            <div class="feat-card-top">
              <span class="feat-icon" aria-hidden="true">
                <svg viewBox="0 0 24 24" width="22" height="22" fill="none" set:html={featIcon(f.icon)}></svg>
              </span>
              <span class="feat-num">{String(i + 1).padStart(2, '0')}</span>
            </div>
            <h3 class="feat-title">{f.title}</h3>
            <p class="feat-desc">{f.description}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- ②b The film — near-black band, only if a video is set -->
  {data.video && (
    <section style="background:#0A0A0A;padding:5rem 0;border-bottom:1px solid #0A0A0A;">
      <div class="container">
        <p class="section-label anim-fade-up" style="color:rgba(255,255,255,0.55);">See it in action</p>
        <h2 class="anim-fade-up" style="font-size:clamp(1.75rem,3vw,2.25rem);font-weight:800;letter-spacing:-0.02em;color:#fff;margin-bottom:2rem;transition-delay:0.05s;">
          {data.video.heading ?? `${data.title} in motion`}
        </h2>
        <div class="anim-fade-up" style="transition-delay:0.1s;">
          <VideoPlayer
            src={data.video.src}
            poster={data.video.poster}
            captions={data.video.captions}
            title={data.video.title}
            duration={data.video.duration}
            tone="dark"
          />
        </div>
      </div>
    </section>
  )}

  <!-- ③ Overview — white bg (only if markdown body has content) -->
  {hasBody && (
    <section style="background:#fff;padding:4rem 0;border-bottom:1px solid #E0E0DC;">
      <div class="container">
        <div style="display:grid;grid-template-columns:1fr 1fr;gap:4rem;align-items:start;" class="overview-grid">
          <div>
            <p class="section-label anim-fade-up">Deep Dive</p>
            <h2 class="anim-fade-up" style="font-size:clamp(1.75rem,3vw,2.25rem);font-weight:800;letter-spacing:-0.02em;margin-bottom:1.5rem;transition-delay:0.05s;">
              About {data.title}
            </h2>
            <div class="prod-body anim-fade-up" style="transition-delay:0.1s;">
              <Content />
            </div>
          </div>
          <div class="overview-aside anim-fade-up" style="transition-delay:0.15s;">
            <div style="background:#F5F5F2;border:1px solid #E0E0DC;border-radius:12px;padding:1.75rem;">
              <p style="font-size:0.6875rem;font-weight:700;letter-spacing:0.1em;text-transform:uppercase;color:#5A5A5A;margin-bottom:1rem;">At a glance</p>
              <dl class="glance-list">
                <div class="glance-row">
                  <dt>Type</dt>
                  <dd>{data.type === 'salesforce-app' ? 'Salesforce AppExchange App' : data.type === 'mobile-app' ? 'Flutter Mobile App' : data.type === 'desktop-app' ? 'Desktop App (macOS · Windows · Linux)' : 'Integration Connector'}</dd>
                </div>
                <div class="glance-row">
                  <dt>Status</dt>
                  <dd>{data.status === 'ga' ? 'Generally Available' : data.status === 'preview' ? 'Preview' : 'Beta'}</dd>
                </div>
                {data.version && (
                  <div class="glance-row">
                    <dt>Version</dt>
                    <dd>v{data.version}</dd>
                  </div>
                )}
                {data.requirements && data.requirements.slice(0, 2).map(req => (
                  <div class="glance-row">
                    <dt>Requires</dt>
                    <dd>{req}</dd>
                  </div>
                ))}
              </dl>
            </div>
          </div>
        </div>
      </div>
    </section>
  )}

  <!-- ④ Tech Stack — grey bg (only if techStack data is present) -->
  {data.techStack && data.techStack.length > 0 && (
    <section style="background:#F5F5F2;padding:4rem 0;border-bottom:1px solid #E0E0DC;">
      <div class="container">
        <p class="section-label anim-fade-up">Under the Hood</p>
        <h2 class="anim-fade-up" style="font-size:clamp(1.75rem,3vw,2.25rem);font-weight:800;letter-spacing:-0.02em;margin-bottom:2rem;transition-delay:0.05s;">
          Tech Stack
        </h2>
        <div class="ts-grid">
          {data.techStack.map((item, i) => (
            <div class={`ts-row anim-fade-up`} style={`transition-delay:${i * 0.04}s;`}>
              <span class="ts-label">{item.label}</span>
              <span class="ts-value">{item.value}</span>
            </div>
          ))}
        </div>
      </div>
    </section>
  )}

  <!-- ⑤ Screenshots slider — white bg (only if screenshots array is non-empty) -->
  {data.screenshots && data.screenshots.length > 0 && (
    <section class="ss-section">
      <div class="container">
        <p class="section-label">See it in action</p>
        <h2 class="ss-heading">Screenshots</h2>
      </div>

      <div class="ss-stage" id="ssStage" data-count={data.screenshots.length}>
        <!-- Track: slides laid out absolutely, JS drives translateX -->
        <div class="ss-track" id="ssTrack">
          {data.screenshots.map((src, i) => (
            <div class="ss-slide" data-index={i}>
              <div class="ss-frame">
                <img
                  src={src}
                  alt={`${data.title} screenshot ${i + 1}`}
                  class="ss-img"
                  loading="lazy"
                  draggable="false"
                />
              </div>
            </div>
          ))}
        </div>

        <!-- Dot indicators -->
        <div class="ss-dots" id="ssDots">
          {data.screenshots.map((_s, i) => (
            <button class="ss-dot" data-dot={i} aria-label={`Screenshot ${i + 1}`} />
          ))}
        </div>

        <!-- Prev / Next arrows -->
        <button class="ss-arrow ss-arrow-prev" id="ssPrev" aria-label="Previous screenshot">
          <svg width="20" height="20" viewBox="0 0 20 20" fill="none">
            <path d="M12.5 15L7.5 10L12.5 5" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/>
          </svg>
        </button>
        <button class="ss-arrow ss-arrow-next" id="ssNext" aria-label="Next screenshot">
          <svg width="20" height="20" viewBox="0 0 20 20" fill="none">
            <path d="M7.5 5L12.5 10L7.5 15" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/>
          </svg>
        </button>
      </div>
    </section>
  )}

  <!-- ⑥ Roadmap — white bg (only if roadmap data is present) -->
  {data.roadmap && data.roadmap.length > 0 && (
