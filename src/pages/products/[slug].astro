const illustration = illustrations[slug] ?? '';

const hasPricingOrReqs = (data.pricing && data.pricing.length > 0) ||
  (data.requirements && data.requirements.length > 0);
---

<Page
  title={`${data.title} — CloudAlgo Products`}
  description={data.tagline}
>

  <!-- ① Hero — white bg, matches .page-header -->
  <div class="page-header" style="padding-bottom:3rem;">
    <div class="container">
      <nav class="breadcrumb">
        <a href="/">Home</a>
        <span>&rarr;</span>
        <a href="/products">Products</a>
        <span>&rarr;</span>
        <span aria-current="page">{data.title}</span>
      </nav>
      <div style="display:grid;grid-template-columns:1fr auto;gap:3rem;align-items:center;margin-top:1.5rem;" class="prod-hero-grid">
        <div>
          <p class="section-label">{typeLabel(data.type)}</p>
          <div style="display:flex;align-items:center;gap:0.625rem;margin-bottom:0.75rem;flex-wrap:wrap;">
            {data.status === 'ga' ? (
              <span style="background:#0A0A0A;color:#fff;font-size:0.65rem;font-weight:700;padding:3px 10px;border-radius:100px;text-transform:uppercase;letter-spacing:0.06em;">
                {statusLabel(data.status)}
              </span>
            ) : (
              <span style="border:1.5px solid #0A0A0A;color:#0A0A0A;font-size:0.65rem;font-weight:700;padding:3px 10px;border-radius:100px;text-transform:uppercase;letter-spacing:0.06em;">
                {statusLabel(data.status)}
              </span>
            )}
            {data.version && (
              <span style="font-size:0.8rem;color:#5A5A5A;">v{data.version}</span>
            )}
            {data.lastUpdated && (
              <span style="font-size:0.8rem;color:#5A5A5A;">&middot; Updated {data.lastUpdated}</span>
            )}
          </div>
          <h1 style="font-size:clamp(2rem,4vw,3rem);margin-bottom:0.75rem;">{data.title}</h1>
          <p style="font-size:1.0625rem;color:#5A5A5A;line-height:1.7;max-width:520px;margin-bottom:1.5rem;">
            {data.tagline}
          </p>
          <div style="display:flex;gap:0.75rem;flex-wrap:wrap;">
            {data.externalUrl ? (
              <a href={data.externalUrl} target="_blank" rel="noopener noreferrer" class="btn btn-primary">
                {data.type === 'mobile-app' ? 'Download on App Store ↗' : 'Get started ↗'}
              </a>
            ) : (
              <a href="/contact" class="btn btn-primary">Join waitlist &rarr;</a>
            )}
            {data.type !== 'mobile-app' && (
              <a href="/contact" class="btn btn-outline">Book a demo</a>
            )}
            {data.type === 'mobile-app' && (
              <a href={`/apps/insurealgo/privacy`} class="btn btn-outline">Privacy Policy</a>
            )}
          </div>
        </div>
        {illustration && (
          <div style="width:320px;flex-shrink:0;" aria-hidden="true" set:html={illustration} class="prod-hero-illo" />
        )}
      </div>
    </div>
  </div>

  <!-- ② Key features — grey bg -->
  <section style="background:#F5F5F2;padding:4rem 0;border-bottom:1px solid #E0E0DC;">
    <div class="container">
      <p class="section-label anim-fade-up">What it does</p>
      <h2 class="anim-fade-up" style="font-size:clamp(1.75rem,3vw,2.25rem);font-weight:800;letter-spacing:-0.02em;margin-bottom:2rem;transition-delay:0.05s;">
        Key Features
      </h2>
      <div style="display:grid;grid-template-columns:repeat(auto-fit,minmax(220px,1fr));gap:1rem;">
        {data.features.map((f, i) => (
          <div
            class="anim-scale-pop"
            style={`background:#fff;border:1px solid #E0E0DC;border-radius:12px;padding:1.5rem;transition-delay:${i * 0.06}s;`}
          >
            <div style="margin-bottom:0.75rem;" aria-hidden="true">
              <svg width="22" height="22" viewBox="0 0 18 18" fill="none">
                <rect x="0.75" y="0.75" width="16.5" height="16.5" rx="4.25" stroke="#0A0A0A" stroke-width="1.5"/>
                <path d="M5.5 9L7.8 11.5L12.5 6.5" stroke="#0A0A0A" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/>
              </svg>
            </div>
            <h3 style="font-size:1rem;font-weight:700;color:#0A0A0A;margin-bottom:0.4rem;">{f.title}</h3>
            <p style="font-size:0.875rem;color:#5A5A5A;line-height:1.6;margin:0;">{f.description}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- ③ Screenshots slider — white bg (only if screenshots array is non-empty) -->
  {data.screenshots && data.screenshots.length > 0 && (
    <section class="ss-section">
      <div class="container">
        <p class="section-label">See it in action</p>
        <h2 class="ss-heading">Screenshots</h2>
      </div>

      <div class="ss-stage" id="ssStage" data-count={data.screenshots.length}>
        <!-- Track: slides laid out absolutely, JS drives translateX -->
        <div class="ss-track" id="ssTrack">
          {data.screenshots.map((src, i) => (
            <div class="ss-slide" data-index={i}>
              <div class="ss-frame">
                <img
                  src={src}
                  alt={`${data.title} screenshot ${i + 1}`}
                  class="ss-img"
                  loading="lazy"
                  draggable="false"
                />
              </div>
            </div>
          ))}
        </div>

        <!-- Dot indicators -->
        <div class="ss-dots" id="ssDots">
          {data.screenshots.map((_s, i) => (
            <button class="ss-dot" data-dot={i} aria-label={`Screenshot ${i + 1}`} />
          ))}
        </div>

        <!-- Prev / Next arrows -->
        <button class="ss-arrow ss-arrow-prev" id="ssPrev" aria-label="Previous screenshot">
          <svg width="20" height="20" viewBox="0 0 20 20" fill="none">
            <path d="M12.5 15L7.5 10L12.5 5" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/>
          </svg>
        </button>
        <button class="ss-arrow ss-arrow-next" id="ssNext" aria-label="Next screenshot">
          <svg width="20" height="20" viewBox="0 0 20 20" fill="none">
            <path d="M7.5 5L12.5 10L7.5 15" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/>
          </svg>
        </button>
      </div>
    </section>
  )}

  <!-- ④ Pricing + Requirements — grey bg (only if at least one is set) -->
  {hasPricingOrReqs && (
    <section style="background:#F5F5F2;padding:4rem 0;border-bottom:1px solid #E0E0DC;">
      <div class="container">
        <div style="display:grid;grid-template-columns:repeat(auto-fit,minmax(260px,1fr));gap:3rem;">
          {data.pricing && data.pricing.length > 0 && (
            <div>
              <p class="section-label">Licensing</p>
              <h3 style="font-size:1.125rem;font-weight:700;color:#0A0A0A;margin-bottom:1rem;">Pricing</h3>
              <table style="width:100%;border-collapse:collapse;border:1px solid #E0E0DC;border-radius:12px;overflow:hidden;background:#fff;">
                <tbody>
                  {data.pricing.map((row, i) => (
                    <tr style={i > 0 ? 'border-top:1px solid #E0E0DC;' : ''}>
                      <td style="padding:0.875rem 1.25rem;font-weight:700;color:#0A0A0A;font-size:0.9375rem;">{row.tier}</td>
                      <td style="padding:0.875rem 1.25rem;color:#5A5A5A;font-weight:600;font-size:0.9375rem;text-align:right;">{row.price}</td>
                    </tr>
                  ))}
                </tbody>
              </table>
            </div>
          )}
          {data.requirements && data.requirements.length > 0 && (
            <div>
              <p class="section-label">Before you install</p>
              <h3 style="font-size:1.125rem;font-weight:700;color:#0A0A0A;margin-bottom:1rem;">Requirements</h3>
              <ul style="list-style:none;padding:0;margin:0;display:flex;flex-direction:column;gap:0.75rem;">
                {data.requirements.map(req => (
                  <li style="font-size:0.9375rem;color:#5A5A5A;padding-left:1.5rem;position:relative;line-height:1.55;">
                    <span style="position:absolute;left:0;color:#0A0A0A;font-weight:700;">→</span>
                    {req}
                  </li>
                ))}
              </ul>
            </div>
          )}
        </div>
      </div>
    </section>
  )}

  <!-- ⑤ CTA strip — dark bg -->
  <section style="background:#0A0A0A;padding:4rem 0;">
    <div class="container">
      <div style="display:flex;align-items:center;justify-content:space-between;gap:2rem;flex-wrap:wrap;">
        <div>
          <h2 style="font-size:clamp(1.5rem,3vw,2rem);font-weight:900;color:#fff;letter-spacing:-0.025em;margin-bottom:0.35rem;">
            Ready to get started?
          </h2>
          <p style="font-size:0.9375rem;color:rgba(255,255,255,0.5);margin:0;">
            {data.externalUrl ? 'Available now — free to get started' : 'Early access — join the waitlist'}
          </p>
        </div>
        <div style="display:flex;gap:0.75rem;flex-wrap:wrap;">
          {data.externalUrl ? (
            <a href={data.externalUrl} target="_blank" rel="noopener noreferrer" class="btn btn-light">
              {data.type === 'mobile-app' ? 'Download on App Store ↗' : 'Get started ↗'}
            </a>
          ) : (
            <a href="/contact" class="btn btn-light">Join waitlist →</a>
          )}
          {data.type === 'mobile-app' ? (
            <a href={`/apps/insurealgo/privacy`} class="btn" style="background:transparent;color:#fff;border-color:rgba(255,255,255,0.3);">
              Privacy Policy
            </a>
          ) : (
            <a href="/contact" class="btn" style="background:transparent;color:#fff;border-color:rgba(255,255,255,0.3);">
              Contact us
            </a>
          )}
        </div>
      </div>
    </div>
  </section>

<style>
@media (max-width: 767px) {
  .prod-hero-grid { grid-template-columns: 1fr !important; }
  .prod-hero-illo { display: none !important; }
}

/* ── Screenshot Slider ───────────────────────────────────── */
.ss-section {
  background: #fff;
  padding: 4rem 0 3rem;
  border-bottom: 1px solid #E0E0DC;
  overflow: hidden;
}

.ss-heading {
  font-size: clamp(1.75rem, 3vw, 2.25rem);
  font-weight: 800;
  letter-spacing: -0.02em;
  margin-bottom: 2.5rem;
}

/* Stage: fixed-height viewport, clips overflow */
.ss-stage {
  position: relative;
  height: 600px;
  display: flex;
  align-items: center;
  justify-content: center;
}

/* Track fills the full width, slides position inside it */
.ss-track {
  position: relative;
  width: 100%;
  height: 100%;
  display: flex;
  align-items: center;
  justify-content: center;
}

/* Each slide */
.ss-slide {
  position: absolute;
  display: flex;
  align-items: center;
  justify-content: center;
  transition:
    transform 0.65s cubic-bezier(0.4, 0, 0.2, 1),
    opacity   0.65s cubic-bezier(0.4, 0, 0.2, 1),
    scale     0.65s cubic-bezier(0.4, 0, 0.2, 1),
    filter    0.65s cubic-bezier(0.4, 0, 0.2, 1);
  will-change: transform, opacity, scale, filter;
}

/* Phone-frame wrapper */
.ss-frame {
  background: #0A0A0A;
  border-radius: 36px;
  padding: 10px;
  box-shadow:
    0 0 0 1px rgba(255,255,255,0.08) inset,
    0 24px 80px rgba(0,0,0,0.18),
    0 4px 16px rgba(0,0,0,0.10);
  position: relative;
}

.ss-frame::before {
  content: '';
  position: absolute;
  top: 10px;
  left: 50%;
  transform: translateX(-50%);
  width: 72px;
  height: 10px;
  background: #1a1a1a;
  border-radius: 0 0 8px 8px;
  z-index: 1;
}

.ss-img {
  display: block;
  height: 480px;
  width: auto;
  border-radius: 28px;
  pointer-events: none;
  user-select: none;
}

/* Dot row */
.ss-dots {
  position: absolute;
  bottom: 0;
  left: 50%;
  transform: translateX(-50%);
  display: flex;
  gap: 8px;
  z-index: 10;
}

.ss-dot {
  width: 8px;
  height: 8px;
  border-radius: 50%;
  border: none;
  background: #0A0A0A;
  opacity: 0.18;
  cursor: pointer;
  padding: 0;
  transition: opacity 0.3s, transform 0.3s, width 0.3s;
}

.ss-dot.active {
  opacity: 1;
  width: 24px;
  border-radius: 4px;
}

/* Arrows */
.ss-arrow {
  position: absolute;
  top: 50%;
  transform: translateY(-50%);
  width: 44px;
  height: 44px;
  border-radius: 50%;
  border: 1.5px solid #E0E0DC;
  background: #fff;
  color: #0A0A0A;
  display: flex;
  align-items: center;
  justify-content: center;
  cursor: pointer;
  z-index: 10;
  transition: border-color 0.2s, box-shadow 0.2s, transform 0.2s;
  box-shadow: 0 2px 8px rgba(0,0,0,0.06);
}

.ss-arrow:hover {
  border-color: #0A0A0A;
  box-shadow: 0 4px 16px rgba(0,0,0,0.12);
  transform: translateY(-50%) scale(1.08);
}

.ss-arrow-prev { left: max(1rem, calc(50% - 320px)); }
.ss-arrow-next { right: max(1rem, calc(50% - 320px)); }

@media (max-width: 767px) {
  .ss-stage { height: 480px; }
  .ss-img { height: 360px; }
  .ss-frame { border-radius: 28px; }
  .ss-img { border-radius: 20px; }
  .ss-arrow-prev { left: 0.5rem; }
  .ss-arrow-next { right: 0.5rem; }
}
</style>

<script>
  (function () {
    const stage   = document.getElementById('ssStage');
    const track   = document.getElementById('ssTrack');
    const dotsEl  = document.getElementById('ssDots');
    const btnPrev = document.getElementById('ssPrev');
    const btnNext = document.getElementById('ssNext');
    if (!stage || !track || !dotsEl || !btnPrev || !btnNext) return;

    const slides   = Array.from(track.querySelectorAll<HTMLElement>('.ss-slide'));
    const dots     = Array.from(dotsEl.querySelectorAll<HTMLElement>('.ss-dot'));
    const total    = slides.length;
    let current    = 0;
    let timer: number | undefined;
    const INTERVAL = 3200;

    function getSlideWidth(): number {
      const img = slides[0]?.querySelector<HTMLElement>('.ss-img');
      return img ? img.offsetWidth + 20 : 280;
    }

    function render(animate: boolean): void {
      const sw = getSlideWidth();
      slides.forEach((slide, i) => {
        const dist    = i - current;
        const absDist = Math.abs(dist);
        const xRaw    = dist * sw * 0.62;
        const sc      = absDist === 0 ? 1    : absDist === 1 ? 0.78 : 0.62;
        const op      = absDist === 0 ? 1    : absDist === 1 ? 0.55 : 0.28;
        const blur    = absDist === 0 ? 0    : absDist === 1 ? 3    : 7;
        const zIdx    = total - absDist;

        if (!animate) {
          slide.style.transition = 'none';
          requestAnimationFrame(() => { slide.style.transition = ''; });
        }

        slide.style.transform = `translateX(${xRaw}px) scale(${sc})`;
        slide.style.opacity   = String(op);
        slide.style.filter    = blur ? `blur(${blur}px)` : '';
        slide.style.zIndex    = String(zIdx);
      });

      dots.forEach((d, i) => d.classList.toggle('active', i === current));
    }

    function goTo(n: number, animate = true): void {
      current = ((n % total) + total) % total;
      render(animate);
    }

    function next(): void { goTo(current + 1); }
    function prev(): void { goTo(current - 1); }

    function startTimer(): void {
      clearInterval(timer);
      timer = window.setInterval(next, INTERVAL);
    }

    render(false);
    startTimer();

    btnNext.addEventListener('click', () => { next(); startTimer(); });
    btnPrev.addEventListener('click', () => { prev(); startTimer(); });

    dots.forEach((dot, i) => {
      dot.addEventListener('click', () => { goTo(i); startTimer(); });
    });

    stage.addEventListener('mouseenter', () => clearInterval(timer));
    stage.addEventListener('mouseleave', () => startTimer());

    let touchStartX = 0;
    stage.addEventListener('touchstart', (e: TouchEvent) => {
      touchStartX = e.touches[0].clientX;
    }, { passive: true });
    stage.addEventListener('touchend', (e: TouchEvent) => {
      const dx = e.changedTouches[0].clientX - touchStartX;
      if (Math.abs(dx) > 40) { dx < 0 ? next() : prev(); startTimer(); }
    }, { passive: true });

    window.addEventListener('resize', () => render(false));
  })();
</script>

</Page>
