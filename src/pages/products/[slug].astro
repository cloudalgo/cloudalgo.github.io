    <text x="150" y="77" font-family="Outfit,sans-serif" font-size="13" font-weight="800" fill="#0A0A0A">OrgVitals</text>
    <text x="374" y="77" text-anchor="end" font-family="Outfit,sans-serif" font-size="9" fill="#0A0A0A" opacity="0.5" letter-spacing="0.06em">HEALTH REPORT</text>
    <!-- Left: grade dial -->
