/* Stage: fixed-height viewport, clips overflow */
.ss-stage {
  position: relative;
  height: 600px;
  display: flex;
  align-items: center;
  justify-content: center;
}

/* Track fills the full width, slides position inside it */
.ss-track {
  position: relative;
  width: 100%;
  height: 100%;
  display: flex;
  align-items: center;
  justify-content: center;
}

/* Each slide */
.ss-slide {
  position: absolute;
  display: flex;
  align-items: center;
  justify-content: center;
  transition:
    transform 0.65s cubic-bezier(0.4, 0, 0.2, 1),
    opacity   0.65s cubic-bezier(0.4, 0, 0.2, 1),
    scale     0.65s cubic-bezier(0.4, 0, 0.2, 1),
    filter    0.65s cubic-bezier(0.4, 0, 0.2, 1);
  will-change: transform, opacity, scale, filter;
}

/* Phone-frame wrapper */
.ss-frame {
  background: #0A0A0A;
  border-radius: 36px;
  padding: 10px;
  box-shadow:
    0 0 0 1px rgba(255,255,255,0.08) inset,
    0 24px 80px rgba(0,0,0,0.18),
    0 4px 16px rgba(0,0,0,0.10);
  position: relative;
}

.ss-frame::before {
  content: '';
  position: absolute;
  top: 10px;
  left: 50%;
  transform: translateX(-50%);
  width: 72px;
  height: 10px;
  background: #1a1a1a;
  border-radius: 0 0 8px 8px;
  z-index: 1;
}

.ss-img {
  display: block;
  height: 480px;
  width: auto;
  border-radius: 28px;
  pointer-events: none;
  user-select: none;
}

/* Dot row */
.ss-dots {
  position: absolute;
  bottom: 0;
  left: 50%;
  transform: translateX(-50%);
  display: flex;
  gap: 8px;
  z-index: 10;
}

.ss-dot {
  width: 8px;
  height: 8px;
  border-radius: 50%;
  border: none;
  background: #0A0A0A;
  opacity: 0.18;
  cursor: pointer;
  padding: 0;
  transition: opacity 0.3s, transform 0.3s, width 0.3s;
}

.ss-dot.active {
  opacity: 1;
  width: 24px;
  border-radius: 4px;
}

/* Arrows */
.ss-arrow {
  position: absolute;
  top: 50%;
  transform: translateY(-50%);
  width: 44px;
  height: 44px;
  border-radius: 50%;
  border: 1.5px solid #E0E0DC;
  background: #fff;
  color: #0A0A0A;
  display: flex;
  align-items: center;
  justify-content: center;
  cursor: pointer;
  z-index: 10;
  transition: border-color 0.2s, box-shadow 0.2s, transform 0.2s;
  box-shadow: 0 2px 8px rgba(0,0,0,0.06);
}

.ss-arrow:hover {
  border-color: #0A0A0A;
  box-shadow: 0 4px 16px rgba(0,0,0,0.12);
  transform: translateY(-50%) scale(1.08);
}

.ss-arrow-prev { left: max(1rem, calc(50% - 320px)); }
.ss-arrow-next { right: max(1rem, calc(50% - 320px)); }

@media (max-width: 767px) {
  .ss-stage { height: 480px; }
  .ss-img { height: 360px; }
  .ss-frame { border-radius: 28px; }
  .ss-img { border-radius: 20px; }
  .ss-arrow-prev { left: 0.5rem; }
  .ss-arrow-next { right: 0.5rem; }
}
