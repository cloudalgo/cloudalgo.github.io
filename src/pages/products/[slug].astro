    <text x="210" y="246" font-family="Outfit,sans-serif" font-size="8" font-weight="700" fill="#0A0A0A" opacity="0.55" letter-spacing="0.05em">PERFORMANCE</text>
    <rect x="210" y="252" width="168" height="8" rx="4" fill="#0A0A0A" opacity="0.08"/>
