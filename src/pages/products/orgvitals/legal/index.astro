---
// DRAFT: template prepared for CloudAlgo. Review by qualified legal counsel before relying on it.
//
// The register of OrgVitals instruments. It carries no copy of its own
// beyond the standfirst: every fact on the page comes from
// src/data/legal.ts, the same source each document's docket reads, so
// the index cannot describe a document differently from the document.
import Page from '@/layouts/Page.astro';
import PageMasthead from '@/components/ui/PageMasthead.astro';
import Instruments from '@/components/sections/Instruments.astro';
import { instruments, ISSUER } from '@/data/legal';

const docs = instruments.filter((i) => i.register === 'orgvitals');

const crumbs = [
  { label: 'Home', href: '/' },
  { label: 'Products', href: '/products' },
  { label: 'OrgVitals', href: '/products/orgvitals' },
  { label: 'Legal' },
];
---
<Page
  title="OrgVitals legal — CloudAlgo"
  description="The four instruments governing OrgVitals by CloudAlgo: Privacy Policy, Terms of Service, Data Processing and Usage, and the Acceptable Use Policy."
  canonicalURL="https://cloudalgo.com/products/orgvitals/legal"
>
  <PageMasthead
    crumbs={crumbs}
    facts={[
      { term: 'Instruments', detail: String(docs.length) },
      { term: 'In force since', detail: docs[0].inForce },
      { term: 'Governing law', detail: 'India' },
      { term: 'Issued by', detail: ISSUER },
    ]}
  >
    <Fragment slot="title">Legal</Fragment>
    <Fragment slot="lede">
      Four documents govern OrgVitals. You accept the Terms and the Acceptable
      Use Policy through the in-app consent gate; the other two say what the app
      does with your data and where it goes.
    </Fragment>
  </PageMasthead>

  {/* No `meta` on the head: the docket directly above already prints the
      count, the date in force, the governing law and the issuer, and every
      row below repeats the date. One statement of a filing fact per page. */}
  <Instruments title="In force" items={docs}>
    All four are issued by {ISSUER} and governed by the law of India. Questions
    about any of them go to <a href="mailto:contact@cloudalgo.com">contact@cloudalgo.com</a>.
  </Instruments>
</Page>
