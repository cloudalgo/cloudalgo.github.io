---
import Page from '../layouts/Page.astro';
import { getCollection } from 'astro:content';
import BlogCard from '../components/ui/BlogCard.astro';
import StatsBar from '../components/sections/StatsBar.astro';
import TestimonialsSection from '../components/sections/Testimonials.astro';

const posts = (await getCollection('blog', ({ data }) => data.published))
  .sort((a, b) => b.data.date.getTime() - a.data.date.getTime())
  .slice(0, 4);
---
<Page title="CloudAlgo - Salesforce Consulting Services"
      description="CloudAlgo is your trusted Salesforce & Heroku consulting partner.">

  <!-- Hero -->
  <div class="hero-img-bg">
    <section class="banner-caption d-flex">
      <div class="container d-flex align-content-center flex-wrap">
        <div class="banner-caption_inner">
          <p class="paragraph-large">We are a Salesforce &amp; Heroku consulting agency</p>
          <h1>We help you make the most out of your Salesforce orgs and suggest solutions to your specific needs.</h1>
          <a href="/contact" class="btn btn-light mt-4">Get Started <span class="icon-arrow_forward"></span></a>
        </div>
      </div>
    </section>
  </div>

  <!-- About -->
  <section class="about-section section-padding--vertical">
    <div class="container">
      <div class="row">
        <div class="col-lg-7 col-md-6 align-self-center">
          <img src="/cloud-img.png" alt="CloudAlgo cloud solutions" class="img-fluid" />
        </div>
        <div class="col-lg-5 col-md-6 align-self-center">
          <div class="about-section_inner">
            <h2>Welcome to CloudAlgo</h2>
            <p class="paragraph-large">
              CloudAlgo is your trusted, customer-focused consulting and implementation partner specializing in
              <b>Salesforce and advanced cloud solutions</b>. As an authorized provider, we deliver tailored services
              to businesses across diverse industries. Our team of seasoned experts crafts <b>customized, cloud-based
              strategies</b> that <b>accelerate efficiency, drive automation, and optimize operations</b>.
            </p>
            <p class="paragraph-large">
              Beyond Salesforce, we excel in <b>Heroku consulting</b> to empower you to
              <b>build, run, and scale modern applications effortlessly</b>. Our expertise extends to
              <b>MuleSoft, AWS</b>, and other Salesforce integrations, enabling seamless connectivity across your
              technology stack.
            </p>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- Why Choose Us -->
  <section class="excellence-section grey-bg section-padding--vertical">
    <div class="container">
      <div class="heading-n-description text-center">
        <h2>Why Choose Us</h2>
        <p class="paragraph-large">
          At CloudAlgo, we bring a unique combination of expertise across <b>Salesforce</b>, <b>Heroku</b>,
          <b>MuleSoft</b>, <b>AWS</b>, and other advanced integration technologies. This enables us to provide
          <b>comprehensive, end-to-end solutions</b> tailored to your business's specific needs. Our team of certified
          consultants works closely with you to deeply understand your objectives, crafting <b>customized strategies</b> that
          <b>accelerate efficiency, automate workflows, and optimize operations</b>.
        </p>
        <p class="paragraph-large">
          With our broad experience in <b>cloud computing and enterprise integrations</b>, we empower your business
          to <b>build, scale, and modernize applications</b> while leveraging the full potential of Salesforce and
          cutting-edge platforms. Whether you're looking to streamline sales and marketing processes, integrate complex
          systems, or harness the power of data through Snowflake and AWS, CloudAlgo is your
          <b>trusted partner for innovation and growth</b>.
        </p>
        <p class="paragraph-large">
          Choose CloudAlgo to unlock your business's potential and achieve <b>impactful, measurable results</b> in
          today's dynamic digital landscape.
        </p>
      </div>
      <div class="featured-cards">
        <div class="row">
          <!-- Card 1 -->
          <div class="featured-card col-lg-3 col-md-6 align-items-stretch">
            <div class="featured-card-bg">
              <div class="featured-card-icon">
