---
import Page from '../layouts/Page.astro';
import Hero from '../components/sections/Hero.astro';
import ProofStrip from '../components/sections/ProofStrip.astro';
import Services from '../components/sections/Services.astro';
import Band from '../components/sections/Band.astro';
import ProductsSection from '../components/sections/ProductsSection.astro';
import CaseStudies from '../components/sections/CaseStudies.astro';
import BlogPreview from '../components/sections/BlogPreview.astro';

import { organization, website, orgRef, abs } from '@/data/schema';

// The home page carries the canonical copy of both entity nodes: it is the
// URL every other page's `@id` resolves against, and the one a crawler
// reaches first.
const schema = [
  organization,
  website,
  {
    '@type': 'WebPage',
    '@id': abs('/'),
    url: abs('/'),
    name: 'CloudAlgo — Salesforce & Heroku Consulting',
    isPartOf: { '@id': website['@id'] },
    about: orgRef,
    publisher: orgRef,
    inLanguage: 'en',
  },
];
---
<Page
  title="CloudAlgo — Salesforce & Heroku Consulting"
  description="CloudAlgo is a certified Salesforce & Heroku consulting firm specializing in CRM implementation, AppExchange development, and MuleSoft integration. 70+ projects, 15+ happy clients."
  {schema}
>
  <Hero />
  <ProofStrip />
  <ProductsSection />
  <Services />
  <Band />
  <CaseStudies />
  <BlogPreview />
</Page>
