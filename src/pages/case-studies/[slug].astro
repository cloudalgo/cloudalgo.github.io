---
import Page from '../../layouts/Page.astro';
import { caseStudies } from '../../data/case-studies';

export function getStaticPaths() {
  return caseStudies.map(cs => ({ params: { slug: cs.id }, props: { cs } }));
}

const { cs } = Astro.props;
const prev = caseStudies[caseStudies.findIndex(c => c.id === cs.id) - 1];
const next = caseStudies[caseStudies.findIndex(c => c.id === cs.id) + 1];
---

<Page
  title={`${cs.company} — ${cs.headline} | CloudAlgo Case Study`}
  description={cs.summary}
  ogType="article"
>

  <!-- ── Hero ── -->
  <div class="page-header csd-hero-wrap">
    <div class="container">
      <nav class="breadcrumb">
        <a href="/">Home</a>
        <span>&rarr;</span>
        <a href="/case-studies">Case Studies</a>
        <span>&rarr;</span>
        <span>{cs.company}</span>
      </nav>
      <div class="csd-hero-inner">
        <div class="csd-hero-text">

          <div class="csd-hero-meta">
            <span class="csd-index">{cs.index}</span>
            <span class="csd-pill">{cs.industry}</span>
            <span class="csd-pill">{cs.service}</span>
          </div>
          <h1 class="csd-hero-title">{cs.headline}</h1>
          <p class="csd-hero-sub">{cs.summary}</p>
          <div class="csd-hero-stats">
            <div class="csd-hero-stat">
              <span class="csd-hero-stat-num">{cs.metric}</span>
              <span class="csd-hero-stat-label">{cs.metricLabel}</span>
            </div>
            <div class="csd-hero-divider"></div>
            <div class="csd-hero-stat">
              <span class="csd-hero-stat-num">{cs.duration}</span>
              <span class="csd-hero-stat-label">engagement length</span>
            </div>
          </div>
        </div>

        <!-- Per-case illustration (light-themed) -->
        <div class="csd-hero-illo" aria-hidden="true">
          {cs.id === 'retailscale' && (
            <svg viewBox="0 0 320 240" fill="none" class="csd-hero-svg">
              <rect x="16"  y="140" width="44" height="86"  rx="4" stroke="#0A0A0A" stroke-width="2" opacity="0.18"/>
              <rect x="76"  y="100" width="44" height="126" rx="4" stroke="#0A0A0A" stroke-width="2" opacity="0.32"/>
              <rect x="136" y="60"  width="44" height="166" rx="4" stroke="#0A0A0A" stroke-width="2" opacity="0.48"/>
              <rect x="196" y="28"  width="44" height="198" rx="4" stroke="#0A0A0A" stroke-width="2" opacity="0.65"/>
              <rect x="256" y="6"   width="44" height="220" rx="4" fill="rgba(10,10,10,0.05)" stroke="#0A0A0A" stroke-width="2" opacity="0.85"/>
              <path d="M38 140 L98 100 L158 60 L218 28 L278 8" stroke="#0A0A0A" stroke-width="2" stroke-dasharray="6 4" opacity="0.4" stroke-linecap="round"/>
              <circle cx="278" cy="8" r="5" fill="#0A0A0A" opacity="0.65"/>
              <line x1="8" y1="228" x2="312" y2="228" stroke="#0A0A0A" stroke-width="1.5" opacity="0.1"/>
            </svg>
          )}
          {cs.id === 'medbridge' && (
            <svg viewBox="0 0 320 240" fill="none" class="csd-hero-svg">
              <circle cx="160" cy="120" r="100" stroke="#0A0A0A" stroke-width="2" opacity="0.1"/>
              <circle cx="160" cy="120" r="70"  stroke="#0A0A0A" stroke-width="2" opacity="0.18"/>
              <circle cx="160" cy="120" r="40"  stroke="#0A0A0A" stroke-width="2" opacity="0.28"/>
              <path d="M160 20 L160 220 M60 120 L260 120" stroke="#0A0A0A" stroke-width="3" stroke-linecap="round" opacity="0.6"/>
              <rect x="234" y="16" width="74" height="34" rx="17" fill="#0A0A0A" opacity="0.85"/>
              <text x="271" y="38" text-anchor="middle" font-family="Outfit,sans-serif" font-size="14" font-weight="900" fill="#fff">18×</text>
              <circle cx="36"  cy="26"  r="4" fill="#0A0A0A" opacity="0.12"/>
              <circle cx="284" cy="214" r="4" fill="#0A0A0A" opacity="0.12"/>
            </svg>
          )}
          {cs.id === 'gridflow' && (
            <svg viewBox="0 0 320 240" fill="none" class="csd-hero-svg">
              <circle cx="60"  cy="120" r="44" stroke="#0A0A0A" stroke-width="2" opacity="0.25"/>
              <circle cx="160" cy="120" r="44" stroke="#0A0A0A" stroke-width="2" opacity="0.48"/>
              <circle cx="260" cy="120" r="44" stroke="#0A0A0A" stroke-width="2" opacity="0.7"/>
              <line x1="104" y1="120" x2="116" y2="120" stroke="#0A0A0A" stroke-width="2.5" stroke-dasharray="4 3" opacity="0.5"/>
              <path d="M112 114 L118 120 L112 126" stroke="#0A0A0A" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" opacity="0.5"/>
              <line x1="204" y1="120" x2="216" y2="120" stroke="#0A0A0A" stroke-width="2.5" stroke-dasharray="4 3" opacity="0.5"/>
              <path d="M212 114 L218 120 L212 126" stroke="#0A0A0A" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" opacity="0.5"/>
              <text x="60"  y="117" text-anchor="middle" font-family="Outfit,sans-serif" font-size="11" font-weight="800" fill="#0A0A0A" opacity="0.4">SAP</text>
              <text x="60"  y="131" text-anchor="middle" font-family="Outfit,sans-serif" font-size="9"  fill="#0A0A0A" opacity="0.3">ERP</text>
              <text x="160" y="117" text-anchor="middle" font-family="Outfit,sans-serif" font-size="11" font-weight="800" fill="#0A0A0A" opacity="0.62">Mule</text>
              <text x="160" y="131" text-anchor="middle" font-family="Outfit,sans-serif" font-size="9"  fill="#0A0A0A" opacity="0.45">Soft</text>
              <text x="260" y="117" text-anchor="middle" font-family="Outfit,sans-serif" font-size="11" font-weight="800" fill="#0A0A0A" opacity="0.82">SF</text>
              <text x="260" y="131" text-anchor="middle" font-family="Outfit,sans-serif" font-size="9"  fill="#0A0A0A" opacity="0.6">CRM</text>
            </svg>
          )}
          {cs.id === 'shieldinsure' && (
            <svg viewBox="0 0 320 240" fill="none" class="csd-hero-svg">
              <path d="M160 8 L268 48 L268 124 C268 168 216 192 160 200 C104 192 52 168 52 124 L52 48 Z" stroke="#0A0A0A" stroke-width="2" opacity="0.12"/>
              <path d="M160 26 L248 60 L248 120 C248 156 208 174 160 180 C112 174 72 156 72 120 L72 60 Z" stroke="#0A0A0A" stroke-width="2" opacity="0.24"/>
              <path d="M160 46 L228 74 L228 116 C228 144 200 156 160 162 C120 156 92 144 92 116 L92 74 Z" stroke="#0A0A0A" stroke-width="2" opacity="0.4"/>
              <path d="M120 110 L146 136 L202 88" stroke="#0A0A0A" stroke-width="4" stroke-linecap="round" stroke-linejoin="round" opacity="0.7"/>
            </svg>
          )}
          {cs.id === 'partsco' && (
            <svg viewBox="0 0 320 240" fill="none" class="csd-hero-svg">
              <rect x="16" y="20" width="110" height="148" rx="6" stroke="#0A0A0A" stroke-width="2" opacity="0.25"/>
              <rect x="28" y="38" width="86" height="14" rx="3" fill="#0A0A0A" opacity="0.1"/>
              <rect x="28" y="60" width="70" height="8"  rx="2" fill="#0A0A0A" opacity="0.08"/>
              <rect x="28" y="76" width="78" height="8"  rx="2" fill="#0A0A0A" opacity="0.08"/>
              <rect x="28" y="92" width="60" height="8"  rx="2" fill="#0A0A0A" opacity="0.08"/>
              <path d="M136 94 L184 94" stroke="#0A0A0A" stroke-width="2.5" stroke-dasharray="5 3" opacity="0.45" stroke-linecap="round"/>
              <path d="M178 87 L186 94 L178 101" stroke="#0A0A0A" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" opacity="0.55"/>
              <rect x="194" y="20" width="110" height="148" rx="6" fill="#0A0A0A" opacity="0.82"/>
              <text x="249" y="76"  text-anchor="middle" font-family="Outfit,sans-serif" font-size="11" font-weight="700" fill="rgba(255,255,255,0.65)">Approved</text>
              <text x="249" y="108" text-anchor="middle" font-family="Outfit,sans-serif" font-size="30" font-weight="900" fill="#fff">1d</text>
              <text x="249" y="130" text-anchor="middle" font-family="Outfit,sans-serif" font-size="9"  font-weight="500" fill="rgba(255,255,255,0.5)">was 5 days</text>
              <path d="M232 145 L242 155 L270 135" stroke="rgba(255,255,255,0.55)" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"/>
            </svg>
          )}
          {cs.id === 'lifesciences' && (
            <svg viewBox="0 0 320 240" fill="none" class="csd-hero-svg">
              <rect x="40" y="12" width="240" height="176" rx="10" stroke="#0A0A0A" stroke-width="2" opacity="0.22"/>
              <rect x="56" y="28" width="44" height="44" rx="8" stroke="#0A0A0A" stroke-width="2" opacity="0.38"/>
              <path d="M68 50 L74 56 L88 44" stroke="#0A0A0A" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" opacity="0.55"/>
              <rect x="112" y="34" width="128" height="12" rx="3" fill="#0A0A0A" opacity="0.12"/>
              <rect x="112" y="52" width="90"  height="8"  rx="2" fill="#0A0A0A" opacity="0.08"/>
              <line x1="56" y1="90" x2="264" y2="90" stroke="#0A0A0A" stroke-width="1" opacity="0.1"/>
              <text x="56" y="130" font-family="Outfit,sans-serif" font-size="20" fill="#0A0A0A" opacity="0.4">★★★★★</text>
              <text x="56" y="152" font-family="Outfit,sans-serif" font-size="10" font-weight="600" fill="#0A0A0A" opacity="0.3">4.8 · 200+ enterprise customers</text>
              <circle cx="268" cy="28" r="18" fill="#0A0A0A" opacity="0.85"/>
              <path d="M260 28 L265 33 L278 22" stroke="#fff" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"/>
            </svg>
          )}
        </div>
      </div>
    </div>
  </div>

  <!-- ── Challenge ── -->
  <section class="csd-section csd-section--white">
    <div class="container csd-two-col">
      <div class="csd-col-label-block">
        <p class="section-label">The challenge</p>
        <div class="csd-col-number" aria-hidden="true">01</div>
      </div>
      <div class="csd-col-content">
        <h2 class="csd-section-title">What needed solving.</h2>
        <p class="paragraph-large csd-body-text">{cs.challenge}</p>
      </div>
    </div>
  </section>

  <!-- ── Solution ── -->
  <section class="csd-section csd-section--dark">
    <div class="container">
      <div class="csd-two-col">
        <div class="csd-col-label-block">
          <p class="section-label" style="color:rgba(255,255,255,0.4);">The solution</p>
          <div class="csd-col-number" style="color:rgba(255,255,255,0.12);" aria-hidden="true">02</div>
        </div>
        <div class="csd-col-content">
          <h2 class="csd-section-title" style="color:#fff;">What we built.</h2>
          <p class="paragraph-large csd-body-text" style="color:rgba(255,255,255,0.6);">{cs.solution}</p>
        </div>
      </div>
      <!-- Steps -->
      <div class="csd-steps">
        {cs.solutionSteps.map((step, i) => (
          <div class="csd-step anim-fade-up" style={`transition-delay:${i * 0.08}s`}>
            <div class="csd-step-num">{String(i + 1).padStart(2, '0')}</div>
            <div class="csd-step-body">
              <h3 class="csd-step-title">{step.title}</h3>
              <p class="csd-step-text">{step.body}</p>
            </div>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- ── Outcomes ── -->
  <section class="csd-section csd-section--offwhite">
    <div class="container">
      <div class="csd-two-col" style="margin-bottom:3rem;">
        <div class="csd-col-label-block">
          <p class="section-label">The results</p>
          <div class="csd-col-number" aria-hidden="true">03</div>
        </div>
        <div class="csd-col-content">
          <h2 class="csd-section-title">Measurable outcomes.</h2>
        </div>
      </div>
      <div class="csd-outcomes">
        {cs.outcomes.map((o, i) => (
          <div class="csd-outcome anim-scale-pop" style={`transition-delay:${i * 0.07}s`}>
            <div class="csd-outcome-num">{o.metric}</div>
            <div class="csd-outcome-label">{o.label}</div>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- ── Testimonial ── -->
  {cs.testimonial && (
    <section class="csd-section csd-section--white">
      <div class="container">
        <blockquote class="csd-quote anim-fade-up">
          <div class="csd-quote-mark">"</div>
          <p class="csd-quote-text">{cs.testimonial.quote}</p>
          <footer class="csd-quote-footer">
            <span class="csd-quote-name">{cs.testimonial.name}</span>
            <span class="csd-quote-role">{cs.testimonial.role}</span>
          </footer>
        </blockquote>
      </div>
    </section>
  )}

  <!-- ── Tech stack ── -->
  <section class="csd-section csd-section--offwhite" style="padding-top:3rem;padding-bottom:3rem;">
    <div class="container">
      <p class="section-label" style="margin-bottom:1rem;">Tech stack</p>
      <div class="csd-tags">
        {cs.tags.map(tag => <span class="csd-tag">{tag}</span>)}
      </div>
    </div>
  </section>

  <!-- ── Prev / Next ── -->
  <section class="csd-nav-section">
    <div class="container">
      <div class="csd-nav-grid">
        {prev ? (
          <a href={`/case-studies/${prev.id}`} class="csd-nav-card csd-nav-card--prev">
            <span class="csd-nav-direction">&larr; Previous</span>
            <span class="csd-nav-company">{prev.company}</span>
            <span class="csd-nav-headline">{prev.headline}</span>
          </a>
        ) : <div />}
        {next ? (
          <a href={`/case-studies/${next.id}`} class="csd-nav-card csd-nav-card--next">
            <span class="csd-nav-direction">Next &rarr;</span>
            <span class="csd-nav-company">{next.company}</span>
            <span class="csd-nav-headline">{next.headline}</span>
          </a>
        ) : <div />}
      </div>
    </div>
  </section>

  <!-- ── CTA ── -->
  <section class="csd-cta">
    <div class="container">
      <p class="csd-cta-label">Work with us</p>
      <h2 class="csd-cta-title">Ready to get results like these?</h2>
      <p class="csd-cta-sub">Tell us about your project — we'll scope it and respond within one business day.</p>
      <div class="csd-cta-actions">
        <a href="/contact" class="csd-cta-btn-primary">Start a conversation &rarr;</a>
        <a href="/case-studies" class="csd-cta-btn-secondary">See all case studies</a>
      </div>
    </div>
  </section>

</Page>

<style>
/* ── Hero ── */
.csd-hero-wrap { padding-bottom: 4rem; }
.csd-hero-inner {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 3rem;
  align-items: center;
  margin-top: 0.5rem;
}
.csd-hero-meta {
  display: flex;
  align-items: center;
  gap: 0.625rem;
  margin-bottom: 1.25rem;
  flex-wrap: wrap;
}
.csd-index {
  font-size: 0.7rem;
  font-weight: 900;
  letter-spacing: 0.1em;
  color: #5A5A5A;
  font-family: 'Outfit', sans-serif;
}
.csd-pill {
  font-size: 0.7rem;
  font-weight: 700;
  letter-spacing: 0.07em;
  text-transform: uppercase;
  color: #5A5A5A;
  border: 1px solid #E0E0DC;
  border-radius: 100px;
  padding: 0.2rem 0.75rem;
}
.csd-hero-title {
  font-size: clamp(1.875rem, 3.5vw, 3rem);
  font-weight: 900;
  letter-spacing: -0.03em;
  line-height: 1.1;
  color: #0A0A0A;
  margin-bottom: 1.25rem;
}
.csd-hero-sub {
  font-size: 1rem;
  color: #5A5A5A;
  line-height: 1.75;
  margin-bottom: 2rem;
  max-width: 480px;
}
.csd-hero-stats {
  display: flex;
  align-items: center;
  gap: 2rem;
}
.csd-hero-stat { display: flex; flex-direction: column; gap: 0.25rem; }
.csd-hero-stat-num {
  font-size: 2rem;
  font-weight: 900;
  letter-spacing: -0.04em;
  color: #0A0A0A;
  font-family: 'Outfit', sans-serif;
  line-height: 1;
}
.csd-hero-stat-label {
  font-size: 0.75rem;
  color: #5A5A5A;
  font-weight: 500;
}
.csd-hero-divider {
  width: 1px;
  height: 40px;
  background: #E0E0DC;
}
.csd-hero-illo { display: flex; justify-content: center; align-items: center; }
.csd-hero-svg  { width: 100%; max-width: 400px; height: auto; }

/* ── Sections ── */
.csd-section { padding: 5rem 0; }
.csd-section--white   { background: #fff; border-bottom: 1px solid #E0E0DC; }
.csd-section--offwhite{ background: #F5F5F2; border-bottom: 1px solid #E0E0DC; }
.csd-section--dark    { background: #0A0A0A; }

.csd-two-col {
  display: grid;
  grid-template-columns: 200px 1fr;
  gap: 3rem;
  align-items: start;
}
.csd-col-label-block { position: relative; padding-top: 0.25rem; }
.csd-col-number {
  font-size: 7rem;
  font-weight: 900;
  letter-spacing: -0.05em;
  color: rgba(10,10,10,0.07);
  font-family: 'Outfit', sans-serif;
  line-height: 1;
  margin-top: 0.5rem;
  user-select: none;
}
.csd-section-title {
  font-size: clamp(1.75rem, 2.5vw, 2.25rem);
  font-weight: 800;
  letter-spacing: -0.02em;
  color: #0A0A0A;
  margin-bottom: 1.25rem;
  line-height: 1.15;
}
.csd-body-text { color: #5A5A5A; max-width: 640px; }

/* ── Solution steps ── */
.csd-steps {
  display: grid;
  grid-template-columns: repeat(2, 1fr);
  gap: 1.5rem;
  margin-top: 3rem;
}
.csd-step {
  border: 1px solid rgba(255,255,255,0.1);
  border-radius: 12px;
  padding: 1.75rem;
  background: rgba(255,255,255,0.03);
}
.csd-step-num {
  font-size: 0.7rem;
  font-weight: 900;
  letter-spacing: 0.1em;
  color: rgba(255,255,255,0.2);
  font-family: 'Outfit', sans-serif;
  margin-bottom: 0.875rem;
}
.csd-step-title {
  font-size: 0.95rem;
  font-weight: 800;
  color: #fff;
  margin-bottom: 0.5rem;
  line-height: 1.3;
}
.csd-step-text {
  font-size: 0.85rem;
  color: rgba(255,255,255,0.5);
  line-height: 1.7;
}

/* ── Outcomes ── */
.csd-outcomes {
  display: grid;
  grid-template-columns: repeat(3, 1fr);
  gap: 1.5rem;
}
.csd-outcome {
  background: #fff;
  border: 1px solid #E0E0DC;
  border-radius: 14px;
  padding: 2rem 1.75rem;
}
.csd-outcome-num {
  font-size: clamp(2.5rem, 4vw, 3.5rem);
  font-weight: 900;
  letter-spacing: -0.04em;
  color: #0A0A0A;
  font-family: 'Outfit', sans-serif;
  line-height: 1;
  margin-bottom: 0.625rem;
}
.csd-outcome-label {
  font-size: 0.85rem;
  color: #5A5A5A;
  line-height: 1.5;
  font-weight: 500;
}

/* ── Testimonial ── */
.csd-quote {
  max-width: 780px;
  margin: 0 auto;
  text-align: center;
  position: relative;
}
.csd-quote-mark {
  font-size: 6rem;
  font-weight: 900;
  color: #E0E0DC;
  font-family: 'Outfit', sans-serif;
  line-height: 0.5;
  margin-bottom: 1.5rem;
}
.csd-quote-text {
  font-size: clamp(1.125rem, 2vw, 1.375rem);
  font-weight: 600;
  color: #0A0A0A;
  line-height: 1.65;
  letter-spacing: -0.01em;
  margin-bottom: 2rem;
}
.csd-quote-footer {
  display: flex;
  flex-direction: column;
  gap: 0.25rem;
  align-items: center;
}
.csd-quote-name {
  font-size: 0.9375rem;
  font-weight: 700;
  color: #0A0A0A;
}
.csd-quote-role {
  font-size: 0.8125rem;
  color: #5A5A5A;
}

/* ── Tags ── */
.csd-tags { display: flex; flex-wrap: wrap; gap: 0.5rem; }
.csd-tag {
  font-size: 0.8rem;
  font-weight: 600;
  color: #0A0A0A;
  border: 1.5px solid #E0E0DC;
  border-radius: 100px;
  padding: 0.35rem 0.875rem;
  background: #fff;
}

/* ── Prev/Next nav ── */
.csd-nav-section {
  background: #F5F5F2;
  padding: 3rem 0;
  border-top: 1px solid #E0E0DC;
  border-bottom: 1px solid #E0E0DC;
}
.csd-nav-grid {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 1.5rem;
}
.csd-nav-card {
  display: flex;
  flex-direction: column;
  gap: 0.375rem;
  padding: 1.5rem;
  background: #fff;
  border: 1px solid #E0E0DC;
  border-radius: 12px;
  text-decoration: none;
  transition: border-color 200ms, transform 200ms cubic-bezier(0.34,1.56,0.64,1);
}
.csd-nav-card:hover { border-color: #0A0A0A; transform: translateY(-2px); }
.csd-nav-card--next { text-align: right; }
.csd-nav-direction {
  font-size: 0.75rem;
