---
import Page from '../../layouts/Page.astro';
import { caseStudies } from '../../data/case-studies';

export function getStaticPaths() {
  return caseStudies.map(cs => ({ params: { slug: cs.id }, props: { cs } }));
}

const { cs } = Astro.props;
const prev = caseStudies[caseStudies.findIndex(c => c.id === cs.id) - 1];
const next = caseStudies[caseStudies.findIndex(c => c.id === cs.id) + 1];
---

<Page
  title={`${cs.company} — ${cs.headline} | CloudAlgo Case Study`}
  description={cs.summary}
  ogType="article"
>

  <!-- ── Hero ── -->
  <div class="csd-hero">
    <div class="container">
      <nav class="breadcrumb" style="--bc-color:rgba(255,255,255,0.4);">
        <a href="/" style="color:rgba(255,255,255,0.4);">Home</a>
        <span style="color:rgba(255,255,255,0.25);">&rarr;</span>
        <a href="/case-studies" style="color:rgba(255,255,255,0.4);">Case Studies</a>
        <span style="color:rgba(255,255,255,0.25);">&rarr;</span>
        <span style="color:rgba(255,255,255,0.65);">{cs.company}</span>
      </nav>

      <div class="csd-hero-inner">
        <div class="csd-hero-text">
          <div class="csd-hero-meta">
            <span class="csd-index">{cs.index}</span>
            <span class="csd-pill">{cs.industry}</span>
            <span class="csd-pill">{cs.service}</span>
          </div>
          <h1 class="csd-hero-title">{cs.headline}</h1>
          <p class="csd-hero-sub">{cs.summary}</p>
          <div class="csd-hero-stats">
            <div class="csd-hero-stat">
              <span class="csd-hero-stat-num">{cs.metric}</span>
              <span class="csd-hero-stat-label">{cs.metricLabel}</span>
            </div>
            <div class="csd-hero-divider"></div>
            <div class="csd-hero-stat">
              <span class="csd-hero-stat-num">{cs.duration}</span>
              <span class="csd-hero-stat-label">engagement length</span>
            </div>
          </div>
        </div>

        <!-- Hero illustration: abstract geometric per case study -->
        <div class="csd-hero-illo" aria-hidden="true">
          {cs.id === 'retailscale' && (
            <svg viewBox="0 0 400 300" fill="none" class="csd-hero-svg">
              <rect x="20"  y="180" width="60" height="100" rx="4" stroke="rgba(255,255,255,0.2)" stroke-width="2"/>
              <rect x="100" y="130" width="60" height="150" rx="4" stroke="rgba(255,255,255,0.35)" stroke-width="2"/>
              <rect x="180" y="80"  width="60" height="200" rx="4" stroke="rgba(255,255,255,0.5)" stroke-width="2"/>
              <rect x="260" y="40"  width="60" height="240" rx="4" stroke="rgba(255,255,255,0.65)" stroke-width="2"/>
              <rect x="340" y="10"  width="46" height="270" rx="4" fill="rgba(255,255,255,0.08)" stroke="rgba(255,255,255,0.85)" stroke-width="2"/>
              <path d="M50 180 L130 130 L210 80 L290 40 L363 13" stroke="rgba(255,255,255,0.45)" stroke-width="2" stroke-dasharray="7 4" stroke-linecap="round"/>
              <circle cx="363" cy="13" r="6" fill="rgba(255,255,255,0.7)"/>
              <line x1="10" y1="282" x2="390" y2="282" stroke="rgba(255,255,255,0.1)" stroke-width="1.5"/>
            </svg>
          )}
          {cs.id === 'medbridge' && (
            <svg viewBox="0 0 400 300" fill="none" class="csd-hero-svg">
              <circle cx="200" cy="150" r="120" stroke="rgba(255,255,255,0.1)" stroke-width="2"/>
              <circle cx="200" cy="150" r="84"  stroke="rgba(255,255,255,0.18)" stroke-width="2"/>
              <circle cx="200" cy="150" r="48"  stroke="rgba(255,255,255,0.28)" stroke-width="2"/>
              <path d="M200 30 L200 270 M80 150 L320 150" stroke="rgba(255,255,255,0.6)" stroke-width="3" stroke-linecap="round"/>
              <rect x="286" y="20" width="100" height="42" rx="21" fill="rgba(255,255,255,0.1)" stroke="rgba(255,255,255,0.3)" stroke-width="1.5"/>
              <text x="336" y="46" text-anchor="middle" font-family="Outfit,sans-serif" font-size="18" font-weight="900" fill="rgba(255,255,255,0.85)">18×</text>
              <circle cx="50"  cy="260" r="5" fill="rgba(255,255,255,0.12)"/>
              <circle cx="370" cy="260" r="5" fill="rgba(255,255,255,0.1)"/>
            </svg>
          )}
          {cs.id === 'gridflow' && (
            <svg viewBox="0 0 400 300" fill="none" class="csd-hero-svg">
              <circle cx="80"  cy="150" r="52" stroke="rgba(255,255,255,0.22)" stroke-width="2"/>
              <circle cx="200" cy="150" r="52" stroke="rgba(255,255,255,0.42)" stroke-width="2"/>
              <circle cx="320" cy="150" r="52" stroke="rgba(255,255,255,0.62)" stroke-width="2"/>
              <line x1="132" y1="150" x2="148" y2="150" stroke="rgba(255,255,255,0.4)" stroke-width="2.5" stroke-dasharray="4 3"/>
              <path d="M144 142 L152 150 L144 158" stroke="rgba(255,255,255,0.5)" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/>
              <line x1="252" y1="150" x2="268" y2="150" stroke="rgba(255,255,255,0.4)" stroke-width="2.5" stroke-dasharray="4 3"/>
              <path d="M264 142 L272 150 L264 158" stroke="rgba(255,255,255,0.5)" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/>
              <text x="80"  y="147" text-anchor="middle" font-family="Outfit,sans-serif" font-size="13" font-weight="800" fill="rgba(255,255,255,0.4)">SAP</text>
              <text x="80"  y="163" text-anchor="middle" font-family="Outfit,sans-serif" font-size="10" fill="rgba(255,255,255,0.28)">ERP</text>
              <text x="200" y="147" text-anchor="middle" font-family="Outfit,sans-serif" font-size="13" font-weight="800" fill="rgba(255,255,255,0.65)">Mule</text>
              <text x="200" y="163" text-anchor="middle" font-family="Outfit,sans-serif" font-size="10" fill="rgba(255,255,255,0.45)">Soft</text>
              <text x="320" y="147" text-anchor="middle" font-family="Outfit,sans-serif" font-size="13" font-weight="800" fill="rgba(255,255,255,0.85)">SF</text>
              <text x="320" y="163" text-anchor="middle" font-family="Outfit,sans-serif" font-size="10" fill="rgba(255,255,255,0.6)">CRM</text>
            </svg>
          )}
          {cs.id === 'shieldinsure' && (
            <svg viewBox="0 0 400 300" fill="none" class="csd-hero-svg">
              <path d="M200 10 L348 64 L348 164 C348 234 278 270 200 280 C122 270 52 234 52 164 L52 64 Z" stroke="rgba(255,255,255,0.12)" stroke-width="2"/>
              <path d="M200 34 L320 80 L320 158 C320 218 264 248 200 256 C136 248 80 218 80 158 L80 80 Z" stroke="rgba(255,255,255,0.22)" stroke-width="2"/>
              <path d="M200 58 L292 96 L292 152 C292 202 250 224 200 230 C150 224 108 202 108 152 L108 96 Z" stroke="rgba(255,255,255,0.38)" stroke-width="2"/>
              <path d="M152 148 L180 176 L256 112" stroke="rgba(255,255,255,0.72)" stroke-width="4" stroke-linecap="round" stroke-linejoin="round"/>
            </svg>
          )}
          {cs.id === 'partsco' && (
            <svg viewBox="0 0 400 300" fill="none" class="csd-hero-svg">
              <rect x="20"  y="30"  width="150" height="200" rx="8" stroke="rgba(255,255,255,0.22)" stroke-width="2"/>
              <rect x="36"  y="56"  width="118" height="16" rx="3" fill="rgba(255,255,255,0.1)"/>
              <rect x="36"  y="84"  width="90"  height="10" rx="2" fill="rgba(255,255,255,0.07)"/>
              <rect x="36"  y="102" width="104" height="10" rx="2" fill="rgba(255,255,255,0.07)"/>
              <rect x="36"  y="120" width="80"  height="10" rx="2" fill="rgba(255,255,255,0.07)"/>
              <path d="M178 130 L222 130" stroke="rgba(255,255,255,0.4)" stroke-width="2.5" stroke-dasharray="5 3" stroke-linecap="round"/>
              <path d="M216 122 L224 130 L216 138" stroke="rgba(255,255,255,0.5)" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"/>
              <rect x="230" y="30" width="150" height="200" rx="8" fill="rgba(255,255,255,0.06)" stroke="rgba(255,255,255,0.55)" stroke-width="2"/>
              <text x="305" y="118" text-anchor="middle" font-family="Outfit,sans-serif" font-size="14" font-weight="700" fill="rgba(255,255,255,0.55)">Approved</text>
              <text x="305" y="158" text-anchor="middle" font-family="Outfit,sans-serif" font-size="42" font-weight="900" fill="rgba(255,255,255,0.85)">1d</text>
              <path d="M278 195 L292 208 L334 180" stroke="rgba(255,255,255,0.5)" stroke-width="3" stroke-linecap="round" stroke-linejoin="round"/>
            </svg>
          )}
          {cs.id === 'lifesciences' && (
            <svg viewBox="0 0 400 300" fill="none" class="csd-hero-svg">
              <rect x="50" y="20" width="300" height="220" rx="14" stroke="rgba(255,255,255,0.18)" stroke-width="2"/>
              <rect x="72" y="48" width="60" height="60" rx="10" stroke="rgba(255,255,255,0.35)" stroke-width="2"/>
              <path d="M88 78 L98 88 L118 70" stroke="rgba(255,255,255,0.55)" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"/>
              <rect x="148" y="56" width="168" height="16" rx="4" fill="rgba(255,255,255,0.12)"/>
              <rect x="148" y="80" width="118" height="10" rx="3" fill="rgba(255,255,255,0.07)"/>
              <line x1="72" y1="130" x2="328" y2="130" stroke="rgba(255,255,255,0.1)" stroke-width="1"/>
              <text x="72" y="168" font-family="Outfit,sans-serif" font-size="28" fill="rgba(255,255,255,0.45)">★★★★★</text>
              <text x="72" y="192" font-family="Outfit,sans-serif" font-size="13" font-weight="600" fill="rgba(255,255,255,0.3)">4.8 · 200+ enterprise customers</text>
              <circle cx="330" cy="48" r="24" fill="rgba(255,255,255,0.1)" stroke="rgba(255,255,255,0.35)" stroke-width="2"/>
              <path d="M320 48 L327 55 L342 40" stroke="rgba(255,255,255,0.65)" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"/>
            </svg>
          )}
        </div>
      </div>
    </div>
  </div>

  <!-- ── Challenge ── -->
  <section class="csd-section csd-section--white">
    <div class="container csd-two-col">
      <div class="csd-col-label-block">
        <p class="section-label">The challenge</p>
        <div class="csd-col-number" aria-hidden="true">01</div>
      </div>
      <div class="csd-col-content">
        <h2 class="csd-section-title">What needed solving.</h2>
        <p class="paragraph-large csd-body-text">{cs.challenge}</p>
      </div>
    </div>
  </section>

  <!-- ── Solution ── -->
  <section class="csd-section csd-section--dark">
    <div class="container">
      <div class="csd-two-col">
        <div class="csd-col-label-block">
          <p class="section-label" style="color:rgba(255,255,255,0.4);">The solution</p>
          <div class="csd-col-number" style="color:rgba(255,255,255,0.06);" aria-hidden="true">02</div>
        </div>
        <div class="csd-col-content">
          <h2 class="csd-section-title" style="color:#fff;">What we built.</h2>
          <p class="paragraph-large csd-body-text" style="color:rgba(255,255,255,0.6);">{cs.solution}</p>
        </div>
      </div>
      <!-- Steps -->
      <div class="csd-steps">
        {cs.solutionSteps.map((step, i) => (
          <div class="csd-step anim-fade-up" style={`transition-delay:${i * 0.08}s`}>
            <div class="csd-step-num">{String(i + 1).padStart(2, '0')}</div>
            <div class="csd-step-body">
              <h3 class="csd-step-title">{step.title}</h3>
              <p class="csd-step-text">{step.body}</p>
            </div>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- ── Outcomes ── -->
  <section class="csd-section csd-section--offwhite">
    <div class="container">
      <div class="csd-two-col" style="margin-bottom:3rem;">
        <div class="csd-col-label-block">
          <p class="section-label">The results</p>
          <div class="csd-col-number" aria-hidden="true">03</div>
        </div>
        <div class="csd-col-content">
          <h2 class="csd-section-title">Measurable outcomes.</h2>
        </div>
      </div>
      <div class="csd-outcomes">
        {cs.outcomes.map((o, i) => (
          <div class="csd-outcome anim-scale-pop" style={`transition-delay:${i * 0.07}s`}>
            <div class="csd-outcome-num">{o.metric}</div>
            <div class="csd-outcome-label">{o.label}</div>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- ── Testimonial ── -->
  {cs.testimonial && (
    <section class="csd-section csd-section--white">
      <div class="container">
        <blockquote class="csd-quote anim-fade-up">
          <div class="csd-quote-mark">"</div>
          <p class="csd-quote-text">{cs.testimonial.quote}</p>
          <footer class="csd-quote-footer">
            <span class="csd-quote-name">{cs.testimonial.name}</span>
            <span class="csd-quote-role">{cs.testimonial.role}</span>
          </footer>
        </blockquote>
      </div>
    </section>
  )}

  <!-- ── Tech stack ── -->
  <section class="csd-section csd-section--offwhite" style="padding-top:3rem;padding-bottom:3rem;">
    <div class="container">
      <p class="section-label" style="margin-bottom:1rem;">Tech stack</p>
      <div class="csd-tags">
        {cs.tags.map(tag => <span class="csd-tag">{tag}</span>)}
      </div>
    </div>
  </section>

  <!-- ── Prev / Next ── -->
  <section class="csd-nav-section">
    <div class="container">
      <div class="csd-nav-grid">
        {prev ? (
          <a href={`/case-studies/${prev.id}`} class="csd-nav-card csd-nav-card--prev">
            <span class="csd-nav-direction">&larr; Previous</span>
            <span class="csd-nav-company">{prev.company}</span>
            <span class="csd-nav-headline">{prev.headline}</span>
          </a>
        ) : <div />}
        {next ? (
          <a href={`/case-studies/${next.id}`} class="csd-nav-card csd-nav-card--next">
            <span class="csd-nav-direction">Next &rarr;</span>
            <span class="csd-nav-company">{next.company}</span>
            <span class="csd-nav-headline">{next.headline}</span>
          </a>
        ) : <div />}
      </div>
    </div>
  </section>

  <!-- ── CTA ── -->
  <section class="csd-cta">
    <div class="container">
      <p class="csd-cta-label">Work with us</p>
      <h2 class="csd-cta-title">Ready to get results like these?</h2>
      <p class="csd-cta-sub">Tell us about your project — we'll scope it and respond within one business day.</p>
      <div class="csd-cta-actions">
        <a href="/contact" class="csd-cta-btn-primary">Start a conversation &rarr;</a>
        <a href="/case-studies" class="csd-cta-btn-secondary">See all case studies</a>
      </div>
    </div>
  </section>

</Page>

<style>
/* ── Hero ── */
.csd-hero {
  background: #0A0A0A;
  padding-top: 6.5rem;
  padding-bottom: 4rem;
  overflow: hidden;
  position: relative;
}
.csd-hero::before {
  content: '';
  position: absolute;
  inset: 0;
  background: radial-gradient(circle at 65% 50%, rgba(255,255,255,0.03) 0%, transparent 55%);
  pointer-events: none;
}
.csd-hero-inner {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 3rem;
  align-items: center;
  margin-top: 2rem;
}
.csd-hero-meta {
  display: flex;
  align-items: center;
  gap: 0.625rem;
  margin-bottom: 1.25rem;
}
.csd-index {
  font-size: 0.7rem;
  font-weight: 900;
  letter-spacing: 0.1em;
  color: rgba(255,255,255,0.25);
  font-family: 'Outfit', sans-serif;
}
.csd-pill {
  font-size: 0.7rem;
  font-weight: 700;
  letter-spacing: 0.07em;
  text-transform: uppercase;
  color: rgba(255,255,255,0.55);
  border: 1px solid rgba(255,255,255,0.18);
  border-radius: 100px;
  padding: 0.2rem 0.75rem;
}
.csd-hero-title {
  font-size: clamp(1.875rem, 3.5vw, 3rem);
  font-weight: 900;
  letter-spacing: -0.03em;
  line-height: 1.1;
  color: #fff;
  margin-bottom: 1.25rem;
}
.csd-hero-sub {
  font-size: 1rem;
  color: rgba(255,255,255,0.5);
  line-height: 1.75;
  margin-bottom: 2rem;
  max-width: 480px;
}
.csd-hero-stats {
  display: flex;
  align-items: center;
  gap: 2rem;
}
.csd-hero-stat { display: flex; flex-direction: column; gap: 0.25rem; }
.csd-hero-stat-num {
  font-size: 2rem;
  font-weight: 900;
  letter-spacing: -0.04em;
  color: #fff;
  font-family: 'Outfit', sans-serif;
  line-height: 1;
}
.csd-hero-stat-label {
  font-size: 0.75rem;
  color: rgba(255,255,255,0.4);
  font-weight: 500;
}
.csd-hero-divider {
  width: 1px;
  height: 40px;
  background: rgba(255,255,255,0.15);
}
.csd-hero-illo { display: flex; justify-content: center; align-items: center; }
.csd-hero-svg  { width: 100%; max-width: 400px; height: auto; }

/* ── Sections ── */
.csd-section { padding: 5rem 0; }
.csd-section--white   { background: #fff; border-bottom: 1px solid #E0E0DC; }
.csd-section--offwhite{ background: #F5F5F2; border-bottom: 1px solid #E0E0DC; }
.csd-section--dark    { background: #0A0A0A; }

.csd-two-col {
  display: grid;
  grid-template-columns: 200px 1fr;
  gap: 3rem;
  align-items: start;
}
.csd-col-label-block { position: relative; padding-top: 0.25rem; }
.csd-col-number {
  font-size: 7rem;
  font-weight: 900;
  letter-spacing: -0.05em;
  color: #0A0A0A;
  opacity: 0.04;
  font-family: 'Outfit', sans-serif;
  line-height: 1;
  margin-top: 0.5rem;
  user-select: none;
}
.csd-section-title {
  font-size: clamp(1.75rem, 2.5vw, 2.25rem);
  font-weight: 800;
  letter-spacing: -0.02em;
  color: #0A0A0A;
  margin-bottom: 1.25rem;
  line-height: 1.15;
}
.csd-body-text { color: #5A5A5A; max-width: 640px; }

/* ── Solution steps ── */
.csd-steps {
  display: grid;
  grid-template-columns: repeat(2, 1fr);
  gap: 1.5rem;
  margin-top: 3rem;
}
.csd-step {
  border: 1px solid rgba(255,255,255,0.1);
  border-radius: 12px;
  padding: 1.75rem;
  background: rgba(255,255,255,0.03);
}
.csd-step-num {
  font-size: 0.7rem;
  font-weight: 900;
  letter-spacing: 0.1em;
  color: rgba(255,255,255,0.2);
  font-family: 'Outfit', sans-serif;
  margin-bottom: 0.875rem;
}
.csd-step-title {
  font-size: 0.95rem;
  font-weight: 800;
  color: #fff;
  margin-bottom: 0.5rem;
  line-height: 1.3;
}
.csd-step-text {
  font-size: 0.85rem;
  color: rgba(255,255,255,0.5);
  line-height: 1.7;
}

/* ── Outcomes ── */
.csd-outcomes {
  display: grid;
  grid-template-columns: repeat(3, 1fr);
  gap: 1.5rem;
}
.csd-outcome {
  background: #fff;
  border: 1px solid #E0E0DC;
  border-radius: 14px;
  padding: 2rem 1.75rem;
}
.csd-outcome-num {
  font-size: clamp(2.5rem, 4vw, 3.5rem);
  font-weight: 900;
  letter-spacing: -0.04em;
  color: #0A0A0A;
  font-family: 'Outfit', sans-serif;
  line-height: 1;
  margin-bottom: 0.625rem;
}
.csd-outcome-label {
  font-size: 0.85rem;
  color: #5A5A5A;
  line-height: 1.5;
  font-weight: 500;
}

/* ── Testimonial ── */
.csd-quote {
  max-width: 780px;
  margin: 0 auto;
  text-align: center;
  position: relative;
}
.csd-quote-mark {
  font-size: 6rem;
  font-weight: 900;
  color: #E0E0DC;
  font-family: 'Outfit', sans-serif;
  line-height: 0.5;
  margin-bottom: 1.5rem;
}
.csd-quote-text {
  font-size: clamp(1.125rem, 2vw, 1.375rem);
  font-weight: 600;
  color: #0A0A0A;
  line-height: 1.65;
  letter-spacing: -0.01em;
  margin-bottom: 2rem;
}
.csd-quote-footer {
  display: flex;
  flex-direction: column;
  gap: 0.25rem;
  align-items: center;
}
.csd-quote-name {
  font-size: 0.9375rem;
  font-weight: 700;
  color: #0A0A0A;
}
.csd-quote-role {
  font-size: 0.8125rem;
  color: #5A5A5A;
}

/* ── Tags ── */
.csd-tags { display: flex; flex-wrap: wrap; gap: 0.5rem; }
.csd-tag {
  font-size: 0.8rem;
  font-weight: 600;
  color: #0A0A0A;
  border: 1.5px solid #E0E0DC;
  border-radius: 100px;
  padding: 0.35rem 0.875rem;
  background: #fff;
}

/* ── Prev/Next nav ── */
.csd-nav-section {
  background: #F5F5F2;
  padding: 3rem 0;
  border-top: 1px solid #E0E0DC;
  border-bottom: 1px solid #E0E0DC;
}
