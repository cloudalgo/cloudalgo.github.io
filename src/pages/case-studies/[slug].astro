---
/**
 * One engagement, in full: what changed, why it stayed broken, what we
 * ruled out, what we built, what we learned, and what it settled.
 *
 * /case-studies/ answers "which of the five is like mine?" -- this page
 * answers "what actually happened?", so it is the index's ledger row at
 * one zoom level in. The row's struck-through `was` becomes the whole
 * `.state` band; the row's figure becomes the closing `.tally`.
 *
 * Everything on the page comes from `@/data/case-studies`. There is no
 * per-study markup here: the five differ only in the fields they carry,
 * and the two optional sections (`.ruledout`, the decisive stamp) are
 * gated on the presence of their data rather than on the study's id.
 *
 * No closing CTA. The footer's `.footer-cta` is on every page and a
 * second ask three blocks above it reads as a page that does not trust
 * its own argument.
 */
import Page from '@/layouts/Page.astro';
import Button from '@/components/ui/Button.astro';
import PageMasthead from '@/components/ui/PageMasthead.astro';
import ClosingManifest from '@/components/sections/ClosingManifest.astro';
import EngagementPager from '@/components/sections/EngagementPager.astro';
import { caseStudies } from '@/data/case-studies';
import { organization, orgRef, breadcrumbs, abs, SITE_ID } from '@/data/schema';

export function getStaticPaths() {
  return caseStudies.map(cs => ({ params: { slug: cs.id }, props: { cs } }));
}

const { cs } = Astro.props;

const at = caseStudies.findIndex(c => c.id === cs.id);
const prev = caseStudies[at - 1];
const next = caseStudies[at + 1];

/* The hero mark. `detailMark` is a verbatim substring of `detailTitle`
   -- if an edit breaks that the page fails the build rather than
   shipping a headline with no emphasis and no explanation why. */
if (!cs.detailTitle.includes(cs.detailMark)) {
  throw new Error(
    `case-studies/[slug].astro: detailMark "${cs.detailMark}" is not in ` +
    `detailTitle for "${cs.id}". Both live in src/data/case-studies.ts.`,
  );
}
const [beforeMark, afterMark] = cs.detailTitle.split(cs.detailMark);
const markedTitle =
  `${beforeMark}<span class="mark mark--draw">${cs.detailMark}</span>${afterMark}`;

const facts = [
  { term: 'Client', detail: cs.ledger.client },
  { term: 'Sector', detail: cs.industry },
  { term: 'Platforms', detail: cs.service },
  { term: 'Engagement', detail: cs.duration },
  { term: cs.standNote.label, detail: cs.standNote.detail },
  { term: 'Study', detail: `${cs.index} of five` },
];

/* Counted rather than written down, so a constraint added to the data
   cannot leave the section head claiming the old number. */
const WORDS = ['No', 'One', 'Two', 'Three', 'Four', 'Five', 'Six', 'Seven', 'Eight', 'Nine', 'Ten'];
const constraints = `${WORDS[cs.challengePoints.length] ?? cs.challengePoints.length} constraints`;
const components = `${WORDS[cs.techStack.length] ?? cs.techStack.length} components`;

const csUrl = abs(`/case-studies/${cs.id}/`);

/* One array, rendered by the masthead and declared to the crawler. A
   trail invented for the crawler that does not match the printed one is
   what gets the rich result dropped. */
const crumbs = [
  { label: 'Home', href: '/' },
  { label: 'Case studies', href: '/case-studies/' },
  { label: cs.company },
];

const schema: object[] = [
  {
    '@type': 'Article',
    '@id': csUrl,
    headline: cs.headline,
    description: cs.summary,
    author: orgRef,
    publisher: orgRef,
    isPartOf: { '@id': SITE_ID },
    inLanguage: 'en',
    url: csUrl,
    mainEntityOfPage: { '@type': 'WebPage', '@id': csUrl },
  },
  organization,
  breadcrumbs(crumbs, csUrl),
];
---
<Page
  title={`${cs.seoTitle} — CloudAlgo case study`}
  description={cs.summary}
  ogType="article"
  schema={schema}
>
  <PageMasthead
    {crumbs}
    facts={facts}
  >
    <Fragment slot="title" set:html={markedTitle} />
    <Fragment slot="lede">{cs.detailLede}</Fragment>
    <Fragment slot="actions">
      <Button href="/contact/" variant="primary" size="sm">Tell us your version of this &rarr;</Button>
      <Button href="/case-studies/" variant="outline" size="sm">All five studies</Button>
    </Fragment>
  </PageMasthead>

  {/* ── The change, in one band ─────────────────────────────────── */}
  <section class="state" aria-labelledby="state-heading">
    <div class="state__inner">
      <div class="state__head anim-fade-up">
        <h2 id="state-heading" class="state__title">{cs.stateTitle}</h2>
        <span class="state__note">Struck through: the way it used to work</span>
      </div>

      <div class="state__table anim-fade-up">
        <div class="state__row state__row--head" aria-hidden="true">
          <span class="state__what">{cs.stateWhat}</span>
          <span class="state__key">Was</span>
          <span class="state__key">Now</span>
        </div>
        {cs.resultsTable.map((row) => (
          <div class="state__row">
            <span class="state__what">{row.metric}</span>
            <span class="state__was" data-key="was"><s>{row.before}</s></span>
            <span class="state__now" data-key="now">{row.after}</span>
          </div>
        ))}
      </div>
    </div>
  </section>

  {/* ── Why it stayed that way ──────────────────────────────────── */}
  <section class="section-press" aria-labelledby="impasse-heading">
    <div class="section-press__head anim-fade-up">
      <h2 id="impasse-heading" class="section-title section-title--xs section-title--tighter section-press__title">Why it stayed that way.</h2>
      <span class="section-press__note">{constraints}</span>
    </div>

    <p class="section-press__lede anim-fade-up">{cs.challenge}</p>

    <ol class="impasse anim-fade-up">
      {cs.challengePoints.map((point, i) => (
        <li class:list={['impasse__item', i === cs.decisivePoint && 'impasse__item--decisive']}>
          <span class="impasse__n">{String(i + 1).padStart(2, '0')}</span>
          <p class="impasse__text">{point}</p>
          {i === cs.decisivePoint && cs.decisiveStamp && (
            <span class="impasse__stamp">{cs.decisiveStamp}</span>
          )}
        </li>
      ))}
    </ol>
  </section>

  {/* ── What we ruled out ───────────────────────────────────────────
      Four of the five have a register. Study 01 rebuilt a platform
      rather than picking a tool, so there was nothing to rule out and
      the section is absent rather than padded. */}
  {cs.toolComparison && (
    <section class="section-press" aria-labelledby="ruledout-heading">
      <div class="section-press__head anim-fade-up">
        <h2 id="ruledout-heading" class="section-title section-title--xs section-title--tighter section-press__title">What we ruled out first.</h2>
        <span class="section-press__note">{cs.ruledoutNote}</span>
      </div>

      {cs.whyNotOffShelf && <p class="section-press__lede anim-fade-up">{cs.whyNotOffShelf}</p>}

      <div class="ruledout anim-fade-up">
        {cs.toolComparison.map((t) => (
          <div class="ruledout__row">
            <div class="ruledout__who">
              <span class="ruledout__name">{t.tool}</span>
              <span class="ruledout__cat">{t.category}</span>
            </div>
            <div class="ruledout__pair">
              <p class="ruledout__line"><span class="ruledout__key">Does</span><span>{t.doesWell}</span></p>
              <p class:list={['ruledout__line', t.chosen ? 'ruledout__line--in' : 'ruledout__line--out']}>
                <span class="ruledout__key">{t.chosen ? 'Why it won' : 'Rules it out'}</span>
                <span>{t.limitation}</span>
              </p>
            </div>
          </div>
        ))}
      </div>
    </section>
  )}

  {/* ── What we built ───────────────────────────────────────────────
      `buildChain` is the difference between a sequence and a set. Two
      of the five are one path with a queue or a layer between stages,
      and those get the rail and the numerals; the other three are
      parallel flows of one build, where a numeral would only decorate.
      Same reasoning as the engineering notes below. */}
  <section class="section-press" aria-labelledby="build-heading">
    <div class="section-press__head anim-fade-up">
      <h2 id="build-heading" class="section-title section-title--xs section-title--tighter section-press__title">What we built instead.</h2>
      <span class="section-press__note">{cs.buildNote}</span>
    </div>

    <p class="section-press__lede anim-fade-up">{cs.solution}</p>

    <ol class:list={['build', 'anim-fade-up', !cs.buildChain && 'build--parts']}>
      {cs.solutionSteps.map((step, i) => (
        <li class="build__stage">
          <span class="build__mark">{cs.buildChain && <span class="build__n">{String(i + 1).padStart(2, '0')}</span>}</span>
          <div class="build__body">
            <div class="build__row">
              <h3 class="build__title">{step.title}</h3>
              {step.path && <span class="build__path">{step.path}</span>}
            </div>
            <p>{step.body}</p>
          </div>
        </li>
      ))}
    </ol>

    <div class="stack anim-fade-up">
      <div class="stack__head">
        <span class="stack__label">What it is made of</span>
        <span class="stack__count">{components}</span>
      </div>
      <div class="stack__grid">
        {cs.techStack.map((row) => (
          <p class="stack__row"><span class="stack__layer">{row.layer}</span><span>{row.technology}</span></p>
        ))}
      </div>
    </div>
  </section>

  {/* ── Engineering notes ───────────────────────────────────────── */}
  <section class="section-press" aria-labelledby="notes-heading">
    <div class="section-press__head anim-fade-up">
      <h2 id="notes-heading" class="section-title section-title--xs section-title--tighter section-press__title">Engineering notes.</h2>
      <span class="section-press__note">{cs.notesNote}</span>
    </div>

    <div class="notes anim-fade-up">
      {cs.technicalHighlights.map((note) => (
        <div class="notes__item">
          <h3 class="notes__title">{note.title}</h3>
          <p>{note.body}</p>
        </div>
      ))}
    </div>
  </section>

  {/* ── What it settled ─────────────────────────────────────────── */}
  <section class="section-press" aria-labelledby="tally-heading">
    <div class="section-press__head anim-fade-up">
      <h2 id="tally-heading" class="section-title section-title--xs section-title--tighter section-press__title">What it settled.</h2>
      <span class="section-press__note">Three figures, still true</span>
    </div>

    <div class="tally anim-fade-up">
      {cs.outcomes.map((o) => (
        <div class="tally__cell">
          <span class="tally__fig stat-num stat-num--fluid stat-num--tight">{o.metric}</span>
          <p class="tally__cap">{o.label}</p>
        </div>
      ))}
    </div>
  </section>

  <ClosingManifest
    class="anim-fade-up"
    labelledby="manifest-heading"
    kicker="What this one shows"
    items={cs.whatDemonstrates.map((d) => ({ title: d.title, detail: d.body }))}
  >
    <Fragment slot="title">Four things you can hold us to.</Fragment>
    <Fragment slot="note">A case study is only worth reading if it generalises. These are the parts of this build that would show up again on yours.</Fragment>
    <a class="btn btn-light btn-sm" slot="actions" href="/case-studies/">See the other four studies</a>
  </ClosingManifest>

  {/* At either end of the run the neighbour is the index: 01 has nothing
      before it and 05 nothing after, and a reader who has run out of
      studies in one direction wants the list, not a dead half-row. */}
  <EngagementPager
    class="anim-fade-up"
    prev={prev
      ? { href: `/case-studies/${prev.id}/`, n: prev.index, name: prev.ledger.client, shape: prev.pagerNote }
      : { href: '/case-studies/', name: '← All five studies', shape: 'The index' }}
    next={next
      ? { href: `/case-studies/${next.id}/`, n: next.index, name: next.ledger.client, shape: next.pagerNote }
      : { href: '/case-studies/', name: 'All five studies →', shape: 'The index' }}
  />
</Page>
