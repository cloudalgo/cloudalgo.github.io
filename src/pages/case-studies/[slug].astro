---
import Page from '../../layouts/Page.astro';
import { caseStudies } from '../../data/case-studies';
import PageHeader from '@/components/ui/PageHeader.astro';
import SectionLabel from '../../components/ui/SectionLabel.astro';
import Badge from '@/components/ui/Badge.astro';

export function getStaticPaths() {
  return caseStudies.map(cs => ({ params: { slug: cs.id }, props: { cs } }));
}

const { cs } = Astro.props;
const prev = caseStudies[caseStudies.findIndex(c => c.id === cs.id) - 1];
const next = caseStudies[caseStudies.findIndex(c => c.id === cs.id) + 1];

const csUrl = `https://cloudalgo.com/case-studies/${cs.id}`;
const schema = {
  "@context": "https://schema.org",
  "@type": "Article",
  "headline": cs.headline,
  "description": cs.summary,
  "author": {
    "@type": "Organization",
    "name": "CloudAlgo",
    "url": "https://cloudalgo.com"
  },
  "publisher": {
    "@type": "Organization",
    "name": "CloudAlgo",
    "logo": { "@type": "ImageObject", "url": "https://cloudalgo.com/logo.svg" }
  },
  "url": csUrl,
  "mainEntityOfPage": { "@type": "WebPage", "@id": csUrl }
};
---

<Page
  title={`${cs.company} — ${cs.headline} | CloudAlgo Case Study`}
  description={cs.summary}
  ogType="article"
  schema={schema}
>

  <!-- ── Hero ── -->
  <PageHeader
    class="csd-hero-wrap"
    crumbs={[
      { label: 'Home', href: '/' },
      { label: 'Case Studies', href: '/case-studies' },
      { label: cs.company },
    ]}
