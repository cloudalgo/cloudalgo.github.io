---
import CookieConsent from '../components/ui/CookieConsent.astro';

export interface Props {
  title: string;
  description?: string;
  image?: string;
  canonicalURL?: string;
  /** Pass 'article' for blog posts */
  ogType?: 'website' | 'article';
  /** ISO date string — used for article published_time */
  publishedTime?: string;
  /** Author name — used for article:author on blog posts */
  author?: string;
  /** Category — used for article:section on blog posts */
  section?: string;
  /** Structured-data JSON-LD blob — pass from individual pages */
  schema?: object | object[];
}

const {
  title,
  description = 'CloudAlgo — Certified Salesforce & Heroku consulting. 70+ projects delivered, 12 years experience.',
  image = '/og-default.jpg',
  canonicalURL = new URL(Astro.url.pathname, Astro.site).href,
  ogType = 'website',
  publishedTime,
  author,
  section,
  schema,
} = Astro.props;

const schemaJson: string | null = !schema
  ? null
  : Array.isArray(schema)
    ? JSON.stringify({ '@context': 'https://schema.org', '@graph': schema })
    : JSON.stringify(schema);

const imageHost = 'https://cloudalgo.com';
const ogImage = image.startsWith('http') ? image : `${imageHost}${image}`;
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />

    <!-- Fonts. Linked here rather than @import-ed from global.css so the
         preload scanner can start the request without first parsing the CSS,
         and so the connection to the font host opens in parallel.

         Weights are ranges, not a discrete list, because all three faces are
         variable: `wght@600..900` and `wght@600;700;800` fetch the BYTE-
         IDENTICAL set of 14 gstatic files, but the range form declares every
         weight in between as real. The discrete form was silently down-
         matching -- the stylesheets ask for 900 in 18 rules and the artwork
         asks for 800/900 in 86 SVG nodes, none of which the list covered.
         It also cuts the served CSS from 15.8KB to 5.4KB, since the list
         repeats an @font-face per weight per unicode subset. -->
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      rel="stylesheet"
      href="https://fonts.googleapis.com/css2?family=Archivo:wght@600..900&family=Geist:wght@400..900&family=Geist+Mono:wght@400..500&display=swap"
    />
    <link rel="icon" type="image/png" href="/favicon.png" />
    <link rel="canonical" href={canonicalURL} />

    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="robots" content="index, follow" />

    <!-- Open Graph -->
    <meta property="og:site_name" content="CloudAlgo" />
    <meta property="og:logo"      content="https://cloudalgo.com/logo.svg" />
    <meta property="og:locale"    content="en_US" />
    <meta property="og:type"      content={ogType} />
    <meta property="og:title"     content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url"       content={canonicalURL} />
    <meta property="og:image"     content={ogImage} />
    <meta property="og:image:type"   content="image/jpeg" />
    <meta property="og:image:width"  content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt"    content={title} />
    {publishedTime && <meta property="article:published_time" content={publishedTime} />}
    {author    && <meta property="article:author"  content={author} />}
    {section   && <meta property="article:section" content={section} />}

    <!-- Twitter / X -->
    <meta name="twitter:card"        content="summary_large_image" />
    <meta name="twitter:site"        content="@cloudalgo" />
    <meta name="twitter:title"       content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image"       content={ogImage} />
    <meta name="twitter:image:alt"   content={title} />

    <!-- JSON-LD structured data -->
    {schemaJson && <script is:inline type="application/ld+json" set:html={schemaJson} />}

  </head>
  <body>
    <div id="scroll-progress-bar" aria-hidden="true"></div>
    <slot />
    <script>
      // Scrollable page height, measured once and refreshed when the layout
      // actually changes. Reading scrollHeight inside a scroll handler forces a
      // synchronous layout on every event, which is the expensive part.
      let scrollableHeight = 0;
      const measureScrollable = () => {
        scrollableHeight = document.body.scrollHeight - window.innerHeight;
      };
      measureScrollable();
      window.addEventListener('resize', measureScrollable, { passive: true });
      // Lazy images and the font swap change page height after first paint
      if (typeof ResizeObserver !== 'undefined') {
        new ResizeObserver(measureScrollable).observe(document.body);
      }

      // Scroll progress bar
      const progressBar = document.getElementById('scroll-progress-bar');
      if (progressBar) {
        let barRafId: number | null = null;
        const paintProgress = () => {
          barRafId = null;
          const pct = scrollableHeight > 0 ? window.scrollY / scrollableHeight : 0;
          // scaleX composites; animating width relayouts the page every frame
          progressBar.style.transform = `scaleX(${Math.min(Math.max(pct, 0), 1)})`;
        };
        window.addEventListener('scroll', () => {
          if (barRafId === null) barRafId = requestAnimationFrame(paintProgress);
        }, { passive: true });
        window.addEventListener('resize', paintProgress, { passive: true });
        paintProgress();
      }

      // Scroll animations
      const observer = new IntersectionObserver((entries) => {
        entries.forEach(entry => {
          if (entry.isIntersecting) {
            entry.target.classList.add('in-view');
            observer.unobserve(entry.target);
          }
        });
      }, { threshold: 0.1, rootMargin: '0px 0px -40px 0px' });

      document.querySelectorAll('.anim-fade-up, .anim-scale-pop').forEach(el => {
        observer.observe(el);
      });

      // Scroll parallax for [data-parallax] elements
      const noMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
      if (!noMotion) {
        const parallaxEls = Array.from(document.querySelectorAll<HTMLElement>('[data-parallax]'));
        if (parallaxEls.length) {
          const items = parallaxEls.map(el => {
            const rect = el.getBoundingClientRect();
            const naturalCenter = rect.top + rect.height / 2 + window.scrollY;
            return {
              el,
              naturalCenter,
              speed: parseFloat(el.dataset.parallax ?? '0.1'),
              visible: false,
            };
          });

          let pRafId: number | null = null;
          const updateParallax = () => {
            pRafId = null;
            for (const item of items) {
              if (!item.visible) continue;
              const fromCenter = item.naturalCenter - window.scrollY - window.innerHeight * 0.5;
              item.el.style.transform = `translateY(${fromCenter * item.speed}px)`;
            }
          };
          const requestParallax = () => {
            if (pRafId === null) pRafId = requestAnimationFrame(updateParallax);
          };

          // will-change pins a compositor layer for as long as it is set, so it
          // is granted only while an element is near the viewport. Off-screen
          // elements are skipped entirely rather than transformed unseen.
          // The observer repaints on every change, because its first entries
          // arrive after the initial frame — without that, an element already
          // on screen at load would sit untransformed until the first scroll.
          const byEl = new Map(items.map(item => [item.el, item]));
          const nearViewport = new IntersectionObserver(entries => {
            for (const entry of entries) {
              const item = byEl.get(entry.target as HTMLElement);
              if (!item) continue;
              item.visible = entry.isIntersecting;
              item.el.style.willChange = entry.isIntersecting ? 'transform' : '';
            }
            requestParallax();
          }, { rootMargin: '200px 0px' });
          items.forEach(item => nearViewport.observe(item.el));

          window.addEventListener('scroll', requestParallax, { passive: true });
          requestParallax();
        }
      }

      // GA4: scroll depth (25 / 50 / 75 / 100%)
      //
      // gtag only exists once the visitor has accepted cookies, which may well
      // be after they have already scrolled. So depth is tracked as a
      // high-water mark and the milestones are only *consumed* when there is
      // something to send them to — otherwise a pre-consent scroll would burn
      // all four as no-ops and the visit would report no depth at all.
      const MILESTONES = [25, 50, 75, 100];
      const sentMilestones = new Set<number>();
      let deepestPct = 0;

      const flushScrollDepth = () => {
        const gtag = (window as any).gtag;
        if (!gtag) return;
        for (const milestone of MILESTONES) {
          if (deepestPct >= milestone && !sentMilestones.has(milestone)) {
            sentMilestones.add(milestone);
            gtag('event', 'scroll_depth', {
              event_category: 'Engagement',
              event_label: `${milestone}%`,
              value: milestone,
            });
          }
        }
        // Every milestone is reported at most once, so once they are all in
        // there is nothing left for this handler to do
        if (sentMilestones.size === MILESTONES.length) {
          window.removeEventListener('scroll', reportScrollDepth);
        }
      };

      const reportScrollDepth = () => {
        if (scrollableHeight <= 0) return;
        deepestPct = Math.max(deepestPct, Math.round((window.scrollY / scrollableHeight) * 100));
        flushScrollDepth();
      };
      window.addEventListener('scroll', reportScrollDepth, { passive: true });
      // Consent can land long after the scrolling did; catch up when it does
      window.addEventListener('ca:trackers-ready', flushScrollDepth);

      // GA4: CTA button clicks
      document.addEventListener('click', (e) => {
        const el = (e.target as Element).closest('a, button');
        if (!el) return;
        const text = el.textContent?.trim().slice(0, 50);
        const href = (el as HTMLAnchorElement).href || '';

        // Outbound links
        if (href && !href.includes('cloudalgo.com') && href.startsWith('http')) {
          (window as any).gtag?.('event', 'outbound_click', {
            event_category: 'Outbound',
            event_label: href,
          });
        }

        // CTA buttons (Get in Touch, Book, Contact, Schedule)
        if (/get in touch|book|contact|schedule|send message/i.test(text || '')) {
          (window as any).gtag?.('event', 'cta_click', {
            event_category: 'CTA',
            event_label: text,
          });
        }
      });
    </script>
    <CookieConsent />
  </body>
</html>
