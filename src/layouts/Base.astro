---
import CookieConsent from '../components/ui/CookieConsent.astro';

export interface Props {
  title: string;
  description?: string;
  image?: string;
  canonicalURL?: string;
  /** Pass 'article' for blog posts */
  ogType?: 'website' | 'article';
  /** ISO date string — used for article published_time */
  publishedTime?: string;
  /** Author name — used for article:author on blog posts */
  author?: string;
  /** Category — used for article:section on blog posts */
  section?: string;
  /** Structured-data JSON-LD blob — pass from individual pages */
  schema?: object;
}

const {
  title,
  description = 'CloudAlgo — Certified Salesforce & Heroku consulting. 70+ projects delivered, 12 years experience.',
  image = '/og-default.jpg',
  canonicalURL = new URL(Astro.url.pathname, Astro.site).href,
  ogType = 'website',
  publishedTime,
  author,
  section,
  schema,
} = Astro.props;

const imageHost = 'https://cloudalgo.com';
const ogImage = image.startsWith('http') ? image : `${imageHost}${image}`;
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="icon" type="image/png" href="/favicon.png" />
    <link rel="canonical" href={canonicalURL} />

    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="robots" content="index, follow" />

    <!-- Open Graph -->
    <meta property="og:site_name" content="CloudAlgo" />
    <meta property="og:logo"      content="https://cloudalgo.com/logo.svg" />
    <meta property="og:locale"    content="en_US" />
    <meta property="og:type"      content={ogType} />
    <meta property="og:title"     content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url"       content={canonicalURL} />
    <meta property="og:image"     content={ogImage} />
    <meta property="og:image:type"   content="image/jpeg" />
    <meta property="og:image:width"  content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt"    content={title} />
    {publishedTime && <meta property="article:published_time" content={publishedTime} />}
    {author    && <meta property="article:author"  content={author} />}
    {section   && <meta property="article:section" content={section} />}

    <!-- Twitter / X -->
    <meta name="twitter:card"        content="summary_large_image" />
    <meta name="twitter:site"        content="@cloudalgo" />
    <meta name="twitter:title"       content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image"       content={ogImage} />
    <meta name="twitter:image:alt"   content={title} />

    <!-- JSON-LD structured data -->
    {schema && <script is:inline type="application/ld+json" set:html={JSON.stringify(schema)} />}

  </head>
  <body>
    <slot />
    <script>
      // Scroll animations
      const observer = new IntersectionObserver((entries) => {
        entries.forEach(entry => {
          if (entry.isIntersecting) {
            entry.target.classList.add('in-view');
            observer.unobserve(entry.target);
          }
        });
      }, { threshold: 0.1, rootMargin: '0px 0px -40px 0px' });

      document.querySelectorAll('.anim-fade-up, .anim-scale-pop').forEach(el => {
        observer.observe(el);
      });

      // GA4: scroll depth (25 / 50 / 75 / 100%)
      const scrollMilestones = new Set<number>();
      window.addEventListener('scroll', () => {
        const pct = Math.round(
          (window.scrollY / (document.body.scrollHeight - window.innerHeight)) * 100
        );
        for (const milestone of [25, 50, 75, 100]) {
          if (pct >= milestone && !scrollMilestones.has(milestone)) {
            scrollMilestones.add(milestone);
            (window as any).gtag?.('event', 'scroll_depth', {
              event_category: 'Engagement',
              event_label: `${milestone}%`,
              value: milestone,
            });
          }
        }
      }, { passive: true });

      // GA4: CTA button clicks
      document.addEventListener('click', (e) => {
        const el = (e.target as Element).closest('a, button');
        if (!el) return;
        const text = el.textContent?.trim().slice(0, 50);
        const href = (el as HTMLAnchorElement).href || '';

        // Outbound links
        if (href && !href.includes('cloudalgo.com') && href.startsWith('http')) {
          (window as any).gtag?.('event', 'outbound_click', {
            event_category: 'Outbound',
            event_label: href,
          });
        }

        // CTA buttons (Get in Touch, Book, Contact, Schedule)
        if (/get in touch|book|contact|schedule|send message/i.test(text || '')) {
          (window as any).gtag?.('event', 'cta_click', {
            event_category: 'CTA',
            event_label: text,
          });
        }
      });
    </script>
    <CookieConsent />
  </body>
</html>
