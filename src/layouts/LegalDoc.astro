---
/**
 * DRAFT: template prepared for CloudAlgo. Review by qualified legal
 * counsel before relying on it.
 *
 * The layout every legal document on the site opens on.
 *
 * A legal document is an instrument that is IN FORCE, and the thing you
 * do with one is CITE it. So the page is built around citation: the
 * docket in the masthead says what the instrument is and since when, the
 * clauses are numbered by a CSS counter and each one answers its own
 * anchor, the rail is that numbering as a contents list, and the register
 * at the foot is the other instruments in force.
 *
 * ── Why this file parses its own slot ──
 * Each page writes plain `<h2>` / `<h3>` / `<p>` markup, and this layout
 * renders the slot to a string, splits it on the headings, and wraps each
 * one in the clause markup. The alternative -- every page hand-writing
 * `<section class="clause" id="c-4">` around every heading -- is 400
 * lines of duplicated scaffolding across seven files, and the rail would
 * be a second hand-maintained copy of the same list. Parsing once here
 * means the body and the rail cannot disagree, and a clause inserted
 * anywhere renumbers both.
 *
 * The numbering is never read from the copy. Documents that were
 * hand-numbered ("4. Your responsibilities") have that prefix stripped,
 * so a clause deleted in one of them cannot leave a stale "7." behind.
 *
 * The clause count is checked against src/data/legal.ts at build time.
 * A document and its register entry drifting apart fails the build
 * rather than shipping a wrong figure in the docket.
 */
import Page from '@/layouts/Page.astro';
import PageMasthead from '@/components/ui/PageMasthead.astro';
import type { Crumb } from '@/components/ui/PageMasthead.astro';
import SectionRail from '@/components/ui/SectionRail.astro';
import Instruments from '@/components/sections/Instruments.astro';
import { instrumentFor, siblingsOf, registerLabel, ISSUER } from '@/data/legal';

interface Props {
  /** The document's route -- its key in the register. */
  href: string;
  description: string;
  canonicalURL: string;
  /** The standfirst beside the title: what this document is for, in a
      sentence a reader who is not counsel can act on. */
  lede: string;
  /** Overrides the trail derived from the document's register. */
  crumbs?: Crumb[];
}

const { href, description, canonicalURL, lede, crumbs } = Astro.props;

const doc = instrumentFor(href);
if (!doc) {
  throw new Error(
    `LegalDoc: no instrument registered for "${href}". ` +
      `Add it to src/data/legal.ts before giving it a page.`,
  );
}

/* The trail follows the register, so the four OrgVitals documents cannot
   drift into four slightly different versions of the same path. */
const trails: Record<typeof doc.register, Crumb[]> = {
  site: [{ label: 'Home', href: '/' }],
  orgvitals: [
    { label: 'Home', href: '/' },
    { label: 'Products', href: '/products' },
    { label: 'OrgVitals', href: '/products/orgvitals' },
    { label: 'Legal', href: '/products/orgvitals/legal' },
  ],
  insurealgo: [
    { label: 'Home', href: '/' },
    { label: 'Products', href: '/products' },
    { label: 'InsureAlgo', href: '/products/insurealgo' },
  ],
};

const trail: Crumb[] = crumbs ?? [...trails[doc.register], { label: doc.title }];

/* ── Parsing the slot ────────────────────────────────────── */

const raw = await Astro.slots.render('default');

const H2 = /<h2\b[^>]*>([\s\S]*?)<\/h2>/g;
const heads = [...raw.matchAll(H2)];

/** Heading markup to a plain string, for the rail and the anchor label. */
const plain = (html: string) =>
  html
    .replace(/<[^>]+>/g, '')
    .replace(/&amp;/g, '&')
    .replace(/&nbsp;/g, ' ')
    .trim()
    /* Hand-typed clause numbers are dropped: the counter owns numbering. */
    .replace(/^\d+\.\s*/, '');

/** Sub-headings and tables inside a clause take the clause's own markup. */
const dress = (html: string) =>
  html
    .replace(
      /<h3\b[^>]*>([\s\S]*?)<\/h3>/g,
      (_m, inner) =>
        `<h3 class="clause__sub"><span class="clause__sub-n" aria-hidden="true"></span><span>${inner}</span></h3>`,
    )
    .replace(/<table\b[^>]*>/g, '<table class="clause__table">');

const lead = (heads.length > 0 ? raw.slice(0, heads[0].index) : raw).trim();

const clauses = heads.map((m, i) => {
  const start = m.index! + m[0].length;
  const end = i + 1 < heads.length ? heads[i + 1].index! : raw.length;
  return {
    id: `c-${i + 1}`,
    title: plain(m[1]),
    body: dress(raw.slice(start, end)),
  };
});

if (clauses.length !== doc.clauses) {
  throw new Error(
    `LegalDoc: ${href} renders ${clauses.length} clauses, but the register ` +
      `in src/data/legal.ts says ${doc.clauses}. Update whichever is wrong.`,
  );
}

const siblings = siblingsOf(href);
const family = registerLabel[doc.register];
---

<Page
  title={`${doc.title}${doc.register === 'site' ? '' : ` — ${family}`} | CloudAlgo`}
  description={description}
  canonicalURL={canonicalURL}
>
  <PageMasthead crumbs={trail} standClass="docket">
    <Fragment slot="title">{doc.title}</Fragment>
    <Fragment slot="lede">{lede}</Fragment>

    <Fragment slot="stand">
      <span class="pip pip--ga docket__pip">In force</span>
      <dl>
        <div><dt>Applies to</dt><dd>{doc.appliesTo}</dd></div>
        <div><dt>In force since</dt><dd>{doc.inForce}</dd></div>
        <div><dt>Clauses</dt><dd>{doc.clauses}</dd></div>
        {doc.governingLaw && (
          <div><dt>Governing law</dt><dd>{doc.governingLaw}</dd></div>
        )}
        <div><dt>Issued by</dt><dd>{ISSUER}</dd></div>
      </dl>
    </Fragment>
  </PageMasthead>

  <div class="doc">
    <div class="doc__body">
      {lead && <div class="doc__lead" set:html={lead} />}

      {clauses.map((c) => (
        <section class="clause" id={c.id}>
          <h2 class="clause__h">
            <span class="clause__n" aria-hidden="true"></span>
            <span>
              {c.title}
              <a class="clause__cite" href={`#${c.id}`} aria-label={`Link to ${c.title}`}>&para;</a>
            </span>
          </h2>
          <div class="clause__body" set:html={c.body} />
        </section>
      ))}
    </div>

    <SectionRail
      items={clauses.map((c) => ({ id: c.id, title: c.title }))}
      label="Clauses"
      observe=".clause"
      footNote="Questions about this document go to"
      footHref="mailto:contact@cloudalgo.com"
      footLabel="contact@cloudalgo.com"
    />
  </div>

  {siblings.length > 0 && (
    <Instruments
      title={`Also in force${doc.register === 'site' ? '' : ` for ${family}`}`}
      meta={`Issued by ${ISSUER}`}
      items={siblings}
    />
  )}
</Page>
